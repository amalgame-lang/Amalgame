        // parse, and field breakdown are all native AM now. The
        // resolver picks up the class declarations directly from
        // the bundled .am.
        // Crypto — migrated post-v0.7.5: the SHA-256 compression
        // function + HMAC ipad/opad live in a top-level @c { } block
        // inside src/stdlib/crypto.am. Public Sha256.* / Hmac.*
        // methods bridge through small @c blocks.
        // String
        this.DeclareGlobal("String_Length",     "int",    false)
        this.DeclareGlobal("String_IsEmpty",    "bool",   false)
        this.DeclareGlobal("String_Contains",   "bool",   false)
        this.DeclareGlobal("String_StartsWith", "bool",   false)
        this.DeclareGlobal("String_EndsWith",   "bool",   false)
        this.DeclareGlobal("String_IndexOf",    "int",    false)
        this.DeclareGlobal("String_LastIndexOf","int",    false)
        this.DeclareGlobal("String_Substring",  "string", false)
        this.DeclareGlobal("String_ToUpper",    "string", false)
        this.DeclareGlobal("String_ToLower",    "string", false)
        this.DeclareGlobal("String_Trim",       "string", false)
        this.DeclareGlobal("String_TrimStart",  "string", false)
        this.DeclareGlobal("String_TrimEnd",    "string", false)
        this.DeclareGlobal("String_Replace",    "string", false)
        this.DeclareGlobal("String_Split",      "List<string>", false)
        this.DeclareGlobal("String_Join",       "string", false)
        this.DeclareGlobal("String_Repeat",     "string", false)
        this.DeclareGlobal("String_ToInt",      "int",    false)
        this.DeclareGlobal("String_ToFloat",    "float",  false)
        this.DeclareGlobal("String_FromInt",    "string", false)
        this.DeclareGlobal("String_FromByte",   "string", false)
        this.DeclareGlobal("String_FromCodepoint", "string", false)
        // Process args + exit code — backed by globals set in main()
        this.DeclareGlobal("Args_Count",        "int",    false)
        this.DeclareGlobal("Args_Get",          "string", false)
        this.DeclareGlobal("Exit_Set",          "void",   false)
        this.DeclareGlobal("Exit_Get",          "int",    false)
        this.DeclareGlobal("String_FromFloat",  "string", false)
        this.DeclareGlobal("String_From",       "string", false)
        this.DeclareGlobal("String_CharAt",     "string", false)
        // Net — TCP/UDP sockets only. The libcurl-backed Http_*
        // helpers used to live here through v0.8.30 but were
        // dropped in v0.8.31 — amc no longer links against libcurl.
        // Use the external `amalgame-net-http` (pure-AM HTTP/1.1)
        // or future `amalgame-net-curl` (libcurl binding) packages.
        this.DeclareGlobal("TcpServer_Listen",  "?",      false)
        this.DeclareGlobal("TcpServer_Accept",  "?",      false)
        this.DeclareGlobal("TcpServer_Close",   "void",   false)
        this.DeclareGlobal("TcpServer_IsListening", "bool", false)
        this.DeclareGlobal("TcpClient_Connect", "?",      false)
        this.DeclareGlobal("TcpClient_Send",    "void",   false)
        this.DeclareGlobal("TcpClient_Receive", "string", false)
        this.DeclareGlobal("TcpClient_Close",   "void",   false)
        this.DeclareGlobal("TcpClient_IsConnected", "bool", false)
        this.DeclareGlobal("TcpConn_Send",      "void",   false)
        this.DeclareGlobal("TcpConn_Receive",   "string", false)
        this.DeclareGlobal("TcpConn_Close",     "void",   false)
        this.DeclareGlobal("TcpConn_IsConnected", "bool", false)
        this.DeclareGlobal("UdpSocket_New",         "?",      false)
        this.DeclareGlobal("UdpSocket_Bind",        "bool",   false)
        this.DeclareGlobal("UdpSocket_Send",        "bool",   false)
        this.DeclareGlobal("UdpSocket_Receive",     "string", false)
        // v0.8.52: recvfrom + select-timeout variant. Returns
        // AmalgameUdpDatagram* (Data/DataLen/FromIp/FromPort)
        // accessed via field-style — required for any P2P UDP
        // protocol where the sender of each packet matters
        // (ACK routing, request/response).
        this.DeclareGlobal("UdpSocket_ReceiveFrom", "?",      false)
        // v0.8.53: tune SO_RCVBUF. Default is 8 MiB (set in
        // UdpSocket_New); this overrides explicitly. Returns the
        // kernel-granted size or -1.
        this.DeclareGlobal("UdpSocket_SetRecvBuf",  "i64",    false)
        this.DeclareGlobal("UdpSocket_Close",       "void",   false)
    }

    // ── Scope management (nested stack) ───────────────
    // LocalNames/Types/IsLets is a flat array of all live entries across nested scopes.
    // ScopeStarts is a stack of start indices: the current scope owns indices [top..count).
    // Lookups walk LocalNames backwards so inner scopes shadow outer ones.

    private void PushScope(string label) {
        this.ScopeStarts.Add(this.LocalNames.Count())
    }

    private void PopScope() {
        let depth = this.ScopeStarts.Count()
        if (depth == 0) { return }
        let mark = this.ScopeStarts.Get(depth - 1)
        this.ScopeStarts.RemoveAt(depth - 1)
        // Truncate LocalNames/Types/IsLets back to mark (drop entries
        // declared in this scope) and restore each name's shadowed
        // binding in LocalIndex so the outer scope's binding (if any)
        // becomes visible again.
        while (this.LocalNames.Count() > mark) {
            let last = this.LocalNames.Count() - 1
            let lname: string = this.LocalNames.Get(last)
            let prev:  int    = this.ShadowPrev.Get(last)
            if (prev < 0) {
                this.LocalIndex.Remove(lname)
            } else {
                this.LocalIndex.Set(lname, prev)
            }
            this.LocalNames.RemoveAt(last)
            this.LocalTypes.RemoveAt(last)
            this.LocalIsLets.RemoveAt(last)
            this.ShadowPrev.RemoveAt(last)
        }
    }

    private int CurrentScopeStart() {
        let depth = this.ScopeStarts.Count()
        if (depth == 0) { return 0 }
        return this.ScopeStarts.Get(depth - 1)
    }

    private void DeclareGlobal(string name, string typeName, bool isLet) {
        // O(1) dedupe via the hashed index instead of a linear scan
        // over GlobalNames. With ~1k globals declared by the time
        // the workspace finishes Pass 1, the old O(N) scan dominated
        // total Resolve time (~150s on c_gen.am pre-index).
        if (this.GlobalIndex.Has(name)) { return }
        let idx: int = this.GlobalNames.Count()
        this.GlobalNames.Add(name)
        this.GlobalTypes.Add(typeName)
        this.GlobalIndex.Set(name, idx)
    }

    // Helper exists separately so the self-host codegen sees the
    // PARAM AstNode through a typed parameter — chained `.Get(i).Name`
    // erases to void* across the call boundary and breaks the
    // declaration. Used by the lambda resolver branch.
    //
    // v2.5: respect the param's annotated type when it has been
    // pre-patched by PatchLambdaParamTypes from a higher-order method
    // callsite. Falls back to "?" (capture by-value as int) otherwise.
    private void DeclareLambdaParam(AstNode p) {
        var t: string = p.Str
        if (String_Length(t) == 0) { t = "?" }
        this.DeclareCurrent(p.Name, t, true)
    }

    private bool DeclareCurrent(string name, string typeName, bool isLet) {
        // Duplicate check: only within the current scope (allow
        // shadowing outer scopes). LocalIndex stores the latest
        // binding for `name`; if it's >= the current scope's start
        // it's a same-scope dup, otherwise it's an outer binding we
        // legitimately shadow.
        let start = this.CurrentScopeStart()
        if (this.LocalIndex.Has(name)) {
            let existing: int = this.LocalIndex.Get(name)
            if (existing >= start) { return false }
        }
        let newIdx: int = this.LocalNames.Count()
        var prev: int = -1
        if (this.LocalIndex.Has(name)) { prev = this.LocalIndex.Get(name) }
        this.LocalNames.Add(name)
        this.LocalTypes.Add(typeName)
        this.LocalIsLets.Add(isLet)
        this.ShadowPrev.Add(prev)
        this.LocalIndex.Set(name, newIdx)
        return true
    }

    private bool LookupInScopes(string name) {
        if (this.LocalIndex.Has(name)) { return true }
        return this.GlobalIndex.Has(name)
    }

    private string LookupType(string name) {
        if (this.LocalIndex.Has(name)) {
            let idx: int = this.LocalIndex.Get(name)
            return this.LocalTypes.Get(idx)
        }
        if (this.GlobalIndex.Has(name)) {
            let idx: int = this.GlobalIndex.Get(name)
            return this.GlobalTypes.Get(idx)
        }
        return "?"
    }

    private bool LookupIsLet(string name) {
        if (this.LocalIndex.Has(name)) {
            let idx: int = this.LocalIndex.Get(name)
            return this.LocalIsLets.Get(idx)
        }
        return false
    }

    // Local-only lookup: return the LocalNames index, or -1 if not local.
    // Used by capture analysis to decide whether an identifier lives in
    // an enclosing scope (idx < LambdaBoundary) or in the lambda itself.
    private int IndexOfLocal(string name) {
        if (this.LocalIndex.Has(name)) { return this.LocalIndex.Get(name) }
        return -1
    }

    // Record a captured local on the lambda node (in `Args`, deduped).
    // Each capture is stored as an IDENTIFIER node carrying the captured
    // name (Name) and its Amalgame type (Str), which CGen later turns
    // into the env struct field type.
    private void AddCapture(AstNode lam, string name, string typeName, int line, int col) {
        let n = lam.Args.Count()
        for i in 0..n {
            let arg = lam.Args.Get(i)
            if (arg.Name == name) { return }
        }
        let id = new AstNode(NodeKind.IDENTIFIER, line, col)
        id.Name = name
        id.Str  = typeName
        lam.Args.Add(id)
    }

    // Idempotent capture attempt by name. Used by the IDENTIFIER
    // branch of ResolveExpr and by the string-interpolation scanner
    // (CaptureIdentsInInterpExpr) which needs to trigger capture on
    // identifiers embedded in `"{…}"` segments that the resolver
    // wouldn't otherwise walk (the parser keeps the interpolation
    // raw and the cgen lowers it via InterpExprToC later).
    private void TryCaptureLocalByName(string name, int line, int col) {
        if (this.LambdaInProgress == null) { return }
        let idx = this.IndexOfLocal(name)
        if (idx == -1) { return }
        if (idx >= this.LambdaBoundary) { return }
        var typeName = this.LocalTypes.Get(idx)
        if (String_Length(typeName) == 0 || typeName == "?") {
            typeName = "int"
        }
        this.AddCapture(this.LambdaInProgress, name, typeName, line, col)
    }

    // Walk the inside of a `{…}` interpolation segment and trigger
    // capture analysis on every identifier-shaped token. TryCapture
    // is a no-op for non-locals so spurious tokens (field names,
    // method names, keywords) are safe.
    private void CaptureIdentsInInterpExpr(string inner, int line, int col) {
        let n          = String_Length(inner)
        let identStart = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_"
        let identCont  = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
        var i = 0
        while (i < n) {
            let ch = String_Substring(inner, i, 1)
            if (!String_Contains(identStart, ch)) {
                i = i + 1
                continue
            }
            var j = i + 1
            while (j < n) {
                let cj = String_Substring(inner, j, 1)
                if (!String_Contains(identCont, cj)) { break }
                j = j + 1
            }
            // Only attempt capture on the first token of a member chain.
            // A leading `.` before our position means we're at a member
            // access (`x.Field`) — skip it; only the receiver `x`
            // matters for capture, and we've already scanned it.
            var skip = false
            if (i > 0) {
                let prev = String_Substring(inner, i - 1, 1)
                if (prev == ".") { skip = true }
            }
            if (!skip) {
                let name = String_Substring(inner, i, j - i)
                this.TryCaptureLocalByName(name, line, col)
            }
            i = j
        }
    }

    // ── Error reporting ───────────────────────────────

    private void Error(string msg, AstNode node) {
        this.EmitError(msg, node.Line, node.Column)
    }

    private void ErrorMsg(string msg) {
        this.EmitError(msg, 0, 0)
    }

    private void EmitError(string msg, int line, int col) {
        let file = this.CurrentFile
        let ln   = String_FromInt(line)
        let cl   = String_FromInt(col)
        var head = "\nerror[resolver]: " + msg + "\n"
        if (String_Length(file) > 0 && line > 0) {
            head = head + "  --> " + file + ":" + ln + ":" + cl + "\n"
            let snip = this.Sources.GetLine(file, line)
            head = head + SourceSnippet.Format(snip, line, col)
        }
        this.Errors.Add(head)
        // Structured copy for downstream consumers (LSP). The
        // formatted string in `Errors` stays untouched so existing
        // CLI output paths are unaffected.
        let raw = new ResolverError(msg, file, line, col)
        this.RawErrors.Add(raw)
    }

    public bool HasErrors() {
        return this.Errors.Count() > 0
    }

    public string GetErrors() {
        var result = ""
        let count  = this.Errors.Count()
        for i in 0..count {
            result = result + this.Errors.Get(i)
        }
        return result
    }

    // ── Public entry points ───────────────────────────

    // Typed accessors over Programs for callers (TypeChecker) — chained
    // access like `this.Symbols.Programs.Get(i)` confuses the self-host
    // codegen, which emits `Programs_Get` instead of `Programs->Get`.
    public int ProgramCount() {
        return this.Programs.Count()
    }

    public AstNode ProgramAt(int i) {
        return this.Programs.Get(i)
    }

    // Read-only enumeration of declared global names. Used by the LSP
    // server to populate completion lists. Names + types are kept in
    // lockstep, so the indices match.
    public int GlobalCount() {
        return this.GlobalNames.Count()
    }

    public string GlobalNameAt(int i) {
        return this.GlobalNames.Get(i)
    }

    public string GlobalTypeAt(int i) {
        return this.GlobalTypes.Get(i)
    }

    public void ResolvePrograms() {
        this.CollectAll()
        this.ResolveAll()
    }

    // Pass 1 only — collects every top-level class / enum / member
    // into the global symbol table. Idempotent over the same
    // Programs list (DeclareGlobal + MemberTable.Set both dedupe).
    // Exposed separately so callers (CLI --verbose, LSP refresh)
    // can time the two passes independently.
    public void CollectAll() {
        let progCount = this.Programs.Count()
        for p in 0..progCount {
            this.CollectProgram(this.Programs.Get(p))
        }
    }

    // Pass 2 only — walks every method body, resolving identifier
    // references against the global table + the local-scope stack.
    // Must run after CollectAll so cross-file forward references
    // resolve (a method declared in A.am can refer to a class
    // declared in B.am that hasn't been Pass-2'd yet).
    public void ResolveAll() {
        let progCount = this.Programs.Count()
        for p in 0..progCount {
            this.ResolveProgram(this.Programs.Get(p))
        }
    }

    // ── Pass 1: Collect ───────────────────────────────

    private void CollectProgram(AstNode prog) {
        let count = prog.Children.Count()
        for i in 0..count {
            this.CollectDecl(prog.Children.Get(i))
        }
    }

    private void CollectDecl(AstNode decl) {
        let k = decl.Kind
        if (k == NodeKind.CLASS_DECL) {
            this.DeclareGlobal(decl.Name, decl.Name, false)
            this.CollectClassMembers(decl)
        }
        if (k == NodeKind.ENUM_DECL) {
            this.DeclareGlobal(decl.Name, decl.Name, false)
            this.CollectEnumMembers(decl)
        }
    }

    private void CollectClassMembers(AstNode cls) {
        let name    = cls.Name
        let kids    = cls.Children
        let members = kids.Count()
        for i in 0..members {
            this.CollectClassMember(name, kids.Get(i))
        }
    }

    private void CollectClassMember(string className, AstNode m) {
        let mk = m.Kind
        if (mk == NodeKind.VAR_DECL) {
            this.Members.Set(className, m.Name, m.Str)
        }
        if (mk == NodeKind.METHOD_DECL) {
            this.Members.Set(className, m.Name, m.Str)
            // Also index the AstNode so PatchLambdaParamTypesGeneric's
            // FindMethodInPrograms is O(1) instead of O(progs ×
            // classes × methods) per CALL/NEW_EXPR.
            this.MethodNodeIndex.Set(className + "." + m.Name, m)
        }
    }

    private void CollectEnumMembers(AstNode en) {
        let name = en.Name
        let kids = en.Children
        let count = kids.Count()
        for i in 0..count {
            this.CollectEnumMember(name, kids.Get(i))
        }
    }

    private void CollectEnumMember(string enumName, AstNode m) {
        this.Members.Set(enumName, m.Name, enumName)
        let qualName = enumName + "_" + m.Name
        this.DeclareGlobal(qualName, enumName, false)
    }

    // ── Pass 2: Resolve ───────────────────────────────

    private void ResolveEnumChild(AstNode m) {
        if (m.Kind == NodeKind.METHOD_DECL) {
            this.ResolveMethod(m)
        }
    }

    private void ResolveProgram(AstNode prog) {
        // Filename is stashed by the parser in Str2 so error messages can
        // resolve to the right source for snippet rendering.
        this.CurrentFile = prog.Str2
        let count = prog.Children.Count()
        for i in 0..count {
            this.ResolveDecl(prog.Children.Get(i))
        }
    }

    private void ResolveDecl(AstNode decl) {
        let k = decl.Kind
        if (k == NodeKind.CLASS_DECL) {
            this.ResolveClass(decl)
        }
        if (k == NodeKind.ENUM_DECL) {
            let enumKids = decl.Children
            let methods  = enumKids.Count()
            for i in 0..methods {
                this.ResolveEnumChild(enumKids.Get(i))
            }
        }
    }

    private void ResolveClass(AstNode cls) {
        let prevClass     = this.CurrentClass
        this.CurrentClass = cls.Name
        this.PushScope("class:" + cls.Name)

        // Register "this" in class scope
        this.DeclareCurrent("this", cls.Name, false)

        // Pre-register all fields and methods in class scope
        let classKids = cls.Children
        let members   = classKids.Count()
        for i in 0..members {
            this.PreRegisterMember(classKids.Get(i))
        }

        // Resolve method bodies
        for j in 0..members {
            this.ResolveMember(classKids.Get(j))
        }

        this.PopScope()
        this.CurrentClass = prevClass
    }

    private void PreRegisterMember(AstNode m) {
        let mk = m.Kind
        if (mk == NodeKind.VAR_DECL) {
            this.DeclareCurrent(m.Name, m.Str, false)
        }
        if (mk == NodeKind.METHOD_DECL) {
            this.DeclareCurrent(m.Name, m.Str, false)
        }
    }

    private void ResolveMember(AstNode m) {
        let mk = m.Kind
        if (mk == NodeKind.METHOD_DECL) {
            this.ResolveMethod(m)
        }
        if (mk == NodeKind.VAR_DECL) {
            if (m.Left != null) { this.ResolveExpr(m.Left) }
        }
    }

    private void ResolveMethod(AstNode method) {
        let prevReturn     = this.CurrentReturn
        this.CurrentReturn = method.Str
        this.PushScope("method:" + method.Name)

        // Register params
        let params = method.Params.Count()
        for i in 0..params {
            let p = method.Params.Get(i)
            this.DeclareCurrent(p.Name, p.Str, true)
        }

        // Resolve body
        if (method.Body != null) {
            this.ResolveBlock(method.Body)
        }

        this.PopScope()
        this.CurrentReturn = prevReturn
    }

    private void ResolveBlock(AstNode block) {
        this.PushScope("block")
        let stmts = block.Children.Count()
        for i in 0..stmts {
            this.ResolveStmt(block.Children.Get(i))
        }
        this.PopScope()
    }

    private void ResolveStmt(AstNode stmt) {
        if (stmt == null) { return }
        let k = stmt.Kind

        match k {
            NodeKind.VAR_DECL => {
                // Resolve RHS first (can't see variable being declared)
                if (stmt.Left != null) { this.ResolveExpr(stmt.Left) }
                let isLet = stmt.Flag == false   // Flag = isMut; let = not mutable
                // v2.5: when no annotation is given, infer the variable's
                // type from the RHS so PatchLambdaParamTypes can later see
                // it as `List<User>` (rather than ""). Falls back to the
                // explicit annotation otherwise.
                var declType: string = stmt.Str
                if (String_Length(declType) == 0 && stmt.Left != null) {
                    declType = this.InferExprType(stmt.Left)
                }
                this.DeclareCurrent(stmt.Name, declType, isLet)
                return
            }
            NodeKind.RETURN_STMT => {
                if (stmt.Left != null) { this.ResolveExpr(stmt.Left) }
                return
            }
            NodeKind.IF_STMT => {
                this.ResolveIf(stmt)
                return
            }
            NodeKind.WHILE_STMT => {
                if (stmt.Cond != null) { this.ResolveExpr(stmt.Cond) }
                this.LoopDepth = this.LoopDepth + 1
                if (stmt.Body != null) { this.ResolveBlock(stmt.Body) }
                this.LoopDepth = this.LoopDepth - 1
                return
            }
            NodeKind.FOR_IN_STMT => {
                this.ResolveForIn(stmt)
                return
            }
            NodeKind.BREAK_STMT => {
                if (this.LoopDepth == 0) { this.Error("'break' outside loop", stmt) }
                return
            }
            NodeKind.CONTINUE_STMT => {
                if (this.LoopDepth == 0) { this.Error("'continue' outside loop", stmt) }
                return
            }
            NodeKind.TRY_STMT => {
                if (stmt.Body != null) { this.ResolveBlock(stmt.Body) }
                if (stmt.Else != null) {
                    this.PushScope("catch")
                    if (String_Length(stmt.Name) > 0) {
                        this.DeclareCurrent(stmt.Name, "void*", true)
                    }
                    this.ResolveBlock(stmt.Else)
                    this.PopScope()
                }
                if (stmt.Cond != null) { this.ResolveBlock(stmt.Cond) }
                return
            }
            NodeKind.THROW_STMT => {
                if (stmt.Left != null) { this.ResolveExpr(stmt.Left) }
                return
            }
            NodeKind.INLINE_C => {
                // Raw C splice — opaque to the Amalgame frontend by design.
                return
            }
            NodeKind.ASSIGN => {
                this.ResolveAssign(stmt)
                return
            }
            // Block (e.g. try/catch emitted as nested block)
            NodeKind.BLOCK => {
                this.ResolveBlock(stmt)
                return
            }
            _ => { }
        }
        // Match nodes are stored as IF_STMT with Name="__match__" and are
        // already handled by the IF_STMT arm above; this Name-keyed guard
        // stays as a belt for any bare match arriving with another kind.
        if (stmt.Name == "__match__") {
            this.ResolveMatch(stmt)
            return
        }
        // Expression statement
        this.ResolveExpr(stmt)
    }

    private void ResolveIf(AstNode stmt) {
        if (stmt.Cond != null) { this.ResolveExpr(stmt.Cond) }
        if (stmt.Body != null) { this.ResolveBlock(stmt.Body) }
        if (stmt.Else != null) {
            this.ResolveElseBranch(stmt.Else)
        }
    }

    private void ResolveElseBranch(AstNode branch) {
        if (branch == null) { return }
        let bk = branch.Kind
        if (bk == NodeKind.IF_STMT) {
            this.ResolveIf(branch)
        } else {
            this.ResolveBlock(branch)
        }
    }

    private void ResolveForIn(AstNode stmt) {
        // stmt.Left = iterable, stmt.Name = loop var
        if (stmt.Left != null) { this.ResolveExpr(stmt.Left) }
        this.PushScope("for-in")
        // Infer element type from iterable
        var elemType = "?"
        if (stmt.Left != null) {
            let colType = this.InferExprType(stmt.Left)
            elemType    = this.CollectionElemType(colType)
        }
        this.DeclareCurrent(stmt.Name, elemType, true)
        this.LoopDepth = this.LoopDepth + 1
        if (stmt.Body != null) { this.ResolveBlock(stmt.Body) }
        this.LoopDepth = this.LoopDepth - 1
        this.PopScope()
    }

    private void ResolveAssign(AstNode stmt) {
        if (stmt.Left  != null) { this.ResolveExpr(stmt.Left) }
        if (stmt.Right != null) { this.ResolveExpr(stmt.Right) }
        // Immutability check
        if (stmt.Left != null && stmt.Left.Kind == NodeKind.IDENTIFIER) {
            let varName = stmt.Left.Name
            if (this.LookupIsLet(varName)) {
                this.Error("Cannot assign to immutable binding '" + varName + "'", stmt.Left)
            }
        }
    }

    private void ResolveMatch(AstNode stmt) {
        if (stmt.Left != null) { this.ResolveExpr(stmt.Left) }
        let armCount = stmt.Children.Count()
        for i in 0..armCount {
            this.ResolveMatchArm(stmt.Children.Get(i))
        }
    }

    private void ResolveMatchArm(AstNode arm) {
        if (arm == null) { return }
        this.PushScope("match-arm")
        // arm.Left = pattern, arm.Right = body
        if (arm.Left  != null) { this.ResolveExpr(arm.Left) }
        let armBody = arm.Right
        if (armBody != null) {
            this.ResolveArmBody(armBody)
        }
        this.PopScope()
    }

    private void ResolveArmBody(AstNode body) {
        let bk = body.Kind
        if (bk == NodeKind.BLOCK) {
            let kids  = body.Children
            let count = kids.Count()
            for i in 0..count {
                this.ResolveStmt(kids.Get(i))
            }
        } else {
            this.ResolveStmt(body)
        }
    }

    // ── Lambda param-type inference (v2.5) ────────────
    //
    // When the call is a higher-order list method like
    // xs.Map(x => x.Name), the lambda's PARAM is created with type "?"
    // by the parser. The CGen emits the lambda top-level BEFORE seeing
    // the callsite, so without this patch the body would resolve `x` as
    // an untyped local and `x.Name` would fail. We mutate p.Str on the
    // PARAM AstNode here, before descending into the lambda body, so
    // that DeclareLambdaParam (and later the typechecker / cgen) see
    // the inferred element type.
    //
    // Single-T methods (Map, Filter, ForEach, Any, All, CountIf) take a
    // (T) → ? lambda where T is the element type of the receiver.
    // Reduce takes (Acc, T) → Acc and is deferred to a follow-up
    // because the Acc type depends on the init argument, not the
    // receiver alone.
    // Returns true if any of the call's args is a __lambda__
    // METHOD_DECL node. Used as a cheap pre-check so the per-call
    // type-inference / method lookup work in the lambda-patching
    // path is skipped on the (very common) calls with no lambda args.
    // On c_gen.am this trims resolve time from ~145s to ~25s.
    private bool HasLambdaArg(AstNode call) {
        let argc: int = call.Args.Count()
        for i in 0..argc {
            let arg: AstNode = call.Args.Get(i)
            if (arg.Kind == NodeKind.METHOD_DECL && arg.Name == "__lambda__") {
                return true
            }
        }
        return false
    }

    private void PatchLambdaParamTypes(AstNode call) {
        if (call.Left == null) { return }
        if (call.Left.Kind != NodeKind.MEMBER) { return }
        let methodName = call.Left.Name
        var isSingleT = false
        if (methodName == "Map") { isSingleT = true }
        else if (methodName == "Filter") { isSingleT = true }
        else if (methodName == "ForEach") { isSingleT = true }
        else if (methodName == "Any") { isSingleT = true }
        else if (methodName == "All") { isSingleT = true }
        else if (methodName == "CountIf") { isSingleT = true }
        if (!isSingleT) { return }
        if (call.Left.Left == null) { return }
        // Skip the receiver-type inference unless the call actually has
        // a lambda arg to patch. Without this every `xs.Map(x)` in the
        // codebase paid for a recursive InferExprType walk.
        if (!this.HasLambdaArg(call)) { return }
        let recvType = this.InferExprType(call.Left.Left)
        let elem: string = this.CollectionElemType(recvType)
        if (String_Length(elem) == 0) { return }
        if (elem == "?") { return }
        let argc: int = call.Args.Count()
        for i in 0..argc {
            let arg = call.Args.Get(i)
            if (arg.Kind == NodeKind.METHOD_DECL && arg.Name == "__lambda__") {
                let pn: int = arg.Params.Count()
                if (pn >= 1) {
                    let p = arg.Params.Get(0)
                    if (String_Length(p.Str) == 0 || p.Str == "?") {
                        p.Str = elem
                    }
                }
            }
        }
    }

    // ── Lambda-param inference from typed-Closure target signatures ─
    //
    // When a lambda is passed *directly* (no typed-local binding) to a
    // method/ctor parameter declared `Closure<A1, A2, …, R>`, push each
    // A_i into the lambda's i-th PARAM Str. The cgen then emits the
    // pointer-typed unpack (`Demo_User* u = (Demo_User*)__arg0;`) and
    // the body resolves `u.Name` without the `(c: Type) =>` workaround.
    //
    // Sites covered:
    //   - NEW_EXPR  (`new Route(c => …)`):     ctor params
    //   - CALL via MEMBER (`r.SetHandler(c => …)`): method params
    //
    // The static-method shape (`Foo(c => …)` with Foo top-level) is
    // out of scope — Amalgame doesn't have top-level fns, every static
    // call goes through a class via MEMBER (`Foo.Bar(c => …)`), which
    // the MEMBER branch already handles.

    public AstNode FindMethodInPrograms(string className, string methodName) {
        // O(1) lookup via the index populated during CollectAll.
        // Falls back to null if the (class, method) pair wasn't seen
        // (external programs registered AFTER CollectAll, dynamic
        // lookups before the table is fully populated, etc.). The
        // pre-index implementation was a triple-nested loop that
        // dominated Pass-2 resolve time on c_gen.am (140s+ → seconds).
        let key: string = className + "." + methodName
        if (!this.MethodNodeIndex.Has(key)) { return null }
        return this.MethodNodeIndex.Get(key)
    }

    private void PatchLambdasFromTypedClosureParams(AstNode call, AstNode methodDecl) {
        if (methodDecl == null) { return }
        let pn: int = methodDecl.Params.Count()
        let argc: int = call.Args.Count()
        let lim: int = if (pn < argc) { pn } else { argc }
        for ai in 0..lim {
            let arg: AstNode = call.Args.Get(ai)
            if (arg.Kind != NodeKind.METHOD_DECL) { continue }
            if (arg.Name != "__lambda__") { continue }
            let param: AstNode = methodDecl.Params.Get(ai)
            let paramT: string = param.Str
            if (!String_StartsWith(paramT, "Closure<")) { continue }
            if (!String_EndsWith(paramT, ">")) { continue }
            let inner: string = String_Substring(paramT, 8, String_Length(paramT) - 9)
            let parts: List<string> = this.SplitTopLevelCommasResolver(inner)
            let pc: int = parts.Count()
            if (pc < 1) { continue }
            // All entries except the last are arg types — patch lambda's params.
            let argTypeCount: int = pc - 1
            let lamPn: int = arg.Params.Count()
            let toPatch: int = if (argTypeCount < lamPn) { argTypeCount } else { lamPn }
            for li in 0..toPatch {
                let lp: AstNode = arg.Params.Get(li)
                if (String_Length(lp.Str) == 0 || lp.Str == "?") {
                    lp.Str = String_Trim(parts.Get(li))
                }
            }
        }
    }

    // Depth-aware comma split so `Closure<List<int>, Map<string,int>, R>`
    // returns 3 parts (mirrors c_gen.am::SplitTopLevelCommas).
    private List<string> SplitTopLevelCommasResolver(string s) {
        let parts: List<string> = new List<string>()
        let n: int = String_Length(s)
        var depth: int = 0
        var cur: string = ""
        for i in 0..n {
            let ch: string = String_Substring(s, i, 1)
            if (ch == "<") { depth = depth + 1; cur = cur + ch }
            else if (ch == ">") { depth = depth - 1; cur = cur + ch }
            else if (ch == "," && depth == 0) {
                parts.Add(cur)
                cur = ""
            } else {
                cur = cur + ch
            }
        }
        if (String_Length(cur) > 0) { parts.Add(cur) }
        return parts
    }

    private void PatchLambdaParamTypesGeneric(AstNode expr) {
        // Cheap pre-check: skip both NEW_EXPR + CALL branches when
        // the args carry no lambda. The receiver-type inference +
        // FindMethodInPrograms lookup otherwise fire for every call
        // in the AST (thousands per big method), which dominated
        // resolve time on c_gen.am.
        if (!this.HasLambdaArg(expr)) { return }
        // NEW_EXPR: ctor lookup on the class being constructed.
        if (expr.Kind == NodeKind.NEW_EXPR) {
            let methodDecl: AstNode = this.FindMethodInPrograms(expr.Name, expr.Name)
            this.PatchLambdasFromTypedClosureParams(expr, methodDecl)
            return
        }
        // CALL via MEMBER: method lookup on the receiver's class.
        // Two shapes:
        //   - `ClassName.Method(lambda)`  → static; recvClass == ClassName
        //   - `localVar.Method(lambda)`   → instance; recvClass == type of localVar
        if (expr.Kind == NodeKind.CALL && expr.Left != null && expr.Left.Kind == NodeKind.MEMBER) {
            let mem: AstNode = expr.Left
            if (mem.Left == null) { return }
            var recvClass: string = ""
            if (mem.Left.Kind == NodeKind.IDENTIFIER) {
                let recvName: string = mem.Left.Name
                if (this.LookupInScopes(recvName)) {
                    let t: string = this.GetTypeName(recvName)
                    if (t == recvName) {
                        // Static-call shape: class name registered as its
                        // own type marker (DeclareGlobal(name, name, …)).
                        recvClass = recvName
                    } else if (String_Length(t) > 0 && t != "?") {
                        // Instance-call shape: local var's type IS the
                        // class. Strip the trailing `?` for nullable
                        // locals so the lookup still hits.
                        if (String_EndsWith(t, "?")) {
                            recvClass = String_Substring(t, 0, String_Length(t) - 1)
                        } else {
                            recvClass = t
                        }
                    }
                }
            }
            if (String_Length(recvClass) == 0) { return }
            let methodDecl: AstNode = this.FindMethodInPrograms(recvClass, mem.Name)
            this.PatchLambdasFromTypedClosureParams(expr, methodDecl)
        }
    }

    // ── Expression resolver ───────────────────────────

    private void ResolveExpr(AstNode expr) {
        if (expr == null) { return }
        let k = expr.Kind
        match k {

        NodeKind.IDENTIFIER => {
            // Skip parser error-recovery placeholders — they already represent a parse error
            if (expr.Name == "_unknown_") { return }
            // Wildcard placeholder used in match patterns. Treated as "matches
            // anything" by the codegen; the resolver shouldn't insist on a
            // declared binding for it.
            if (expr.Name == "_") { return }
            if (!this.LookupInScopes(expr.Name)) {
                this.Error("Unknown symbol '" + expr.Name + "'", expr)
                return
            }
            // Capture analysis: while inside a lambda body, any local
            // resolved at an index below LambdaBoundary lives in an
            // enclosing scope and must be captured by value. Fall back
            // to "int" when the local was declared without an
            // annotation and the resolver doesn't have a richer type
            // — matches v1 closures' (i64) -> i64 boxing convention.
            this.TryCaptureLocalByName(expr.Name, expr.Line, expr.Column)
            return
        }
        NodeKind.BINARY => {
            if (expr.Left  != null) { this.ResolveExpr(expr.Left) }
            if (expr.Right != null) { this.ResolveExpr(expr.Right) }
            return
        }
        NodeKind.UNARY => {
            if (expr.Left != null) { this.ResolveExpr(expr.Left) }
            return
        }
        NodeKind.MEMBER => {
            // Only resolve the target; member name validated by TypeChecker
            if (expr.Left != null) { this.ResolveExpr(expr.Left) }
            return
        }
        NodeKind.CALL => {
            if (expr.Left != null) { this.ResolveExpr(expr.Left) }
            // v2.5: when the call is a higher-order list method
            // (xs.Map/Filter/...), patch the lambda arg's PARAM types
            // from the receiver's element type so the body can resolve
            // member access like `x.Name` instead of failing on `?`.
            this.PatchLambdaParamTypes(expr)
            // v0.8.36: when the callee's parameter is declared
            // `Closure<A1, A2, …, R>`, patch the lambda arg's PARAM
            // Str so the cgen emits a typed unpack — same mechanism,
            // driven by the target signature instead of the receiver
            // element type.
            this.PatchLambdaParamTypesGeneric(expr)
            let argc = expr.Args.Count()
            for i in 0..argc {
                this.ResolveExpr(expr.Args.Get(i))
            }
            return
        }
        NodeKind.NEW_EXPR => {
            // Same typed-Closure patching for `new T(c => …)` ctor args.
            this.PatchLambdaParamTypesGeneric(expr)
            let argc = expr.Args.Count()
            for i in 0..argc {
                this.ResolveExpr(expr.Args.Get(i))
            }
            return
        }
        NodeKind.INDEX_EXPR => {
            if (expr.Left  != null) { this.ResolveExpr(expr.Left) }
            if (expr.Right != null) { this.ResolveExpr(expr.Right) }
            return
        }
        NodeKind.LIST_COMP => {
            // [proj for var in iter (if guard)?]: resolve iter in the
            // outer scope, then push a scope so var shadows whatever
            // outer binding has the same name while resolving the
            // projection and guard.
            if (expr.Right != null) { this.ResolveExpr(expr.Right) }
            this.PushScope("list-comp")
            var elemType = "?"
            if (expr.Right != null) {
                let colType = this.InferExprType(expr.Right)
                elemType    = this.CollectionElemType(colType)
            }
            this.DeclareCurrent(expr.Str, elemType, true)
            if (expr.Left != null) { this.ResolveExpr(expr.Left) }
            if (expr.Cond != null) { this.ResolveExpr(expr.Cond) }
            this.PopScope()
            return
        }
        NodeKind.LIST_LITERAL => {
            // [e1, e2, ...]: each element is resolved in the outer
            // scope. No new bindings introduced.
            let nc: int = expr.Children.Count()
            for i in 0..nc {
                this.ResolveExpr(expr.Children.Get(i))
            }
            return
        }
        NodeKind.ASSIGN => {
            this.ResolveAssign(expr)
            return
        }
        NodeKind.IF_STMT => {
            // match-as-expression: parser reuses IF_STMT with Name=__match__,
            // arms in Children. Delegate to the existing match resolver so
            // the arm bodies see the correct binders.
            if (expr.Name == "__match__") {
                this.ResolveMatch(expr)
                return
            }
            // if-expression
            if (expr.Cond != null) { this.ResolveExpr(expr.Cond) }
            if (expr.Body != null) { this.ResolveBlock(expr.Body) }
            if (expr.Else != null) { this.ResolveElseBranch(expr.Else) }
            return
        }
        NodeKind.METHOD_DECL if expr.Name == "__lambda__" => {
            // Lambda body: open a fresh scope, declare every param at
            // the boundary, and resolve the body with capture tracking
            // on. Saving/restoring the previous LambdaInProgress lets
            // nested lambdas work; the inner lambda captures into
            // itself, and any of those captures that came from outside
            // the outer lambda will also re-trigger capture on the
            // outer when the inner is being resolved.
            //
            // v2: Params is a List<AstNode> of PARAMs (was Str=name in
            // v1). Body is either an expression in Left, or a BLOCK in
            // Body — exclusive, set by the parser.
            let prevLam      = this.LambdaInProgress
            let prevBoundary = this.LambdaBoundary
            this.PushScope("lambda")
            this.LambdaInProgress = expr
            this.LambdaBoundary   = this.LocalNames.Count()
            let pn: int = expr.Params.Count()
            for pi in 0..pn {
                this.DeclareLambdaParam(expr.Params.Get(pi))
            }
            if (expr.Left != null) { this.ResolveExpr(expr.Left) }
            if (expr.Body != null) { this.ResolveBlock(expr.Body) }
            this.PopScope()
            this.LambdaInProgress = prevLam
            this.LambdaBoundary   = prevBoundary
            return
        }
        NodeKind.LITERAL_STRING => {
            // String interpolations `"…{expr}…"` are kept as a raw
            // LITERAL_STRING by the parser and lowered later by
            // CGen's EmitInterpolatedString. The resolver therefore
            // never walks the embedded expressions through the
            // normal IDENTIFIER branch — which breaks capture
            // analysis when a captured local is referenced *only*
            // through `{…}` inside a lambda body. Scan each `{…}`
            // segment for identifier-shaped tokens and trigger the
            // capture-attempt helper on each.
            if (this.LambdaInProgress == null) { return }
            let raw = expr.Str
            let rn  = String_Length(raw)
            var ri  = 0
            while (ri < rn) {
                let rch = String_Substring(raw, ri, 1)
                if (rch != "{") {
                    ri = ri + 1
                    continue
                }
                let rest  = String_Substring(raw, ri + 1, rn - ri - 1)
                let close = String_IndexOf(rest, "}")
                if (close <= 0) {
                    ri = ri + 1
                    continue
                }
                let inner = String_Substring(raw, ri + 1, close)
                this.CaptureIdentsInInterpExpr(inner, expr.Line, expr.Column)
                ri = ri + 1 + close + 1
            }
            return
        }
        // Literals, this, null — always valid
        _ => { }
        }
    }

    // ── Type inference (lightweight, for for-in) ──────

    private string InferExprType(AstNode expr) {
        if (expr == null) { return "?" }
        let k = expr.Kind
        if (k == NodeKind.IDENTIFIER) { return this.LookupType(expr.Name) }
        if (k == NodeKind.LITERAL_INT)    { return "int" }
        if (k == NodeKind.LITERAL_FLOAT)  { return "float" }
        if (k == NodeKind.LITERAL_STRING) { return "string" }
        if (k == NodeKind.LITERAL_BOOL)   { return "bool" }
        if (k == NodeKind.BINARY && expr.Str == "..") { return "range" }
        // v0.8.39 — `let app = this` now picks up the enclosing class
        // type instead of falling through to "?".  Closures capturing
        // `app` then box it as a class pointer instead of i64.
        if (k == NodeKind.THIS_EXPR) {
            if (String_Length(this.CurrentClass) > 0) {
                return this.CurrentClass
            }
        }
        if (k == NodeKind.NEW_EXPR) {
            // v2.5: include the generic type-arg so List<User> is
            // returned as "List<User>" — needed by
            // PatchLambdaParamTypes via CollectionElemType.
            if (String_Length(expr.Str2) > 0) {
                return expr.Name + "<" + expr.Str2 + ">"
            }
            return expr.Name
        }
        if (k == NodeKind.MEMBER) {
            if (expr.Left != null) {
                let targetType = this.InferExprType(expr.Left)
                return this.Members.Get(targetType, expr.Name)
            }
        }
        if (k == NodeKind.CALL) {
            // For chained higher-order list calls — `xs.Filter(p).Map(q)` —
            // we need to infer the type of the inner call so that
            // PatchLambdaParamTypes can patch q's param against the
            // correct element type. Type-preserving methods (Filter,
            // ForEach) yield the receiver's type unchanged. Map/Reduce
            // change the element type and need lambda return-type
            // inference, which we don't yet have at the resolver layer
            // (deferred — falls through to "?").
            if (expr.Left != null && expr.Left.Kind == NodeKind.MEMBER) {
                let mname = expr.Left.Name
                if (mname == "Filter" || mname == "ForEach") {
                    if (expr.Left.Left != null) {
                        return this.InferExprType(expr.Left.Left)
                    }
                }
            }
        }
        return "?"
    }

    private string CollectionElemType(string typeKey) {
        if (typeKey == "range" || typeKey == "int") { return "int" }
        if (String_StartsWith(typeKey, "List<") && String_EndsWith(typeKey, ">")) {
            return String_Substring(typeKey, 5, String_Length(typeKey) - 6)
        }
        if (String_StartsWith(typeKey, "Set<") && String_EndsWith(typeKey, ">")) {
            return String_Substring(typeKey, 4, String_Length(typeKey) - 5)
        }
        if (String_EndsWith(typeKey, "[]")) {
            return String_Substring(typeKey, 0, String_Length(typeKey) - 2)
        }
        return "?"
    }

    // ── Public query API (used by TypeChecker) ────────

    public string GetMemberType(string className, string memberName) {
        return this.Members.Get(className, memberName)
    }

    public bool HasMember(string className, string memberName) {
        return this.Members.Has(className, memberName)
    }

    public string GetVarType(string name) {
        return this.LookupType(name)
    }

    // ── SymbolTable-compatible API for TypeChecker ────
    // Allows TypeChecker to call resolver.Global-style methods
    // without needing a separate SymbolTable object.

    public bool HasSymbol(string name) {
        return this.LookupInScopes(name)
    }

    public string GetTypeName(string name) {
        return this.LookupType(name)
    }

    public void SetTypeName(string name, string typeName) {
        let lc = this.LocalNames.Count()
        for i in 0..lc {
            if (this.LocalNames.Get(i) == name) {
                this.LocalTypes.Add(typeName)
                return
            }
        }
        // Pre-existing quirk preserved: this Add (not Set) at an
        // index appends rather than overwrites. Effectively a no-op
        // for downstream lookups (which read the FIRST match in
        // GlobalNames, i.e. the original entry) and shouldn't be
        // reached often. Indexed presence check still beats the
        // O(N) scan when it IS reached.
        if (this.GlobalIndex.Has(name)) {
            this.GlobalTypes.Add(typeName)
        }
    }
}
