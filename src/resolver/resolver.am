namespace Amalgame.Compiler

import Amalgame.Collections
import Amalgame.String

// ═══════════════════════════════════════════════════════
//  resolver.am  —  Name resolution pass
//
//  Two sequential passes over the AST:
//
//  Pass 1 — CollectDecl
//    Register every top-level type name (class, enum)
//    into the global scope so forward references work.
//    Also build the member table: className → field/method → typeName.
//
//  Pass 2 — ResolveDecl
//    Walk the entire AST. Open/close scopes around each
//    declaration and block. Validate every identifier and
//    type reference. Register local variables.
//
//  The MemberTable built in Pass 1 is used by the
//  TypeChecker to resolve member access types.
// ═══════════════════════════════════════════════════════

// ── MemberTable ───────────────────────────────────────
// Hash-indexed `className + "." + memberName` → typeName lookup.
// The flat parallel lists (Keys, Values) preserve insertion order
// for the LSP enumeration paths (MemberCountFor / MemberNameForAt);
// `Index` is the hot-path companion: `name` → `position in Values`.
// Every member access in the resolver / typechecker hits Has/Get,
// so the prior O(N) linear scan dominated total Resolve time —
// dropping ~150s on c_gen.am to ~1s once the index is in.
public class MemberTable {
    private Keys:   List<string>
    private Values: List<string>
    private Index:  Map<string, int>

    public MemberTable() {
        this.Keys   = new List<string>()
        this.Values = new List<string>()
        this.Index  = new Map<string, int>()
    }

    public void Set(string className, string memberName, string typeName) {
        let key = className + "." + memberName
        // Silent no-op on duplicate key (same comment as before the
        // index landed: same source text → same parser output → same
        // member type, so the second Set carries identical value).
        if (this.Index.Has(key)) { return }
        let idx: int = this.Keys.Count()
        this.Keys.Add(key)
        this.Values.Add(typeName)
        this.Index.Set(key, idx)
    }

    public string Get(string className, string memberName) {
        let key = className + "." + memberName
        if (!this.Index.Has(key)) { return "?" }
        let idx: int = this.Index.Get(key)
        return this.Values.Get(idx)
    }

    public bool Has(string className, string memberName) {
        return this.Index.Has(className + "." + memberName)
    }

    // Used by the LSP completion path to enumerate the members of a
    // given class / enum. Walks the flat key list and strips the
    // `<className>.` prefix; deduplicates so re-Set'd entries don't
    // surface twice. The order matches insertion (which mirrors the
    // declaration order in the source — useful for the LSP client).
    public int MemberCountFor(string className) {
        let prefix: string = className + "."
        let n: int = this.Keys.Count()
        var seen: int = 0
        let names = new List<string>()
        for i in 0..n {
            let k: string = this.Keys.Get(i)
            if (String_StartsWith(k, prefix)) {
                let nameLen: int = String_Length(k) - String_Length(prefix)
                let name: string = String_Substring(k, String_Length(prefix), nameLen)
                var dup: bool = false
                let sn: int = names.Count()
                for j in 0..sn {
                    if (names.Get(j) == name) { dup = true }
                }
                if (!dup) {
                    names.Add(name)
                    seen = seen + 1
                }
            }
        }
        return seen
    }

    public string MemberNameForAt(string className, int idx) {
        let prefix: string = className + "."
        let n: int = this.Keys.Count()
        var seen: int = 0
        let names = new List<string>()
        for i in 0..n {
            let k: string = this.Keys.Get(i)
            if (String_StartsWith(k, prefix)) {
                let nameLen: int = String_Length(k) - String_Length(prefix)
                let name: string = String_Substring(k, String_Length(prefix), nameLen)
                var dup: bool = false
                let sn: int = names.Count()
                for j in 0..sn {
                    if (names.Get(j) == name) { dup = true }
                }
                if (!dup) {
                    if (seen == idx) { return name }
                    names.Add(name)
                    seen = seen + 1
                }
            }
        }
        return ""
    }
}

// ── ResolverError ────────────────────────────────────
// Structured form of a resolver error, kept in parallel with
// `Errors: List<string>` (the formatted strings used by CLI
// output). Mirrors `TypeError` from typechecker.am — we don't
// reuse TypeError directly to keep the source-file dependency
// graph one-way (resolver ← typechecker, not the other way).
public class ResolverError {
    public Message:  string
    public Filename: string
    public Line:     int
    public Column:   int

    public ResolverError(string msg, string file, int line, int col) {
        this.Message  = msg
        this.Filename = file
        this.Line     = line
        this.Column   = col
    }
}

// ── FullResolver ──────────────────────────────────────
public class FullResolver {
    // Flat scope: global names + local (method-level) names
    // Using parallel lists to avoid void* dereference on List.Get()
    private GlobalNames:   List<string>
    private GlobalTypes:   List<string>
    // Hash-indexed companion to GlobalNames so DeclareGlobal /
    // LookupInScopes / LookupType / LookupIsLet skip the O(N)
    // linear scan. Maps `name` → `index in GlobalNames/GlobalTypes`.
    // Without this, ResolvePrograms scales O(refs × globals); a
    // ~5k-LoC file like src/generator/c_gen.am took ~150s to
    // resolve before this index. With it: O(refs × log N) via the
    // bdwgc map's hashed probing.
    private GlobalIndex:   Map<string, int>
    // Method body lookup: `className + "." + methodName` →
    // METHOD_DECL AstNode. Populated during CollectAll on every
    // CLASS_DECL's METHOD_DECL children. Replaces the O(progs ×
    // classes × methods) linear scan in `FindMethodInPrograms`
    // — which fires on EVERY call/new-expr during Pass 2
    // (PatchLambdaParamTypesGeneric route). Dominated the resolve
    // time on c_gen.am (~5k LoC, ~100 classes × 30+ methods) where
    // every CALL/NEW_EXPR triggered a full-AST sweep.
    private MethodNodeIndex: Map<string, AstNode>
    // v0.8.57 perf — O(1) local lookups via a Map keyed on the
    // identifier name → its LocalNames index. The parallel
    // ShadowPrev list tracks, for every LocalNames entry, the
    // LocalIndex value it shadowed at declaration time (or -1 when
    // the name was previously unbound). PopScope walks the popped
    // entries and restores ShadowPrev[i] into LocalIndex so the
    // outer binding becomes visible again.
    //
    // Pre-fix, every identifier reference paid an O(N) walk over
    // LocalNames in LookupInScopes/Type/IsLet/IndexOfLocal. On
    // c_gen.am (5k LoC, dozens of locals per method) that pushed
    // `amc --check` to 132s. The Map makes lookups O(1) hash hits.
    private LocalIndex:    Map<string, int>
    private ShadowPrev:    List<int>
    private LocalNames:    List<string>
    private LocalTypes:    List<string>
    private LocalIsLets:   List<bool>
    // Stack of scope start indices into LocalNames/Types/IsLets
    private ScopeStarts:   List<int>
    // Member table: class → member → type
    public  Members:       MemberTable
    // Errors collected — formatted for CLI output
    private Errors:        List<string>
    // Same errors in structured form, for tools that need to map
    // back to (file, line, col) — LSP, future IDE features. Kept
    // in lock-step with Errors via EmitError.
    public  RawErrors:     List<ResolverError>
    // Multiple programs to resolve together
    public  Programs:      List<AstNode>
    // Current class being visited
    private CurrentClass:  string
    // Current method return type
    private CurrentReturn: string
    // Loop nesting depth
    private LoopDepth:     int
    // Capture analysis: when we descend into a lambda body, the lambda
    // node is kept here so IDENTIFIER resolutions can flag references
    // to enclosing-scope locals as captures. LambdaBoundary is the
    // LocalNames index where this lambda's own scope begins; any local
    // resolved at a lower index lives in an enclosing scope and must
    // be captured.
    private LambdaInProgress: AstNode?
    private LambdaBoundary:   int
    // Current file being resolved — used by error formatters to render source snippets.
    private CurrentFile:   string
    // Source map (path → text) — set by main; defaults to an empty SourceMap so
    // standalone uses (resolver tests) keep working without configuration.
    public  Sources:       SourceMap
    // v0.5 package-manager: classes + functions contributed by
    // external packages installed via `amc add`. Parallel lists
    // (rather than a Map) so the resolver introspection tools
    // already comfortable with parallel-array iteration keep
    // working. Empty by default; populated via RegisterPackages.
    public  PkgClasses:    List<string>
    public  PkgFuncs:      List<string>
    public  PkgFuncCTypes: List<string>

    public FullResolver() {
        this.GlobalNames   = new List<string>()
        this.GlobalTypes   = new List<string>()
        this.GlobalIndex   = new Map<string, int>()
        this.MethodNodeIndex = new Map<string, AstNode>()
        this.LocalIndex    = new Map<string, int>()
        this.ShadowPrev    = new List<int>()
        this.LocalNames    = new List<string>()
        this.LocalTypes    = new List<string>()
        this.LocalIsLets   = new List<bool>()
        this.ScopeStarts   = new List<int>()
        this.Members       = new MemberTable()
        this.Errors        = new List<string>()
        this.RawErrors     = new List<ResolverError>()
        this.Programs      = new List<AstNode>()
        this.CurrentClass  = ""
        this.CurrentReturn = "void"
        this.LoopDepth     = 0
        this.LambdaInProgress = null
        this.LambdaBoundary   = 0
        this.CurrentFile   = ""
        this.Sources       = new SourceMap()
        this.PkgClasses    = new List<string>()
        this.PkgFuncs      = new List<string>()
        this.PkgFuncCTypes = new List<string>()
        this.RegisterBuiltins()
    }

    // ── v0.5 package-manager hook ────────────────────
    //
    // Called by main.am after constructing the resolver — feeds it
    // every class + function declared by installed external
    // packages. Declares the class name as a type-global and each
    // `<Class>_<Func>` symbol with its Amalgame-side return type
    // (C-level pointers stripped to opaque class names so the
    // resolver treats them like SQLite_Open did pre-v0.5).
    //
    // Also remembers the cType for each function in parallel lists
    // so PR 3d's cgen can consult them when deriving C return-type
    // table entries without going back to the registry.
    //
    // Idempotent: re-registering same packages overwrites earlier
    // entries (Amalgame-resolver's DeclareGlobal silently no-ops
    // on duplicates — invariant from PR #228 / v0.4.7).
    public void RegisterPackages(PackageRegistry reg) {
        let n: int = reg.Packages.Count()
        for i in 0..n {
            let p: LoadedPackage = reg.Packages.Get(i)
            // Register every class the package exposes. Packages
            // that declare `classes = [...]` (multi-class, e.g.
            // amalgame-tls) may have several; legacy single-class
            // packages always have exactly one via ClassNames[0].
            let pkgCn: int = p.ClassNames.Count()
            for pkgCi in 0..pkgCn {
                let pkgCls: string = p.ClassNames.Get(pkgCi)
                this.DeclareGlobal(pkgCls, "type", false)
                this.PkgClasses.Add(pkgCls)
            }
            // Each function as a runtime global. The C symbol is
            // mangled with the full package namespace so two
            // packages declaring the same short class can coexist
            // without collision at link time.
            //   Redis.Open → Amalgame_Database_NoSQL_Redis_Open
            let fn: int = p.FuncNames.Count()
            for j in 0..fn {
                let fName: string = p.FuncNames.Get(j)
                let cType: string = p.FuncRets.Get(j)
                let mangled: string = PackageRegistry.ManglePackageSymbol(p.Ns, fName)
                let amType: string = PackageRegistry.AmalgameTypeFromC(cType)
                this.DeclareGlobal(mangled, amType, false)
                this.PkgFuncs.Add(mangled)
                this.PkgFuncCTypes.Add(cType)
            }
        }
    }

    // ── Builtin registration ──────────────────────────

    private void RegisterBuiltins() {
        this.DeclareGlobal("int",    "type", false)
        this.DeclareGlobal("float",  "type", false)
        this.DeclareGlobal("double", "type", false)
        this.DeclareGlobal("bool",   "type", false)
        this.DeclareGlobal("string", "type", false)
        this.DeclareGlobal("void",   "type", false)
        this.DeclareGlobal("null",   "null", false)
        this.DeclareGlobal("true",   "bool", false)
        this.DeclareGlobal("false",  "bool", false)
        this.DeclareGlobal("this",   "?",    false)
        this.DeclareGlobal("args",   "string[]", false)
        // MCU escape valve (docs/proposals/amc-embedded.md §5.3). persist(x)
        // forces x into the persistent region so it outlives the per-tick
        // arena reset. Type-transparent (handled in the typechecker); on the
        // hosted target it's the identity (a runtime macro). Declared here so
        // the bare call resolves instead of raising "Unknown symbol".
        this.DeclareGlobal("persist", "?", false)
        // Stdlib namespaces / static classes — declared as types so calls like
        // String.Method(s) or List.<Util>(...) don't raise "Unknown symbol".
        // The CGen maps `Foo.Method(...)` to `Foo_Method(...)` via the isStdlib
        // path; the builtin function names are declared individually below.
        this.DeclareGlobal("String",         "type", false)
        this.DeclareGlobal("List",           "type", false)
        this.DeclareGlobal("Map",            "type", false)
        this.DeclareGlobal("Set",            "type", false)
        this.DeclareGlobal("Path",           "type", false)
        this.DeclareGlobal("Env",            "type", false)
        // Process
        this.DeclareGlobal("Process",                       "type", false)
        this.DeclareGlobal("Process_Run",                   "int",                   false)
        this.DeclareGlobal("Process_RunCapture",            "AmalgameProcessResult", false)
        // v2 (2026-05-16): split stderr + timeout-aware variants
        this.DeclareGlobal("Process_RunTimeout",            "int",                   false)
        this.DeclareGlobal("Process_RunCaptureBoth",        "AmalgameProcessResult", false)
        this.DeclareGlobal("Process_RunCaptureBothTimeout", "AmalgameProcessResult", false)
        // v3 (2026-05-17): streaming Spawn with persistent handle
        this.DeclareGlobal("Process_Spawn",                 "AmalgameProcessHandle", false)
        this.DeclareGlobal("Process_IsAlive",               "bool",                  false)
        this.DeclareGlobal("Process_ExitCode",              "int",                   false)
        this.DeclareGlobal("Process_Wait",                  "bool",                  false)
        this.DeclareGlobal("Process_Kill",                  "void",                  false)
        this.DeclareGlobal("Process_KillForce",             "void",                  false)
        this.DeclareGlobal("Process_WriteLine",             "bool",                  false)
        this.DeclareGlobal("Process_ReadLine",              "string",                false)
        this.DeclareGlobal("Process_ReadErrLine",           "string",                false)
        // Console
        // MCU HAL (docs/proposals/amc-embedded.md §9). Static facade; the
        // bodies live in the board runtime header (embedded-only). Pins and
        // levels are plain int for now (the opaque typed Pin is a follow-up).
        this.DeclareGlobal("Mcu",            "type", false)
        this.DeclareGlobal("Mcu_PinMode",      "void", false)
        this.DeclareGlobal("Mcu_DigitalWrite", "void", false)
        this.DeclareGlobal("Mcu_DigitalRead",  "int",  false)
        this.DeclareGlobal("Mcu_Toggle",       "void", false)
        this.DeclareGlobal("Mcu_DelayMs",      "void", false)
        this.DeclareGlobal("Mcu_Millis",       "int",  false)
        this.DeclareGlobal("Mcu_WaitTick",     "void", false)
        this.DeclareGlobal("Mcu_Ticks",        "int",  false)
        this.DeclareGlobal("Mcu_High",         "int",  false)
        this.DeclareGlobal("Mcu_Low",          "int",  false)
        this.DeclareGlobal("Mcu_Output",       "int",  false)
        this.DeclareGlobal("Mcu_Input",        "int",  false)
        this.DeclareGlobal("Console",        "type", false)
        this.DeclareGlobal("Console_WriteLine",  "void",   false)
        this.DeclareGlobal("Console_WriteError", "void",   false)
        this.DeclareGlobal("Console_Clear",      "void",   false)
        this.DeclareGlobal("Console_Write",      "void",   false)
        this.DeclareGlobal("Console_ReadLine",   "string", false)
        this.DeclareGlobal("Console_ReadBytes",  "string", false)
        this.DeclareGlobal("Console_Flush",      "void",   false)
        // File / Path
        this.DeclareGlobal("File",           "type", false)
        this.DeclareGlobal("Path",           "type", false)
        this.DeclareGlobal("String_CharAt1",  "string", false)
        this.DeclareGlobal("String_CharAtUnchecked", "string", false)
        this.DeclareGlobal("File_ReadAll",    "string", false)
        this.DeclareGlobal("File_WriteAll",   "void",   false)
        this.DeclareGlobal("File_AppendAll",  "void",   false)
        this.DeclareGlobal("File_WriteLines", "void",   false)
        this.DeclareGlobal("File_OpenWrite",  "void",   false)
        this.DeclareGlobal("File_StreamLine", "void",   false)
