        this.DeclareGlobal("File_Exists",    "bool",   false)
        this.DeclareGlobal("File_Delete",    "bool",   false)
        this.DeclareGlobal("File_Size",      "int",    false)
        this.DeclareGlobal("File_Mtime",     "int",    false)
        this.DeclareGlobal("File_IsFile",    "bool",   false)
        this.DeclareGlobal("File_IsDir",     "bool",   false)
        this.DeclareGlobal("Path_Combine",        "string", false)
        this.DeclareGlobal("Path_GetExtension",   "string", false)
        this.DeclareGlobal("Path_GetFilename",    "string", false)
        this.DeclareGlobal("Path_GetDirectory",   "string", false)
        this.DeclareGlobal("Path_GetStem",        "string", false)
        this.DeclareGlobal("Path_IsAbsolute",     "bool",   false)
        this.DeclareGlobal("Path_Normalize",      "string", false)
        this.DeclareGlobal("Path_Sep",            "string", false)
        // BuildInfo lives in src/stdlib/amc_buildinfo.am since v0.7.4 —
        // the resolver picks it up from the class declaration like any
        // other AM class. The macros `AMC_GIT_REV` / `AMC_BUILD_DATE`
        // are still wired by build_amc.sh; both return "" when the
        // defines aren't set, so callers detect "no build info" and
        // skip the banner line. Used by `amc --version`.
        // Logging lives in src/stdlib/logging.am since the post-v0.7.5
        // migration — the class is now declared in AM with `@c { … }`
        // bodies sharing state through the trimmed
        // `runtime/Amalgame_Logging.h` (state globals only). The
        // resolver picks the class up from the AM declaration like any
        // other bundled module.
        // Service lives in src/stdlib/service.am since post-v0.7.5
        // (signal handler + nanosleep wrapped in @c {} blocks; rest
        // is pure AM). Class picked up from the bundled .am source.
        // (Database.SQLite global declarations moved to package
        //  amalgame-database-sqlite v0.1.0 — RegisterPackages
        //  declares them dynamically when the user has done
        //  `amc add github.com/amalgame-lang/amalgame-database-sqlite`.)
        // (Database.NoSQL.Redis + Messaging.MQTT global
        //  declarations moved to their respective packages —
        //  RegisterPackages declares them dynamically when the
        //  user has done `amc add`.)
        this.DeclareGlobal("Service_ShouldStop",  "bool",   false)
        this.DeclareGlobal("Service_RequestStop", "void",   false)
        this.DeclareGlobal("Service_Sleep",       "void",   false)
        // Environment variables (Env.Get / Env.Has)
        this.DeclareGlobal("Env_Get",             "string", false)
        this.DeclareGlobal("Env_Has",             "bool",   false)
        // Math — migrated to AM (post-v0.7.5). The class itself
        // is still declared here so `import Amalgame.Math` sees
        // the type, but the flat `Math_X` runtime symbols are gone
        // — callers use the qualified `Math.X(...)` form.
        this.DeclareGlobal("Math",           "type",   false)
        // WebSocket — RFC 6455 client (text frames).
        // Runtime in runtime/Amalgame_WebSocket.h.
        this.DeclareGlobal("WebSocket",            "type",         false)
        this.DeclareGlobal("WebSocket_Connect",    "WebSocket",    false)
        this.DeclareGlobal("WebSocket_SendText",   "bool",         false)
        this.DeclareGlobal("WebSocket_ReceiveText","string",       false)
        this.DeclareGlobal("WebSocket_Close",      "void",         false)
