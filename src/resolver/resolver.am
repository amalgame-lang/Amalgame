        this.DeclareGlobal("Compress_Inflate",     "List<int>",    false)
        this.DeclareGlobal("Compress_GzipString",  "List<int>",    false)
        this.DeclareGlobal("Compress_GunzipString","string",       false)
        // Regex — POSIX regex.h binding. Runtime in
        // runtime/Amalgame_Regex.h.
        this.DeclareGlobal("Regex",                "type",        false)
        this.DeclareGlobal("Match",                "type",        false)
        this.DeclareGlobal("Regex_Test",           "bool",        false)
        this.DeclareGlobal("Regex_Match",          "Match",       false)
        this.DeclareGlobal("Regex_Replace",        "string",      false)
        this.DeclareGlobal("Regex_ReplaceAll",     "string",      false)
        this.DeclareGlobal("Match_GetText",        "string",      false)
        this.DeclareGlobal("Match_GetStart",       "int",         false)
        this.DeclareGlobal("Match_GetEnd",         "int",         false)
        this.DeclareGlobal("Match_GroupCount",     "int",         false)
        this.DeclareGlobal("Match_GroupText",      "string",      false)
        this.DeclareGlobal("Match_GroupStart",     "int",         false)
        this.DeclareGlobal("Match_GroupEnd",       "int",         false)
        // FileWatcher lives in src/stdlib/io_filewatcher.am since
        // the post-v0.7.5 runtime header migration — the resolver
        // picks the class up from the bundled AM source.
        // Math.Vec / Mat4 — runtime helpers behind the public
        // Amalgame.Math.Vec facade in src/stdlib/math_vec.am. All
        // operations heap-allocate via GC_MALLOC and return fresh
        // values, so users can chain without aliasing concerns.
        // Type globals first so `new Vec3(...)` resolves.
