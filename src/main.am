        Console.WriteError("                [PASS]/[FAIL]/[SKIP] lines from their stdout.")
        Console.WriteError("  lsp           Run a minimal LSP server (stdio JSON-RPC).")
        Console.WriteError("                v1 publishes diagnostics on didOpen/didChange.")
        Console.WriteError("  dap           Run a DAP proxy over stdio (forwards to lldb-dap / gdb --dap).")
        Console.WriteError("                Use `amc build -g entry.am` first to embed DWARF info.")
        Console.WriteError("  migrate <f>   Migrate a source file or directory to Amalgame via LLM.")
        Console.WriteError("                Auto-uses claude-api when ANTHROPIC_API_KEY is set, else")
        Console.WriteError("                shells out to the local `claude` CLI. See `amc migrate --help`.")
        Console.WriteError("  generate <p>  Generate an Amalgame program from a natural-language prompt.")
        Console.WriteError("                Same provider auto-selection as migrate. See `amc generate --help`.")
        Console.WriteError("  explain <f>   Read an Amalgame file and emit a natural-language explanation.")
        Console.WriteError("                See `amc explain --help`.")
        Console.WriteError("  new <name>    Scaffold a new Amalgame project (exe / lib / test / service / forms).")
        Console.WriteError("                Wires .vscode/launch.json + settings.json by default so F5 =")
        Console.WriteError("                `amc dap` debug; pass --no-vscode to skip. See `amc new --help`.")
        Console.WriteError("  package <X>   Package manager (alias `pkg`). Verbs: add / remove / list /")
        Console.WriteError("                search / versions / info / outdated / notice / check /")
        Console.WriteError("                update / cache. See `amc package --help`.")
    }

    // ── test subcommand ────────────────────────────────
    // Discovers *_test.am under <dir> (default `.`), compiles each
    // with the running amc binary + gcc, runs the result, and parses
    // its stdout for `[PASS] <name>`, `[FAIL] <name>: <msg>`, and
    // `[SKIP] <name>` lines. The runner expects to be invoked from
    // a directory with a sibling `runtime/` so gcc can find the
    // headers — true for the Amalgame repo itself; downstream users
    // will need a richer install story (--runtime, AMC_RUNTIME env
    // var) which is left for a follow-up.
    public static int RunTest(int argc) {
        var dir       = "."
        var filterPat = ""
        var ciMode    = false
        var listOnly  = false
        var i = 2
        while (i < argc) {
            let a = Args_Get(i)
            if (a == "--filter" && i + 1 < argc) {
                // Only run *_test.am files whose discovered path
                // contains <pat> (plain substring, not regex). Lets
                // you re-run a single failing case without grepping
                // for the bundle directory: `--filter websocket`.
                i = i + 1
                filterPat = Args_Get(i)
            } else if (a == "--ci") {
                // Terse output: drop per-file headers + [PASS]/[SKIP]
                // lines; keep [FAIL], COMPILE-FAIL, and the tally.
                // Keeps CI logs scannable when nothing's broken.
                ciMode = true
            } else if (a == "--list") {
                // Print discovered test paths (after --filter) and
                // exit 0 without compiling or running. Useful for
                // test-explorer UIs and quick sanity-checks.
                listOnly = true
            } else if (a == "-h" || a == "--help") {
                Console.WriteLine("Usage: amc test [<dir>] [options]")
                Console.WriteLine("  <dir>           Root to discover *_test.am under (default: .)")
                Console.WriteLine("Options:")
                Console.WriteLine("  --filter <pat>  Only run tests whose path contains <pat>")
                Console.WriteLine("  --ci            Terse output (drop PASS/SKIP, keep FAIL + tally)")
                Console.WriteLine("  --list          Print discovered paths and exit (no compile, no run)")
                return 0
            } else if (String_StartsWith(a, "-")) {
                Console.WriteError("amc test: unknown option '" + a + "'")
                return 1
            } else {
                dir = a
            }
            i = i + 1
        }

        // v0.5.1: auto-install missing deps before running tests.
        // amalgame.lock-declared packages that aren't in the cache
        // get re-cloned here, so `git clone <repo> && amc test`
        // works in one step. No-op when there's no lock file or
        // every dep is already present.
        let installed: int = AddCommand.EnsureInstalled()
        if (installed < 0) {
            Console.WriteError("amc test: package install failed; aborting")
            return 1
        }
        if (installed > 0) {
            Console.WriteLine("amc test: installed " + String_FromInt(installed) + " missing dep(s)")
        }

        // v0.5.2: resolve amc's runtime/ once + pre-compile each
        // installed package's vendored .c sources to .o files
        // cached in /tmp. The .o files get linked into every test
        // binary so SQLite (and any future vendoring backend)
        // links cleanly without the user doing gcc by hand.
        // Resolve amc's canonical path via /proc/self/exe (Linux) /
        // GetModuleFileNameA (Windows) so runtime/ discovery works
        // when amc is invoked via PATH — argv[0] is then just "amc"
        // and the dirname() fallback collapses. Same fix as BuildEntry.
        var amcPathForRt: string = Program.ResolveSelfPath()
        if (String_Length(amcPathForRt) == 0) {
            amcPathForRt = Args_Get(0)
        }
        let amcRuntime: string = Program.ResolveRuntimeDir(amcPathForRt)
        let registry = PackageRegistry.Load()
        let pkgObjs: List<string> = Program.PreCompilePackageSources(registry, amcRuntime)
        let hasCxx: bool = registry.HasCxxSources()
        let pkgLibs: List<string> = registry.CollectLibs()
        // Project F follow-up: per-package facade archives
        // (libamalgame-pkg-<class>.a) live alongside the precompiled
        // .o files at <pkgDir>/build/<platform>/. Auto-link each one
        // so user tests resolve the AM facade symbols without
        // bundling the facade source on every compile.
        let facadeArs: List<string> = registry.CollectFacadeArchives()

        // Discovery: shell out to `find`. Works on POSIX and on
        // Windows MSYS2 (the only Windows path the repo CI exercises).
        // Convention: `fixtures/` subdirectories are pruned so canonical
        // test-input files (LSP workspace fixtures, test-runner self-test
        // fixtures, etc.) don't get auto-executed when crawling a tree
        // from above. Users who *want* to run a fixture explicitly can
        // still do `amc test ./tests/fixtures/<name>/` — the prune only
        // applies to nested `fixtures` directories, not the input root.
        let findCmd = "find " + dir + " -name fixtures -prune -o -name '*_test.am' -type f -print"
        let discovered = Process.RunCapture(findCmd)
        if (discovered.Exit != 0) {
            Console.WriteError("amc test: failed to enumerate tests in " + dir)
            Console.WriteError(discovered.Stdout)
            return 1
        }
        let raw: List<string> = String_Split(String_Trim(discovered.Stdout), "\n")
        // Normalize: trim every entry and drop blanks (String_Split
        // on "" yields a single empty entry; the `find` trailing
        // newline can yield one too). Also apply --filter here so
        // downstream code sees a clean, ready-to-iterate list.
        let lines:  List<string> = new List<string>()
        let rawN: int = raw.Count()
        for ri in 0..rawN {
            let r = String_Trim(raw.Get(ri))
            if (String_Length(r) == 0) { continue }
            if (String_Length(filterPat) > 0 && !String_Contains(r, filterPat)) { continue }
            lines.Add(r)
        }
        let nLines = lines.Count()
        if (nLines == 0) {
            if (String_Length(filterPat) > 0) {
                Console.WriteLine("No *_test.am files matched filter '" + filterPat + "' under " + dir)
            } else {
                Console.WriteLine("No *_test.am files found under " + dir)
            }
            return 0
        }
        // --list: print discovered paths (already filtered) and exit.
        if (listOnly) {
            for li in 0..nLines {
                Console.WriteLine(lines.Get(li))
            }
            return 0
        }

        var amcPath: string = Program.ResolveSelfPath()
        if (String_Length(amcPath) == 0) {
            amcPath = Args_Get(0)
        }
        var pass        = 0
        var fail        = 0
        var skip        = 0
        var compileFail = 0

        for li in 0..nLines {
            let path = String_Trim(lines.Get(li))
            if (String_Length(path) == 0) { continue }
            if (!ciMode) { Console.WriteLine("── " + path) }

            // Step 1 — amc <test>.am -o <tmp>  → produces <tmp>.c
            let outBin = "/tmp/amc_test_" + String_FromInt(li)
            let outC   = outBin + ".c"
            let amcCmd = amcPath + " " + path + " -o " + outBin + " --quiet"
            let cr = Process.RunCapture(amcCmd)
            if (cr.Exit != 0) {
                if (ciMode) { Console.WriteLine("  [COMPILE-FAIL] in " + path) }
                else        { Console.WriteLine("  [COMPILE-FAIL]") }
                Console.Write(cr.Stdout)
                compileFail = compileFail + 1
                continue
            }
            // Step 2 — compile + link the emitted .c. Locate amc's
            // runtime/ headers so this works in any cwd (not just
            // the Amalgame source tree). amcRuntime resolved once
            // before the test loop (see above).
            //
            // Two-stage when any installed package ships C++:
            //  (a) gcc -c <test>.c -o <test>.o  — compile as C, since
            //      amc emits C-style void* conversions and string-
            //      literal-to-char* casts that g++ rejects.
            //  (b) g++ <test>.o pkg_objs... — link as C++ so libstdc++
            //      + C++ static-init order resolve correctly. A plain
            //      `gcc -lstdc++` link skips C++ init that some
            //      amalgamations (DuckDB) need.
            // Otherwise a single-step gcc link is the v0.5.2 path.
            // v0.8.49: amc's c_gen auto-emits #include lines for
            // every cached package's runtime header. The gcc link
            // needs -I for each so the transitive #includes (e.g.
            // net-http's Amalgame_Net_Http.h → "Amalgame_Async.h")
            // resolve. Pre-cook the -I list once and use it in
            // both branches.
            let pkgIncDirs: List<string> = AddCommand.AllCachedRuntimeDirs()
            let pkgIncN: int = pkgIncDirs.Count()
            var pkgIncFlags: string = ""
            for pii in 0..pkgIncN {
                pkgIncFlags = pkgIncFlags + " -I\"" + pkgIncDirs.Get(pii) + "\""
            }
            var gccCmd: string = ""
            if (hasCxx) {
                // Stage (a): gcc -c to .o
                var compileCmd: string = "gcc -O2 -Wno-unused-variable -Wno-unused-parameter -Wno-unused-but-set-variable -Iruntime"
                if (String_Length(amcRuntime) > 0) {
                    compileCmd = compileCmd + " -I\"" + amcRuntime + "\""
                }
                compileCmd = compileCmd + pkgIncFlags
                let objOut: string = outBin + ".o"
                compileCmd = compileCmd + " -c " + outC + " -o " + objOut + " 2>&1"
                let stageA = Process.RunCapture(compileCmd)
                if (stageA.Exit != 0) {
                    if (ciMode) { Console.WriteLine("  [LINK-FAIL] in " + path) }
                    else        { Console.WriteLine("  [LINK-FAIL]") }
                    Console.Write(stageA.Stdout)
                    compileFail = compileFail + 1
                    continue
                }
                // Stage (b): g++ link
                gccCmd = "g++ -O2 " + objOut
            } else {
                gccCmd = "gcc -O2 -Wno-unused-variable -Wno-unused-parameter -Wno-unused-but-set-variable -Iruntime"
                if (String_Length(amcRuntime) > 0) {
                    gccCmd = gccCmd + " -I\"" + amcRuntime + "\""
                }
                gccCmd = gccCmd + pkgIncFlags + " " + outC
            }
            let nObjs: int = pkgObjs.Count()
            for poi in 0..nObjs {
                gccCmd = gccCmd + " \"" + pkgObjs.Get(poi) + "\""
            }
            // Splice per-package facade archives. Each ar archive
            // contributes one .o whose symbols satisfy the forward
            // decls the cgen emitted (because the facade was
            // auto-registered as `--external` — see
            // AmalgameCompiler.Run).
            let nFAr: int = facadeArs.Count()
            for fai in 0..nFAr {
                gccCmd = gccCmd + " \"" + facadeArs.Get(fai) + "\""
            }
            // v0.8.49: link libamalgame.a too. Without it, package
            // facades that reference bundled stdlib symbols (e.g.
            // amalgame-tls's acme_config.am parses TOML via Json)
            // fail to link with undefined `Amalgame_Formats_Json_*`.
            // Same path-resolution logic that BuildEntry uses
            // (line 1511).
            let libATest: string = Program.ResolveLibAmalgameA(AddCommand.ResolveSelfPath())
            if (String_Length(libATest) > 0) {
                gccCmd = gccCmd + " \"" + libATest + "\""
            }
            gccCmd = gccCmd + " -lgc -lm -lz -lpthread"
        if (!Program.IsWindows()) { gccCmd = gccCmd + " -ldl" }
            // Splice per-package libs (-l<name>). Each loaded
            // package contributes zero or more bare names via
            // its manifest's [stdlib].libs array.
            let nLibs: int = pkgLibs.Count()
            for plj in 0..nLibs {
                gccCmd = gccCmd + " -l" + pkgLibs.Get(plj)
            }
            gccCmd = gccCmd + " -o " + outBin + " 2>&1"
            let gcc = Process.RunCapture(gccCmd)
            if (gcc.Exit != 0) {
                if (ciMode) { Console.WriteLine("  [LINK-FAIL] in " + path) }
                else        { Console.WriteLine("  [LINK-FAIL]") }
                Console.Write(gcc.Stdout)
                compileFail = compileFail + 1
                continue
            }
            // Step 3 — run and parse stdout for tag lines. Anything
            // not matching a tag is preserved as test stdout (for
            // debugging), printed indented under the tag lines.
            let rr = Process.RunCapture(outBin)
            let outLines: List<string> = String_Split(rr.Stdout, "\n")
            let on = outLines.Count()
            for ln in 0..on {
                let lineStr = outLines.Get(ln)
                if (String_StartsWith(lineStr, "[PASS]")) {
                    if (!ciMode) { Console.WriteLine("  " + lineStr) }
                    pass = pass + 1
                } else if (String_StartsWith(lineStr, "[FAIL]")) {
                    // FAILs always surface — print the file path in
                    // --ci so a CI log scanner can locate the test
                    // without the per-file header.
                    if (ciMode) { Console.WriteLine("  [FAIL] in " + path) }
                    Console.WriteLine("  " + lineStr)
                    fail = fail + 1
                } else if (String_StartsWith(lineStr, "[SKIP]")) {
                    if (!ciMode) { Console.WriteLine("  " + lineStr) }
                    skip = skip + 1
                }
            }
            // Surface a non-zero exit even if no tag lines were
            // emitted — covers tests that crash before printing.
            if (rr.Exit != 0 && pass == 0 && fail == 0 && skip == 0) {
                if (ciMode) { Console.WriteLine("  [FAIL] <crash> in " + path + " exit=" + String_FromInt(rr.Exit)) }
                else        { Console.WriteLine("  [FAIL] <crash> exit=" + String_FromInt(rr.Exit)) }
                fail = fail + 1
            }
        }

        Console.WriteLine("")
        Console.WriteLine("──────────────────────────────────")
        Console.WriteLine("PASS: " + String_FromInt(pass) + "  FAIL: " + String_FromInt(fail) + "  SKIP: " + String_FromInt(skip))
        if (compileFail > 0) {
            Console.WriteLine("COMPILE-FAIL: " + String_FromInt(compileFail))
            return 1
        }
        if (fail > 0) { return 1 }
        return 0
    }

    // Pre-compile every installed package's vendored source(s)
    // to .o files. Each test binary then links the resulting .o
    // list, so packages with vendored deps (SQLite C, DuckDB C++)
    // compile cleanly via `amc test`.
    //
    // Cache lookup order (since v0.5.4):
    //   1. `<pkg-dir>/build/<platform>/<class>-<basename>.o`
    //      — persistent, written by `amc package add` when the
    //      manifest declares `[stdlib].precompile = true`. Survives
    //      reboots, shared across all `amc test` invocations.
    //   2. `/tmp/amc-pkg-<class>-<basename>.o`
    //      — volatile, written here on the lazy path when (1) misses.
    //      Wiped on reboot but cheap to rebuild.
    //   3. Compile fresh.
    //
    // Compiler dispatch: gcc for .c (+ p.CFlags), g++ for
    // .cpp/.cc/.cxx (+ p.CxxFlags). Same dispatch as
    // AddCommand.PrecompilePackage so the two paths stay coherent.
    // A volatile /tmp object is reused only when it is newer than its
    // sources AND than the project's amalgame.lock: the generated C
    // #include's every declared package header, so an object built
    // before a dependency was declared (e.g. web before compress) lacks
    // that header and fails at link time ("undefined reference to
    // Compress_GzipString") until reboot.
    public static bool VolatileObjFresh(string obj, List<string> sources) {
        let t: int = File.Mtime(obj)
        if (t <= 0) { return false }
        if (File.Exists("amalgame.lock") && File.Mtime("amalgame.lock") > t) { return false }
        let n: int = sources.Count()
        for i in 0..n {
            if (File.Mtime(sources.Get(i)) > t) { return false }
        }
        return true
    }

    public static List<string> PreCompilePackageSources(PackageRegistry reg, string amcRuntime) {
        let out: List<string> = new List<string>()
        let n: int = reg.Packages.Count()
        for i in 0..n {
            let p: LoadedPackage = reg.Packages.Get(i)
            // Both the facade (single AM file) and [stdlib].sources
            // (a list) need to land in the package's combined .o.
            // Splitting them here so the AM pipeline below sees one
            // unified list — the precompile output is per-package,
            // not per-source.
            let sources: List<string> = new List<string>()
            if (String_Length(p.Facade) > 0) {
                sources.Add(p.Facade)
            }
            let extraSrc: int = p.Sources.Count()
            for esi in 0..extraSrc {
                sources.Add(p.Sources.Get(esi))
            }
            let sn: int = sources.Count()
            if (sn == 0) { continue }
            // Compute the persistent precompile cache dir for this
            // package (only used if .o is present there; not
            // created here).
            let persistentDir: string = PackageRegistry.PrecompileCacheDir(p.PkgDir)

            // Split sources into AM vs C/C++.  AM sources all compile
            // together via a single `amc --lib` invocation (cross-file
            // refs like Cookie ↔ HttpResponse need their siblings in
            // scope).  Native sources still compile one-per-file since
            // each is independent.
            let amSources: List<string> = new List<string>()
            let nativeSources: List<string> = new List<string>()
            for j in 0..sn {
                let sp: string = sources.Get(j)
                if (String_Length(sp) == 0) { continue }
                if (String_EndsWith(sp, ".am")) {
                    amSources.Add(sp)
                } else {
                    nativeSources.Add(sp)
                }
            }

            // ── AM path: single combined .o per package ───
            if (amSources.Count() > 0) {
                let amObj: string = "/tmp/amc-pkg-" + p.ClassName + ".o"
                let amCacheObj: string = persistentDir + "/" + p.ClassName + ".o"
                var skipAm: bool = false
                if (File.Exists(amCacheObj)) {
                    out.Add(amCacheObj); skipAm = true
                } else if (File.Exists(amObj) && Program.VolatileObjFresh(amObj, amSources)) {
                    out.Add(amObj); skipAm = true
                }
                if (!skipAm) {
                    let amCsrc: string = amObj + ".c"
                    let amcSelf: string = Program.ResolveSelfPath()
                    var amcCmd: string = "\"" + amcSelf + "\" --lib --quiet -o \"" + amObj + "\""
                    let amCount: int = amSources.Count()
                    for ai in 0..amCount {
                        amcCmd = amcCmd + " \"" + amSources.Get(ai) + "\""
                    }
                    let amcRes = Process.RunCapture(amcCmd)
                    if (amcRes.Exit != 0) {
                        Console.WriteError("amc precompile: amc --lib failed for " + p.ClassName)
                        Console.WriteError(amcRes.Stdout)
                    } else {
                        var cmd: string = "gcc -O2"
                        if (String_Length(amcRuntime) > 0) {
                            cmd = cmd + " -I\"" + amcRuntime + "\""
                        }
                        // The package's own runtime/ dir hosts the C
                        // header named in [stdlib].header — every
                        // include line in the generated .c references
                        // it by basename, so missing the -I produces
                        // the classic "Amalgame_X.h not found" fatal
                        // error at the precompile gcc step.
                        let pkgRuntime: string = p.PkgDir + "/runtime"
                        cmd = cmd + " -I\"" + pkgRuntime + "\" -I\"" + p.PkgDir + "\""
                        // v0.8.49 — also -I every cached package's
                        // runtime/. amc auto-emits #include lines for
                        // every cached header in the generated .c (the
                        // gen_test.c-style multi-include), so a sibling
                        // header whose own header transitively
                        // #include's another (e.g. net-http v0.9.1+'s
                        // Amalgame_Net_Http.h → Amalgame_Async.h)
                        // needs the sibling's runtime/ on -I.
                        let allCachedDirs: List<string> = AddCommand.AllCachedRuntimeDirs()
                        let acn: int = allCachedDirs.Count()
                        for aci in 0..acn {
                            cmd = cmd + " -I\"" + allCachedDirs.Get(aci) + "\""
                        }
                        if (String_Length(p.CFlags) > 0) {
                            cmd = cmd + " " + p.CFlags
                        }
                        cmd = cmd + " -w -c \"" + amCsrc + "\" -o \"" + amObj + "\""
                        let gccRes = Process.RunCapture(cmd)
                        if (gccRes.Exit != 0) {
                            Console.WriteError("amc precompile: gcc failed for " + p.ClassName)
                            Console.WriteError(gccRes.Stdout)
                        } else {
                            Console.WriteLine("Pre-compiled " + p.ClassName + " (" + String_FromInt(amCount) + " AM sources)")
                            out.Add(amObj)
                        }
                    }
                }
            }

            // ── Native path: one .o per .c/.cpp source ─────
            let nn: int = nativeSources.Count()
            for j in 0..nn {
                let srcPath: string = nativeSources.Get(j)
                let lastSlash: int = String_LastIndexOf(srcPath, "/")
                var srcLeaf: string = srcPath
                if (lastSlash >= 0) {
                    srcLeaf = String_Substring(srcPath, lastSlash + 1, String_Length(srcPath) - lastSlash - 1)
                }
                let persistentObj: string = persistentDir + "/" + p.ClassName + "-" + srcLeaf + ".o"
                if (File.Exists(persistentObj)) {
                    out.Add(persistentObj)
                    continue
                }
                let objPath: string = "/tmp/amc-pkg-" + p.ClassName + "-" + srcLeaf + ".o"
                if (File.Exists(objPath)) {
                    out.Add(objPath)
                    continue
                }
                let isCxx: bool = PackageRegistry.IsCxxSource(srcPath)
                var cmd: string = ""
                if (isCxx) {
                    cmd = "g++ -O2"
                } else {
                    cmd = "gcc -O2"
                }
                if (String_Length(amcRuntime) > 0) {
                    cmd = cmd + " -I\"" + amcRuntime + "\""
                }
                // v0.8.49 — same -I-cache-walk rationale as
                // the AM pre-compile path above.
                let cachedNativeDirs: List<string> = AddCommand.AllCachedRuntimeDirs()
                let cndN: int = cachedNativeDirs.Count()
                for cndI in 0..cndN {
                    cmd = cmd + " -I\"" + cachedNativeDirs.Get(cndI) + "\""
                }
                if (isCxx && String_Length(p.CxxFlags) > 0) {
                    cmd = cmd + " " + p.CxxFlags
                }
                if (!isCxx && String_Length(p.CFlags) > 0) {
                    cmd = cmd + " " + p.CFlags
                }
                cmd = cmd + " -w -c \"" + srcPath + "\" -o \"" + objPath + "\""
                let res = Process.RunCapture(cmd)
                if (res.Exit != 0) {
                    Console.WriteError("amc test: failed to pre-compile " + srcPath)
                    Console.WriteError(res.Stdout)
                    continue
                }
                Console.WriteLine("Pre-compiled " + p.ClassName + " source: " + srcLeaf)
                out.Add(objPath)
            }
        }
        return out
    }


    // ── build / run / watch (v0.7.9+) ───────────────────
    //
    // `amc build <entry.am>` is the first-class compile verb.
    // Under the hood it shares the gcc-link logic that `amc test`
    // already uses, plus an explicit link against `lib/libamalgame.a`
    // when it's shipped alongside amc — so packages that reference
    // bundled-stdlib classes (Json / Toml) resolve at link time
    // without the user knowing the magic.
    //
    // The bare-args form `amc -o out file.am` still works (no
    // gcc step, .c emission only) — keeping the surface for the
    // edge cases where users want to splice their own gcc command
    // (CI cross-compile, custom flags).
    //
    // Returns 0 on success, non-zero on amc-compile / gcc-link
    // failure. Errors are printed to stderr inline.

    // Scan a failed-amc stdout for `Unknown symbol 'X'` diagnostics
    // and shell out to `amc package suggest --json X` to print a
    // friendly hint section below the raw error dump. Mirrors the
    // LSP-side `CollectPackageInstallSuggestions` codepath — same
    // schema, same safety stance (display-only, never auto-install).
    //
    // Silent (no extra output) when the index isn't reachable or
    // no symbol matches a known package.
    public static void PrintPackageSuggestionsForOutput(string output, string amcPath) {
        let lines: List<string> = String_Split(output, "\n")
        let n: int = lines.Count()
        let prefix: string = "Unknown symbol '"
        let prefLen: int = String_Length(prefix)
        let seen: List<string> = new List<string>()
        var headerPrinted: bool = false
        var cmd: string = "amc"
        if (String_Length(amcPath) > 0) { cmd = amcPath }
        for li in 0..n {
            let line: string = lines.Get(li)
            let idx: int = String_IndexOf(line, prefix)
            if (idx < 0) { continue }
            let restLen: int = String_Length(line) - idx - prefLen
            if (restLen <= 0) { continue }
            let rest: string = String_Substring(line, idx + prefLen, restLen)
            let endQuote: int = String_IndexOf(rest, "'")
            if (endQuote <= 0) { continue }
            let symName: string = String_Substring(rest, 0, endQuote)
            if (symName == "_" || symName == "_unknown_") { continue }
            // Dedupe — same symbol can fire multiple errors.
            let ns: int = seen.Count()
            var dup: bool = false
            for si in 0..ns {
                if (seen.Get(si) == symName) { dup = true }
            }
            if (dup) { continue }
            seen.Add(symName)
            let result = Process.RunCapture(cmd + " package suggest --json " + symName)
            if (result.Exit != 0) { continue }
            let trimmed: string = String_Trim(result.Stdout)
            if (String_Length(trimmed) == 0 || trimmed == "[]") { continue }
            let parsed: JsonResult = Json.Parse(trimmed)
            if (!parsed.Ok) { continue }
            let doc: JsonValue = parsed.Value
            if (doc.IsNull() || !doc.IsArray()) { continue }
            let arr: List<JsonValue> = doc.AsArray()
            let nr: int = arr.Count()
            if (nr == 0) { continue }
            if (!headerPrinted) {
                Console.WriteLine("")
                Console.WriteLine("hint: unresolved symbols match curated packages — install via:")
                headerPrinted = true
            }
            Console.WriteLine("  '" + symName + "':")
            for ri in 0..nr {
                let entry: JsonValue = arr.Get(ri)
                let pn: string = entry.Get("name").AsString()
                let pt: string = entry.Get("latest_compatible_tag").AsString()
                var hintLine: string = "    amc package add " + pn
                if (String_Length(pt) > 0) { hintLine = hintLine + "@" + pt }
                Console.WriteLine(hintLine)
            }
        }
    }

    // ── Minimal amalgame.toml line-scan (no full TOML parser needed) ──
    // Returns the raw text after `key =` on its line ("" if absent).
    private static string TomlRawValue(List<string> lines, string key) {
        let n: int = lines.Count()
        for i in 0..n {
            let t: string = String_TrimStart(lines.Get(i))
            if (String_StartsWith(t, "#")) { continue }
            if (String_StartsWith(t, key)) {
                let after: string = String_TrimStart(String_From(t, String_Length(key)))
                if (String_StartsWith(after, "=")) {
                    return String_Trim(String_From(after, 1))
                }
            }
        }
        return ""
    }
    private static string TomlScalar(List<string> lines, string key) {
        // Strip only the SURROUNDING quotes — inner quotes are significant
        // (e.g. flash_cmd = "openocd ... -c \"program ...\"").
        var v: string = Program.TomlRawValue(lines, key)
        let n: int = String_Length(v)
        if (n >= 2 && String_StartsWith(v, "\"") && String_EndsWith(v, "\"")) {
            v = String_Substring(v, 1, n - 2)
        }
        return v
    }
    private static List<string> TomlArray(List<string> lines, string key) {
        let out: List<string> = new List<string>()
        var raw: string = Program.TomlRawValue(lines, key)
        if (String_Length(raw) == 0) { return out }
        raw = String_Replace(raw, "[", "")
        raw = String_Replace(raw, "]", "")
        raw = String_Replace(raw, "\"", "")
        let parts: List<string> = String_Split(raw, ",")
        let pn: int = parts.Count()
        for i in 0..pn {
            let v: string = String_Trim(parts.Get(i))
            if (String_Length(v) > 0) { out.Add(v) }
        }
        return out
    }
    // Expand a colon-separated env var into repeated `<flag>"dir"` tokens.
    private static string EnvDirFlags(string envName, string flag) {
        let v: string = Env.Get(envName)
        if (String_Length(v) == 0) { return "" }
        var s: string = ""
        let parts: List<string> = String_Split(v, ":")
        let pn: int = parts.Count()
        for i in 0..pn {
            let d: string = String_Trim(parts.Get(i))
            if (String_Length(d) > 0) { s = s + " " + flag + "\"" + d + "\"" }
        }
        return s
    }

    // MCU: cross-compile + link a freestanding .c into a runnable ELF
    // (+ .bin/.hex). No host libc, no -lgc.
    //   - boardPath == ""  → the bundled QEMU lm3s6965 (Cortex-M3) board.
    //   - boardPath != ""  → an external board package (amalgame-mcu-<board>):
    //       startup = <board>/boards/startup.c, linker from its amalgame.toml,
    //       runtime header in <board>/runtime/, libs+defines from the manifest.
    //       Machine-specific lib search paths come from env (a board's native
    //       deps like libopencm3 live wherever the user built them):
    //         AMC_EMBED_INC  (colon-sep include dirs → -I)
    //         AMC_EMBED_LIB  (colon-sep library dirs → -L)
    public static int LinkEmbedded(
        string target, string outC, string outBin, string amcRuntime,
        string boardPath, bool verbose, bool debug
    ) {
        let embDir: string = amcRuntime + "/embedded"
        var startup: string = ""
        var ld: string = ""
        var cpu: string = Program.TargetCpuFlags(target)
        var defines: List<string> = new List<string>()
        var libs: List<string> = new List<string>()
        var incBoard: string = " -I\"" + embDir + "\""

        if (String_Length(boardPath) > 0) {
            // External board package.
            let manifest: string = boardPath + "/amalgame.toml"
            if (!File.Exists(manifest)) {
                Console.WriteError("amc build --board: no amalgame.toml at " + boardPath)
                return 1
            }
            let mlines: List<string> = String_Split(File.ReadAll(manifest), "\n")
            startup = boardPath + "/boards/startup.c"
            let linkerRel: string = Program.TomlScalar(mlines, "linker")
            if (String_Length(linkerRel) == 0) {
                Console.WriteError("amc build --board: [target].linker missing in " + manifest)
                return 1
            }
            ld = boardPath + "/" + linkerRel
            let cf: string = Program.TomlScalar(mlines, "cpu_flags")
            if (String_Length(cf) > 0) { cpu = cf }
            defines = Program.TomlArray(mlines, "defines")
            libs = Program.TomlArray(mlines, "libs")
            incBoard = incBoard + " -I\"" + boardPath + "/runtime\""
            var embInc: string = Program.EnvDirFlags("AMC_EMBED_INC", "-I")
            if (String_Length(embInc) == 0) {
                // Auto-detect the libopencm3 built by `amc mcu setup` (~/libopencm3)
                // so users don't have to export AMC_EMBED_INC/LIB by hand.
                let home: string = Env.Get("HOME")
                if (String_Length(home) > 0 && File.Exists(home + "/libopencm3/include")) {
                    embInc = " -I\"" + home + "/libopencm3/include\""
                }
            }
            incBoard = incBoard + embInc
            // Force-define AMC_BOARD_HEADER so the embedded runtime pulls in the
            // board's real Mcu_* (libopencm3) instead of the QEMU semihosting
            // default — without this the firmware hangs on a semihosting bkpt
            // on real silicon. Basename of the manifest's [stdlib].header.
            let hdr: string = Program.TomlScalar(mlines, "header")
            if (String_Length(hdr) > 0) {
                var base: string = hdr
                let sl: int = String_LastIndexOf(hdr, "/")
                if (sl >= 0) { base = String_Substring(hdr, sl + 1, String_Length(hdr) - sl - 1) }
                incBoard = incBoard + " -DAMC_BOARD_HEADER='\"" + base + "\"'"
            }
        } else {
            // Bundled board: QEMU lm3s6965 for cortex-m3, and a RAM-loaded
            // image for esp32s3 (the ESP32-S3 ROM loads a header-wrapped
            // image whose segments live in internal SRAM — no flash cache /
            // 2nd-stage bootloader needed for a console "hello").
            var board: string = ""
            if (target == "cortex-m3") { board = "qemu-lm3s6965" }
            if (target == "esp32s3")   { board = "esp32s3-ramload" }
            if (String_Length(board) == 0) {
                Console.WriteError("amc build --target=" + target + ": no bundled board asset.")
                Console.WriteError("  cortex-m3 ships the QEMU lm3s6965 board; esp32s3 ships a")
                Console.WriteError("  RAM-loaded board; for other targets pass --board=<pkg>.")
                return 1
            }
            let boardDir: string = embDir + "/boards/" + board
            startup = boardDir + "/startup.c"
            ld = boardDir + "/board.ld"
        }
        if (!File.Exists(startup) || !File.Exists(ld)) {
            Console.WriteError("amc build: board startup/linker missing (" + startup + " / " + ld + ")")
            return 1
        }

        // Extra board sources beyond startup.c, compiled+linked alongside it and
        // the program. Lets a board ship e.g. an Xtensa vector table + interrupt
        // bring-up (esp32s3-ramload: vectors.S + interrupts.c, B0b-2). Picked up
        // from the same dir as startup.c, by convention, if present.
        var extraSrc: string = ""
        let sdir: int = String_LastIndexOf(startup, "/")
        if (sdir >= 0) {
            let bdir: string = String_Substring(startup, 0, sdir)
            var cands: List<string> = new List<string>()
            cands.Add("vectors.S")
            cands.Add("interrupts.c")
            cands.Add("heap.c")
            let cn: int = cands.Count()
            for ci in 0..cn {
                let f: string = bdir + "/" + cands.Get(ci)
                if (File.Exists(f)) { extraSrc = extraSrc + " \"" + f + "\"" }
            }
        }

        let cc: string  = Program.TargetCC(target)
        var ccHint: string = "sudo apt install gcc-arm-none-eabi  (Debian/Ubuntu)"
        if (Program.TargetIsXtensa(target)) {
            ccHint = "install the ESP-IDF Xtensa toolchain (xtensa-esp32s3-elf-gcc), e.g. via esp-idf or PlatformIO; put its bin/ on PATH"
        }
        if (!Program.RequireTool(cc, ccHint)) {
            return 1
        }
        var optFlag: string = "-Os"
        if (debug) { optFlag = "-O0 -g" }
        var cmd: string = cc + " " + cpu + " " + optFlag
        cmd = cmd + " -ffreestanding -nostartfiles -ffunction-sections -fdata-sections -Wl,--gc-sections"
        let dn: int = defines.Count()
        for di in 0..dn { cmd = cmd + " -D" + defines.Get(di) }
        cmd = cmd + incBoard
        cmd = cmd + " -T \"" + ld + "\""
        cmd = cmd + " \"" + startup + "\"" + extraSrc + " \"" + outC + "\""
        var embLib: string = Program.EnvDirFlags("AMC_EMBED_LIB", "-L")
        if (String_Length(embLib) == 0) {
            let homeL: string = Env.Get("HOME")
            if (String_Length(homeL) > 0 && File.Exists(homeL + "/libopencm3/lib")) {
                embLib = " -L\"" + homeL + "/libopencm3/lib\""
            }
        }
        cmd = cmd + embLib
        let ln: int = libs.Count()
        for li in 0..ln { cmd = cmd + " -l" + libs.Get(li) }
        cmd = cmd + " -o \"" + outBin + "\" 2>&1"
        if (verbose) { Console.WriteLine("  " + cc + ": " + cmd) }
        let r = Process.RunCapture(cmd)
        if (r.Exit != 0) {
            Console.WriteError("  [LINK-FAIL] " + cc + " exited " + String_FromInt(r.Exit))
            Console.Write(r.Stdout)
            return 1
        }
        // Packaging differs by ROM boot contract:
        //   ESP32-S3 → esptool elf2image wraps the ELF in an esp_image header
        //     (magic 0xE9 + segment table + entry); the ROM validates and
        //     RAM-loads it. Flash at offset 0x0 with `esptool write_flash`.
        //   Cortex-M → raw .bin + Intel .hex (vector table at flash base).
        if (Program.TargetIsXtensa(target)) {
            if (!Program.RequireTool("esptool", "pip install esptool  (or use the ESP-IDF / PlatformIO copy)")) {
                return 1
            }
            let img: string = outBin + ".bin"
            let elf2 = Process.RunCapture(
                "esptool --chip esp32s3 elf2image --flash_mode dio --flash_freq 80m --flash_size 2MB -o \""
                + img + "\" \"" + outBin + "\" 2>&1")
            if (elf2.Exit != 0) {
                Console.WriteError("  [IMAGE-FAIL] esptool elf2image exited " + String_FromInt(elf2.Exit))
                Console.Write(elf2.Stdout)
                return 1
            }
            if (verbose) { Console.Write(elf2.Stdout) }
            Console.WriteLine("  image: " + img + "  (flash with: esptool --chip esp32s3 write_flash 0x0 " + img + ")")
        } else {
            // objcopy → raw .bin + Intel .hex for flashers (st-flash/avrdude).
            let oc: string = Program.TargetObjcopy(target)
            let cBin = Process.RunCapture(oc + " -O binary \"" + outBin + "\" \"" + outBin + ".bin\" 2>&1")
            if (cBin.Exit != 0) { Console.Write(cBin.Stdout) }
            let cHex = Process.RunCapture(oc + " -O ihex \"" + outBin + "\" \"" + outBin + ".hex\" 2>&1")
            if (cHex.Exit != 0) { Console.Write(cHex.Stdout) }
        }
        if (verbose) {
            let sz = Process.RunCapture(Program.TargetSize(target) + " \"" + outBin + "\" 2>&1")
            Console.Write(sz.Stdout)
        }
        return 0
    }

    // MCU toolchain preflight: is `tool` on PATH? On a miss, print an
    // actionable install hint and return false (the caller aborts). Keeps the
    // failure mode "amc tells you exactly what to apt-install" instead of a
    // cryptic gcc/openocd error. See tools/mcu-setup.sh for one-shot install.
    public static bool RequireTool(string tool, string hint) {
        let p = Process.RunCapture("command -v '" + tool + "' 2>/dev/null")
        if (p.Exit == 0 && String_Length(String_Trim(p.Stdout)) > 0) { return true }
        Console.WriteError("amc: required tool '" + tool + "' not found on PATH.")
        Console.WriteError("     install: " + hint)
        Console.WriteError("     or run:  tools/mcu-setup.sh  (installs the full MCU toolchain)")
        return false
    }

    // MCU: flash a freshly-built firmware onto the chip. Reads the board's
    // [target].flash_cmd template (e.g. "st-flash write {bin} 0x08000000")
    // and substitutes {bin}/{elf}/{hex}. The flasher (st-flash/openocd/
    // esptool/avrdude) must be installed and the board connected.
    public static int FlashEmbedded(string boardPath, string outBin) {
        if (String_Length(boardPath) == 0) {
            Console.WriteError("amc build --flash: needs --board=<pkg> declaring [target].flash_cmd")
            return 1
        }
        let manifest: string = boardPath + "/amalgame.toml"
        if (!File.Exists(manifest)) {
            Console.WriteError("amc build --flash: no amalgame.toml at " + boardPath)
            return 1
        }
        let lines: List<string> = String_Split(File.ReadAll(manifest), "\n")
        var cmd: string = ""
        let tool: string = Program.TomlScalar(lines, "flash_tool")
        if (tool == "openocd") {
            if (!Program.RequireTool("openocd", "sudo apt install openocd")) { return 1 }
            // amc owns the quoting of the multi-word -c command (OpenOCD is the
            // reliable path on Nucleo; st-flash 1.7 has an F76x loader bug).
            let cfg: string = Program.TomlScalar(lines, "openocd_cfg")
            var addr: string = Program.TomlScalar(lines, "flash_addr")
            if (String_Length(addr) == 0) { addr = "0x08000000" }
            cmd = "openocd -f " + cfg + " -c \"program " + outBin + ".bin " + addr + " verify reset exit\""
        } else {
            // Custom template (e.g. st-flash/esptool/avrdude). {bin}/{elf}/{hex}
            // placeholders — built by concatenation so amc's "{ident}" string
            // interpolation leaves them literal (the template is in the TOML).
            cmd = Program.TomlScalar(lines, "flash_cmd")
            if (String_Length(cmd) == 0) {
                Console.WriteError("amc build --flash: no [target].flash_tool/flash_cmd in " + manifest)
                return 1
            }
            cmd = String_Replace(cmd, "{" + "bin}", outBin + ".bin")
            cmd = String_Replace(cmd, "{" + "elf}", outBin)
            cmd = String_Replace(cmd, "{" + "hex}", outBin + ".hex")
        }
        Console.WriteLine("  flash: " + cmd)
        let r = Process.RunCapture(cmd + " 2>&1")
        Console.Write(r.Stdout)
        if (r.Exit != 0) {
            Console.WriteError("  [FLASH-FAIL] flasher exited " + String_FromInt(r.Exit))
            return 1
        }
        Console.WriteLine("✓ Flashed " + outBin + ".bin")
        return 0
    }

    // `amc monitor [--port <dev>] [--baud <rate>]` — stream a serial port to
    // the terminal (the board's UART; on a Nucleo that's the ST-LINK virtual
    // COM port /dev/ttyACM0). Sets raw 8N1 via stty then cats the device;
    // Ctrl-C stops. Pairs with the board's Console-over-UART override so you
    // can watch Console.WriteLine output from the chip.
    public static int RunMonitor(int argc) {
        var port: string = "/dev/ttyACM0"
        var baud: string = "115200"
        var i: int = 2
        while (i < argc) {
            let a: string = Args_Get(i)
            if ((a == "--port" || a == "-p") && i + 1 < argc) {
                i = i + 1
                port = Args_Get(i)
            } else if ((a == "--baud" || a == "-b") && i + 1 < argc) {
                i = i + 1
                baud = Args_Get(i)
            } else if (a == "-h" || a == "--help") {
                Console.WriteError("Usage: amc monitor [--port /dev/ttyACM0] [--baud 115200]")
                Console.WriteError("  Stream a serial port (board UART / ST-LINK VCP) to the terminal.")
                return 0
            }
            i = i + 1
        }
        if (!File.Exists(port)) {
            Console.WriteError("amc monitor: serial port '" + port + "' not found")
            Console.WriteError("  plug the board in (Nucleo ST-LINK VCP is usually /dev/ttyACM0),")
            Console.WriteError("  or pass --port <dev>. List with: ls /dev/ttyACM* /dev/ttyUSB*")
            return 1
        }
        Console.WriteLine("amc monitor: " + port + " @ " + baud + " baud  (Ctrl-C to stop)")
        let cmd: string = "stty -F '" + port + "' " + baud + " raw -echo 2>/dev/null; exec cat '" + port + "'"
        let rc: int = Process.Run(cmd)
        return rc
    }

    public static int BuildOneBinary(
        string amcPath,
        string entryAm,
        string outBin,
        string amcRuntime,
        string libamalgameA,
        List<string> pkgObjs,
        List<string> facadeArs,
        List<string> pkgLibs,
        bool hasCxx,
        bool verbose,
        bool debug,
        string target,
        string board
    ) {
        let outC: string = outBin + ".c"
        var quietFlag: string = " --quiet"
        if (verbose) { quietFlag = " --verbose" }
        // MCU: forward --target to the transpile sub-invocation so it emits
        // the freestanding C (§4). Empty target → hosted, unchanged.
        var targetFlag: string = ""
        if (String_Length(target) > 0) { targetFlag = " --target=" + target }
        let amcCmd: string = amcPath + " " + entryAm + " -o " + outBin + quietFlag + targetFlag
        let cr = Process.RunCapture(amcCmd)
        if (cr.Exit != 0) {
            Console.WriteError("  [COMPILE-FAIL] amc exited " + String_FromInt(cr.Exit))
            Console.Write(cr.Stdout)
            Program.PrintPackageSuggestionsForOutput(cr.Stdout, amcPath)
            return 1
        }
        if (verbose) {
            Console.WriteLine("  amc → " + outC)
        }

        // MCU: cross-compile + link the freestanding .c against the board
        // startup + linker script, then objcopy to .bin/.hex. No host libc,
        // no -lgc. Bypasses the entire hosted gcc chain below.
        if (String_Length(target) > 0) {
            return Program.LinkEmbedded(target, outC, outBin, amcRuntime, board, verbose, debug)
        }

        // v0.8.0+: --debug swaps -O2 for -O0 -g so gcc emits DWARF
        // line tables + frame info; the `amc dap` adapter needs that
        // to map breakpoints on .am files (via the #line directives
        // amc already emits in the .c) to runtime addresses.
        var optFlag: string = "-O2"
        if (debug) { optFlag = "-O0 -g" }
        // v0.8.49: same auto-include-the-cache rationale as the
        // `amc test` link path above — pre-cook the -I list once.
        let pkgIncDirs2: List<string> = AddCommand.AllCachedRuntimeDirs()
        let pkgIncN2: int = pkgIncDirs2.Count()
        var pkgIncFlags2: string = ""
        for pi2 in 0..pkgIncN2 {
            pkgIncFlags2 = pkgIncFlags2 + " -I\"" + pkgIncDirs2.Get(pi2) + "\""
        }
        var gccCmd: string = ""
        if (hasCxx) {
            // C++ package present (DuckDB etc.) — two-stage link.
            // Stage A: gcc -c on the cgen-emitted .c. amc emits C-style
            // void* casts and string-literal-to-char* coercions that
            // g++ rejects with -fpermissive warnings as errors, so
            // we compile as C first.
            var compileCmd: string = "gcc " + optFlag + " -Wno-unused-variable -Wno-unused-parameter -Wno-unused-but-set-variable -Iruntime"
            if (String_Length(amcRuntime) > 0) {
                compileCmd = compileCmd + " -I\"" + amcRuntime + "\""
            }
            compileCmd = compileCmd + pkgIncFlags2
            let objOut: string = outBin + ".o"
            compileCmd = compileCmd + " -c " + outC + " -o " + objOut + " 2>&1"
            let stageA = Process.RunCapture(compileCmd)
            if (stageA.Exit != 0) {
                Console.WriteError("  [LINK-FAIL] gcc -c exited " + String_FromInt(stageA.Exit))
                Console.Write(stageA.Stdout)
                return 1
            }
            gccCmd = "g++ " + optFlag + " " + objOut
        } else {
            gccCmd = "gcc " + optFlag + " -Wno-unused-variable -Wno-unused-parameter -Wno-unused-but-set-variable -Iruntime"
            if (String_Length(amcRuntime) > 0) {
                gccCmd = gccCmd + " -I\"" + amcRuntime + "\""
            }
            gccCmd = gccCmd + pkgIncFlags2 + " " + outC
        }
        // Per-package vendored .o (SQLite, DuckDB).
        let nObjs: int = pkgObjs.Count()
        for poi in 0..nObjs {
            gccCmd = gccCmd + " \"" + pkgObjs.Get(poi) + "\""
        }
        // Per-package facade archives (libamalgame-pkg-<class>.a).
        let nFAr: int = facadeArs.Count()
        for fai in 0..nFAr {
            gccCmd = gccCmd + " \"" + facadeArs.Get(fai) + "\""
        }
        // Bundled stdlib archive — only link when it's actually
        // shipped alongside amc (source-tree build OR installed
        // release). Skip silently when missing so the build path
        // stays usable in minimal /usr/local/bin-only setups, but
        // future packages that reference Json / Toml symbols may
        // fail to link without it.
        if (String_Length(libamalgameA) > 0) {
            gccCmd = gccCmd + " \"" + libamalgameA + "\""
        }
        gccCmd = gccCmd + " -lgc -lm -lz -lpthread"
        if (!Program.IsWindows()) { gccCmd = gccCmd + " -ldl" }
        let nLibs: int = pkgLibs.Count()
        for plj in 0..nLibs {
            gccCmd = gccCmd + " -l" + pkgLibs.Get(plj)
        }
        gccCmd = gccCmd + " -o " + outBin + " 2>&1"
        if (verbose) {
            Console.WriteLine("  gcc: " + gccCmd)
        }
        let gcc = Process.RunCapture(gccCmd)
        if (gcc.Exit != 0) {
            Console.WriteError("  [LINK-FAIL] gcc exited " + String_FromInt(gcc.Exit))
            Console.Write(gcc.Stdout)
            return 1
        }
        return 0
    }

    // BuildEntry — full pipeline for a single entry .am. Resolves
    // amc's runtime/ dir, loads the package registry, pre-compiles
    // vendored package sources, then delegates to BuildOneBinary.
    // Returns the exit code from BuildOneBinary; the caller decides
    // whether to chain a subsequent `Process.Run` (amc run).
    public static int BuildEntry(string entryAm, string outBin, bool verbose, bool debug, string target, string board) {
        if (!File.Exists(entryAm)) {
            Console.WriteError("amc build: entry file not found: " + entryAm)
            return 2
        }

        // Télémétrie d'usage anonyme (best-effort, non bloquant, opt-out env).
        // Couvre build + run (chemin partagé). Throttlé 1×/jour.
        Telemetry.Ping()

        // Resolve amc's own absolute path. Args_Get(0) carries whatever
        // the shell put in argv[0] — when amc is launched via PATH that's
        // the bare name "amc", which makes the dirname() lookup below
        // collapse to nothing. /proc/self/exe is the kernel-resolved
        // canonical path on Linux and (some) BSDs; macOS/Windows fall
        // through to Args_Get(0) until the equivalent is wired.
        var amcPath: string = Program.ResolveSelfPath()
        if (String_Length(amcPath) == 0) {
            amcPath = Args_Get(0)
        }
        let amcRuntime: string = Program.ResolveRuntimeDir(amcPath)

        // MCU builds have NO packages and no host link chain — skip the
        // install + pre-compile machinery entirely (it would try to build
        // host-only cached packages, which both wastes work and spews
        // unrelated errors). Embedded links only against the board startup
        // + the freestanding runtime (see LinkEmbedded).
        var libamalgameA: string = ""
        var pkgObjs: List<string> = new List<string>()
        var pkgLibs: List<string> = new List<string>()
        var facadeArs: List<string> = new List<string>()
        var hasCxx: bool = false
        if (String_Length(target) == 0) {
            // v0.5.1: auto-install lock-listed packages missing from cache.
            let installed: int = AddCommand.EnsureInstalled()
            if (installed < 0) {
                Console.WriteError("amc build: package install failed; aborting")
                return 1
            }
            if (installed > 0 && verbose) {
                Console.WriteLine("amc build: installed " + String_FromInt(installed) + " missing dep(s)")
            }
            libamalgameA = Program.ResolveLibAmalgameA(amcPath)
            let registry = PackageRegistry.Load()
            pkgObjs = Program.PreCompilePackageSources(registry, amcRuntime)
            hasCxx = registry.HasCxxSources()
            pkgLibs = registry.CollectLibs()
            facadeArs = registry.CollectFacadeArchives()
        }

        let rc: int = Program.BuildOneBinary(
            amcPath, entryAm, outBin, amcRuntime, libamalgameA,
            pkgObjs, facadeArs, pkgLibs, hasCxx, verbose, debug, target, board
        )
        return rc
    }

    // ── build subcommand (v0.7.9+) ──────────────────────
    //
    // `amc build [-o <out>] [--verbose] <entry.am>` — Cargo-style
    // compile verb. Default output is the entry file's stem
    // (`foo.am` → `./foo`). Builds against the full package +
    // bundled-stdlib link chain, so the resulting binary runs
    // standalone without an external gcc invocation.
    public static int RunBuild(int argc) {
        var entryAm: string = ""
        var outBin: string = ""
        var verbose: bool = false
        var debug: bool = false
        var target: string = ""
        var board: string = ""
        var flash: bool = false
        var i: int = 2
        while (i < argc) {
            let a: string = Args_Get(i)
            if (a == "-h" || a == "--help") {
                Console.WriteError("Usage: amc build [-o <out>] [-g|--debug] [--target=<mcu>] [--verbose] <entry.am>")
                Console.WriteError("")
                Console.WriteError("Compile + link a runnable binary in one step.")
                Console.WriteError("Equivalent to `amc -o out entry.am` plus the gcc invocation")
                Console.WriteError("(runtime headers, libamalgame.a, installed packages, libs).")
                Console.WriteError("")
                Console.WriteError("  -g, --debug      swap -O2 for -O0 -g (DWARF for amc dap)")
                Console.WriteError("  --target=<mcu>   cross-compile freestanding for an MCU")
                Console.WriteError("                   (" + Program.KnownTargets() + "); produces .elf + .bin/.hex")
                Console.WriteError("  --board=<path>   board package (amalgame-mcu-<board>) for startup +")
                Console.WriteError("                   linker + libs. cortex-m3 defaults to bundled QEMU board.")
                Console.WriteError("                   Native lib paths via env AMC_EMBED_INC / AMC_EMBED_LIB.")
                Console.WriteError("  --flash          after building, flash via the board's [target].flash_cmd")
                return 0
            }
            if (a == "-o" && i + 1 < argc) {
                outBin = Args_Get(i + 1)
                i = i + 2
            } else if (a == "-v" || a == "--verbose") {
                verbose = true
                i = i + 1
            } else if (a == "-g" || a == "--debug") {
                debug = true
                i = i + 1
            } else if (String_StartsWith(a, "--target=")) {
                target = String_From(a, 9)
                if (!Program.IsKnownTarget(target)) {
                    Console.WriteError("amc build: unknown --target '" + target + "'")
                    Console.WriteError("     known: " + Program.KnownTargets())
                    return 1
                }
                i = i + 1
            } else if (String_StartsWith(a, "--board=")) {
                board = String_From(a, 8)
                i = i + 1
            } else if (a == "--flash") {
                flash = true
                i = i + 1
            } else if (String_StartsWith(a, "-")) {
                Console.WriteError("amc build: unknown option '" + a + "'")
                return 1
            } else {
                if (String_Length(entryAm) > 0) {
                    Console.WriteError("amc build: only one entry .am file is supported; got '" + entryAm + "' and '" + a + "'")
                    return 1
                }
                entryAm = a
                i = i + 1
            }
        }
        if (String_Length(entryAm) == 0) {
            Console.WriteError("amc build: missing entry .am argument")
            Console.WriteError("Usage: amc build [-o <out>] [-g|--debug] [--verbose] <entry.am>")
            return 2
        }
        // Default output: strip directory + ".am" suffix from entry.
        if (String_Length(outBin) == 0) {
            outBin = entryAm
            let lastSlash: int = String_LastIndexOf(outBin, "/")
            if (lastSlash >= 0) {
                outBin = String_Substring(outBin, lastSlash + 1, String_Length(outBin) - lastSlash - 1)
            }
            if (String_EndsWith(outBin, ".am")) {
                outBin = String_Substring(outBin, 0, String_Length(outBin) - 3)
            }
            outBin = "./" + outBin
        }
        var rc: int = Program.BuildEntry(entryAm, outBin, verbose, debug, target, board)
        if (rc == 0) {
            Console.WriteLine("✓ Built " + outBin)
            // MCU: --flash runs the board's flash command on the fresh binary.
            if (flash && String_Length(target) > 0) {
                rc = Program.FlashEmbedded(board, outBin)
            }
        }
        return rc
    }

    // ── run subcommand (v0.7.9+) ────────────────────────
    //
    // `amc run [-o <out>] [--verbose] <entry.am> [-- args...]` —
    // build the binary, then exec it. Args after the `--` sentinel
    // are forwarded to the user binary's argv; everything before
    // configures the build itself.
    public static int RunRun(int argc) {
        var entryAm: string = ""
        var outBin: string = ""
        var verbose: bool = false
        var debug: bool = false
        let userArgs: List<string> = new List<string>()
        var sawSep: bool = false
        var i: int = 2
        while (i < argc) {
            let a: string = Args_Get(i)
            if (sawSep) {
                userArgs.Add(a)
                i = i + 1
                continue
            }
            if (a == "-h" || a == "--help") {
                Console.WriteError("Usage: amc run [-o <out>] [-g|--debug] [--verbose] <entry.am> [-- args...]")
                Console.WriteError("")
                Console.WriteError("Build the binary, then run it. Args after the `--` sentinel")
                Console.WriteError("are forwarded to the resulting program's argv.")
                return 0
            }
            if (a == "--") {
                sawSep = true
                i = i + 1
            } else if (a == "-o" && i + 1 < argc) {
                outBin = Args_Get(i + 1)
                i = i + 2
            } else if (a == "-v" || a == "--verbose") {
                verbose = true
                i = i + 1
            } else if (a == "-g" || a == "--debug") {
                debug = true
                i = i + 1
            } else if (String_StartsWith(a, "-")) {
                Console.WriteError("amc run: unknown option '" + a + "'")
                return 1
            } else {
                if (String_Length(entryAm) > 0) {
                    Console.WriteError("amc run: only one entry .am file is supported; got '" + entryAm + "' and '" + a + "'")
                    return 1
                }
                entryAm = a
                i = i + 1
            }
        }
        if (String_Length(entryAm) == 0) {
            Console.WriteError("amc run: missing entry .am argument")
            Console.WriteError("Usage: amc run [-o <out>] [--verbose] <entry.am> [-- args...]")
            return 2
        }
        if (String_Length(outBin) == 0) {
            outBin = entryAm
            let lastSlash: int = String_LastIndexOf(outBin, "/")
            if (lastSlash >= 0) {
                outBin = String_Substring(outBin, lastSlash + 1, String_Length(outBin) - lastSlash - 1)
            }
            if (String_EndsWith(outBin, ".am")) {
                outBin = String_Substring(outBin, 0, String_Length(outBin) - 3)
            }
            outBin = "./" + outBin
        }
        let buildRc: int = Program.BuildEntry(entryAm, outBin, verbose, debug, "", "")
        if (buildRc != 0) {
            return buildRc
        }
        // Assemble the run command. User args are passed through.
        var runCmd: string = outBin
        let na: int = userArgs.Count()
        for ai in 0..na {
            let ua: string = userArgs.Get(ai)
            // Naive single-quote escape: every arg gets its own
            // pair of single quotes. Doesn't handle embedded
            // single quotes; consumers needing that should script
            // around amc run directly.
            runCmd = runCmd + " \"" + ua + "\""
        }
        return Process.Run(runCmd)
    }

    // ── watch subcommand (v0.7.9+) ──────────────────────
    //
    // `amc watch [-o <out>] [--run] [--verbose] <entry.am>` —
    // build the binary now, then poll every 500 ms for mtime
    // changes on the entry file (v1 only watches the single file
    // explicitly named; transitive imports are deferred to
    // FileWatcher v2). When the file changes, rebuild and
    // (optionally) re-run. Ctrl-C to exit.
    public static int RunWatch(int argc) {
        var entryAm: string = ""
        var outBin: string = ""
        var verbose: bool = false
        var runAfter: bool = false
        var i: int = 2
        while (i < argc) {
            let a: string = Args_Get(i)
            if (a == "-h" || a == "--help") {
                Console.WriteError("Usage: amc watch [-o <out>] [--run] [--verbose] <entry.am>")
                Console.WriteError("")
                Console.WriteError("Build now, then poll <entry.am>'s mtime every 500 ms.")
                Console.WriteError("On change: rebuild (and re-run with --run). Ctrl-C to exit.")
                Console.WriteError("v1 watches only the explicit entry file; transitive imports")
                Console.WriteError("come post-D when the FileWatcher event-loop lands.")
                return 0
            }
            if (a == "-o" && i + 1 < argc) {
                outBin = Args_Get(i + 1)
                i = i + 2
            } else if (a == "-v" || a == "--verbose") {
                verbose = true
                i = i + 1
            } else if (a == "--run") {
                runAfter = true
                i = i + 1
            } else if (String_StartsWith(a, "-")) {
                Console.WriteError("amc watch: unknown option '" + a + "'")
                return 1
            } else {
                if (String_Length(entryAm) > 0) {
                    Console.WriteError("amc watch: only one entry .am file is supported")
                    return 1
                }
                entryAm = a
                i = i + 1
            }
        }
        if (String_Length(entryAm) == 0) {
            Console.WriteError("amc watch: missing entry .am argument")
            return 2
        }
        if (String_Length(outBin) == 0) {
            outBin = entryAm
            let lastSlash: int = String_LastIndexOf(outBin, "/")
            if (lastSlash >= 0) {
                outBin = String_Substring(outBin, lastSlash + 1, String_Length(outBin) - lastSlash - 1)
            }
            if (String_EndsWith(outBin, ".am")) {
                outBin = String_Substring(outBin, 0, String_Length(outBin) - 3)
            }
            outBin = "./" + outBin
        }

        Console.WriteLine("amc watch: " + entryAm + " → " + outBin)
        let _rc1: int = Program.BuildAndMaybeRun(entryAm, outBin, verbose, runAfter)
        var lastMtime: int = Program.FileMtimeNs(entryAm)
        Console.WriteLine("  (watching for changes, Ctrl-C to exit)")
        while (true) {
            Program.SleepMs(500)
            let cur: int = Program.FileMtimeNs(entryAm)
            if (cur != lastMtime && cur > 0) {
                lastMtime = cur
                Console.WriteLine("")
                Console.WriteLine("── change detected, rebuilding")
                let _rc2: int = Program.BuildAndMaybeRun(entryAm, outBin, verbose, runAfter)
            }
        }
        return 0
    }

    private static int BuildAndMaybeRun(string entryAm, string outBin, bool verbose, bool runAfter) {
        let rc: int = Program.BuildEntry(entryAm, outBin, verbose, false, "", "")
        if (rc != 0) { return rc }
        Console.WriteLine("✓ Built " + outBin)
        if (runAfter) {
            Console.WriteLine("── running")
            return Process.Run(outBin)
        }
        return 0
    }

    // mtime in nanoseconds, 0 on stat failure (missing file). Used
    // by watch to detect changes without dragging in the full
    // FileWatcher facade (which is now an external package).
    private static int FileMtimeNs(string path) {
        @c {
        #ifdef _WIN32
            struct _stat64 st;
            if (_stat64(path, &st) != 0) return 0;
            return (i64)((int64_t) st.st_mtime * 1000000000LL);
        #else
            struct stat st;
            if (stat(path, &st) != 0) return 0;
            #ifdef __APPLE__
                return (i64)((int64_t) st.st_mtimespec.tv_sec * 1000000000LL + (int64_t) st.st_mtimespec.tv_nsec);
            #else
                return (i64)((int64_t) st.st_mtim.tv_sec * 1000000000LL + (int64_t) st.st_mtim.tv_nsec);
            #endif
        #endif
        }
    }

    private static void SleepMs(int ms) {
        @c {
        #ifdef _WIN32
            Sleep((DWORD) ms);
        #else
            struct timespec ts;
            ts.tv_sec  = (time_t)(ms / 1000);
            ts.tv_nsec = (long)((ms % 1000) * 1000000L);
            nanosleep(&ts, NULL);
        #endif
        }
    }

    // ── fmt subcommand ─────────────────────────────────
    public static int RunFmt(int argc) {
        let ap = new ArgParser()
        ap.Flag("-w").Flag("--write").Flag("-h").Flag("--help").Parse(argc, 2)
        if (ap.HelpRequested()) {
            Console.WriteError("Usage: amc fmt [-w|--write] <file.am>...")
            Console.WriteError("")
            Console.WriteError("Re-emit canonical formatting of Amalgame source files.")
            Console.WriteError("Default: print to stdout. With -w, rewrite each file in place.")
            return 0
        }
        if (String_Length(ap.GetUnknown()) > 0) {
            Console.WriteError("amc fmt: unknown argument '" + ap.GetUnknown() + "'")
            return 1
        }
        let write: bool = ap.HasFlag("-w") || ap.HasFlag("--write")
        let files = ap.GetPositionals()
        let fn: int = files.Count()
        for j in 0..fn {
            let f: string = files.Get(j)
            if (!String_EndsWith(f, ".am")) {
                Console.WriteError("amc fmt: unknown argument '" + f + "'")
                return 1
            }
        }
        if (files.Count() == 0) {
            Console.WriteError("amc fmt: no input .am files")
            return 1
        }
        let n = files.Count()
        for j in 0..n {
            let path = files.Get(j)
            let src  = File.ReadAll(path)
            let lex  = new Lexer(src, path)
            let toks = lex.Tokenize()
            let par  = new Parser(toks)
            let prog = par.Parse()
            if (par.HasErrors()) {
                Console.WriteError("amc fmt: parse errors in " + path)
                Console.WriteError(par.GetErrors())
                return 1
            }
            let fmt = new Formatter(par.Comments)
            let out = fmt.Format(prog)
            if (write) {
                File.WriteAll(path, out)
            } else {
                Console.Write(out)
            }
        }
        return 0
    }

    public static void Main(string[] args) {
        let argc = Args_Count()
        if (argc < 2) {
            Program.PrintUsage()
            Exit_Set(1)
            return
        }
        if (Args_Get(1) == "build") {
            Exit_Set(Program.RunBuild(argc))
            return
        }
        if (Args_Get(1) == "run") {
            Exit_Set(Program.RunRun(argc))
            return
        }
        if (Args_Get(1) == "watch") {
            Exit_Set(Program.RunWatch(argc))
            return
        }
        if (Args_Get(1) == "fmt") {
            Exit_Set(Program.RunFmt(argc))
            return
        }
        if (Args_Get(1) == "doc") {
            Exit_Set(DocCommand.Run(argc))
            return
        }
        if (Args_Get(1) == "test") {
            Exit_Set(Program.RunTest(argc))
            return
        }
        if (Args_Get(1) == "lsp") {
            let server = new LspServer()
            Exit_Set(server.Run())
            return
        }
        if (Args_Get(1) == "dap") {
            let dap = new DapServer()
            Exit_Set(dap.Run())
            return
        }
        if (Args_Get(1) == "migrate") {
            Exit_Set(MigrateCommand.Run(argc))
            return
        }
        if (Args_Get(1) == "generate") {
            Exit_Set(GenerateCommand.Run(argc))
            return
        }
        if (Args_Get(1) == "explain") {
            Exit_Set(ExplainCommand.Run(argc))
            return
        }
        if (Args_Get(1) == "new") {
            Exit_Set(NewCommand.Run(argc))
            return
        }
        if (Args_Get(1) == "monitor") {
            Exit_Set(Program.RunMonitor(argc))
            return
        }
        if (Args_Get(1) == "mcu") {
            Exit_Set(McuCommand.Run(argc))
            return
        }
        // Package-manager commands live under `amc package <X>`
        // (also accepts the short alias `amc pkg <X>`). Centralising
        // every PM verb under one umbrella keeps the top-level
        // command space clear for language ops (compile / fmt /
        // test / lsp / migrate / generate / explain / new) and
        // matches dotnet's / go-mod's grouping convention.
        let v1: string = Args_Get(1)
        if (v1 == "package" || v1 == "pkg") {
            Exit_Set(AddCommand.RunPackage(argc))
            return
        }

        let inputFiles    = new List<string>()
        let externalFiles = new List<string>()
        var outputName    = "a.out"
        var isLib         = false
        var checkOnly     = false
        var lintMode      = false
        var useColor      = false
        var verbose       = true
        // MCU: --target=<mcu> opts into the freestanding embedded profile
        // (docs/proposals/amc-embedded.md). Empty = hosted, unchanged.
        var target        = ""

        var i = 1
        while (i < argc) {
            let a = Args_Get(i)
            if (a == "-o" && i + 1 < argc) {
                i = i + 1
                outputName = Args_Get(i)
            } else if (a == "--external" && i + 1 < argc) {
                // Project F (v0.7.5+): the file is parsed for resolver
                // visibility but its class definitions are NOT emitted in
                // the output .c — they're expected to land at link time
                // from libamalgame.a. Call sites in primary files lower
                // through the file's own namespace mangling rather than
                // the bundle's NsPrefix.
                i = i + 1
                externalFiles.Add(Args_Get(i))
            } else if (a == "--lib") {
                isLib = true
            } else if (String_StartsWith(a, "--target=")) {
                target = String_From(a, 9)
                if (!Program.IsKnownTarget(target)) {
                    Console.WriteError("amc: unknown --target '" + target + "'")
                    Console.WriteError("     known: " + Program.KnownTargets())
                    Exit_Set(1)
                    return
                }
            } else if (a == "--check") {
                checkOnly = true
            } else if (a == "--lint") {
                lintMode = true
            } else if (a == "--color") {
                useColor = true
            } else if (a == "--no-color") {
                useColor = false
            } else if (a == "--quiet") {
                verbose = false
            } else if (a == "--verbose") {
                verbose = true
            } else if (a == "--version") {
                // Build provenance: rev + date are baked at link time
                // by build_amc.sh via -DAMC_GIT_REV / -DAMC_BUILD_DATE.
                // When the defines are missing (someone gcc'd the C
                // snapshot directly), the helpers return "" and we
                // skip the line — never emit a half-rendered banner.
                let rev:  string = BuildInfo.GitRev()
                let date: string = BuildInfo.BuildDate()
                var head:  string = "amc " + PackageRegistry.AmcVersion()
                var prov:  string = ""
                if (String_Length(rev) > 0 && String_Length(date) > 0) {
                    prov = " (commit " + rev + ", built " + date + ")"
                } else if (String_Length(rev) > 0) {
                    prov = " (commit " + rev + ")"
                } else if (String_Length(date) > 0) {
                    prov = " (built " + date + ")"
                }
                Console.WriteLine(head + prov)
                Console.WriteLine("Self-hosted Amalgame compiler.")
                Console.WriteLine("Copyright (c) 2026 Bastien Mouget. License: Apache-2.0.")
                Console.WriteLine("Website:    https://amalgame.me")
                Console.WriteLine("Repository: https://github.com/amalgame-lang/Amalgame")
                Console.WriteLine("Issues:     https://github.com/amalgame-lang/Amalgame/issues")
                Exit_Set(0)
                return
            } else if (a == "--help" || a == "-h") {
                Program.PrintUsage()
                Exit_Set(0)
                return
            } else if (String_EndsWith(a, ".am")) {
                inputFiles.Add(a)
            } else {
                Console.WriteError("amc: unknown option '" + a + "'")
                Program.PrintUsage()
                Exit_Set(1)
                return
            }
            i = i + 1
        }

        if (inputFiles.Count() == 0) {
            Console.WriteError("amc: no input .am files")
            Exit_Set(1)
            return
        }

        let compiler = new AmalgameCompiler()
        compiler.SetLib(isLib)
        compiler.SetCheckOnly(checkOnly)
        compiler.SetLintMode(lintMode)
        compiler.SetColor(useColor)
        compiler.SetVerbose(verbose)
        compiler.SetExternalFiles(externalFiles)
        compiler.SetTarget(target)
        compiler.Run(inputFiles, outputName)
        Exit_Set(compiler.GetExitCode())
    }
}
