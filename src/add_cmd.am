    }

    // ── versions verb ─────────────────────────────────
    //
    // Show all indexed versions of a single package, each with a
    // compat marker against the running amc. Equivalent to the
    // versions block emitted by `amc package search` filtered to
    // one package, but with a shorter command for a known target.
    public static int RunVersions(int argc, int startIdx) {
        var pkgName: string = ""
        var refresh: bool = false
        var jsonOut: bool = false
        var i: int = startIdx
        while (i < argc) {
            let a: string = Args_Get(i)
            if (a == "-h" || a == "--help") {
                Console.WriteError("Usage: amc package versions <name> [--refresh] [--json]")
                Console.WriteError("")
                Console.WriteError("Show indexed versions of <name> with compat against your")
                Console.WriteError("amc " + PackageRegistry.AmcVersion() + ".")
                Console.WriteError("")
                Console.WriteError("--refresh  force re-download of the index (cache TTL 30 min).")
                Console.WriteError("--json     emit machine-readable JSON on stdout (for scripts).")
                return 0
            }
            if (a == "--refresh") {
                refresh = true
            } else if (a == "--json") {
                jsonOut = true
            } else if (String_Length(pkgName) == 0) {
                pkgName = a
            }
            i = i + 1
        }
        if (String_Length(pkgName) == 0) {
            Console.WriteError("amc package versions: missing <name>")
            return 2
        }
        if (refresh) {
            let cachePath: string = AddCommand.IndexCachePath()
            if (File.Exists(cachePath)) {
                let _rm: bool = File.Delete(cachePath)
            }
        }
        let indexSrc: string = AddCommand.FetchIndex()
        if (String_Length(indexSrc) == 0) {
            Console.WriteError("could not fetch packages-index")
            return 1
        }
        let doc = Toml.Parse(indexSrc)
        if (doc.IsNull()) {
            Console.WriteError("packages-index parse error")
            return 1
        }
        // Verify the package is indexed (otherwise output is empty).
        let pkgArr: TomlValue = doc.Get("package")
        if (!pkgArr.IsArray()) {
            Console.WriteError("packages-index has no [[package]] entries")
            return 1
        }
        var found: bool = false
        var urlS: string = ""
        let pn: int = pkgArr.Count()
        for j in 0..pn {
            let p: TomlValue = pkgArr.At(j)
            if (p.Get("name").AsString() == pkgName) {
                found = true
                urlS = p.Get("url").AsString()
            }
        }
        if (!found) {
            Console.WriteError("amc package versions: '" + pkgName + "' not found in packages-index.")
            Console.WriteError("       Use full URL form for unindexed packages:")
            Console.WriteError("       `amc package add github.com/<owner>/<repo>@<tag>`")
            return 1
        }
        let amcVer: string = PackageRegistry.AmcVersion()
        let verArr: TomlValue = doc.Get("version")
        if (jsonOut) {
            AddCommand.PrintVersionsJsonForPackage(verArr, pkgName, urlS, amcVer)
            return 0
        }
        Console.WriteLine(pkgName + " — " + urlS)
        AddCommand.PrintVersionsForPackage(verArr, pkgName, amcVer)
        return 0
    }

    // ── EnsureInstalled (used by amc test) ────────────
    //
    // Walks amalgame.lock and re-installs any [[package]] entry
    // whose cached directory is missing on disk. Idempotent —
    // if the cache is intact, no-op (no network, no clone).
    //
    // Returns the number of packages newly installed (0 means
    // everything was already present). -1 on a hard error.
    //
    // Called at the start of `amc test` so user CI can clone +
    // run without an extra `amc add` step. Same hook applies to
    // any future `amc build` / `amc run` once those land.
    public static int EnsureInstalled() {
        let lockPath: string = "amalgame.lock"
        if (!File.Exists(lockPath)) { return 0 }
        let lockSrc: string = File.ReadAll(lockPath)
        let lockDoc = Toml.Parse(lockSrc)
        if (lockDoc.IsNull()) { return 0 }
        let pkgs: TomlValue = lockDoc.Get("package")
        if (!pkgs.IsArray()) { return 0 }

        let cacheRoot: string = AddCommand.CacheRoot()
        let n: int = pkgs.Count()
        var installed: int = 0
        for i in 0..n {
            let entry: TomlValue = pkgs.At(i)
            let gitV: TomlValue = entry.Get("git")
            let tagV: TomlValue = entry.Get("tag")
            let revV: TomlValue = entry.Get("rev")
            let gitS: string = gitV.AsString()
            let tagS: string = tagV.AsString()
            let revS: string = revV.AsString()
            if (String_Length(gitS) == 0 || String_Length(tagS) == 0) { continue }
            if (String_Length(revS) < 8) { continue }
            let shortSha: string = String_Substring(revS, 0, 8)
            let pkgDir: string = cacheRoot + "/" + gitS + "/" + tagS + "_" + shortSha
            let manifestPath: string = pkgDir + "/amalgame.toml"
            if (File.Exists(manifestPath)) { continue }
            // Missing — install via the shell-out path. Use the
            // same Args_Get(0) trick as RunInstallSpec for path
            // discovery.
            Console.WriteLine("Installing missing dep: " + gitS + "@" + tagS + "...")
            let amcPath0: string = Args_Get(0)
            var amcExe: string = amcPath0
            if (String_Length(amcExe) == 0) { amcExe = "amc" }
            let exit: int = Process_Run("\"" + amcExe + "\" package add \"" + gitS + "@" + tagS + "\"")
            if (exit != 0) {
                Console.WriteError("amc package add failed for " + gitS + "@" + tagS)
                return -1
            }
            installed = installed + 1
        }
        return installed
    }

    // ── amc cache ─────────────────────────────────────
    //
    // `amc cache clear`         — drop the packages-index cache
    //                              so the next `amc add` / `amc
    //                              search` re-fetches from
    //                              raw.githubusercontent.com.
    // `amc cache clear --all`   — also wipe the package cache
    //                              (~/.amalgame/packages/). Next
    //                              `amc add` will re-clone every
    //                              dep from scratch.
    public static int RunCache(int argc, int startIdx) {
        if (argc <= startIdx) {
            Console.WriteError("Usage: amc package cache <subcmd>")
            Console.WriteError("")
            Console.WriteError("Subcommands:")
            Console.WriteError("  clear         drop the packages-index cache")
            Console.WriteError("  clear --all   also wipe ~/.amalgame/packages/")
            return 2
        }
        let sub: string = Args_Get(startIdx)
        if (sub == "clear") {
            var alsoPackages: bool = false
            var helpAsked: bool = false
            var i: int = startIdx + 1
            while (i < argc) {
                let a: string = Args_Get(i)
                if (a == "--all")  { alsoPackages = true }
                if (a == "-h")     { helpAsked = true }
                if (a == "--help") { helpAsked = true }
                i = i + 1
            }
            if (helpAsked) {
                Console.WriteError("Usage: amc cache clear [--all]")
                return 0
            }
            // Always nuke the index cache file.
            let idxPath: string = AddCommand.IndexCachePath()
            let _idxRm: bool = File.Delete(idxPath)
            Console.WriteLine("Cleared packages-index cache (" + idxPath + ")")
            if (alsoPackages) {
                let pkgRoot: string = AddCommand.CacheRoot()
                let _pkgRm: bool = AddCommand.RmRf(pkgRoot)
                Console.WriteLine("Cleared package cache (" + pkgRoot + ")")
                Console.WriteLine("Run `amc add` again to reinstall each dep.")
            }
            return 0
        }
        Console.WriteError("unknown cache subcommand: " + sub)
        return 2
    }

    // ── amc update ────────────────────────────────────
    //
    // `amc update <name>@<tag>` — bump a dep's pinned tag.
    // Internally a remove + add: rewrites amalgame.toml +
    // amalgame.lock to reference the new tag.
    //
    //   amc update redis@v0.3.0
    //
    // For v0.5.1 we don't auto-discover newer tags from the
    // package's git remote — the user names the target tag
    // explicitly. Semver-range driven auto-update is a v0.5.x
    // ask once we add range constraints.
    public static int RunUpdate(int argc, int startIdx) {
        var spec: string = ""
        var i: int = startIdx
        while (i < argc) {
            let a: string = Args_Get(i)
            if (a == "-h" || a == "--help") {
                Console.WriteError("Usage: amc package update <name>@<tag>")
                Console.WriteError("")
                Console.WriteError("Bump the pinned tag for the named dep. Equivalent to")
                Console.WriteError("`amc package remove <name>` then `amc package add <name>@<tag>`.")
                return 0
            }
            if (String_StartsWith(a, "-")) {
                Console.WriteError("unknown flag: " + a)
                return 2
            }
            if (String_Length(spec) == 0) { spec = a }
            i = i + 1
        }
        if (String_Length(spec) == 0) {
            Console.WriteError("usage: amc package update <name>@<tag>")
            return 2
        }
        let atIdx: int = String_LastIndexOf(spec, "@")
        if (atIdx <= 0 || atIdx >= String_Length(spec) - 1) {
            Console.WriteError("expected <name>@<tag> — got '" + spec + "'")
            return 2
        }
        let depName: string = String_Substring(spec, 0, atIdx)
        let newTag:  string = String_Substring(spec, atIdx + 1, String_Length(spec) - atIdx - 1)

        // Verify the dep exists.
        if (!File.Exists("amalgame.toml")) {
            Console.WriteError("no amalgame.toml in cwd — nothing to update")
            return 1
        }
        let tomlSrc: string = File.ReadAll("amalgame.toml")
        let doc = Toml.Parse(tomlSrc)
        if (doc.IsNull()) {
            Console.WriteError("amalgame.toml parse error")
            return 1
        }
        let deps: TomlValue = doc.Get("dependencies")
        if (!deps.IsTable() || !deps.Has(depName)) {
            Console.WriteError("'" + depName + "' is not a declared dependency. Use `amc package add " + spec + "` to install it fresh.")
            return 1
        }
        // Get the existing git URL — we keep the same source,
        // just bump the tag.
        let entry: TomlValue = deps.Get(depName)
        let gitV: TomlValue = entry.Get("git")
        let gitUrl: string = gitV.AsString()
        if (String_Length(gitUrl) == 0) {
            Console.WriteError("dependency '" + depName + "' has no git url — manifest is malformed")
            return 1
        }
        Console.WriteLine("Updating " + depName + " → " + newTag + " (from " + gitUrl + ")")
        // Synthesise the spec `amc add` would have parsed and run
        // its full pipeline. The existing Run() does ResolveShortname
        // → clone → validate → manifest update → lock rebuild.
        // We bypass shortname resolution (gitUrl is already a URL)
        // by passing the URL form directly via Args.
        //
        // Cheap form: just shell out... actually we're already in
        // amc. Better: factor Run() so we can call it with a
        // pre-built spec. For v1 simplicity, write Args[2] via a
        // global is too invasive — just inline by calling the
        // same helpers in order.
        return AddCommand.RunInstallSpec(gitUrl + "@" + newTag)
    }

    // Programmatic entry to the install pipeline — used by amc
    // update (and any future caller that wants to install with
    // an already-resolved URL@tag). Mirrors what Run() does after
    // arg parsing.
    public static int RunInstallSpec(string spec) {
        let parsed: List<string> = AddCommand.ParseSpec(spec)
        if (parsed.Count() != 2) {
            Console.WriteError("RunInstallSpec: malformed spec '" + spec + "'")
            return 2
        }
        let url: string = parsed.Get(0)
        let tag: string = parsed.Get(1)
        if (!AddCommand.IsSafeUrl(url)) { return 2 }
        if (!AddCommand.IsSafeTag(tag)) { return 2 }
        // The rest of the install pipeline is identical to what
        // Run() does — proper refactor (Run() taking a spec
        // parameter) is a v0.5.x ask. For now: shell out to the
        // same amc binary the user invoked. Args_Get(0) is the
        // argv[0] amc was launched with — if a bare name, $PATH
        // resolves it; if a full path, it's used directly. Works
        // cross-platform (no /proc dependency).
        let amcPath: string = Args_Get(0)
        if (String_Length(amcPath) == 0) { amcPath = "amc" }
        return Process_Run("\"" + amcPath + "\" package add \"" + url + "@" + tag + "\"")
    }

    // ── amc list ──────────────────────────────────────
    //
    // List packages installed in the current project's
    // amalgame.lock. Empty / missing lock → friendly "no
    // packages" message, NOT an error (lots of projects don't
    // use any external packages).
    public static int RunList(int argc, int startIdx) {
        let reg = PackageRegistry.Load()
        let n: int = reg.Packages.Count()
        if (n == 0) {
            Console.WriteLine("No packages installed in this project.")
            Console.WriteLine("(no amalgame.lock in cwd, or the lock has no [[package]] entries)")
            return 0
        }
        Console.WriteLine(String_FromInt(n) + " package(s) installed:")
        Console.WriteLine("")
        for i in 0..n {
            let lp: LoadedPackage = reg.Packages.Get(i)
            // 'class' field is the short Amalgame class name; the
            // package's `Name` is the full slug. Show the short
            // class first since that's what users type in code,
            // followed by the resolved git tag (v0.5.5+).
            var headline: string = "  " + lp.ClassName
            if (String_Length(lp.Tag) > 0) {
                headline = headline + " @ " + lp.Tag
            }
            headline = headline + " — " + lp.Name
            Console.WriteLine(headline)
            Console.WriteLine("    namespace: " + lp.Ns)
            Console.WriteLine("    header:    " + lp.Header)
            Console.WriteLine("")
        }
        return 0
    }

    // ── amc remove ────────────────────────────────────
    //
    // Strip a dep from amalgame.toml + amalgame.lock. Does NOT
    // delete the cached package files at
    // `~/.amalgame/packages/...` — those stay so re-installing
    // is instant. v0.5.x `amc gc` will clean unreferenced
    // cache dirs.
    //
    //   amc remove redis
    //   amc remove sqlite mqtt   (multi-arg, all-or-nothing)
    public static int RunRemove(int argc, int startIdx) {
        // Each entry is `<name>` or `<name>@<tag>`. The `@<tag>`
        // form is a safety check — if specified, must match the
        // installed tag, otherwise we refuse to remove (protects
        // against typo'ing the wrong version after an update).
        let toRemove:   List<string> = new List<string>()
        let expectTags: List<string> = new List<string>()   // parallel; "" = any
        var i: int = startIdx
        while (i < argc) {
            let a: string = Args_Get(i)
            if (a == "-h" || a == "--help") {
                Console.WriteError("Usage: amc package remove <dep-name>[@<tag>] [<dep-name>[@<tag>]...]")
                Console.WriteError("")
                Console.WriteError("Strip the named dep(s) from amalgame.toml + amalgame.lock.")
                Console.WriteError("With `@<tag>`, refuse to remove unless the installed tag matches —")
                Console.WriteError("safer than the bare-name form when you're not sure what's pinned.")
                Console.WriteError("Cached package files are kept; a future `amc package gc` verb will")
                Console.WriteError("clean unreferenced cache dirs.")
                return 0
            }
            if (String_StartsWith(a, "-")) {
                Console.WriteError("unknown flag: " + a)
                return 2
            }
            // Optional `@<tag>` suffix.
            let atIdx: int = String_IndexOf(a, "@")
            if (atIdx > 0) {
                toRemove.Add(String_Substring(a, 0, atIdx))
                expectTags.Add(String_Substring(a, atIdx + 1, String_Length(a) - atIdx - 1))
            } else {
                toRemove.Add(a)
                expectTags.Add("")
            }
            i = i + 1
        }
        if (toRemove.Count() == 0) {
            Console.WriteError("usage: amc package remove <dep-name>[@<tag>] [...]")
            return 2
        }

        // Read project's amalgame.toml.
        let tomlPath: string = "amalgame.toml"
        if (!File.Exists(tomlPath)) {
            Console.WriteError("no amalgame.toml in cwd — nothing to remove")
            return 1
        }
        let tomlSrc: string = File.ReadAll(tomlPath)
        let doc = Toml.Parse(tomlSrc)
        if (doc.IsNull()) {
            Console.WriteError("amalgame.toml parse error")
            return 1
        }
        let depsTable: TomlValue = doc.Get("dependencies")
        if (!depsTable.IsTable()) {
            Console.WriteError("amalgame.toml has no [dependencies] table — nothing to remove")
            return 1
        }

        // Verify every name exists + tag matches (if user pinned)
        // before mutating either file.
        let remN: int = toRemove.Count()
        for ri in 0..remN {
            let name: string = toRemove.Get(ri)
            let want: string = expectTags.Get(ri)
            if (!depsTable.Has(name)) {
                Console.WriteError("'" + name + "' is not a declared dependency")
                return 1
            }
            if (String_Length(want) > 0) {
                // Validate the installed tag matches what the user
                // typed. Reads from amalgame.toml's dep entry, not
                // the lockfile, because the toml entry is the SoT
                // for the user's intent.
                let depEntry: TomlValue = depsTable.Get(name)
                let installedTag: string = depEntry.Get("tag").AsString()
                if (installedTag != want) {
                    Console.WriteError("'" + name + "' is pinned to " + installedTag + ", not " + want + " — refusing to remove.")
                    Console.WriteError("       Drop the @<tag> suffix to remove whatever version is installed.")
                    return 1
                }
            }
        }

        // Mutate: build a fresh [dependencies] table that omits
        // the names. Toml.SetEntry doesn't have a Remove, so we
        // rebuild by copying surviving entries.
        let oldKeys: List<string> = depsTable.Keys()
        let oldN: int = oldKeys.Count()
        let newDeps = new TomlValue()
        newDeps.BecomeTable()
        for ki in 0..oldN {
            let k: string = oldKeys.Get(ki)
            var skip: bool = false
            for rj in 0..remN {
                // Extract to a typed local — chained `List.Get(idx)
                // == otherString` confuses the cgen's cross-call
                // return-type inference and silently produces a
                // wrong comparison (gotcha #3).
                let removeName: string = toRemove.Get(rj)
                if (removeName == k) { skip = true }
            }
            if (!skip) {
                let v: TomlValue = depsTable.Get(k)
                newDeps.SetEntry(k, v)
            }
        }
        doc.SetEntry("dependencies", newDeps)
        let out: string = Toml.Serialize(doc)
        let ok: bool = File.WriteAll(tomlPath, out)
        if (!ok) {
            Console.WriteError("could not write amalgame.toml")
            return 1
        }

        // Rewrite amalgame.lock — for v0.5 it's a flat list of
        // [[package]] entries; we rebuild it from the surviving
        // deps' cache manifests so the SHA pins stay coherent.
        let lockPath: string = "amalgame.lock"
        if (File.Exists(lockPath)) {
            AddCommand.RebuildLockFromTomlDeps(newDeps, lockPath)
        }

        // Confirm.
        for ri2 in 0..remN {
            Console.WriteLine("Removed '" + toRemove.Get(ri2) + "' from amalgame.toml + amalgame.lock.")
        }
        Console.WriteLine("(cached files at ~/.amalgame/packages/... were kept — `amc gc` reclaims those)")
        return 0
    }

    // Rebuild the lock file from a [dependencies] table. Walks
    // each dep, looks up its existing cache dir to recover the
    // pinned `rev`, emits a fresh lock. If any dep can't be
    // resolved in the cache, the lock entry is dropped (the
    // next `amc add` will repin).
    public static void RebuildLockFromTomlDeps(TomlValue depsTable, string lockPath) {
        let cacheRoot: string = AddCommand.CacheRoot()
        var out: string = "# amalgame.lock — auto-generated, commit me\n"
        let keys: List<string> = depsTable.Keys()
        let n: int = keys.Count()
        for i in 0..n {
            let depName: string = keys.Get(i)
            let entry: TomlValue = depsTable.Get(depName)
            let gitV: TomlValue = entry.Get("git")
            let tagV: TomlValue = entry.Get("tag")
            let gitS: string = gitV.AsString()
            let tagS: string = tagV.AsString()
            if (String_Length(gitS) == 0 || String_Length(tagS) == 0) { continue }
            // Find the matching cache dir (any <tag>_<sha>).
            let baseDir: string = cacheRoot + "/" + gitS
            let existing: string = AddCommand.FindExistingForTag(baseDir, tagS)
            if (String_Length(existing) == 0) { continue }
            let rev: string = AddCommand.ExtractRevFromDirName(existing)
            // Pad short sha back to 40 chars best-effort; we
            // only stored 8. v0.5.x can probe git for the full
            // SHA at install time.
            out = out + "\n[[package]]\n"
            out = out + "name = \"" + depName + "\"\n"
            out = out + "git  = \"" + gitS + "\"\n"
            out = out + "tag  = \"" + tagS + "\"\n"
            out = out + "rev  = \"" + rev + "\"\n"
        }
        let _ok: bool = File.WriteAll(lockPath, out)
    }

    // ── amc search ────────────────────────────────────
    //
    // `amc search [keyword]` — list packages in the curated
    // index. Filters by substring match against name +
    // description when a keyword is given. No keyword: lists
    // everything. Reuses the same FetchIndex helper as the
    // shortname-resolution path, so the cache is shared.
    public static int RunSearch(int argc, int startIdx) {
        var keyword: string = ""
        var refresh: bool = false
        var noVersions: bool = false
        var i: int = startIdx
        while (i < argc) {
            let a: string = Args_Get(i)
            if (a == "-h" || a == "--help") {
                Console.WriteError("Usage: amc package search [keyword] [--refresh] [--no-versions]")
                Console.WriteError("")
                Console.WriteError("List packages in amalgame-lang/packages-index.")
                Console.WriteError("With a keyword, filter by name + description substring.")
                Console.WriteError("Each match shows its known versions and compat status")
                Console.WriteError("against your amc " + PackageRegistry.AmcVersion() + ".")
                Console.WriteError("")
                Console.WriteError("--refresh       force re-download of the index (cache TTL 30 min).")
                Console.WriteError("--no-versions   omit the per-package versions block — faster browse,")
                Console.WriteError("                useful when you only want names + urls.")
                return 0
            }
            if (a == "--refresh") {
                refresh = true
            } else if (a == "--no-versions") {
                noVersions = true
            } else if (String_Length(keyword) == 0) {
                keyword = a
            }
            i = i + 1
        }
        let kw: string = String_ToLower(keyword)
        if (refresh) {
            let cachePath: string = AddCommand.IndexCachePath()
            if (File.Exists(cachePath)) {
                let _rm: bool = File.Delete(cachePath)
            }
        }
        let indexSrc: string = AddCommand.FetchIndex()
        if (String_Length(indexSrc) == 0) {
            Console.WriteError("could not fetch packages-index")
            return 1
        }
        let doc = Toml.Parse(indexSrc)
        if (doc.IsNull()) {
            Console.WriteError("packages-index parse error")
            return 1
        }
        let pkgArr: TomlValue = doc.Get("package")
        if (!pkgArr.IsArray()) {
            Console.WriteError("packages-index has no [[package]] entries")
            return 1
        }
        let verArr: TomlValue = doc.Get("version")
        let amcVer: string = PackageRegistry.AmcVersion()
        let n: int = pkgArr.Count()
        var matches: int = 0
        for j in 0..n {
            let entry: TomlValue = pkgArr.At(j)
            let nameS:  string = entry.Get("name").AsString()
            let descS:  string = entry.Get("description").AsString()
            let tierS:  string = entry.Get("tier").AsString()
            let urlS:   string = entry.Get("url").AsString()
            let licS:   string = entry.Get("license").AsString()
            var skip: bool = false
            if (String_Length(kw) > 0) {
                let nameL: string = String_ToLower(nameS)
                let descL: string = String_ToLower(descS)
                if (String_IndexOf(nameL, kw) < 0 && String_IndexOf(descL, kw) < 0) {
                    skip = true
                }
            }
            if (skip) { continue }
            let badge: string = "  "
            if (tierS == "official") { badge = "✓ " }
            Console.WriteLine(badge + nameS + " — " + descS)
            Console.WriteLine("    " + urlS + " (" + tierS + ", " + licS + ")")
            if (!noVersions) {
                AddCommand.PrintVersionsForPackage(verArr, nameS, amcVer)
            }
            Console.WriteLine("")
            matches = matches + 1
        }
        if (matches == 0) {
            if (String_Length(kw) > 0) {
                Console.WriteLine("No packages match '" + keyword + "'.")
            } else {
                Console.WriteLine("(packages-index is empty)")
            }
            return 1
        }
        return 0
    }

    // Walk the [[version]] array, filter by `package == pkgName`,
    // and print each tag with a compat marker against `amcVer`.
    // Ordering follows the index file: assumed newest-last (the
    // schema doc tells contributors to append). `--latest` marker
    // goes on the last compatible tag in iteration order.
    public static void PrintVersionsForPackage(TomlValue verArr, string pkgName, string amcVer) {
        if (!verArr.IsArray()) {
            Console.WriteLine("    versions: (no [[version]] entries in index)")
            return
        }
        let n: int = verArr.Count()
        // Two-pass: first collect matching entries so we know which
        // is the latest, then print. Lightweight — N is at most a
        // few per package.
        let tags: List<string> = new List<string>()
        let reqs: List<string> = new List<string>()
        for i in 0..n {
            let entry: TomlValue = verArr.At(i)
            let pkg: string = entry.Get("package").AsString()
            if (pkg != pkgName) { continue }
            let tag: string = entry.Get("tag").AsString()
            let req: string = entry.Get("required-amalgame").AsString()
            if (String_Length(tag) == 0) { continue }
            tags.Add(tag)
            reqs.Add(req)
        }
        let count: int = tags.Count()
        if (count == 0) {
            Console.WriteLine("    versions: (none indexed yet — use full URL form)")
            return
        }
        // Determine the latest compatible tag (last one in iteration
        // order that passes VersionSatisfies). Marker shown next to it.
        var latestCompat: int = -1
        for j in 0..count {
            let req: string = reqs.Get(j)
            if (PackageRegistry.VersionSatisfies(amcVer, req)) {
                latestCompat = j
            }
        }
        Console.WriteLine("    versions:")
        // Iterate newest-first for the user (reverse the file order).
        var k: int = count - 1
        while (k >= 0) {
            let tag: string = tags.Get(k)
            let req: string = reqs.Get(k)
            var line: string = "      " + tag
            var compat: bool = true
            if (String_Length(req) > 0) {
                compat = PackageRegistry.VersionSatisfies(amcVer, req)
            }
            if (compat) {
                line = line + " ✓"
            } else {
                line = line + " ✗"
            }
            if (String_Length(req) > 0) {
                line = line + " (needs amc " + req + ")"
            }
            if (k == latestCompat) {
                line = line + "  ← latest compatible"
            }
            Console.WriteLine(line)
            k = k - 1
        }
    }

    // ── versions --json ──────────────────────────────
    //
    // Same data as PrintVersionsForPackage but emitted as a single
    // JSON object on stdout, so scripts can pipe to jq / parse
    // without scraping the rendered text. Schema kept stable on
    // purpose — additions go to new keys, never rename existing.
    public static void PrintVersionsJsonForPackage(TomlValue verArr, string pkgName, string urlS, string amcVer) {
        let tags: List<string> = new List<string>()
        let reqs: List<string> = new List<string>()
        if (verArr.IsArray()) {
            let n: int = verArr.Count()
            for i in 0..n {
                let entry: TomlValue = verArr.At(i)
                if (entry.Get("package").AsString() != pkgName) { continue }
                let tag: string = entry.Get("tag").AsString()
                if (String_Length(tag) == 0) { continue }
                tags.Add(tag)
                reqs.Add(entry.Get("required-amalgame").AsString())
            }
        }
        let count: int = tags.Count()
        var latestCompat: int = -1
        for j in 0..count {
            if (PackageRegistry.VersionSatisfies(amcVer, reqs.Get(j))) {
                latestCompat = j
            }
        }
        var out: string = "{\n"
        out = out + "  \"package\": \"" + AddCommand.JsonEscape(pkgName) + "\",\n"
        out = out + "  \"url\": \""     + AddCommand.JsonEscape(urlS)    + "\",\n"
        out = out + "  \"amc\": \""     + AddCommand.JsonEscape(amcVer)  + "\",\n"
        out = out + "  \"versions\": ["
        if (count == 0) {
            out = out + "]\n}"
            Console.WriteLine(out)
            return
        }
        out = out + "\n"
        // Emit newest-first (reverse iteration), same order as the
        // text renderer, so jq users see the same ordering.
        var k: int = count - 1
        while (k >= 0) {
            let tag: string = tags.Get(k)
            let req: string = reqs.Get(k)
            var compat: bool = true
            if (String_Length(req) > 0) {
                compat = PackageRegistry.VersionSatisfies(amcVer, req)
            }
            var entryOut: string = "    {"
            entryOut = entryOut + "\"tag\": \"" + AddCommand.JsonEscape(tag) + "\""
            entryOut = entryOut + ", \"required-amalgame\": \"" + AddCommand.JsonEscape(req) + "\""
            if (compat) {
                entryOut = entryOut + ", \"compatible\": true"
            } else {
                entryOut = entryOut + ", \"compatible\": false"
            }
            if (k == latestCompat) {
                entryOut = entryOut + ", \"latest_compatible\": true"
            } else {
                entryOut = entryOut + ", \"latest_compatible\": false"
            }
            entryOut = entryOut + "}"
            if (k > 0) {
                entryOut = entryOut + ","
            }
            out = out + entryOut + "\n"
            k = k - 1
        }
        out = out + "  ]\n}"
        Console.WriteLine(out)
    }

    // ── suggest verb (v0.7.8+) ────────────────────────
    //
    // LSP / IDE integration helper. Given an Amalgame symbol that
    // didn't resolve in the user's project (e.g. `import
    // Amalgame.Crypto` flags `Crypto` as unknown, or `let c: Crypto`
    // hits a missing-type diagnostic), suggest packages from the
    // curated index that expose a matching class or namespace.
    //
    // Matching heuristic (fuzzy on purpose — the LSP can't always
    // tell the user's exact intent):
    //   1. Last segment of a dotted namespace (`Amalgame.Crypto`
    //      → `crypto`, `Amalgame.IO.FileWatcher` → `filewatcher`).
    //   2. Lower-cased class name as-is (`Crypto` → `crypto`).
    //   3. Substring on the package name (`crypt` → `crypto`).
    //   4. Substring on the package description (last-ditch).
    //
    // The first three are scored higher and emitted first; the
    // description-substring fallback only fires when the name
    // matches produced zero results.
    //
    // Output:
    //   - Default: human-readable, same shape as `search` but
    //     framed as suggestions (one-shot, no exhaustive listing).
    //   - --json: stable machine-readable schema for the LSP:
    //       [{ "name": "...", "url": "...", "description": "...",
    //          "tier": "...", "license": "...", "category": "...",
    //          "latest_compatible_tag": "v0.1.0" | "",
    //          "match_reason": "namespace-tail" | "class-name"
    //                       | "name-substring" | "description-substring" }]
    public static int RunSuggest(int argc, int startIdx) {
        var query: string = ""
        var refresh: bool = false
        var jsonOut: bool = false
        var i: int = startIdx
        while (i < argc) {
            let a: string = Args_Get(i)
            if (a == "-h" || a == "--help") {
                Console.WriteError("Usage: amc package suggest <name|namespace> [--json] [--refresh]")
                Console.WriteError("")
                Console.WriteError("Suggest packages from the curated index that match a class")
                Console.WriteError("or namespace. Intended for LSP `using X;` quickfix integration.")
                Console.WriteError("")
                Console.WriteError("Examples:")
                Console.WriteError("  amc package suggest Crypto --json")
                Console.WriteError("  amc package suggest Amalgame.IO.FileWatcher")
                Console.WriteError("  amc package suggest yaml")
                return 0
            }
            if (a == "--refresh") {
                refresh = true
            } else if (a == "--json") {
                jsonOut = true
            } else if (String_Length(query) == 0) {
                query = a
            }
            i = i + 1
        }
        if (String_Length(query) == 0) {
            Console.WriteError("amc package suggest: missing <name|namespace> argument")
            Console.WriteError("Run `amc package suggest --help` for usage.")
            return 2
        }
        // Derive the lookup keys from the query.
        //   "Amalgame.IO.FileWatcher" → tail = "filewatcher"
        //   "Crypto"                   → tail = "crypto" (same)
        //   "yaml"                     → tail = "yaml"
        var tail: string = query
        let lastDot: int = String_LastIndexOf(query, ".")
        if (lastDot >= 0 && lastDot + 1 < String_Length(query)) {
            tail = String_Substring(query, lastDot + 1, String_Length(query) - lastDot - 1)
        }
        let tailL: string = String_ToLower(tail)
        let queryL: string = String_ToLower(query)

        if (refresh) {
            let cachePath: string = AddCommand.IndexCachePath()
            if (File.Exists(cachePath)) {
                let _rm: bool = File.Delete(cachePath)
            }
        }
        let indexSrc: string = AddCommand.FetchIndex()
        if (String_Length(indexSrc) == 0) {
            if (jsonOut) {
                Console.WriteLine("[]")
            } else {
                Console.WriteError("could not fetch packages-index")
            }
            return 1
        }
        let doc = Toml.Parse(indexSrc)
        if (doc.IsNull()) {
            if (jsonOut) {
                Console.WriteLine("[]")
            } else {
                Console.WriteError("packages-index parse error")
            }
            return 1
        }
        let pkgArr: TomlValue = doc.Get("package")
        if (!pkgArr.IsArray()) {
            if (jsonOut) {
                Console.WriteLine("[]")
            } else {
                Console.WriteError("packages-index has no [[package]] entries")
            }
            return 1
        }
        let verArr: TomlValue = doc.Get("version")
        let amcVer: string = PackageRegistry.AmcVersion()

        // Two passes: high-confidence matches first (exact name or
        // tail==name), substring matches second. Description-
        // substring is only consulted when both name passes are empty.
        let matchedNames: List<string>   = new List<string>()
        let matchedReasons: List<string> = new List<string>()
        let n: int = pkgArr.Count()
        for j in 0..n {
            let entry: TomlValue = pkgArr.At(j)
            let nameS:  string = entry.Get("name").AsString()
            let nameL:  string = String_ToLower(nameS)
            if (nameL == tailL && lastDot >= 0) {
                matchedNames.Add(nameS)
                matchedReasons.Add("namespace-tail")
            } else if (nameL == queryL || nameL == tailL) {
                matchedNames.Add(nameS)
                matchedReasons.Add("class-name")
            }
        }
        // Second pass: substring on name (only if no exact match found).
        if (matchedNames.Count() == 0) {
            for j in 0..n {
                let entry: TomlValue = pkgArr.At(j)
                let nameS:  string = entry.Get("name").AsString()
                let nameL:  string = String_ToLower(nameS)
                if (String_IndexOf(nameL, tailL) >= 0) {
                    matchedNames.Add(nameS)
                    matchedReasons.Add("name-substring")
                }
            }
        }
        // Third pass: substring on description (only if name match
        // gave nothing). Lowest signal, surfaced last.
        if (matchedNames.Count() == 0) {
            for j in 0..n {
                let entry: TomlValue = pkgArr.At(j)
                let nameS:  string = entry.Get("name").AsString()
                let descL:  string = String_ToLower(entry.Get("description").AsString())
                if (String_IndexOf(descL, tailL) >= 0) {
                    matchedNames.Add(nameS)
                    matchedReasons.Add("description-substring")
                }
            }
        }

        let mc: int = matchedNames.Count()
        if (jsonOut) {
            var out: string = "["
            if (mc == 0) {
                Console.WriteLine(out + "]")
                return 0
            }
            for k in 0..mc {
                let nm: string = matchedNames.Get(k)
                let reason: string = matchedReasons.Get(k)
                let entry: TomlValue = AddCommand.FindPackageByName(pkgArr, nm)
                let descS:  string = entry.Get("description").AsString()
                let tierS:  string = entry.Get("tier").AsString()
                let urlS:   string = entry.Get("url").AsString()
                let licS:   string = entry.Get("license").AsString()
                let catS:   string = entry.Get("category").AsString()
                let latest: string = AddCommand.LatestCompatibleTag(verArr, nm, amcVer)
                var item: string = "\n  {"
                item = item + "\"name\": \""        + AddCommand.JsonEscape(nm)   + "\","
                item = item + "\"url\": \""         + AddCommand.JsonEscape(urlS) + "\","
                item = item + "\"description\": \"" + AddCommand.JsonEscape(descS)+ "\","
                item = item + "\"tier\": \""        + AddCommand.JsonEscape(tierS)+ "\","
                item = item + "\"license\": \""     + AddCommand.JsonEscape(licS) + "\","
                item = item + "\"category\": \""    + AddCommand.JsonEscape(catS) + "\","
                item = item + "\"latest_compatible_tag\": \"" + AddCommand.JsonEscape(latest) + "\","
                item = item + "\"match_reason\": \"" + AddCommand.JsonEscape(reason) + "\"}"
                if (k + 1 < mc) {
                    item = item + ","
                }
                out = out + item
            }
            out = out + "\n]"
            Console.WriteLine(out)
            return 0
        }
        // Human-readable fallback.
        if (mc == 0) {
            Console.WriteLine("No packages match '" + query + "'.")
            Console.WriteLine("Run `amc package search` to browse the full curated index.")
            return 1
        }
        Console.WriteLine("Suggestions for '" + query + "':")
        Console.WriteLine("")
        for k in 0..mc {
            let nm: string = matchedNames.Get(k)
            let entry: TomlValue = AddCommand.FindPackageByName(pkgArr, nm)
            let descS:  string = entry.Get("description").AsString()
            let urlS:   string = entry.Get("url").AsString()
            let latest: string = AddCommand.LatestCompatibleTag(verArr, nm, amcVer)
            Console.WriteLine("  " + nm + " — " + descS)
            Console.WriteLine("    " + urlS)
            if (String_Length(latest) > 0) {
                Console.WriteLine("    install: amc package add " + nm + "@" + latest)
            } else {
                Console.WriteLine("    install: amc package add " + nm + "  (no compatible tag indexed yet)")
            }
            Console.WriteLine("")
        }
        return 0
    }

    // Walk the [[package]] array and return the entry whose `name`
    // matches `target`. Returns a null TomlValue when not found.
    public static TomlValue FindPackageByName(TomlValue pkgArr, string target) {
        let n: int = pkgArr.Count()
        for i in 0..n {
            let entry: TomlValue = pkgArr.At(i)
            if (entry.Get("name").AsString() == target) {
                return entry
            }
        }
        return new TomlValue()
    }

    // Latest tag for `pkgName` whose `required-amalgame` is satisfied
    // by `amcVer`. Returns "" when none of the indexed tags qualify
    // (or no tags at all). Same iteration / "newest = last" convention
    // used everywhere else in the index.
    public static string LatestCompatibleTag(TomlValue verArr, string pkgName, string amcVer) {
        if (!verArr.IsArray()) { return "" }
        let n: int = verArr.Count()
        var found: string = ""
        for i in 0..n {
            let entry: TomlValue = verArr.At(i)
            if (entry.Get("package").AsString() != pkgName) { continue }
            let tag: string = entry.Get("tag").AsString()
            let req: string = entry.Get("required-amalgame").AsString()
            if (String_Length(tag) == 0) { continue }
            if (String_Length(req) == 0 || PackageRegistry.VersionSatisfies(amcVer, req)) {
                found = tag
            }
        }
        return found
    }

    // Minimal JSON string escape: backslash, double-quote, and the
    // few control chars that show up in URL / description fields.
    // Sufficient for our index payload (no embedded newlines in
    // practice); upgrade to a full Unicode escape if a malicious
    // index entry ever lands.
    public static string JsonEscape(string s) {
        var out: string = String_Replace(s, "\\", "\\\\")
        out = String_Replace(out, "\"", "\\\"")
        out = String_Replace(out, "\n", "\\n")
        out = String_Replace(out, String_FromByte(13), "\\r")  // see lexer.am "\r" workaround
        out = String_Replace(out, "\t", "\\t")
        return out
    }

    // ── info verb ─────────────────────────────────────
    //
    // Detail view for a single indexed package: description, url,
    // tier, license, category, maintainer — plus all known
    // versions (same renderer as `versions`) and whether the
    // package is currently installed in this project.
    //
    // The install lookup matches the `[[package]].url` slug
    // (last path segment) against `LoadedPackage.Name` in
    // amalgame.lock; works for any package installed via the
    // shortname-resolution path.
    public static int RunInfo(int argc, int startIdx) {
        var pkgName: string = ""
        var refresh: bool = false
        var i: int = startIdx
        while (i < argc) {
            let a: string = Args_Get(i)
            if (a == "-h" || a == "--help") {
                Console.WriteError("Usage: amc package info <name> [--refresh]")
                Console.WriteError("")
                Console.WriteError("Show description, url, license, indexed versions and")
                Console.WriteError("install status for a single indexed package.")
                Console.WriteError("")
                Console.WriteError("--refresh  force re-download of the index (cache TTL 30 min).")
                return 0
            }
            if (a == "--refresh") {
                refresh = true
            } else if (String_Length(pkgName) == 0) {
                pkgName = a
            }
            i = i + 1
        }
        if (String_Length(pkgName) == 0) {
            Console.WriteError("amc package info: missing <name>")
            return 2
        }
        if (refresh) {
            let cachePath: string = AddCommand.IndexCachePath()
            if (File.Exists(cachePath)) {
                let _rm: bool = File.Delete(cachePath)
            }
        }
        let indexSrc: string = AddCommand.FetchIndex()
        if (String_Length(indexSrc) == 0) {
            Console.WriteError("could not fetch packages-index")
            return 1
        }
        let doc = Toml.Parse(indexSrc)
        if (doc.IsNull()) {
            Console.WriteError("packages-index parse error")
            return 1
        }
        let pkgArr: TomlValue = doc.Get("package")
        if (!pkgArr.IsArray()) {
            Console.WriteError("packages-index has no [[package]] entries")
            return 1
        }
        var found:  bool   = false
        var descS:  string = ""
        var urlS:   string = ""
        var tierS:  string = ""
        var licS:   string = ""
        var catS:   string = ""
        var maintS: string = ""
        let pn: int = pkgArr.Count()
        for j in 0..pn {
            let p: TomlValue = pkgArr.At(j)
            if (p.Get("name").AsString() == pkgName) {
                found  = true
                descS  = p.Get("description").AsString()
                urlS   = p.Get("url").AsString()
                tierS  = p.Get("tier").AsString()
                licS   = p.Get("license").AsString()
                catS   = p.Get("category").AsString()
                maintS = p.Get("maintainer").AsString()
            }
        }
        if (!found) {
            Console.WriteError("amc package info: '" + pkgName + "' not found in packages-index.")
            Console.WriteError("       For unindexed packages, use the full URL form:")
            Console.WriteError("       `amc package add github.com/<owner>/<repo>@<tag>`")
            return 1
        }
        var badge: string = "  "
        if (tierS == "official") { badge = "✓ " }
        Console.WriteLine(badge + pkgName + " — " + descS)
        Console.WriteLine("  url:        " + urlS)
        if (String_Length(tierS) > 0)  { Console.WriteLine("  tier:       " + tierS) }
        if (String_Length(licS) > 0)   { Console.WriteLine("  license:    " + licS) }
        if (String_Length(catS) > 0)   { Console.WriteLine("  category:   " + catS) }
        if (String_Length(maintS) > 0) { Console.WriteLine("  maintainer: " + maintS) }

        // Installation status — match by URL slug against the
        // lockfile entries.
        let reg = PackageRegistry.Load()
        var installed:    bool   = false
        var installedTag: string = ""
        let urlSlug: string = AddCommand.LastUrlSegment(urlS)
        let np: int = reg.Packages.Count()
        for k in 0..np {
            let lp: LoadedPackage = reg.Packages.Get(k)
            if (lp.Name == urlSlug) {
                installed = true
                installedTag = lp.Tag
            }
        }
        if (installed) {
            if (String_Length(installedTag) > 0) {
                Console.WriteLine("  installed:  yes (" + installedTag + ")")
            } else {
                Console.WriteLine("  installed:  yes")
            }
        } else {
            Console.WriteLine("  installed:  no")
        }

        let amcVer: string = PackageRegistry.AmcVersion()
        let verArr: TomlValue = doc.Get("version")
        AddCommand.PrintVersionsForPackage(verArr, pkgName, amcVer)
        return 0
    }

    // ── outdated verb ─────────────────────────────────
    //
    // Cross-reference amalgame.lock against the packages-index and
    // list installed deps that have a newer compatible tag
    // available. "Compatible" = the tag's required-amalgame field
    // is satisfied by the running amc; otherwise the bump would
    // refuse to install.
    //
    // Output is one line per outdated dep, plus a summary count.
    // Up-to-date deps are silent (typical `make`-style "nothing to
    // say if nothing to do") so the output is easy to grep in CI.
    // Unindexed deps (installed via full URL, not in packages-index)
    // are reported on stderr so they don't pollute the actionable
    // stdout list.
    //
    // Exit code: 0 in every non-error case (informational verb;
    // unlike npm which returns 1 when outdated deps exist, we keep
    // 0 to avoid breaking simple CI invocations that just want the
    // listing).
    public static int RunOutdated(int argc, int startIdx) {
        var refresh: bool = false
        var i: int = startIdx
        while (i < argc) {
            let a: string = Args_Get(i)
            if (a == "-h" || a == "--help") {
                Console.WriteError("Usage: amc package outdated [--refresh]")
                Console.WriteError("")
                Console.WriteError("Compare amalgame.lock against the packages-index and list")
                Console.WriteError("installed deps that have a newer tag whose required-amalgame")
                Console.WriteError("is satisfied by your amc " + PackageRegistry.AmcVersion() + ".")
                Console.WriteError("")
                Console.WriteError("--refresh  force re-download of the index (cache TTL 30 min).")
                return 0
            }
            if (a == "--refresh") {
                refresh = true
            }
            i = i + 1
        }
        let reg = PackageRegistry.Load()
        let np: int = reg.Packages.Count()
        if (np == 0) {
            Console.WriteLine("No packages installed in this project.")
            return 0
        }
        if (refresh) {
            let cachePath: string = AddCommand.IndexCachePath()
            if (File.Exists(cachePath)) {
                let _rm: bool = File.Delete(cachePath)
            }
        }
        let indexSrc: string = AddCommand.FetchIndex()
        if (String_Length(indexSrc) == 0) {
            Console.WriteError("could not fetch packages-index")
            return 1
        }
        let doc = Toml.Parse(indexSrc)
        if (doc.IsNull()) {
            Console.WriteError("packages-index parse error")
            return 1
        }
        let pkgArr: TomlValue = doc.Get("package")
        let verArr: TomlValue = doc.Get("version")
        let amcVer: string = PackageRegistry.AmcVersion()

        // Two-pass: collect outdated lines first so we can print
        // a clean header + count, then the lines, then a footer
        // with the upgrade hint.
        let outNames:   List<string> = new List<string>()
        let outCurrent: List<string> = new List<string>()
        let outLatest:  List<string> = new List<string>()
        let outReq:     List<string> = new List<string>()
        var unindexed:  int = 0

        for k in 0..np {
            let lp: LoadedPackage = reg.Packages.Get(k)
            let slug: string = lp.Name
            // URL slug → shortname via [[package]] match.
            var shortname: string = ""
            if (pkgArr.IsArray()) {
                let pn: int = pkgArr.Count()
                for j in 0..pn {
                    let p: TomlValue = pkgArr.At(j)
                    let u: string = p.Get("url").AsString()
                    if (AddCommand.LastUrlSegment(u) == slug) {
                        shortname = p.Get("name").AsString()
                    }
                }
            }
            if (String_Length(shortname) == 0) {
                Console.WriteError("  skipped (unindexed): " + slug + " @ " + lp.Tag)
                unindexed = unindexed + 1
                continue
            }
            // Walk [[version]] for this shortname newest-last, keep
            // the last-compatible tag we see. That's the candidate
            // upgrade target.
            var latestCompat:    string = ""
            var latestCompatReq: string = ""
            if (verArr.IsArray()) {
                let vn: int = verArr.Count()
                for j in 0..vn {
                    let v: TomlValue = verArr.At(j)
                    if (v.Get("package").AsString() != shortname) { continue }
                    let tag: string = v.Get("tag").AsString()
                    let req: string = v.Get("required-amalgame").AsString()
                    if (PackageRegistry.VersionSatisfies(amcVer, req)) {
                        latestCompat = tag
                        latestCompatReq = req
                    }
                }
            }
            if (String_Length(latestCompat) == 0) { continue }
            // Only report an upgrade when the candidate is strictly
            // newer than the installed tag. If the user is already
            // on or past the latest known tag (e.g. they installed
            // via full URL ahead of the index PR), say nothing.
            if (PackageRegistry.CompareCmp(latestCompat, lp.Tag) <= 0) { continue }
            outNames.Add(shortname)
            outCurrent.Add(lp.Tag)
            outLatest.Add(latestCompat)
            outReq.Add(latestCompatReq)
        }

        let updates: int = outNames.Count()
        if (updates == 0) {
            Console.WriteLine("All " + String_FromInt(np) + " installed package(s) are up to date.")
            return 0
        }
        Console.WriteLine(String_FromInt(updates) + " of " + String_FromInt(np) + " installed package(s) have updates available:")
        Console.WriteLine("")
        // Compute name column width for a poor man's table.
        var maxName: int = 0
        for k in 0..updates {
            let n: int = String_Length(outNames.Get(k))
            if (n > maxName) { maxName = n }
        }
        for k in 0..updates {
            let name: string = outNames.Get(k)
            var pad: string = ""
            let padN: int = maxName - String_Length(name)
            var p: int = 0
            while (p < padN) {
                pad = pad + " "
                p = p + 1
            }
            var line: string = "  " + name + pad + "  " + outCurrent.Get(k) + " → " + outLatest.Get(k)
            let req: string = outReq.Get(k)
            if (String_Length(req) > 0) {
                line = line + "  (needs amc " + req + ")"
            }
            Console.WriteLine(line)
        }
        Console.WriteLine("")
        Console.WriteLine("Run `amc package update <name>@<tag>` to bump.")
        return 0
    }

    // ── check verb ────────────────────────────────────
    //
    // Verify that every [[package]] entry in amalgame.lock has a
    // corresponding intact cache directory under
    // `~/.amalgame/packages/`. Two modes:
    //
    //   `amc package check`           informational; reports
    //                                  missing entries on stderr,
    //                                  exits 0 even on mismatch.
    //                                  Suggests `amc package add`
    //                                  to repair.
    //
    //   `amc package check --frozen`  CI mode; exits 1 on any
    //                                  mismatch. Designed for the
    //                                  fail-fast lane: catches a
    //                                  PR that bumped the lockfile
    //                                  without re-installing.
    //
    // What "match" means: the lock's git + tag + short-sha resolves
    // to a path that exists on disk AND contains an `amalgame.toml`.
    // The cache layout (`<host>/<owner>/<repo>/<tag>_<sha>/`) is the
    // single source of truth — same path EnsureInstalled checks at
    // `amc test` time. No SHA re-verification — that belongs to
    // `amc package add`'s install-time validation.
    public static int RunCheck(int argc, int startIdx) {
        var frozen: bool = false
        var i: int = startIdx
        while (i < argc) {
            let a: string = Args_Get(i)
            if (a == "-h" || a == "--help") {
                Console.WriteError("Usage: amc package check [--frozen]")
                Console.WriteError("")
                Console.WriteError("Verify amalgame.lock matches the installed package cache.")
                Console.WriteError("Reports any [[package]] entry whose cache dir is missing.")
                Console.WriteError("")
                Console.WriteError("--frozen   exit 1 on mismatch (for CI fail-fast). Without it,")
                Console.WriteError("           the verb is informational and always exits 0.")
                return 0
            }
            if (a == "--frozen") {
                frozen = true
            } else if (String_StartsWith(a, "-")) {
                Console.WriteError("unknown flag: " + a)
                return 2
            }
            i = i + 1
        }
        let lockPath: string = "amalgame.lock"
        if (!File.Exists(lockPath)) {
            Console.WriteLine("No amalgame.lock in cwd — nothing to check.")
            return 0
        }
        let lockSrc: string = File.ReadAll(lockPath)
        let lockDoc = Toml.Parse(lockSrc)
        if (lockDoc.IsNull()) {
            Console.WriteError("amalgame.lock parse error")
            return 1
        }
        let pkgs: TomlValue = lockDoc.Get("package")
        if (!pkgs.IsArray()) {
            Console.WriteLine("amalgame.lock has no [[package]] entries — nothing to check.")
            return 0
        }
        let cacheRoot: string = AddCommand.CacheRoot()
        let n: int = pkgs.Count()
        var ok:      int = 0
        var missing: int = 0
        for k in 0..n {
            let entry: TomlValue = pkgs.At(k)
            let gitS: string = entry.Get("git").AsString()
            let tagS: string = entry.Get("tag").AsString()
            let revS: string = entry.Get("rev").AsString()
            if (String_Length(gitS) == 0 || String_Length(tagS) == 0) { continue }
            if (String_Length(revS) < 8) { continue }
            let shortSha: string = String_Substring(revS, 0, 8)
            let pkgDir:   string = cacheRoot + "/" + gitS + "/" + tagS + "_" + shortSha
            let manifest: string = pkgDir + "/amalgame.toml"
            if (File.Exists(manifest)) {
                Console.WriteLine("  ✓ " + gitS + " @ " + tagS + " (sha " + shortSha + ")")
                ok = ok + 1
            } else {
                Console.WriteLine("  ✗ " + gitS + " @ " + tagS + " — cache dir missing")
                Console.WriteLine("       expected: " + pkgDir + "/")
                missing = missing + 1
            }
        }
        Console.WriteLine("")
        if (missing == 0) {
            Console.WriteLine(String_FromInt(ok) + " of " + String_FromInt(ok) + " package(s) match amalgame.lock.")
            return 0
        }
        Console.WriteLine(String_FromInt(missing) + " of " + String_FromInt(ok + missing) + " installed package(s) failed integrity check.")
        Console.WriteLine("Run `amc package add <name>@<tag>` (or `amc test` for auto-repair) to re-install.")
        if (frozen) {
            return 1
        }
        return 0
    }

    // ── notice verb ───────────────────────────────────
    //
    // Generate a NOTICE-style listing of every installed package's
    // licence + authorship. Output to stdout so users can pipe
    // into NOTICE_DEPS.md / a packaging step:
    //
    //   amc package notice > NOTICE_DEPS.md
    //
    // Source of truth is each package's `amalgame.toml`
    // ([package].name / version / license / description / authors),
    // read from the cache dir on disk (LoadedPackage.PkgDir).
    // Bare-name dependencies without a manifest in the cache are
    // skipped with a stderr warning so the report stays clean.
    public static int RunNotice(int argc, int startIdx) {
        var i: int = startIdx
        while (i < argc) {
            let a: string = Args_Get(i)
            if (a == "-h" || a == "--help") {
                Console.WriteError("Usage: amc package notice")
                Console.WriteError("")
                Console.WriteError("Aggregate licence + authorship of every package referenced")
                Console.WriteError("from amalgame.lock. Output is plain text on stdout, ready to")
                Console.WriteError("redirect into NOTICE_DEPS.md for downstream redistribution.")
                Console.WriteError("")
                Console.WriteError("For each package, the matching upstream LICENSE / NOTICE files")
                Console.WriteError("at <PkgDir>/ contain the full licence text — this verb only")
                Console.WriteError("aggregates the metadata, it does not embed the licence bodies.")
                return 0
            }
            if (String_StartsWith(a, "-")) {
                Console.WriteError("unknown flag: " + a)
                return 2
            }
            i = i + 1
        }
        let reg = PackageRegistry.Load()
        let np: int = reg.Packages.Count()
        if (np == 0) {
            Console.WriteError("No packages installed in this project.")
            return 0
        }
        Console.WriteLine("# Third-party Amalgame packages referenced by this project")
        Console.WriteLine("#")
        Console.WriteLine("# Generated by `amc package notice` from amalgame.lock + each")
        Console.WriteLine("# package's amalgame.toml. For the full licence text, consult")
        Console.WriteLine("# the upstream LICENSE / NOTICE files in each repository.")
        Console.WriteLine("")

        let licenses: List<string> = new List<string>()
        for k in 0..np {
            let lp: LoadedPackage = reg.Packages.Get(k)
            let manifestPath: string = lp.PkgDir + "/amalgame.toml"
            if (!File.Exists(manifestPath)) {
                Console.WriteError("warning: missing manifest for " + lp.Name + " — run `amc package add " + lp.Name + "@" + lp.Tag + "` to repair.")
                continue
            }
            let src: string = File.ReadAll(manifestPath)
            let doc = Toml.Parse(src)
            if (doc.IsNull()) {
                Console.WriteError("warning: unparseable manifest at " + manifestPath)
                continue
            }
            let pkgTable: TomlValue = doc.Get("package")
            if (!pkgTable.IsTable()) { continue }
            let manifestName:    string = pkgTable.Get("name").AsString()
            let manifestVersion: string = pkgTable.Get("version").AsString()
            let manifestLicense: string = pkgTable.Get("license").AsString()
            let manifestDesc:    string = pkgTable.Get("description").AsString()
            // [package].authors is an array of strings in v1 manifests
            // (matches Cargo); join with " · " for a compact one-line
            // attribution.
            var authorsJoined: string = ""
            let authorsArr: TomlValue = pkgTable.Get("authors")
            if (authorsArr.IsArray()) {
                let an: int = authorsArr.Count()
                for j in 0..an {
                    let nameEntry: string = authorsArr.At(j).AsString()
                    if (String_Length(nameEntry) == 0) { continue }
                    if (String_Length(authorsJoined) > 0) {
                        authorsJoined = authorsJoined + " · "
                    }
                    authorsJoined = authorsJoined + nameEntry
                }
            }
            // Display the manifest's name + tag (lp.Tag holds the
            // resolved git tag) since the manifest's [package].version
            // tracks the package release, not the git tag literally.
            var headline: string = "## " + manifestName + " " + lp.Tag
            if (String_Length(manifestVersion) > 0 && manifestVersion != String_Substring(lp.Tag, 1, String_Length(lp.Tag) - 1)) {
                // Tag is `v0.1.1`, version is `0.1.1` — match; only
                // surface the version when they disagree (defensive).
                headline = headline + " (manifest version " + manifestVersion + ")"
            }
            Console.WriteLine(headline)
            Console.WriteLine("Source:    " + lp.Name)
            if (String_Length(manifestLicense) > 0) {
                Console.WriteLine("Licence:   " + manifestLicense)
                // Track unique licences for the footer summary.
                var seen: bool = false
                let ln: int = licenses.Count()
                for j in 0..ln {
                    if (licenses.Get(j) == manifestLicense) { seen = true }
                }
                if (!seen) { licenses.Add(manifestLicense) }
            } else {
                Console.WriteLine("Licence:   (not declared — review upstream)")
            }
            if (String_Length(authorsJoined) > 0) {
                Console.WriteLine("Authors:   " + authorsJoined)
            }
            if (String_Length(manifestDesc) > 0) {
                Console.WriteLine("Summary:   " + manifestDesc)
            }
            Console.WriteLine("")
        }

        // Footer summary — count of packages + distinct licences.
        let lc: int = licenses.Count()
        var summary: string = "# " + String_FromInt(np) + " package(s)"
        if (lc == 1) {
            summary = summary + "; 1 distinct licence: " + licenses.Get(0)
        } else if (lc > 1) {
            summary = summary + "; " + String_FromInt(lc) + " distinct licences: "
            for j in 0..lc {
                if (j > 0) { summary = summary + ", " }
                summary = summary + licenses.Get(j)
            }
        }
        Console.WriteLine(summary)
        return 0
    }

    // Strip everything up to and including the last `/` — used to
    // turn `github.com/amalgame-lang/amalgame-database-duckdb`
    // into `amalgame-database-duckdb`, the slug stored on
    // LoadedPackage.Name. Falls back to the full string if no
    // `/` is present.
    public static string LastUrlSegment(string url) {
        let n: int = String_Length(url)
        if (n == 0) { return "" }
        let idx: int = String_LastIndexOf(url, "/")
        if (idx < 0) { return url }
        return String_Substring(url, idx + 1, n - idx - 1)
    }

    // For `amc package add <shortname>` (no @<tag>) — fetch the
    // index, walk the [[version]] entries for this shortname,
    // return the newest tag whose required-amalgame is satisfied
    // by the running amc. Returns "" if no compatible version is
    // found (printing a clear error for the user first). The
    // returned tag does NOT include a leading `@`.
    public static string ResolveLatestCompatible(string shortname) {
        let indexSrc: string = AddCommand.FetchIndex()
        if (String_Length(indexSrc) == 0) {
            Console.WriteError("could not fetch packages-index — auto-resolve needs the index.")
            Console.WriteError("       Specify an explicit @<tag> or run `amc package search " + shortname + " --refresh`.")
            return ""
        }
        let doc = Toml.Parse(indexSrc)
        if (doc.IsNull()) {
            Console.WriteError("packages-index parse error")
            return ""
        }
        let verArr: TomlValue = doc.Get("version")
        if (!verArr.IsArray()) {
            Console.WriteError("packages-index has no [[version]] entries — auto-resolve impossible.")
            Console.WriteError("       Specify an explicit @<tag> or ask the package maintainer to update the index.")
            return ""
        }
        let amcVer: string = PackageRegistry.AmcVersion()
        let n: int = verArr.Count()
        // Walk newest-last (index convention: append on release),
        // track the last compatible tag we see. After the loop,
        // that's the latest compatible.
        var latestCompat: string = ""
        var anyForShortname: bool = false
        for i in 0..n {
            let entry: TomlValue = verArr.At(i)
            if (entry.Get("package").AsString() != shortname) { continue }
            anyForShortname = true
            let tag: string = entry.Get("tag").AsString()
            let req: string = entry.Get("required-amalgame").AsString()
            if (PackageRegistry.VersionSatisfies(amcVer, req)) {
                latestCompat = tag
            }
        }
        if (!anyForShortname) {
            Console.WriteError("'" + shortname + "' not found in packages-index.")
            Console.WriteError("       For unindexed packages, use the full URL form:")
            Console.WriteError("       `amc package add github.com/<owner>/<repo>@<tag>`")
            return ""
        }
        if (String_Length(latestCompat) == 0) {
            Console.WriteError("No version of '" + shortname + "' is compatible with your amc " + amcVer + ".")
            Console.WriteError("       Run `amc package versions " + shortname + "` to see all tags + their constraints.")
            return ""
        }
        return latestCompat
    }

    // Rewrite a `<shortname>@<tag>` spec to its full URL form by
    // consulting the curated index. If the input isn't a
    // shortname (already a URL), or the index can't be fetched,
    // or the shortname isn't listed: pass through unchanged.
    // Always emits a one-line breadcrumb when a rewrite happens.
    public static string ResolveShortname(string spec) {
        let atIdx: int = String_LastIndexOf(spec, "@")
        if (atIdx <= 0) { return spec }
        let n: int = String_Length(spec)
        let lhs: string = String_Substring(spec, 0, atIdx)
        let rhs: string = String_Substring(spec, atIdx + 1, n - atIdx - 1)
        if (!AddCommand.IsShortname(lhs)) { return spec }

        Console.WriteLine("Resolving shortname '" + lhs + "' via amalgame-lang/packages-index...")
        let indexSrc: string = AddCommand.FetchIndex()
        if (String_Length(indexSrc) == 0) {
            Console.WriteError("warning: could not fetch packages-index — passing '" + lhs + "' through as URL")
            return spec
        }
        let doc = Toml.Parse(indexSrc)
        if (doc.IsNull()) {
            Console.WriteError("warning: packages-index could not be parsed — passing through")
            return spec
        }
        let pkgArr: TomlValue = doc.Get("package")
        if (!pkgArr.IsArray()) { return spec }
        let pkgN: int = pkgArr.Count()
        for i in 0..pkgN {
            let entry: TomlValue = pkgArr.At(i)
            let entryName: TomlValue = entry.Get("name")
            if (entryName.AsString() == lhs) {
                let entryUrl: TomlValue = entry.Get("url")
                let entryTier: TomlValue = entry.Get("tier")
                let urlStr: string = entryUrl.AsString()
                let tierStr: string = entryTier.AsString()
                Console.WriteLine("  → " + urlStr + " (" + tierStr + ")")
                return urlStr + "@" + rhs
            }
        }
        Console.WriteError("'" + lhs + "' not found in packages-index — passing through as URL")
        return spec
    }

    // v0.8.49 — Enumerate every cached package's runtime/ directory
    // (newest installed version of each), suitable for gcc -I
    // augmentation when amc auto-includes their headers. Mirrors
    // the cache walk in build_amc.sh + tools/build-stdlib.sh.
    public static List<string> AllCachedRuntimeDirs() {
        let out = new List<string>()
        let cacheRoot: string = AddCommand.CacheRoot()
        let orgRoot: string = cacheRoot + "/github.com/amalgame-lang"
        if (!File.Exists(orgRoot)) { return out }
        // Native readdir — no shelling to `ls` (absent on cmd.exe).
        let lines: List<string> = String_Split(AddCommand.ListDir(orgRoot), "\n")
        let n: int = lines.Count()
        for i in 0..n {
            let repo: string = String_Trim(lines.Get(i))
            if (String_Length(repo) == 0) { continue }
            let dir: string = AddCommand.LatestCacheRuntimeDir(repo)
            if (String_Length(dir) > 0) {
                out.Add(dir)
            }
        }
        return out
    }

    // v0.8.49 — Given a [dependencies] table key like `amalgame-async`,
    // find the cached package's runtime/ directory so it can be
    // added to the gcc -I path when precompiling a sibling package's
    // facade whose runtime header transitively includes it.
    //
    // Strategy: cache layout is
    //   ~/.amalgame/packages/github.com/amalgame-lang/<depKey>/<tag>_<sha>/
    // Pick the newest installed `<tag>_<sha>` (sort -V, semver-aware)
    // and return its `runtime/` subdirectory.
    //
    // Returns "" when:
    //   - third-party dep (no `amalgame-` prefix; we can't guess the
    //     cache path), or
    //   - the package isn't in the cache yet (shouldn't happen given
    //     the v0.8.49 install-before-precompile reorder, but stay
    //     defensive — empty -I is harmless), or
    //   - the cache dir exists but has no runtime/ (header-less
    //     packages — pure-AM with no @c bindings).
    // Declare an already-cached dependency (and, recursively, the deps
    // of its cached manifest) in the project's amalgame.toml, using the
    // cached tag. An entry the project already has is left untouched —
    // the user may have pinned another version on purpose.
    public static void RegisterCachedDep(string depKey, int depth) {
        if (depth > 16) { return }
        let runtimeDir: string = AddCommand.LatestCacheRuntimeDir(depKey)
        if (String_Length(runtimeDir) == 0) { return }
        let depName: string = AddCommand.ShortnameFromDepKey(depKey)
        if (File.Exists("amalgame.toml")) {
            let cur = Toml.Parse(File.ReadAll("amalgame.toml"))
            if (!cur.IsNull()) {
                let curDeps: TomlValue = cur.Get("dependencies")
                if (curDeps.IsTable() && curDeps.Get(depName).IsTable()) { return }
            }
        }
        // <cache>/github.com/amalgame-lang/<depKey>/<tag>_<sha>/runtime
        let pkgDir: string = String_Substring(runtimeDir, 0, String_Length(runtimeDir) - 8)
        let leafStart: int = String_LastIndexOf(pkgDir, "/") + 1
        let leaf: string = String_Substring(pkgDir, leafStart, String_Length(pkgDir) - leafStart)
        let leafParts: List<string> = String_Split(leaf, "_")
        let tag: string = leafParts.Get(0)
        if (!AddCommand.UpdateProjectManifest(depName, "github.com/amalgame-lang/" + depKey, tag)) { return }
        let mfPath: string = pkgDir + "/amalgame.toml"
        if (!File.Exists(mfPath)) { return }
        let mf = Toml.Parse(File.ReadAll(mfPath))
        if (mf.IsNull()) { return }
        let deps: TomlValue = mf.Get("dependencies")
        if (!deps.IsTable()) { return }
        let keys: List<string> = deps.Keys()
        let n: int = keys.Count()
        for i in 0..n {
            let k: string = keys.Get(i)
            if (deps.Get(k).IsString()) { AddCommand.RegisterCachedDep(k, depth + 1) }
        }
    }

    public static string LatestCacheRuntimeDir(string depKey) {
        if (!String_StartsWith(depKey, "amalgame-")) {
            return ""
        }
        let cacheRoot: string = AddCommand.CacheRoot()
        let pkgCacheParent: string = cacheRoot + "/github.com/amalgame-lang/" + depKey
        if (!File.Exists(pkgCacheParent)) {
            return ""
        }
        // Pick the highest semver among cached `<tag>_<sha>` dirs.
        // Native readdir + semver compare — replaces `ls | sort -V |
        // tail -1` (no `ls`/`sort` on cmd.exe). We compare on the
        // tag portion (before the `_<sha>` suffix) so trailing sha
        // hex never leaks into the patch component.
        let entries: List<string> = String_Split(AddCommand.ListDir(pkgCacheParent), "\n")
        var entry: string = ""
        var bestTag: string = ""
        let ne: int = entries.Count()
        for i in 0..ne {
            let cand: string = String_Trim(entries.Get(i))
            if (String_Length(cand) == 0) { continue }
            let candParts: List<string> = String_Split(cand, "_")
            let candTag: string = candParts.Get(0)
            if (String_Length(entry) == 0 || PackageRegistry.CompareCmp(candTag, bestTag) > 0) {
                entry = cand
                bestTag = candTag
            }
        }
        if (String_Length(entry) == 0) { return "" }
        let runtimeDir: string = pkgCacheParent + "/" + entry + "/runtime"
        if (!File.Exists(runtimeDir)) { return "" }
        return runtimeDir
    }

    // v0.8.49 — Resolve a [dependencies] table key like
    // `amalgame-database-nosql-redis` to its packages-index
    // shortname (`redis`) by URL match. Naïve `amalgame-`-prefix
    // stripping is wrong for many packages: it would yield
    // `database-nosql-redis` (no such index entry) and `http`
    // (instead of `net-http`). Index shortnames are curated, not
    // mechanically derivable from the URL slug.
    //
    // Returns:
    //   - the curated shortname when a matching [[package]] entry
    //     is found in the index (URL ends with `/<depKey>`)
    //   - depKey unchanged for third-party deps (no `amalgame-`
    //     prefix) — they keep their own naming
    //   - on index fetch/parse failure, falls back to the legacy
    //     leaf-of-URL (DepNameFromSlug) so existing installs don't
    //     hard-fail offline
    public static string ShortnameFromDepKey(string depKey) {
        if (!String_StartsWith(depKey, "amalgame-")) {
            return depKey
        }
        let indexSrc: string = AddCommand.FetchIndex()
        if (String_Length(indexSrc) == 0) {
            return AddCommand.DepNameFromSlug(depKey)
        }
        let doc = Toml.Parse(indexSrc)
        if (doc.IsNull()) {
            return AddCommand.DepNameFromSlug(depKey)
        }
        let pkgArr: TomlValue = doc.Get("package")
        if (!pkgArr.IsArray()) {
            return AddCommand.DepNameFromSlug(depKey)
        }
        let urlSuffix: string = "/" + depKey
        let n: int = pkgArr.Count()
        for i in 0..n {
            let entry: TomlValue = pkgArr.At(i)
            let url: string = entry.Get("url").AsString()
            if (String_EndsWith(url, urlSuffix)) {
                let name: string = entry.Get("name").AsString()
                if (String_Length(name) > 0) {
                    return name
                }
            }
        }
        // Not in index — last-resort leaf. This path used to be
        // the default before v0.8.49.
        return AddCommand.DepNameFromSlug(depKey)
    }

    // Look for an existing `<tag>_<sha>` directory under baseDir.
    // Returns the absolute path if found, "" otherwise.
    public static string FindExistingForTag(string baseDir, string tag) {
        let prefix: string = tag + "_"
        // Native readdir via the PM's private @c frontier — no `ls`
        // shell-out (cmd.exe has none).
        let lines: List<string> = String_Split(AddCommand.ListDir(baseDir), "\n")
        let n: int = lines.Count()
        for i in 0..n {
            let line: string = lines.Get(i)
            if (String_StartsWith(line, prefix)) {
                return baseDir + "/" + line
            }
        }
        return ""
    }

    public static string ExtractRevFromDirName(string dir) {
        let slash: int = String_LastIndexOf(dir, "/")
        let leaf: string = String_Substring(dir, slash + 1, String_Length(dir) - slash - 1)
        let under: int = String_LastIndexOf(leaf, "_")
        if (under < 0) { return "" }
        return String_Substring(leaf, under + 1, String_Length(leaf) - under - 1)
    }

    // ── Project manifest + lock writers ───────────────

    // Append or update the [dependencies] entry. Reads the current
    // manifest, parses it, mutates, re-serializes. If no manifest
    // exists, creates a minimal one with the dep.
    public static bool UpdateProjectManifest(string depName, string url, string tag) {
        let path: string = "amalgame.toml"
        var doc: TomlValue
        if (File.Exists(path)) {
            let src: string = File.ReadAll(path)
            doc = Toml.Parse(src)
            if (doc.IsNull()) {
                Console.WriteError("could not parse existing amalgame.toml")
                return false
            }
        } else {
            doc = new TomlValue()
            doc.BecomeTable()
        }

        // Ensure [dependencies] exists.
        var deps: TomlValue = doc.Get("dependencies")
        if (!deps.IsTable()) {
            deps = new TomlValue()
            deps.BecomeTable()
            doc.SetEntry("dependencies", deps)
        }

        // The same package may already be declared under another name:
        // `amc package add net-http@…` writes `net-http`, while adding a
        // package that depends on it (web) registers it as `http`. Update
        // that entry instead of adding a twin — two entries for one git
        // URL made the package load twice (struct redefinitions in facades).
        var key: string = depName
        let existing: List<string> = deps.Keys()
        let ne: int = existing.Count()
        for ei in 0..ne {
            let k: string = existing.Get(ei)
            if (k != depName && String_Length(key) > 0 && key == depName) {
                let v: TomlValue = deps.Get(k)
                if (v.IsTable()) {
                    let g: TomlValue = v.Get("git")
                    if (g.IsString() && g.AsString() == url) { key = k }
                }
            }
        }

        // Build the inline-table value: { git = "...", tag = "..." }
        let entry = new TomlValue()
        entry.BecomeTable()
        let gitVal = new TomlValue()
        gitVal.SetString(url)
        let tagVal = new TomlValue()
        tagVal.SetString(tag)
        entry.SetEntry("git", gitVal)
        entry.SetEntry("tag", tagVal)
        deps.SetEntry(key, entry)

        let out: string = Toml.Serialize(doc)
        let ok: bool = File.WriteAll(path, out)
        return ok
    }

    // Lock entries are flat — one [[package]] table per resolved
    // dep with name/git/tag/rev. The lock file is the source of
    // truth at compile time.
    public static bool UpdateLockFile(string depName, string url, string tag, string rev) {
        let path: string = "amalgame.lock"
        // For v0.5 PR 2: we just emit a fresh lock with the single
        // entry. Transitive deps + merge logic land in PR 2b.
        // If the lock already had entries we'd lose them; this is
        // intentional for the simple-add path.
        var out: string = "# amalgame.lock — auto-generated, commit me\n"
        out = out + "\n"
        out = out + "[[package]]\n"
        out = out + "name = \"" + depName + "\"\n"
        out = out + "git  = \"" + url + "\"\n"
        out = out + "tag  = \"" + tag + "\"\n"
        out = out + "rev  = \"" + rev + "\"\n"
        let ok: bool = File.WriteAll(path, out)
        return ok
    }
}
