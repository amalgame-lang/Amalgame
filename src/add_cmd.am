namespace Amalgame.Compiler

import Amalgame.Collections
import Amalgame.IO
import Amalgame.Process
import Amalgame.String
import Amalgame.Formats.Toml

// ═══════════════════════════════════════════════════════
//  add_cmd.am  —  `amc add` subcommand
// ═══════════════════════════════════════════════════════
//
// Installs a package from a Git URL + tag into the user-global
// cache and records it in the project's `amalgame.toml` +
// `amalgame.lock`. Implements PR 2 of the v0.5 package-manager
// rollout — design doc:
//   docs/proposals/amalgame-package-manager.md
//
//   amc package add <git-url>@<tag>
//
//     git-url:  e.g. github.com/amalgame-lang/amalgame-database-sqlite
//               (protocol stripped if present; https:// prepended)
//     tag:      e.g. v0.1.0 (must match the package's
//               [package].version in its manifest)
//
// What this PR ships:
//   - Single-package install (no transitive deps yet)
//   - Cache layout: ~/.amalgame/packages/<host>/<owner>/<repo>/<tag>_<sha>/
//   - amalgame.toml dep entry insertion
//   - amalgame.lock entry insertion with commit SHA pin
//   - Manifest validation: name matches URL slug, version matches
//     tag, license declared, has [package].name + version
//   - Idempotency: re-running with the same spec is a no-op
//
// What's deferred to follow-up PRs within v0.5:
//   - Transitive dep resolution (PR 2b)
//   - Conflict / cycle detection (PR 2b)
//   - amalgame-lang/packages-index shortname lookup (PR 2c)
//   - amc remove / update / list / search (PR 2d)
//   - Path deps `{ path = "../foo" }` (PR 2e)
//   - sha256 tarball verification (post-v0.5; not needed for git
//     deps since the commit SHA is already content-addressable)
//
// ── Filesystem frontier ──────────────────────────────────
// The package manager mutates the cache (create/move/delete dirs,
// enumerate entries). It used to shell out to `mkdir -p`/`rm -rf`/
// `mv`/`ls`, which don't exist on Windows' cmd.exe. The rich,
// public home for filesystem ops is the `amalgame-io-filesystem`
// package — but amc's own source can't import a package (that would
// be a bootstrap cycle: `amc package add` needs FS ops, and the
// package providing them is fetched *by* `amc package add`). So the
// compiler carries its own private @c frontier here, mirroring the
// package's POSIX opendir / Windows FindFirstFile implementation.
@c {
    #include <string.h>
    #include <stdlib.h>
    #include <sys/stat.h>
    #include <errno.h>
    #ifdef _WIN32
        #include <windows.h>
        #include <direct.h>
    #else
        #include <dirent.h>
        #include <unistd.h>
    #endif

    /* Recursive mkdir — POSIX `mkdir -p`. Walks each prefix segment,
     * ignoring EEXIST. Returns 1 on success, 0 on a hard error. */
    static int amalgame_pm_mkdirp(const char* path) {
        if (!path || !*path) return 0;
        size_t len = strlen(path);
        char* buf = (char*) GC_MALLOC(len + 1);
        memcpy(buf, path, len + 1);
        size_t start = 1;
    #ifdef _WIN32
        if (len >= 2 && buf[1] == ':') {
            start = (len >= 3 && (buf[2] == '\\' || buf[2] == '/')) ? 3 : 2;
        }
    #endif
        for (size_t i = start; i <= len; i++) {
            char c = (i < len) ? buf[i] : '\0';
            if (i == len || c == '/' || c == '\\') {
                buf[i] = '\0';
                int rc;
    #ifdef _WIN32
                rc = _mkdir(buf);
    #else
                rc = mkdir(buf, 0755);
    #endif
                buf[i] = c;
                if (rc != 0 && errno != EEXIST) return 0;
            }
        }
        return 1;
    }

    /* Recursive delete — POSIX `rm -rf`. Missing path = success
     * (idempotent). Returns 1 on success, 0 on a hard error. */
    static int amalgame_pm_rmrf(const char* path) {
        if (!path || !*path) return 0;
        struct stat st;
        if (stat(path, &st) != 0) return 1; /* already gone */
        if (!S_ISDIR(st.st_mode)) {
    #ifdef _WIN32
            /* git leaves pack files read-only; remove()/DeleteFile fail on
             * those unless we clear the attribute first — otherwise the
             * parent dir stays non-empty and RemoveDirectory fails, leaving
             * a half-deleted cache entry. */
            SetFileAttributesA(path, FILE_ATTRIBUTE_NORMAL);
    #endif
            return remove(path) == 0 ? 1 : 0;
        }
        size_t plen = strlen(path);
    #ifdef _WIN32
        {
            char* pattern = (char*) GC_MALLOC(plen + 3);
            memcpy(pattern, path, plen);
            pattern[plen] = '\\'; pattern[plen+1] = '*'; pattern[plen+2] = '\0';
            WIN32_FIND_DATAA fd;
            HANDLE h = FindFirstFileA(pattern, &fd);
            if (h != INVALID_HANDLE_VALUE) {
                do {
                    if (strcmp(fd.cFileName, ".") == 0)  continue;
                    if (strcmp(fd.cFileName, "..") == 0) continue;
                    size_t nl = strlen(fd.cFileName);
                    char* child = (char*) GC_MALLOC(plen + 1 + nl + 1);
                    memcpy(child, path, plen);
                    child[plen] = '\\';
                    memcpy(child + plen + 1, fd.cFileName, nl + 1);
                    amalgame_pm_rmrf(child);
                } while (FindNextFileA(h, &fd));
                FindClose(h);
            }
            SetFileAttributesA(path, FILE_ATTRIBUTE_NORMAL);
            return RemoveDirectoryA(path) ? 1 : 0;
        }
    #else
        {
            DIR* d = opendir(path);
            if (d) {
                struct dirent* e;
                while ((e = readdir(d)) != NULL) {
                    if (strcmp(e->d_name, ".") == 0)  continue;
                    if (strcmp(e->d_name, "..") == 0) continue;
                    size_t nl = strlen(e->d_name);
                    char* child = (char*) GC_MALLOC(plen + 1 + nl + 1);
                    memcpy(child, path, plen);
                    child[plen] = '/';
                    memcpy(child + plen + 1, e->d_name, nl + 1);
                    amalgame_pm_rmrf(child);
                }
                closedir(d);
            }
            return rmdir(path) == 0 ? 1 : 0;
        }
    #endif
    }

    /* Rename/move within a volume — `mv`. 1 on success, 0 on error. */
    static int amalgame_pm_rename(const char* from, const char* to) {
        if (!from || !to) return 0;
        return rename(from, to) == 0 ? 1 : 0;
    }

    /* Directory entry names (excluding "." / ".."), one per line with a
     * trailing newline — like `ls -1`. "" for a missing/unreadable dir.
     * Order is filesystem-native; callers sort if needed. */
    static char* amalgame_pm_listdir(const char* path) {
        size_t cap = 256, len = 0;
        char* out = (char*) GC_MALLOC(cap);
        out[0] = '\0';
        if (!path || !*path) return out;
    #ifdef _WIN32
        {
            size_t plen = strlen(path);
            char* pattern = (char*) GC_MALLOC(plen + 3);
            memcpy(pattern, path, plen);
            pattern[plen] = '\\'; pattern[plen+1] = '*'; pattern[plen+2] = '\0';
            WIN32_FIND_DATAA fd;
            HANDLE h = FindFirstFileA(pattern, &fd);
            if (h == INVALID_HANDLE_VALUE) return out;
            do {
                if (strcmp(fd.cFileName, ".") == 0)  continue;
                if (strcmp(fd.cFileName, "..") == 0) continue;
                size_t nl = strlen(fd.cFileName);
                if (len + nl + 2 > cap) {
                    while (len + nl + 2 > cap) cap *= 2;
                    char* n2 = (char*) GC_MALLOC(cap);
                    memcpy(n2, out, len + 1); out = n2;
                }
                memcpy(out + len, fd.cFileName, nl); len += nl;
                out[len++] = '\n'; out[len] = '\0';
            } while (FindNextFileA(h, &fd));
            FindClose(h);
        }
    #else
        {
            DIR* d = opendir(path);
            if (!d) return out;
            struct dirent* e;
            while ((e = readdir(d)) != NULL) {
                if (strcmp(e->d_name, ".") == 0)  continue;
                if (strcmp(e->d_name, "..") == 0) continue;
                size_t nl = strlen(e->d_name);
                if (len + nl + 2 > cap) {
                    while (len + nl + 2 > cap) cap *= 2;
                    char* n2 = (char*) GC_MALLOC(cap);
                    memcpy(n2, out, len + 1); out = n2;
                }
                memcpy(out + len, e->d_name, nl); len += nl;
                out[len++] = '\n'; out[len] = '\0';
            }
            closedir(d);
        }
    #endif
        return out;
    }
}

public class AddCommand {

    public AddCommand() {}

    // ── Private filesystem helpers (see the @c frontier above) ──
    // Native, shell-free FS ops the package manager needs. The public
    // FS API lives in the amalgame-io-filesystem package; these are the
    // compiler's bootstrap-safe equivalents.

    // Recursive mkdir (`mkdir -p`). True on success.
    static bool MkdirP(path: string) {
        var r: int = 0
        @c { r = (i64) amalgame_pm_mkdirp(path); }
        return r != 0
    }

    // Recursive delete (`rm -rf`). Missing path = success. True on success.
    static bool RmRf(path: string) {
        var r: int = 0
        @c { r = (i64) amalgame_pm_rmrf(path); }
        return r != 0
    }

    // Rename/move within a volume (`mv`). True on success.
    static bool RenamePath(from: string, to: string) {
        var r: int = 0
        @c { r = (i64) amalgame_pm_rename(from, to); }
        return r != 0
    }

    // Directory entry names (excluding "."/".."), newline-joined like
    // `ls -1`. Callers String_Split(out, "\n") + Trim.
    static string ListDir(path: string) {
        @c { return amalgame_pm_listdir(path); }
    }

    public static void PrintUsage() {
        Console.WriteError("Usage: amc package add <spec>... [--no-precompile]")
        Console.WriteError("")
        Console.WriteError("Install one or more Amalgame packages into the user cache and")
        Console.WriteError("record them in amalgame.toml + amalgame.lock. Multiple specs")
        Console.WriteError("install in order and stop on the first failure.")
        Console.WriteError("")
        Console.WriteError("Two spec forms:")
        Console.WriteError("  <shortname>[@<tag>]   resolved via amalgame-lang/packages-index.")
        Console.WriteError("                        When @<tag> is omitted, the latest tag whose")
        Console.WriteError("                        [package].required-amalgame is satisfied by")
        Console.WriteError("                        your running amc is picked automatically.")
        Console.WriteError("  <git-url>@<tag>       full git URL form for unindexed packages;")
        Console.WriteError("                        @<tag> is mandatory (no auto-resolve).")
        Console.WriteError("")
        Console.WriteError("Examples:")
        Console.WriteError("  amc package add duckdb                              # auto-resolve")
        Console.WriteError("  amc package add sqlite@v0.2.0")
        Console.WriteError("  amc package add github.com/foo/bar@v1.2.3")
        Console.WriteError("  amc package add ui-sdl ui-forms                     # multi-spec")
        Console.WriteError("")
        Console.WriteError("Cache: ~/.amalgame/packages/<host>/<owner>/<repo>/<tag>_<sha>/")
        Console.WriteError("")
        Console.WriteError("Validation performed on install:")
        Console.WriteError("  - manifest amalgame.toml exists at repo root")
        Console.WriteError("  - [package].name matches the URL repo slug")
        Console.WriteError("  - [package].version matches the tag")
        Console.WriteError("  - [package].license is declared")
        Console.WriteError("  - [package].required-amalgame (if present) is satisfied by")
        Console.WriteError("    the running amc. Supports >=, >, <, <=, =, ^, ~, and bare")
        Console.WriteError("    (treated as >= for back-compat).")
        Console.WriteError("")
        Console.WriteError("Flags:")
        Console.WriteError("  --no-precompile   Skip install-time compile even if the package's")
        Console.WriteError("                    manifest opts in via [stdlib].precompile = true.")
        Console.WriteError("                    Useful in CI batch installs where you want to")
        Console.WriteError("                    separate install from build.")
        Console.WriteError("  -h, --help        Print this help and exit.")
    }

    public static int Run(int argc, int startIdx) {
        var specs: List<string> = new List<string>()
        var noPrecompile: bool = false
        var i: int = startIdx
        while (i < argc) {
            let a: string = Args_Get(i)
            if (a == "-h" || a == "--help") {
                AddCommand.PrintUsage()
                return 0
            }
            if (a == "--no-precompile") {
                noPrecompile = true
                i = i + 1
                continue
            }
            if (String_StartsWith(a, "-")) {
                Console.WriteError("unknown flag: " + a)
                AddCommand.PrintUsage()
                return 2
            }
            // Multi-spec: collect positional args as separate
            // packages. `amc package add ui-sdl ui-forms` is
            // equivalent to running RunOne twice in sequence;
            // the loop bails on the first install error so the
            // user sees the failing package, not a cascade.
            specs.Add(a)
            i = i + 1
        }
        if (specs.Count() == 0) {
            Console.WriteError("missing <git-url>@<tag> or <shortname>")
            AddCommand.PrintUsage()
            return 2
        }

        let nSpecs: int = specs.Count()
        var si: int = 0
        while (si < nSpecs) {
            let s: string = specs.Get(si)
            if (nSpecs > 1) {
                Console.WriteLine("── Installing " + s + " (" + String_FromInt(si + 1) + "/" + String_FromInt(nSpecs) + ") ──")
            }
            let rc: int = AddCommand.RunOne(s, noPrecompile)
            if (rc != 0) { return rc }
            si = si + 1
        }
        return 0
    }

    // Install a single package. Extracted from Run() so the
    // dispatcher can loop over multiple specs without breaking
    // the existing flow (auto-resolve → clone → validate →
    // precompile → toml update → lock rebuild).
    public static int RunOne(string spec, bool noPrecompile) {

        // ── 1a. Auto-resolve tag if user dropped @<tag> ───
        // `amc package add duckdb` (no tag) → fetch index, pick
        // the newest version whose required-amalgame is satisfied
        // by the running amc. Only works for indexed shortnames;
        // full git URLs still need an explicit @<tag>.
        var workingSpec: string = spec
        let hasAt: int = String_IndexOf(spec, "@")
        if (hasAt < 0) {
            if (!AddCommand.IsShortname(spec)) {
                Console.WriteError("'" + spec + "' is a git URL — it needs an explicit @<tag>.")
                Console.WriteError("       Auto-resolve (no @<tag>) only works for indexed shortnames.")
                return 2
            }
            let resolvedTag: string = AddCommand.ResolveLatestCompatible(spec)
            if (String_Length(resolvedTag) == 0) {
                // ResolveLatestCompatible printed the error already.
                return 1
            }
            workingSpec = spec + "@" + resolvedTag
            Console.WriteLine("Auto-resolved '" + spec + "' → '" + spec + "@" + resolvedTag + "' (latest compatible with amc " + PackageRegistry.AmcVersion() + ")")
        }

        // ── 1b. Resolve shortname if applicable ────────────
        // `amc package add redis@v0.2.0` looks the shortname up via the
        // amalgame-lang/packages-index repo and rewrites to the
        // full git URL. URLs (anything containing `/` or `.` in
        // the part before `@`) skip the lookup.
        let resolvedSpec: string = AddCommand.ResolveShortname(workingSpec)

        // ── 2. Parse spec ─────────────────────────────────
        let parsed: List<string> = AddCommand.ParseSpec(resolvedSpec)
        if (parsed.Count() != 2) {
            Console.WriteError("expected <git-url>@<tag> or <shortname>@<tag> — got '" + spec + "'")
            return 2
        }
        let url: string = parsed.Get(0)
        let tag: string = parsed.Get(1)
        if (!AddCommand.IsSafeUrl(url)) {
            Console.WriteError("rejected url '" + url + "' — only [A-Za-z0-9./_:-] allowed")
            return 2
        }
        if (!AddCommand.IsSafeTag(tag)) {
            Console.WriteError("rejected tag '" + tag + "' — only [A-Za-z0-9._+-] allowed")
            return 2
        }

        // Slug + name derivation from URL: last path segment.
        let pkgName: string = AddCommand.SlugFromUrl(url)
        if (String_Length(pkgName) == 0) {
            Console.WriteError("could not derive package name from url '" + url + "'")
            return 2
        }
        // Pick the user-facing dep handle. Convention: for
        // `amalgame-<...>-leaf` repo names that mirror namespaces
        // (e.g. `amalgame-database-sqlite` for `Amalgame.Database.SQLite`),
        // collapse to the leaf so the user writes `sqlite = {...}`
        // in their manifest. Third-party packages keep their slug.
        // Manifest validation still checks against the full slug.
        let depName: string = AddCommand.DepNameFromSlug(pkgName)

        Console.WriteLine("Resolving " + url + "@" + tag + "...")

        // ── 2. Cache path (before clone, sha unknown yet) ──
        let cacheRoot: string = AddCommand.CacheRoot()
        let baseDir: string = cacheRoot + "/" + url
        // Ensure the parent path exists. Native recursive mkdir — no
        // shelling out to `mkdir -p` (cmd.exe has no such flag).
        let _mk: bool = AddCommand.MkdirP(baseDir)

        // ── 3. Clone if not yet cached ────────────────────
        // We tag the directory by `<tag>_<short_sha>` once we know the
        // SHA. To avoid cloning twice, we clone first to a tmp dir
        // keyed by tag, look up the SHA, then rename. If a directory
        // already exists for <tag>_* we reuse it.
        let existingDir: string = AddCommand.FindExistingForTag(baseDir, tag)
        var pkgDir: string = ""
        var rev: string = ""
        if (String_Length(existingDir) > 0) {
            pkgDir = existingDir
            rev = AddCommand.ExtractRevFromDirName(pkgDir)
            Console.WriteLine("Already cached at " + pkgDir)
        } else {
            let tmpDir: string = baseDir + "/" + tag + "_clone"
            // Wipe any stale tmp from a previous failed run.
            let _wipe: bool = AddCommand.RmRf(tmpDir)
            Console.WriteLine("Cloning into " + tmpDir + "...")
            // git is a real program on every platform; only the quoting
            // must be portable — double quotes work in both cmd.exe and sh.
            let cloneCmd: string = "git clone --depth 1 --branch \"" + tag + "\" \"https://" + url + ".git\" \"" + tmpDir + "\" 2>&1"
            let cloneExit: int = Process_Run(cloneCmd)
            if (cloneExit != 0) {
                Console.WriteError("git clone failed (exit " + String_FromInt(cloneExit) + ")")
                let _wipe2: bool = AddCommand.RmRf(tmpDir)
                return 1
            }
            // Resolve the SHA of the cloned tip.
            let revRes = Process_RunCapture("git -C \"" + tmpDir + "\" rev-parse HEAD 2>&1")
            if (revRes.Exit != 0) {
                Console.WriteError("git rev-parse failed: " + revRes.Stdout)
                let _wipe3: bool = AddCommand.RmRf(tmpDir)
                return 1
            }
            rev = String_Trim(revRes.Stdout)
            if (String_Length(rev) < 7) {
                Console.WriteError("invalid HEAD sha: '" + rev + "'")
                let _wipe4: bool = AddCommand.RmRf(tmpDir)
                return 1
            }
            let shortSha: string = String_Substring(rev, 0, 8)
            pkgDir = baseDir + "/" + tag + "_" + shortSha
            // Move tmp → final — native rename, no `mv`.
            if (!AddCommand.RenamePath(tmpDir, pkgDir)) {
                Console.WriteError("could not finalize cache directory")
                return 1
            }
            // Drop the .git dir — we don't need it past validation.
            let _gitWipe: bool = AddCommand.RmRf(pkgDir + "/.git")
        }

        // ── 4. Read + validate package manifest ────────────
        let manifestPath: string = pkgDir + "/amalgame.toml"
        if (!File.Exists(manifestPath)) {
            Console.WriteError("not an Amalgame package: missing " + manifestPath)
            return 1
        }
        let manifestSrc: string = File.ReadAll(manifestPath)
        let parser = new TomlParser(manifestSrc)
        let manifest: TomlValue = Toml.ParseWithError(manifestSrc, parser)
        if (parser.HasError) {
            Console.WriteError("malformed amalgame.toml: " + parser.ErrMsg)
            return 1
        }
        let pkgTable: TomlValue = manifest.Get("package")
        if (!pkgTable.IsTable()) {
            Console.WriteError("amalgame.toml missing [package] table")
            return 1
        }
        let mfName: TomlValue = pkgTable.Get("name")
        let mfVer: TomlValue  = pkgTable.Get("version")
        let mfLic: TomlValue  = pkgTable.Get("license")
        let mfNameStr: string = mfName.AsString()
        let mfVerStr:  string = mfVer.AsString()
        let mfLicStr:  string = mfLic.AsString()
        if (String_Length(mfNameStr) == 0) {
            Console.WriteError("amalgame.toml missing [package].name")
            return 1
        }
        if (String_Length(mfVerStr) == 0) {
            Console.WriteError("amalgame.toml missing [package].version")
            return 1
        }
        if (String_Length(mfLicStr) == 0) {
            Console.WriteError("amalgame.toml missing [package].license — declare your distribution licence")
            return 1
        }
        // `required-amalgame` is optional; when present, gate the
        // install on the running amc satisfying the constraint.
        // Catches the "package needs newer compiler than installed"
        // class of error up-front rather than via a mysterious
        // gcc symbol-not-found at link time.
        let mfReq: TomlValue = pkgTable.Get("required-amalgame")
        let mfReqStr: string = mfReq.AsString()
        if (String_Length(mfReqStr) > 0) {
            let amc: string = PackageRegistry.AmcVersion()
            if (!PackageRegistry.VersionSatisfies(amc, mfReqStr)) {
                Console.WriteError("amalgame-" + mfNameStr + " " + tag + " requires amc " + mfReqStr)
                Console.WriteError("       your amc is " + amc + " — upgrade and retry")
                return 1
            }
        }
        // `schema-version` is optional; default 1. Packages
        // declaring a higher value than this amc supports are
        // rejected here — the loader (PackageRegistry.LoadFrom)
        // will also silently skip them as a second line of defence,
        // but emitting a clear error at install time avoids the
        // "package installed but invisible at compile" trap.
        let mfSchema: TomlValue = pkgTable.Get("schema-version")
        let mfSchemaInt: int = mfSchema.AsInt()
        let supported: int = PackageRegistry.SupportedManifestSchema()
        if (mfSchemaInt > supported) {
            Console.WriteError("amalgame-" + mfNameStr + " " + tag + " requires manifest schema v" + String_FromInt(mfSchemaInt))
            Console.WriteError("       your amc supports up to v" + String_FromInt(supported) + " — upgrade and retry")
            return 1
        }
        if (mfNameStr != pkgName) {
            Console.WriteError("manifest name '" + mfNameStr + "' does not match URL slug '" + pkgName + "'")
            return 1
        }
        // Accept either the bare version ("0.0.4") or the same with a
        // `-dev` pre-release suffix ("0.0.4-dev"). Several packages —
        // including amalgame-ui-web — never bump the manifest from
        // "<next>-dev" to the release-bare form before tagging because
        // their release flow is "tag once at the end of the dev cycle";
        // failing the install in that case is more noise than safety.
        // Versions that don't match even after stripping `-dev` (e.g.
        // 0.0.5-dev at tag v0.0.4) stay a hard failure since they
        // suggest the manifest belongs to a different release entirely.
        let expectedVer: string = AddCommand.StripV(tag)
        var mfBase: string = mfVerStr
        if (String_EndsWith(mfBase, "-dev")) {
            mfBase = String_Substring(mfBase, 0, String_Length(mfBase) - 4)
        }
        if (mfBase != expectedVer) {
            Console.WriteError("manifest version '" + mfVerStr + "' does not match tag '" + tag + "' (expected '" + expectedVer + "' or '" + expectedVer + "-dev')")
            return 1
        }

        Console.WriteLine("Validated " + mfNameStr + " v" + mfVerStr + " (licence " + mfLicStr + ")")
        Console.WriteLine("Cached at " + pkgDir)

        // ── 4d. Transitive deps (amc v0.8.39+) ───────────
        // v0.8.49: moved BEFORE precompile (4b). Rationale: when this
        // package's runtime header `#include`s a transitive dep's
        // header (e.g. net-http's Amalgame_Net_Http.h includes
        // amalgame-async's Amalgame_Async.h since v0.9.1), the
        // precompile step needs the dep's runtime/ on gcc's -I path.
        // If we precompile first, the dep isn't installed yet → gcc
        // fails. Installing transitives first puts them in the cache
        // so PrecompileFacade's -I walk (also added in v0.8.49) can
        // see them.
        //
        // Schema (compatible with the consumer-level [dependencies]
        // form amc uses to track direct user deps):
        //
        //   [dependencies]
        //   amalgame-crypto = ">=0.3.0"      # short form
        //
        //   [dependencies.crypto]            # long form
        //   git = "github.com/amalgame-lang/amalgame-crypto"
        //   tag = "v0.3.0"
        //
        // The short form is preferred for transitive deps — it lets
        // amc auto-resolve through the packages index. The long form
        // is supported as a fallback for non-indexed git URLs.
        let depsTable: TomlValue = manifest.Get("dependencies")
        if (depsTable.IsTable()) {
            let depKeys: List<string> = depsTable.Keys()
            let ndep: int = depKeys.Count()
            for di in 0..ndep {
                let depKey: string = depKeys.Get(di)
                let depVal: TomlValue = depsTable.Get(depKey)
                var transSpec: string = ""
                if (depVal.IsString()) {
                    // Short form: `amalgame-crypto = ">=0.3.0"`.
                    // Resolve the package name to its packages-index
                    // shortname (curated, not mechanically derivable).
                    // ShortnameFromDepKey looks up the URL in the
                    // index — handles cases where the shortname has
                    // multiple dash-segments (`net-http`,
                    // `io-filewatcher`) or differs from the URL leaf
                    // (`amalgame-database-nosql-redis` → `redis`).
                    transSpec = AddCommand.ShortnameFromDepKey(depKey)
                } else if (depVal.IsTable()) {
                    let depGit: string = depVal.Get("git").AsString()
                    let depTag: string = depVal.Get("tag").AsString()
                    if (String_Length(depGit) > 0 && String_Length(depTag) > 0) {
                        transSpec = depGit + "@" + depTag
                    }
                }
                if (String_Length(transSpec) == 0) {
                    Console.WriteError("[" + mfNameStr + "]: unrecognised dependency entry: " + depKey)
                    return 1
                }
                // If this dep is already installed (e.g. the app added a
                // newer version explicitly before this parent), reuse it
                // instead of resolving the spec — which can pull an OLDER
                // version via a stale packages-index, then get auto-included
                // alongside the newer one (two versions of the same header,
                // and on Windows the older, unported one breaks the build).
                let depCached: string = AddCommand.LatestCacheRuntimeDir(depKey)
                if (String_Length(depCached) > 0) {
                    Console.WriteLine("── " + mfNameStr + " depends on " + depKey + " — already cached, reusing ──")
                    // Reusing the cached copy must still declare it in the
                    // project: the facade precompile below and `amc build`
                    // resolve symbols from the project's amalgame.toml, so a
                    // skipped entry surfaced as "Unknown symbol 'Threading'"
                    // when adding `web` with threading already cached.
                    AddCommand.RegisterCachedDep(depKey, 0)
                    continue
                }
                Console.WriteLine("── " + mfNameStr + " depends on " + depKey + " — auto-installing ──")
                let trc: int = AddCommand.RunOne(transSpec, noPrecompile)
                if (trc != 0) {
                    Console.WriteError("transitive dependency " + depKey + " failed (" + transSpec + ")")
                    return trc
                }
            }
        }

        // The facade precompile resolves symbols through the project's
        // lock: refresh it now that the transitive deps are declared,
        // not only at step 6.
        if (File.Exists("amalgame.toml")) {
            let docMid = Toml.Parse(File.ReadAll("amalgame.toml"))
            if (!docMid.IsNull()) {
                let depsMid: TomlValue = docMid.Get("dependencies")
                if (depsMid.IsTable()) { AddCommand.RebuildLockFromTomlDeps(depsMid, "amalgame.lock") }
            }
        }

        // ── 4b. Optional precompile ───────────────────────
        // If `[stdlib].precompile = true` and the user didn't pass
        // `--no-precompile`, compile every `[stdlib].sources` entry
        // into a persistent .o under `<pkg-dir>/build/<platform>/`.
        // Subsequent `amc test` / `amc build` skip recompilation.
        // No-op if the manifest doesn't declare `precompile = true`
        // or doesn't ship sources.
        //
        // v0.8.49: runs AFTER transitive deps so PrecompileFacade
        // can resolve transitive header includes — see the 4d
        // rationale above.
        if (!noPrecompile) {
            let stdlibTblPre: TomlValue = manifest.Get("stdlib")
            if (stdlibTblPre.IsTable()) {
                if (stdlibTblPre.Get("precompile").AsBool()) {
                    let pkgVer: string = mfNameStr + "@" + tag
                    AddCommand.PrecompilePackage(pkgDir, stdlibTblPre, pkgVer)
                }
                // Project F follow-up: `[stdlib].facade = "facade.am"`
                // opts the package into a pure-AM facade that gets
                // pre-compiled into a per-package archive at
                // <pkgDir>/build/<platform>/libamalgame-pkg-<class>.a.
                // Independent of `precompile = true` — a pure-AM
                // package may have a facade and no C sources.
                let facadeRel: string = stdlibTblPre.Get("facade").AsString()
                if (String_Length(facadeRel) > 0) {
                    AddCommand.PrecompileFacade(pkgDir, stdlibTblPre, depsTable)
                }
            }
        }

        // ── 5. Update project's amalgame.toml ─────────────
        if (!AddCommand.UpdateProjectManifest(depName, url, tag)) {
            Console.WriteError("could not update amalgame.toml")
            return 1
        }

        // ── 6. Rebuild amalgame.lock from the full deps table ─
        // Reads the just-updated amalgame.toml and emits a
        // coherent multi-entry lock. Previously each amc add
        // overwrote the lock with a single entry (PR 2 default);
        // re-reading the toml here keeps all deps in the lock.
        let tomlAfter: string = File.ReadAll("amalgame.toml")
        let docAfter = Toml.Parse(tomlAfter)
        let depsAfter: TomlValue = docAfter.Get("dependencies")
        if (depsAfter.IsTable()) {
            AddCommand.RebuildLockFromTomlDeps(depsAfter, "amalgame.lock")
        }

        Console.WriteLine("Added " + depName + " " + tag)
        return 0
    }

    // ── Precompile ────────────────────────────────────
    //
    // Compile every `[stdlib].sources` entry into a persistent .o
    // under `<pkg-dir>/build/<platform>/`. Called from Run when
    // the package's manifest declares `[stdlib].precompile = true`
    // and the user didn't pass `--no-precompile`.
    //
    // Errors are reported but never fatal — install succeeds even
    // if a source fails to compile, because the user can still
    // fall back to the lazy /tmp cache path on next `amc test`.
    // A loud Console.WriteError makes the failure visible.
    //
    // After successful compile, a calibration sample is appended
    // and the calibration store is saved. Future `amc package add`
    // for similar-language sources gets an ETA derived from this.
    public static void PrecompilePackage(string pkgDir, TomlValue stdlibTbl, string pkgVer) {
        // Read the surface keys we need. Mirror PackageRegistry.LoadFrom
        // but on the in-hand manifest (faster than re-resolving the lock).
        let classVal: TomlValue = stdlibTbl.Get("class")
        let className: string = classVal.AsString()
        if (String_Length(className) == 0) { return }
        let sourcesArr: TomlValue = stdlibTbl.Get("sources")
        if (!sourcesArr.IsArray()) { return }
        let sn: int = sourcesArr.Count()
        if (sn == 0) { return }
        let cflags: string   = stdlibTbl.Get("cflags").AsString()
        let cxxflags: string = stdlibTbl.Get("cxxflags").AsString()

        // Build the persistent cache dir.
        let buildDir: string = PackageRegistry.PrecompileCacheDir(pkgDir)
        if (!AddCommand.MkdirP(buildDir)) {
            Console.WriteError("amc package add: could not create " + buildDir)
            return
        }

        // Resolve amc's runtime/ for -I. Same probe order as
        // PrecompileFacade: $AMC_RUNTIME → XDG install path
        // → legacy in-tree.
        //
        // Use ResolveSelfPath so that even when argv[0] is the
        // bare 'amc' (PATH lookup), we get the canonical absolute
        // path via /proc/self/exe — necessary because the XDG
        // probe walks ..  from the binary's dir.
        let amcPath0: string = AddCommand.ResolveSelfPath()
        var amcRuntime: string = Env_Get("AMC_RUNTIME")
        if (String_Length(amcRuntime) == 0) {
            let slashIdx: int = String_LastIndexOf(amcPath0, "/")
            if (slashIdx >= 0) {
                let amcDir0: string = String_Substring(amcPath0, 0, slashIdx)
                let xdgPath0: string = amcDir0 + "/../share/amalgame/runtime"
                if (File.Exists(xdgPath0 + "/_runtime.h")) {
                    amcRuntime = xdgPath0
                } else {
                    amcRuntime = amcDir0 + "/runtime"
                }
            }
        }

        // Load calibration once (cheap, file may be missing → empty).
        let cal: Calibration = Calibration.Load()

        // Track aggregate stats for the calibration sample. One
        // sample per package per language — we sum sizes + elapsed
        // across all sources of the same lang to get the rate.
        var totalCKb:  int = 0
        var totalCSec: int = 0
        var totalCxxKb:  int = 0
        var totalCxxSec: int = 0

        for j in 0..sn {
            let srcTv: TomlValue = sourcesArr.At(j)
            let srcRel: string = srcTv.AsString()
            if (String_Length(srcRel) == 0) { continue }
            let srcAbs: string = pkgDir + "/" + srcRel
            // Derive leaf for the .o name (avoid `/` in filename).
            let lastSlash: int = String_LastIndexOf(srcAbs, "/")
            var srcLeaf: string = srcAbs
            if (lastSlash >= 0) {
                srcLeaf = String_Substring(srcAbs, lastSlash + 1, String_Length(srcAbs) - lastSlash - 1)
            }
            let objPath: string = buildDir + "/" + className + "-" + srcLeaf + ".o"
            if (File.Exists(objPath)) {
                Console.WriteLine("  reused cache: " + srcLeaf)
                continue
            }
            let sizeBytes: int = File.Size(srcAbs)
            let sizeKb: int = sizeBytes / 1024
            let isCxx: bool = PackageRegistry.IsCxxSource(srcAbs)
            let lang: string = if (isCxx) { "cxx" } else { "c" }

            // ETA from calibration, if we have any samples for this lang.
            let etaSec: int = cal.EstimateSeconds(lang, sizeKb)
            var header: string = "  Compiling " + srcLeaf + " (" + String_FromInt(sizeKb) + " KB " + lang + ")"
            if (etaSec > 0) {
                header = header + " — estimated " + AddCommand.HumanDuration(etaSec)
            } else {
                header = header + " — first " + lang + " compile on this machine, no ETA yet"
            }
            Console.WriteLine(header)

            // Build the compile command. Mirror the same dispatch
            // as Program.PreCompilePackageSources for consistency.
            var cmd: string = ""
            if (isCxx) {
                cmd = "g++ -O2"
            } else {
                cmd = "gcc -O2"
            }
            if (String_Length(amcRuntime) > 0) {
                cmd = cmd + " -I\"" + amcRuntime + "\""
            }
            // v0.8.49: same -I-walks-the-cache rationale as
            // PrecompileFacade and build_amc.sh — amc auto-emits
            // includes for every cached package.
            let cachedPkgDirs: List<string> = AddCommand.AllCachedRuntimeDirs()
            let cpn: int = cachedPkgDirs.Count()
            for cpi in 0..cpn {
                cmd = cmd + " -I\"" + cachedPkgDirs.Get(cpi) + "\""
            }
            if (isCxx && String_Length(cxxflags) > 0) {
                cmd = cmd + " " + cxxflags
            }
            if (!isCxx && String_Length(cflags) > 0) {
                cmd = cmd + " " + cflags
            }
            cmd = cmd + " -w -c \"" + srcAbs + "\" -o \"" + objPath + "\" 2>&1"

            // Time the compile.
            let t0: int = AddCommand.NowSeconds()
            let res = Process.RunCapture(cmd)
            let t1: int = AddCommand.NowSeconds()
            let elapsedS: int = t1 - t0

            if (res.Exit != 0) {
                Console.WriteError("  FAILED to compile " + srcLeaf + ":")
                Console.WriteError(res.Stdout)
                continue
            }
            Console.WriteLine("  ✓ " + srcLeaf + " in " + AddCommand.HumanDuration(elapsedS))

            // Accumulate for calibration.
            if (isCxx) {
                totalCxxKb  = totalCxxKb  + sizeKb
                totalCxxSec = totalCxxSec + elapsedS
            } else {
                totalCKb  = totalCKb  + sizeKb
                totalCSec = totalCSec + elapsedS
            }
        }

        // Append calibration samples — at most one per language per
        // package, summarising the totals we accumulated above.
        var dirty: bool = false
        if (totalCKb > 0 && totalCSec > 0) {
            cal.Add("c", totalCKb, totalCSec, pkgVer)
            dirty = true
        }
        if (totalCxxKb > 0 && totalCxxSec > 0) {
            cal.Add("cxx", totalCxxKb, totalCxxSec, pkgVer)
            dirty = true
        }
        if (dirty) {
            if (!cal.Save()) {
                Console.WriteError("  warning: could not save calibration to " + PackageRegistry.CalibrationPath())
            }
        }
    }

    // ── PrecompileFacade ──────────────────────────────────────
    //
    // Compile the package's `[stdlib].facade = "facade.am"` pure-AM
    // file into a per-package archive at
    // `<pkgDir>/build/<platform>/libamalgame-pkg-<class>.a`.
    // Mirrors what `tools/build-stdlib.sh` does for the integrated
    // stdlib, but per-package and driven at `amc package add` time.
    //
    // Three-step pipeline:
    //   1. amc --lib --quiet <facade.am> -o <buildDir>/<class>-facade
    //        → emits <class>-facade.c
    //   2. gcc -O2 -Iruntime -c <class>-facade.c -o <class>-facade.o
    //   3. ar  rcs libamalgame-pkg-<class>.a <class>-facade.o
    //
    // On any step's failure: report and return — install still
    // succeeds (the user can fall back to non-external mode by
    // ignoring the facade, or re-run `amc package add` later).
    public static void PrecompileFacade(string pkgDir, TomlValue stdlibTbl, TomlValue depsTbl) {
        // v0.8.50: read class name from either `class` (single) or
        // `classes = [...]` (multi). Pre-v0.8.50 only looked at
        // `class` and silently returned for multi-class manifests
        // (amalgame-web, amalgame-net-http) — their facades got
        // skipped, consumer links failed on missing symbols.
        var className: string = stdlibTbl.Get("class").AsString()
        if (String_Length(className) == 0) {
            let classesArr: TomlValue = stdlibTbl.Get("classes")
            if (classesArr.IsArray() && classesArr.Count() > 0) {
                className = classesArr.At(0).AsString()
            }
        }
        if (String_Length(className) == 0) { return }
        let facadeRel: string = stdlibTbl.Get("facade").AsString()
        if (String_Length(facadeRel) == 0) { return }

        let facadeAbs: string = pkgDir + "/" + facadeRel
        if (!File.Exists(facadeAbs)) {
            Console.WriteError("  facade source not found: " + facadeAbs)
            return
        }

        // Persistent cache dir — same shape as PrecompilePackage so
        // both artefacts live side-by-side under <pkgDir>/build/<plat>.
        let buildDir: string = PackageRegistry.PrecompileCacheDir(pkgDir)
        if (!AddCommand.MkdirP(buildDir)) {
            Console.WriteError("amc package add: could not create " + buildDir)
            return
        }

        // Resolve amc's path (for the --lib subprocess) and runtime/
        // dir (for the gcc -I flag) — same dance as PrecompilePackage.
        // Probe order matches Program.ResolveRuntimeDir in main.am:
        //   1. $AMC_RUNTIME env var
        //   2. <bin>/../share/amalgame/runtime  (XDG install layout
        //      since amc v0.8.1, used by install.sh + the release
        //      tarballs)
        //   3. <bin>/runtime                    (legacy in-tree path,
        //      kept for source checkouts)
        //
        // ResolveSelfPath gives us the canonical absolute path via
        // /proc/self/exe so the XDG `..` walk works even when amc
        // is invoked as a bare 'amc' through PATH.
        let amcPath: string = AddCommand.ResolveSelfPath()
        var amcRuntime: string = Env_Get("AMC_RUNTIME")
        if (String_Length(amcRuntime) == 0) {
            let slashIdx: int = String_LastIndexOf(amcPath, "/")
            if (slashIdx >= 0) {
                let amcDir: string = String_Substring(amcPath, 0, slashIdx)
                let xdgPath: string = amcDir + "/../share/amalgame/runtime"
                if (File.Exists(xdgPath + "/_runtime.h")) {
                    amcRuntime = xdgPath
                } else {
                    amcRuntime = amcDir + "/runtime"
                }
            }
        }

        let baseOut: string = buildDir + "/" + className + "-facade"
        let cFile:   string = baseOut + ".c"
        let oFile:   string = baseOut + ".o"
        let archive: string = buildDir + "/libamalgame-pkg-" + className + ".a"

        Console.WriteLine("  Compiling facade " + facadeRel + " → libamalgame-pkg-" + className + ".a")

        // v0.8.50: include [stdlib].sources in the facade compile.
        // amalgame-web v0.7.x+ ships multi-class facades by splitting
        // each middleware into its own .am file (session.am,
        // web_app.am, static.am, …). Without these, the precompiled
        // .a only contains the facade.am classes (Router for web,
        // HttpRequest for net-http) and consumer links fail with
        // undefined `Amalgame_Web_WebApp_New` / `_Static_New` etc.
        var facadeSourcesAbs: string = "\"" + facadeAbs + "\""
        let srcArr: TomlValue = stdlibTbl.Get("sources")
        if (srcArr.IsArray()) {
            let srcN: int = srcArr.Count()
            for si in 0..srcN {
                let srcRel: string = srcArr.At(si).AsString()
                if (String_Length(srcRel) == 0) { continue }
                let srcAbs: string = pkgDir + "/" + srcRel
                if (!File.Exists(srcAbs)) { continue }
                // Skip the facade.am itself if it's also listed
                // in `sources` (shouldn't be, but defensive).
                if (srcRel == facadeRel) { continue }
                facadeSourcesAbs = facadeSourcesAbs + " \"" + srcAbs + "\""
            }
        }

        // Step 1 — amc --lib --quiet. Quote amcPath: on Windows it's
        // "C:/Program Files/Amalgame/bin/amc.exe" and cmd.exe splits the
        // unquoted path on the space ('C:/Program' is not recognized).
        let amcCmd: string = "\"" + amcPath + "\" --lib --quiet " + facadeSourcesAbs + " -o \"" + baseOut + "\" 2>&1"
        let amcRes = Process.RunCapture(amcCmd)
        if (amcRes.Exit != 0) {
            Console.WriteError("  FAILED to compile facade (amc):")
            Console.WriteError(amcRes.Stdout)
            return
        }

        // Step 2 — gcc -c
        // Includes:
        //   -I'<pkgDir>/runtime'  for the package's own
        //                          Amalgame_*.h headers (the
        //                          facade.am's @c { #include ... }
        //                          block resolves against this).
        //   -I'<amcRuntime>'      for the bundled _runtime.h +
        //                          Amalgame_{String,Collections,…}.h.
        //   -Iruntime             legacy in-tree fall-through; kept
        //                          for compatibility with old layouts.
        // Plus any system -I supplied by `[stdlib].cflags` in the
        // package manifest (used by SDL-based packages to splice
        // `$(pkg-config --cflags sdl2 SDL2_ttf)`).
        var gccCmd: string = "gcc -O2 -Iruntime -I\"" + pkgDir + "/runtime\""
        if (String_Length(amcRuntime) > 0) {
            gccCmd = gccCmd + " -I\"" + amcRuntime + "\""
        }
        // v0.8.49: propagate -I for EVERY cached package's runtime/.
        // Two reasons:
        //   1. amc's resolver auto-emits a #include line for every
        //      cached `[stdlib].header` into the generated C — even
        //      for packages this facade doesn't directly use. The
        //      precompile must therefore see every header.
        //   2. When this package's own runtime header transitively
        //      #include's a sibling's header (e.g. net-http
        //      v0.9.1+'s Amalgame_Net_Http.h → "Amalgame_Async.h"),
        //      gcc needs the sibling's runtime/ on -I.
        // Walking the cache covers both. The depsTbl argument is
        // kept for future selective use (-I only for declared deps)
        // but for now we always go broad — matches what the
        // bootstrap and build-stdlib.sh do.
        let cachedDirs: List<string> = AddCommand.AllCachedRuntimeDirs()
        let cdn: int = cachedDirs.Count()
        for ci in 0..cdn {
            gccCmd = gccCmd + " -I\"" + cachedDirs.Get(ci) + "\""
        }
        let cflagsVal: TomlValue = stdlibTbl.Get("cflags")
        let cflagsStr: string = cflagsVal.AsString()
        if (String_Length(cflagsStr) > 0) {
            gccCmd = gccCmd + " " + cflagsStr
        }
        gccCmd = gccCmd + " -w -c \"" + cFile + "\" -o \"" + oFile + "\" 2>&1"
        let gccRes = Process.RunCapture(gccCmd)
        if (gccRes.Exit != 0) {
            Console.WriteError("  FAILED to compile facade (gcc):")
            Console.WriteError(gccRes.Stdout)
            return
        }

        // Step 3 — ar rcs (clobber any stale archive first; ar's
        // default rcs adds to an existing archive, which would
        // accumulate stale members across reinstalls).
        if (File.Exists(archive) && !File.Delete(archive)) {
            Console.WriteError("  warning: could not remove stale archive " + archive)
        }
        let arCmd: string = "ar rcs \"" + archive + "\" \"" + oFile + "\" 2>&1"
        let arRes = Process.RunCapture(arCmd)
        if (arRes.Exit != 0) {
            Console.WriteError("  FAILED to archive facade (ar):")
            Console.WriteError(arRes.Stdout)
            return
        }
        let arSize: int = File.Size(archive)
        Console.WriteLine("  ✓ libamalgame-pkg-" + className + ".a (" + String_FromInt(arSize) + " bytes)")
    }

    // Wall-clock seconds via `date +%s`. Coarse but enough for
    // compile-time tracking — multi-second resolution is well
    // below the typical compile durations we care about (>10s).
    // Mirror of Program.ResolveSelfPath. The bootstrap pipeline
    // compiles add_cmd.am for gen_test without main.am in scope,
    // so cross-class references to Program.* trip 'undefined
    // reference' at link time. Duplicating the @c block here is
    // cheap (Linux readlink + Windows GetModuleFileNameA) and
    // avoids untangling the bootstrap dependency graph.
    public static string ResolveSelfPath() {
        @c {
            #ifdef _WIN32
                char buf[4096];
                DWORD n = GetModuleFileNameA(NULL, buf, sizeof(buf));
                if (n == 0 || n >= sizeof(buf)) { return (code_string) ""; }
                for (DWORD i = 0; i < n; i++) { if (buf[i] == '\\') buf[i] = '/'; }
                char* out = (char*) GC_MALLOC((size_t)(n + 1));
                memcpy(out, buf, (size_t)(n + 1));
                return (code_string) out;
            #else
                char buf[4096];
                ssize_t n = readlink("/proc/self/exe", buf, sizeof(buf) - 1);
                if (n <= 0) { return (code_string) ""; }
                buf[n] = '\0';
                char* out = (char*) GC_MALLOC((size_t)(n + 1));
                memcpy(out, buf, (size_t)(n + 1));
                return (code_string) out;
            #endif
        }
    }

    public static int NowSeconds() {
        // Native epoch seconds — no shelling to `date +%s` (cmd.exe's
        // `date` is interactive and has no `+%s`). time() needs no
        // explicit include: the runtime prelude already pulls <time.h>.
        @c { return (i64) time(NULL); }
    }

    // Render a duration in seconds as `MmSSs` (e.g. `2m47s`) or
    // `<NN>s` if under a minute. Display-only; no parsing back.
    public static string HumanDuration(int seconds) {
        if (seconds < 60) { return String_FromInt(seconds) + "s" }
        let m: int = seconds / 60
        let s: int = seconds % 60
        return String_FromInt(m) + "m" + String_FromInt(s) + "s"
    }

    // ── Spec parsing ──────────────────────────────────

    // "github.com/x/y@v1.0.0" → ["github.com/x/y", "v1.0.0"].
    // Splits at the LAST `@` so URLs containing `@` (e.g. user@host
    // SSH form, though we reject those upstream) don't trip us up.
    public static List<string> ParseSpec(string spec) {
        let out: List<string> = new List<string>()
        let atIdx: int = String_LastIndexOf(spec, "@")
        if (atIdx <= 0 || atIdx >= String_Length(spec) - 1) { return out }
        let url: string = String_Substring(spec, 0, atIdx)
        let tag: string = String_Substring(spec, atIdx + 1, String_Length(spec) - atIdx - 1)
        // Strip a leading protocol scheme if present.
        var cleanUrl: string = url
        if (String_StartsWith(cleanUrl, "https://")) {
            cleanUrl = String_Substring(cleanUrl, 8, String_Length(cleanUrl) - 8)
        }
        if (String_StartsWith(cleanUrl, "http://")) {
            cleanUrl = String_Substring(cleanUrl, 7, String_Length(cleanUrl) - 7)
        }
        out.Add(cleanUrl)
        out.Add(tag)
        return out
    }

    public static bool IsSafeUrl(string url) {
        let n: int = String_Length(url)
        if (n == 0) { return false }
        for i in 0..n {
            let c: string = String_CharAt1(url, i)
            var ok: bool = false
            if (c == "." || c == "/" || c == "_" || c == "-" || c == ":") { ok = true }
            if (String_IndexOf("0123456789", c) >= 0) { ok = true }
            if (String_IndexOf("abcdefghijklmnopqrstuvwxyz", c) >= 0) { ok = true }
            if (String_IndexOf("ABCDEFGHIJKLMNOPQRSTUVWXYZ", c) >= 0) { ok = true }
            if (!ok) { return false }
        }
        return true
    }

    public static bool IsSafeTag(string tag) {
        let n: int = String_Length(tag)
        if (n == 0) { return false }
        for i in 0..n {
            let c: string = String_CharAt1(tag, i)
            var ok: bool = false
            if (c == "." || c == "_" || c == "-" || c == "+") { ok = true }
            if (String_IndexOf("0123456789", c) >= 0) { ok = true }
            if (String_IndexOf("abcdefghijklmnopqrstuvwxyz", c) >= 0) { ok = true }
            if (String_IndexOf("ABCDEFGHIJKLMNOPQRSTUVWXYZ", c) >= 0) { ok = true }
            if (!ok) { return false }
        }
        return true
    }

    // Last path segment of the URL = package name.
    public static string SlugFromUrl(string url) {
        let slashIdx: int = String_LastIndexOf(url, "/")
        if (slashIdx < 0) { return url }
        return String_Substring(url, slashIdx + 1, String_Length(url) - slashIdx - 1)
    }

    // Derive the user-facing dep handle from a package's slug:
    //   `amalgame-database-sqlite`     → `sqlite`
    //   `amalgame-messaging-mqtt`      → `mqtt`
    //   `amalgame-database-nosql-redis` → `redis`
    //   `amalgame-redis` (single-seg)   → `redis`
    //   `cool-thing` (3rd-party)        → `cool-thing` (passthrough)
    //
    // Rule: if slug starts with `amalgame-`, strip the prefix and
    // collapse to the last dash-segment (the leaf of the namespace-
    // mirrored repo name). Otherwise pass through unchanged.
    public static string DepNameFromSlug(string slug) {
        if (!String_StartsWith(slug, "amalgame-")) {
            return slug
        }
        let rest: string = String_Substring(slug, 9, String_Length(slug) - 9)
        let lastDash: int = String_LastIndexOf(rest, "-")
        if (lastDash < 0) {
            return rest
        }
        return String_Substring(rest, lastDash + 1, String_Length(rest) - lastDash - 1)
    }

    // `v0.1.0` → `0.1.0`. Tags conventionally carry the `v`
    // prefix; manifest versions don't.
    public static string StripV(string tag) {
        if (String_StartsWith(tag, "v")) {
            return String_Substring(tag, 1, String_Length(tag) - 1)
        }
        return tag
    }

    // ── Cache path management ─────────────────────────

    public static string CacheRoot() {
        let override: string = Env_Get("AMALGAME_PACKAGES_DIR")
        if (String_Length(override) > 0) {
            return override
        }
        let home: string = Env_Get("HOME")
        if (String_Length(home) > 0) {
            return home + "/.amalgame/packages"
        }
        // Windows : HOME souvent absent → USERPROFILE. Slashes AVANT pour que
        // sh (MSYS/git, qui fait le clone/mv) ET le runtime C (qui fait les
        // checks fopen) résolvent le MÊME chemin. Avec "/tmp" ils divergeaient
        // (sh → AppData\Temp, C → C:\tmp) → "missing amalgame.toml".
        let userProfile: string = Env_Get("USERPROFILE")
        if (String_Length(userProfile) > 0) {
            return String_Replace(userProfile, "\\", "/") + "/.amalgame/packages"
        }
        return "/tmp/amalgame-packages"
    }

    // Where the packages-index lives once fetched. Always under
    // $HOME/.amalgame regardless of AMALGAME_PACKAGES_DIR — that
    // override is for the *package* cache, not the index. A
    // separate cache dir keeps the two concerns clean.
    public static string IndexCachePath() {
        let home: string = Env_Get("HOME")
        if (String_Length(home) > 0) {
            return home + "/.amalgame/cache/packages-index.toml"
        }
        // Windows has no HOME; use USERPROFILE so the index cache lands
        // next to the package cache (CacheRoot uses the same fallback)
        // instead of a broken POSIX /tmp path.
        let userProfile: string = Env_Get("USERPROFILE")
        if (String_Length(userProfile) > 0) {
            return String_Replace(userProfile, "\\", "/") + "/.amalgame/cache/packages-index.toml"
        }
        return "/tmp/amalgame-index.toml"
    }

    // ── Shortname resolution via packages-index ───────

    // Detect a shortname: the part before `@` contains no `/`
    // and no `.`. URLs always have one or the other (host
    // separator or domain dot).
    private static bool IsShortname(string lhs) {
        if (String_IndexOf(lhs, "/") >= 0) { return false }
        if (String_IndexOf(lhs, ".") >= 0) { return false }
        return String_Length(lhs) > 0
    }

    // Fetch the packages-index. The result is cached at
    // ~/.amalgame/cache/packages-index.toml. Since v0.5.6, the
    // cache has a 30-minute TTL — older than that triggers a
    // re-fetch automatically. Force-refresh with `--refresh` on
    // search/versions or `amc package cache clear`. Returns ""
    // on download failure (caller falls back to passing the
    // input through unchanged or surfaces the error).
    public static string FetchIndex() {
        let cachePath: string = AddCommand.IndexCachePath()
        if (File.Exists(cachePath) && AddCommand.IndexCacheIsFresh(cachePath)) {
            return File.ReadAll(cachePath)
        }
        // Make sure ~/.amalgame/cache exists.
        let cacheDir: string = String_Substring(cachePath, 0, String_LastIndexOf(cachePath, "/"))
        let _mkdir: bool = AddCommand.MkdirP(cacheDir)
        // Fetch via raw.githubusercontent.com. --ssl-no-revoke: Windows'
        // curl uses the schannel TLS backend, which fails the fetch with
        // CRYPT_E_NO_REVOCATION_CHECK when it can't reach the CA's
        // revocation endpoint (corporate proxies, offline OCSP). The flag
        // skips that soft check; harmless no-op on OpenSSL/macOS curl.
        let indexUrl: string = "https://raw.githubusercontent.com/amalgame-lang/packages-index/main/packages.toml"
        let cmd: string = "curl -fsSL --ssl-no-revoke \"" + indexUrl + "\" -o \"" + cachePath + "\" 2>&1"
        let exit: int = Process_Run(cmd)
        if (exit != 0 || !File.Exists(cachePath)) {
            // Network failure: serve the stale cache if any. Better
            // than nothing — the worst case is the user sees an old
            // version listing, not a hard error.
            if (File.Exists(cachePath)) {
                Console.WriteError("warning: index fetch failed, serving stale cache from " + cachePath)
                return File.ReadAll(cachePath)
            }
            return ""
        }
        return File.ReadAll(cachePath)
    }

    // True if the cached index file is younger than INDEX_TTL_SECS.
    // Reads mtime via the native File.Mtime primitive (stat) — no
    // shelling to `date -r` (absent on cmd.exe, format differs on BSD).
    // Returns true on any error (treat as "freshness unknown, don't
    // re-fetch unnecessarily").
    public static bool IndexCacheIsFresh(string cachePath) {
        let ttlSecs: int = 1800   // 30 minutes
        let mtime: int = File.Mtime(cachePath)
        if (mtime <= 0) { return true }
        let now: int = AddCommand.NowSeconds()
        if (now <= 0) { return true }
        return (now - mtime) < ttlSecs
    }

    // ── amc package <subcommand> ──────────────────────
    //
    // Single top-level dispatcher for every PM verb. Matches
    // dotnet's `dotnet add package` / `dotnet remove package`
    // grouping convention: pkgmgr commands don't clutter the
    // top-level (which stays reserved for language ops —
    // compile / new / fmt / test / lsp / migrate / generate /
    // explain).
    //
    //   amc package add <git-url|shortname>@<tag>
    //   amc package search [keyword]
    //   amc package list
    //   amc package remove <name> [<name>...]
    //   amc package update <name>@<tag>
    //   amc package cache clear [--all]
    //
    // Short alias: `amc pkg <subcmd>` (main.am dispatches
    // both `package` and `pkg` here).
    public static int RunPackage(int argc) {
        if (argc < 3) {
            AddCommand.PrintPackageUsage()
            return 2
        }
        let sub: string = Args_Get(2)
        if (sub == "-h" || sub == "--help") {
            AddCommand.PrintPackageUsage()
            return 0
        }
        // Sub-commands all read their positional args starting
        // at argv[3] (after `amc package <sub>`); the second
        // arg to each method tells it where to start the scan.
        if (sub == "add")       { return AddCommand.Run(argc, 3) }
        if (sub == "search")    { return AddCommand.RunSearch(argc, 3) }
        if (sub == "suggest")   { return AddCommand.RunSuggest(argc, 3) }
        if (sub == "versions")  { return AddCommand.RunVersions(argc, 3) }
        if (sub == "info")      { return AddCommand.RunInfo(argc, 3) }
        if (sub == "outdated")  { return AddCommand.RunOutdated(argc, 3) }
        if (sub == "notice")    { return AddCommand.RunNotice(argc, 3) }
        if (sub == "check")     { return AddCommand.RunCheck(argc, 3) }
        if (sub == "list")      { return AddCommand.RunList(argc, 3) }
        if (sub == "remove")    { return AddCommand.RunRemove(argc, 3) }
        if (sub == "update")    { return AddCommand.RunUpdate(argc, 3) }
        if (sub == "cache")     { return AddCommand.RunCache(argc, 3) }
        Console.WriteError("amc package: unknown subcommand '" + sub + "'")
        AddCommand.PrintPackageUsage()
        return 2
    }

    public static void PrintPackageUsage() {
        Console.WriteError("Usage: amc package <subcommand> [args...]")
        Console.WriteError("       amc pkg     <subcommand> [args...]")
        Console.WriteError("")
        Console.WriteError("Subcommands:")
        Console.WriteError("  add <name|url>[@<tag>]        Install a package; auto-resolve latest")
        Console.WriteError("                                compatible tag if @<tag> is omitted (indexed")
        Console.WriteError("                                shortnames only)")
        Console.WriteError("    [--no-precompile]            Skip install-time compile (manifest opt-in)")
        Console.WriteError("  search [keyword] [--refresh]  List or filter packages-index with version compat")
        Console.WriteError("    [--no-versions]              Skip the per-package versions block (faster)")
        Console.WriteError("  suggest <name|ns> [--json]    Suggest packages that match a class or namespace")
        Console.WriteError("    [--refresh]                  (intended for LSP / `using X;` quickfix integration)")
        Console.WriteError("  versions <name> [--refresh]   Show all indexed versions of a single package")
        Console.WriteError("    [--json]                     Emit machine-readable JSON")
        Console.WriteError("  info <name> [--refresh]       Show description, url, license, versions, install")
        Console.WriteError("  outdated [--refresh]          List installed deps with a newer compatible tag")
        Console.WriteError("  notice                        Aggregate licence + authorship of installed deps")
        Console.WriteError("  check [--frozen]              Verify amalgame.lock matches the installed cache")
        Console.WriteError("                                (--frozen exits 1 on mismatch — for CI)")
        Console.WriteError("  list                          Show installed deps")
        Console.WriteError("  remove <name>[@<tag>] [...]   Strip dep(s) from amalgame.toml + lock.")
        Console.WriteError("                                `@<tag>` is a safety check (refuses to remove")
        Console.WriteError("                                if the installed tag differs)")
        Console.WriteError("  update <name>@<tag>           Bump a pinned tag")
        Console.WriteError("  cache clear [--all]           Drop cached index / packages")
        Console.WriteError("")
        Console.WriteError("Example:")
        Console.WriteError("  amc package search duckdb")
        Console.WriteError("  amc package add redis@v0.2.0")
