                if (calleeStr == "Process_Spawn") { return "AmalgameProcessHandle*" }
                if (calleeStr == "Process_IsAlive") { return "code_bool" }
                if (calleeStr == "Process_ExitCode") { return "i64" }
                if (calleeStr == "Process_Wait") { return "code_bool" }
