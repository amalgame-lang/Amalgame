                                // namespace-mangled key.
                                let pkgMangled2: string = this.PkgClassMangledPrefix(cname2)
                                if (String_Length(pkgMangled2) > 0 && !this.IsLocalClass(cname2)) {
                                    let retTP: string = this.MethodRetGet(pkgMangled2, mname2)
                                    if (String_Length(retTP) > 0) { return retTP }
                                }
                                let symCls = this.SymName(cname2)
                                let retT2  = this.MethodRetGet(symCls, mname2)
                                if (String_Length(retT2) > 0) { return retT2 }
                            }
                            // Instance method call: obj.Method() → look up via obj's type
                            if (!isUpp) {
                                let objType = this.LocalTypeGet(cname2)
                                let bareCls = String_Replace(objType, "*", "")
                                if (String_Length(bareCls) > 0) {
                                    let retT3 = this.MethodRetGet(bareCls, mname2)
                                    if (String_Length(retT3) > 0) { return retT3 }
                                }
                            }
                        }
                    }
                }
            }
        }
        _ => { }
        }
        return ""
    }

    // Strict identifier-shape check for `{...}` interpolation content.
    // Accepts:  ident, ident.path, ident.path(args), this.path[(args)]
    // Rejects:  anything containing `;`, `:`, `-`, ` `, `+`, `,`, `=`, …
    //           outside of a method-call argument list.
    //
    // Why: pre-fix the check was "starts with a letter, or starts with
    // `this.`" — too permissive. CSS rules like `body{font-family:...}`
    // start with `f` and silently swallowed the brace as an interpolation
    // slot, producing garbage C from cgen. Inline HTML/CSS/JS authored
    // in `.am` string literals now passes through cleanly.
    private bool IsValidInterpExpr(s: string) {
        let n = String_Length(s)
        if (n == 0) { return false }
        let first = String_Substring(s, 0, 1)
        let identStart = String_Contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", first)
        if (!identStart) { return false }
        let identCont = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_."
        var i = 1
        while (i < n) {
            let ch = String_Substring(s, i, 1)
            if (ch == "(") {
                // Method-call form: rest is the argument list. Trust the
                // existing InterpExprToC to parse it; require closing `)`
                // as the very last character so we don't mis-detect mid-
                // string `(` followed by garbage and an unrelated `)`
                // later in the source — that case lands here only when
                // the head segment is already a clean ident path.
                let last = String_Substring(s, n - 1, 1)
                if (last == ")") { return true }
                return false
            }
            let ok = String_Contains(identCont, ch)
            if (!ok) { return false }
            i = i + 1
        }
        return true
    }

    // Re-escape a string value (which may contain real newlines, tabs, quotes)
    // into valid C string literal content.
    // Emit a string literal, expanding {ident} / {this.field} / {obj.method(args)}
    // interpolations. Bare `{` followed by non-identifier content (CSS,
    // JS arrow bodies, JSON, …) passes through as a literal — see
    // IsValidInterpExpr above.
    private string EmitInterpolatedString(string raw) {
        let hasInterp = String_IndexOf(raw, "{")
        if (hasInterp < 0) {
            let escaped = this.EscapeStringForC(raw)
            return "\"" + escaped + "\""
        }
        let len = String_Length(raw)
        // Check for at least one valid {ident…} pattern
        var hasValid = false
        var ci = 0
        while (ci < len) {
            let cch = String_Substring(raw, ci, 1)
            if (cch == "{") {
                let rest = String_Substring(raw, ci + 1, len - ci - 1)
                let close = String_IndexOf(rest, "}")
                if (close > 0) {
                    let inner = String_Substring(raw, ci + 1, close)
                    if (this.IsValidInterpExpr(inner)) {
                        hasValid = true
                        ci = len
                    } else {
                        ci = ci + 1
                    }
                } else {
                    ci = ci + 1
                }
            } else {
                ci = ci + 1
            }
        }
        if (!hasValid) {
            let escaped = this.EscapeStringForC(raw)
            return "\"" + escaped + "\""
        }
        // Build interpolated expression
        var result = "\"\""
        var i = 0
        var segStart = 0
        while (i < len) {
            let ch = String_Substring(raw, i, 1)
            if (ch == "{") {
                let rest2 = String_Substring(raw, i + 1, len - i - 1)
                let close2 = String_IndexOf(rest2, "}")
                if (close2 > 0) {
                    let expr = String_Substring(raw, i + 1, close2)
                    if (this.IsValidInterpExpr(expr)) {
                        if (i > segStart) {
                            let seg = String_Substring(raw, segStart, i - segStart)
                            let esc = this.EscapeStringForC(seg)
                            result = "code_string_concat(" + result + ", \"" + esc + "\")"
                        }
                        let cExpr = this.InterpExprToC(expr)
                        result = "code_string_concat(" + result + ", " + cExpr + ")"
                        segStart = i + 1 + close2 + 1
                        i = segStart
                    } else {
                        i = i + 1
                    }
                } else {
                    i = i + 1
                }
            } else {
                i = i + 1
            }
        }
        if (segStart < len) {
            let seg = String_Substring(raw, segStart, len - segStart)
            let esc = this.EscapeStringForC(seg)
            result = "code_string_concat(" + result + ", \"" + esc + "\")"
        }
        return result
    }

    // Wrap a C expression in the right ToString conversion based on its
    // C return type. Used by the interpolation handler below.
    private string WrapForInterp(string cExpr, string cType) {
        if (cType == "code_string") { return "(" + cExpr + " ? " + cExpr + " : \"\")" }
        if (cType == "i64")         { return "String_FromInt(" + cExpr + ")" }
        if (cType == "double")      { return "String_FromFloat(" + cExpr + ")" }
        if (cType == "code_bool")   { return "((" + cExpr + ") ? \"true\" : \"false\")" }
        // Fallback — assume int for unknown / void
        return "String_FromInt((i64)(" + cExpr + "))"
    }

    // Best-effort C return type for a stdlib-style call name (e.g. "String_Length").
    // Returns "" when unknown so the caller can pick a fallback.
    private string BuiltinCallReturnType(string cName) {
        if (cName == "String_Length" || cName == "String_IndexOf" || cName == "String_LastIndexOf" || cName == "String_ToInt") { return "i64" }
        if (cName == "String_ToFloat") { return "double" }
        if (cName == "String_IsEmpty" || cName == "String_Contains" || cName == "String_StartsWith" || cName == "String_EndsWith" || cName == "String_ToBool") { return "code_bool" }
        if (String_StartsWith(cName, "String_")) { return "code_string" }
        // Math_X flat-name return types — gone post-v0.7.5 Math.h
        // migration. Math.X qualified calls lower via namespace
        // mangling, return type comes from the AM signature.
        if (cName == "File_ReadAll") { return "code_string" }
        if (cName == "File_Exists" || cName == "File_WriteAll" || cName == "File_AppendAll" || cName == "File_Delete" || cName == "File_IsFile" || cName == "File_IsDir") { return "code_bool" }
        if (cName == "File_Size" || cName == "File_Mtime" || cName == "Args_Count" || cName == "Exit_Get") { return "i64" }
        if (cName == "Args_Get") { return "code_string" }
        return ""
    }

    // Convert a simple interpolation expression to a C string expression
    private string InterpExprToC(string expr) {
        // Method/function call: "Class.Method(args)" or "func(args)".
        // Convert dot-separated qualifiers to underscore (C name scheme),
        // then pick a ToString wrapper from the inferred return type.
        let parenIdx = String_IndexOf(expr, "(")
        if (parenIdx > 0) {
            let callee = String_Substring(expr, 0, parenIdx)
            let rest   = String_Substring(expr, parenIdx, String_Length(expr) - parenIdx)
            // Instance dispatch: `obj.method(...)` where obj is a
            // typed local pointer in scope (e.g. `let app = this`
            // captured by a lambda). The naive dot-replace below
            // would produce `app_method(...)` — wrong. Look up obj's
            // C type and emit `<BareT>_method(obj, ...args)`.
            let dotIn = String_IndexOf(callee, ".")
            if (dotIn > 0 && String_IndexOf(String_Substring(callee, dotIn + 1, String_Length(callee) - dotIn - 1), ".") == -1) {
                let objName = String_Substring(callee, 0, dotIn)
                let mName   = String_Substring(callee, dotIn + 1, String_Length(callee) - dotIn - 1)
                let objType = this.LocalTypeGet(objName)
                if (String_Length(objType) > 0 && String_Contains(objType, "*")) {
                    let bareT = String_Replace(objType, "*", "")
                    let inside = String_Substring(rest, 1, String_Length(rest) - 2)
                    var iCall: string = ""
                    if (String_Length(inside) == 0) {
                        iCall = bareT + "_" + mName + "(" + objName + ")"
                    } else {
                        iCall = bareT + "_" + mName + "(" + objName + ", " + inside + ")"
                    }
                    let iRetT = this.MethodRetGet(bareT, mName)
                    if (String_Length(iRetT) > 0) {
                        return this.WrapForInterp(iCall, iRetT)
                    }
                    return "(" + iCall + " ? " + iCall + " : \"\")"
                }
            }
            let cCallee = String_Replace(callee, ".", "_")
            let cCall  = cCallee + rest
            let retT   = this.BuiltinCallReturnType(cCallee)
            if (String_Length(retT) > 0) {
                return this.WrapForInterp(cCall, retT)
            }
            // Unknown callee → assume string (most user methods returning text).
            return "(" + cCall + " ? " + cCall + " : \"\")"
        }
        // this.Field → self->Field
        if (String_StartsWith(expr, "this.")) {
            let field = String_Substring(expr, 5, String_Length(expr) - 5)
            let ft = this.FieldTypeGet(this.CurrentClass, field)
            if (ft == "i64") { return "String_FromInt(self->" + field + ")" }
            if (ft == "double") { return "String_FromFloat(self->" + field + ")" }
            if (ft == "code_bool") { return "((self->" + field + ") ? \"true\" : \"false\")" }
            if (ft == "code_string") { return "(self->" + field + " ? self->" + field + " : \"\")" }
            // Enum or other non-pointer type → treat as integer
            if (String_Length(ft) > 0 && !String_Contains(ft, "*")) { return "String_FromInt((i64)self->" + field + ")" }
            return "(self->" + field + " ? self->" + field + " : \"\")"
        }
        // obj.field → obj->field (obj is a pointer variable)
        let dotIdx = String_IndexOf(expr, ".")
        if (dotIdx > 0) {
            let objName = String_Substring(expr, 0, dotIdx)
            let field2  = String_Substring(expr, dotIdx + 1, String_Length(expr) - dotIdx - 1)
            let objType = this.LocalTypeGet(objName)
            let bareT   = String_Replace(objType, "*", "")
            if (String_Length(bareT) > 0) {
                let ft2 = this.FieldTypeGet(bareT, field2)
                if (ft2 == "i64") { return "String_FromInt(" + objName + "->" + field2 + ")" }
                if (ft2 == "double") { return "String_FromFloat(" + objName + "->" + field2 + ")" }
                if (ft2 == "code_bool") { return "((" + objName + "->" + field2 + ") ? \"true\" : \"false\")" }
                if (ft2 == "code_string") { return "(" + objName + "->" + field2 + " ? " + objName + "->" + field2 + " : \"\")" }
                // Enum or other non-pointer type → treat as integer
                if (String_Length(ft2) > 0 && !String_Contains(ft2, "*")) { return "String_FromInt((i64)" + objName + "->" + field2 + ")" }
                return "(" + objName + "->" + field2 + " ? " + objName + "->" + field2 + " : \"\")"
            }
        }
        // Simple variable
        let varC = this.LocalTypeGet(expr)
        if (varC == "i64") { return "String_FromInt(" + expr + ")" }
        if (varC == "double") { return "String_FromFloat(" + expr + ")" }
        if (varC == "code_bool") { return "(" + expr + " ? \"true\" : \"false\")" }
        if (String_Length(varC) > 0) {
            return "(" + expr + " ? " + expr + " : \"\")"
        }
        // Fallback: treat as int
        return "String_FromInt(" + expr + ")"
    }

    private string EscapeStringForC(string raw) {
        // The Amalgame lexer converts escape sequences to real bytes.
        // We must reverse that for C string literal emission.
        // Order matters: escape backslash first to avoid double-escaping.
        var s = String_Replace(raw, "\\", "\\\\")
        s = String_Replace(s, "\"", "\\\"")
        s = String_Replace(s, "\n", "\\n")
        s = String_Replace(s, "\t", "\\t")
        // CR (0x0d) is built via String_FromByte(13) rather than
        // "\r" — the ancient amc that bootstraps this file lexed
        // both `"\r"` and `"\x0d"` incorrectly (no escape applied),
        // so the previous `String_Replace(s, "\r", ...)` never
        // matched a real CR. Going through a builtin int→byte
        // bypasses the lexer entirely.
        s = String_Replace(s, String_FromByte(13), "\\r")
        // ESC character (0x1B) used in ANSI color codes
        s = String_Replace(s, String_FromByte(27), "\\x1b")
        return s
    }

    private void EmitHeader() {
        // MCU (§4): freestanding prelude. The embedded _runtime.h (found
        // first via -Iruntime/embedded) bundles the whole surface a bare
        // program needs — arena alloc, code_string helpers, Console via
        // semihosting — with NO <gc.h>, NO <stdio.h>, NO host stdlib
        // headers. We emit nothing else: the Amalgame_*.h core headers and
        // package headers below are hosted-only (they pull libc/sockets).
        if (this.Embedded) {
            this.Out.EmitLine("#include \"_runtime.h\"")
            this.Out.EmitBlank()
            return
        }
        this.Out.EmitLine("#include <stdio.h>")
        this.Out.EmitLine("#include <stdlib.h>")
        this.Out.EmitLine("#include <string.h>")
        this.Out.EmitLine("#include \"_runtime.h\"")
        this.Out.EmitLine("#include \"Amalgame_String.h\"")
        this.Out.EmitLine("#include \"Amalgame_Collections.h\"")
        this.Out.EmitLine("#include \"Amalgame_IO.h\"")
        // Math + Math_Vec migrated to AM (post-v0.7.5); runtime
        // headers dropped. Their libm includes live in top-level
        // @c {} blocks in src/stdlib/math.am + math_vec.am.
        // FileWatcher migrated to AM (post-v0.7.5); runtime header
        // dropped. Its libc include (<sys/stat.h>) lives in a
        // top-level @c {} block in src/stdlib/io_filewatcher.am.
        // Regex / Compress / WebSocket runtime headers moved out to
        // their own external packages in v0.7.8 — install with
        // `amc package add regex compress net-websocket` if your
        // code uses them. The `isCoreStdlib` flat-mangling check
        // for `Regex.Method` / `Compress.Method` / `WebSocket.Method`
        // stays in place, so call sites still lower to `Regex_Method`
        // — the package's runtime header supplies the matching symbol
        // via PkgHeaders below.
        this.Out.EmitLine("#include \"Amalgame_Net.h\"")
        this.Out.EmitLine("#include \"Amalgame_Console.h\"")
        this.Out.EmitLine("#include \"Amalgame_Process.h\"")
        // Random migrated to AM (post-v0.7.5); PCG helpers + entropy
        // source live in a top-level @c {} in src/stdlib/random.am.
        // DateTime + Logging: runtime headers dropped after the
        // top-level `@c { … }` extension (post-v0.7.5). Their state
        // globals + libc includes now live in the .am files
        // themselves (src/stdlib/datetime.am, src/stdlib/logging.am).
        // Crypto migrated to AM (post-v0.7.5); SHA-256 + HMAC live
        // in a top-level @c {} in src/stdlib/crypto.am.
        // Service migrated to AM (post-v0.7.5); the signal-handler
        // state + handler function live in a top-level @c {} in
        // src/stdlib/service.am.
        // BuildInfo migrated to AM (post-v0.7.5); the AMC_GIT_REV /
        // AMC_BUILD_DATE `#ifndef` guards live in a top-level @c {}
        // in src/stdlib/amc_buildinfo.am.
        // (Amalgame_Database_SQLite.h / Amalgame_Database_Redis.h
        //  / Amalgame_Messaging_MQTT.h all moved to their own
        //  packages — PackageRegistry emits the #include lines for
        //  whichever the user has `amc add`'d.)
        // v0.5 package-manager: each installed external package
        // contributes its runtime header to the prelude. Empty
        // when no packages are installed; SQLite/Redis/MQTT stay
        // hardcoded above through v0.5 until PR 4/5 extract them.
        let pkgHdrN: int = this.PkgHeaders.Count()
        for ph in 0..pkgHdrN {
            // v0.8.51: skip headers from packages the source doesn't
            // import. Without this filter, every cached package in
            // amalgame.lock contributes an `#include` to every .c —
            // gcc then preprocesses (e.g.) 10MB of duckdb C++ headers
            // for a trivial `path.c` that only uses Collections.
            if (this.ImportsFiltered) {
                let phNs: string = this.PkgHeaderNs.Get(ph)
                if (!this.NamespaceImported(phNs)) {
                    continue
                }
            }
            this.Out.EmitLine("#include \"" + this.PkgHeaders.Get(ph) + "\"")
        }
        this.Out.EmitBlank()
    }

    // Returns true if `ns` is covered by at least one import in
    // ImportedNs. Matching is bidirectional on dot boundaries:
    //   - exact equal:                  "Amalgame.Web" ↔ "Amalgame.Web"
    //   - import is a parent of ns:     "Amalgame.Web" → "Amalgame.Web.Static"
    //   - import is a sub-ns of pkg.Ns: "Amalgame.Web.Static" → pkg with ns "Amalgame.Web"
    // Sub-ns matching covers multi-class packages: e.g. amalgame-web
    // exposes `Amalgame.Web` and also `Amalgame.Web.Mosaic`. A user
    // importing only `Amalgame.Web.Mosaic.Routes` still needs the
    // parent package's runtime header included.
    public bool NamespaceImported(string ns) {
        let nsLen: int = String_Length(ns)
        let n: int = this.ImportedNs.Count()
        for i in 0..n {
            let imp: string = this.ImportedNs.Get(i)
            if (imp == ns) { return true }
            let impLen: int = String_Length(imp)
            if (impLen > nsLen) {
                // imp starts with ns + "."
                if (String_StartsWith(imp, ns + ".")) { return true }
            } else {
                // ns starts with imp + "."
                if (String_StartsWith(ns, imp + ".")) { return true }
            }
        }
        return false
    }

    // v0.8.51: feed the imports parsed from the source (`prog.Args`
    // identifiers, qualified names like "Amalgame.Net.Http"). Must be
    // called BEFORE BeginMulti / Generate / EmitHeader. Switches the
    // PkgHeader / PkgClass-typedef emission into filtered mode so
    // only headers from imported packages reach gcc.
    public void SetImportedNamespaces(List<string> imports) {
        this.ImportedNs = imports
        this.ImportsFiltered = true
    }

    public void SetEmbedded(bool v) { this.Embedded = v }

    // Allocation primitive for `new`/ctor object construction. Hosted keeps
    // GC_MALLOC verbatim (byte-identical, guarded by golden-c). Embedded
    // routes through code_alloc → the region-per-tick arena (§5), so there
    // is NO garbage collector and NO malloc on the MCU.
    private string AllocFn() {
        if (this.Embedded) { return "code_alloc" }
        return "GC_MALLOC"
    }

    public void EmitNetHeader() {
        this.Out.EmitLine("#include \"Amalgame_Net.h\"")
    }

    // ── v0.5 package-manager hook ────────────────────
    //
    // Called by main.am after constructing the CGen — feeds it
    // every class + function declared by installed external
    // packages. Cached as parallel lists for the three downstream
    // dispatch sites:
    //   1. EmitPrelude   — adds an `#include "<header>"` line
    //                       per package
    //   2. isStdlib check (NodeKind.MEMBER static-call path) —
    //                       extends the hardcoded class-name list
    //   3. InferTypeFromExpr return-type table — maps
    //                       `<Class>_<Func>` to its manifest-
    //                       declared C return type
    //
    // Idempotent — re-registering same packages overwrites the
    // earlier entries.
    public void RegisterPackages(PackageRegistry reg) {
        this.PkgClasses     = new List<string>()
        this.PkgFuncs       = new List<string>()
        this.PkgFuncCTypes  = new List<string>()
        this.PkgHeaders     = new List<string>()
        this.PkgHeaderNs    = new List<string>()
        this.PkgClassNs     = new List<string>()
        this.PkgOpaqueTypes = new List<string>()
        let n: int = reg.Packages.Count()
        for i in 0..n {
            let p: LoadedPackage = reg.Packages.Get(i)
            // Dedup by namespace — a TU must reference exactly ONE version
            // of each package. Diamond deps (web pins net-http v0.24.0 while
            // the app resolves v0.25.0) otherwise load BOTH, emitting two
            // `#include`s for the same class — duplicate definitions, or a
            // stale header (e.g. a pre-Windows-port one) breaking the build.
            // Keep the highest version; among equal versions keep the first.
            var skipDup: bool = false
            for k in 0..n {
                if (k == i) { continue }
                let q: LoadedPackage = reg.Packages.Get(k)
                if (q.Ns != p.Ns) { continue }
                let cmp: int = PackageRegistry.CompareCmp(q.Tag, p.Tag)
                if (cmp > 0)               { skipDup = true }
                else if (cmp == 0 && k < i) { skipDup = true }
            }
            if (skipDup) { continue }
            // Add every class the package exposes. Multi-class packages
            // (classes = [...]) get one entry per class, all sharing the
            // same namespace so PkgClassMangledPrefix resolves correctly.
            let pkgCn: int = p.ClassNames.Count()
            for pkgCi in 0..pkgCn {
                this.PkgClasses.Add(p.ClassNames.Get(pkgCi))
                this.PkgClassNs.Add(p.Ns)
            }
            this.PkgHeaders.Add(p.Header)
            this.PkgHeaderNs.Add(p.Ns)
            // C symbols use the full namespace-mangled form so
            // packages can't collide at link time when two of them
            // happen to expose the same short class name.
            //   Redis.Open → Amalgame_Database_NoSQL_Redis_Open
            let fn: int = p.FuncNames.Count()
            for j in 0..fn {
                let fName: string = p.FuncNames.Get(j)
                let cType: string = p.FuncRets.Get(j)
                let mangled: string = PackageRegistry.ManglePackageSymbol(p.Ns, fName)
                this.PkgFuncs.Add(mangled)
                this.PkgFuncCTypes.Add(cType)
                // When the manifest declares the AM-level generic
                // shape via `returns_generic`, register it under
                // each of the package's class names (mangled) so
                // the consumer's `let xs = pg.QueryAll(...)` →
                // chained `.Get(i).Get(j)` propagates layered
                // peeling instead of erasing to `void*`. The flat
                // `[stdlib.functions]` table doesn't disambiguate
                // by class; over-registering across siblings is
                // harmless because the consumer-side lookup is
                // keyed on the receiver's class type, not by
                // brute name match.
                if (j < p.FuncRetsRaw.Count()) {
                    let rawShape: string = p.FuncRetsRaw.Get(j)
                    if (String_Length(rawShape) > 0) {
                        for pkgCk in 0..pkgCn {
                            let mc: string = this.PkgClassMangledPrefix(p.ClassNames.Get(pkgCk))
                            if (String_Length(mc) > 0) {
                                this.MethodRetRawSet(mc, fName, rawShape)
                            }
                        }
                    }
                }
                // Track opaque return types so the consumer can store
                // them in class fields. AmalgameTypeFromC strips a
                // trailing `*` so `AmalgameRedis*` → `AmalgameRedis`.
                // Only record names that look like opaque C types: an
                // identifier starting with an uppercase A-Z and *not*
                // already in PkgClasses (which would re-route via
                // PkgClassMangledPrefix). Skip primitives (the strip
                // is a no-op there, so we'd accidentally hijack `i64`
                // etc. — guard via the C-string-pointer convention).
                if (String_EndsWith(cType, "*")) {
                    let amType: string = PackageRegistry.AmalgameTypeFromC(cType)
                    if (String_Length(amType) > 0) {
                        // De-duplicate — same opaque type can return
                        // from multiple functions in the same package.
                        var seen: bool = false
                        let oc: int = this.PkgOpaqueTypes.Count()
                        for oi in 0..oc {
                            if (this.PkgOpaqueTypes.Get(oi) == amType) { seen = true }
                        }
                        if (!seen) {
                            this.PkgOpaqueTypes.Add(amType)
                        }
                    }
                }
            }
        }
    }

    // Project F: index every CLASS_DECL in the external prog with the
    // file's own namespace, and emit the matching forward-decl typedef
    // so later struct references compile. The class body + methods
    // are intentionally NOT emitted — they're resolved at link time
    // from libamalgame.a.
    //
    // Two-pass: pass 1 registers every external class so that pass 2
    // can resolve cross-class references (e.g. `InstantResult.GetValue`
    // returning `Instant`) via TypeToC → ExternalClassMangled. Without
    // this split, the second class in iteration order isn't yet
    // registered when the first class's method sigs reference it,
    // and the forward decl falls back to the consumer's namespace.
    // Back-compat one-shot entry: process a single external prog
    // end-to-end (typedefs + bodies + method sigs). Suitable for the
    // LSP and any caller that only loads one external. Multi-external
    // callers (main.am compile loop) must use Pass1 / Pass2 separately
    // so cross-external type refs resolve in either direction — see
    // the comment on RegisterExternalProgPass1 below.
    public void RegisterExternalProg(AstNode prog) {
        this.RegisterExternalProgPass1(prog)
        this.RegisterExternalProgPass2(prog)
    }

    // Pass 1 — typedefs only. Register every external class + enum in
    // ExternalClasses / ExternalEnums and emit the matching forward
    // typedef.
    //
    // Why this is separate from Pass 2 (struct bodies + field tracking
    // + method forward decls): when two external packages reference
    // each other's types (e.g. amalgame-web's Route.Handler typed
    // `Closure<WebContext, HttpResponse>` where HttpResponse lives in
    // amalgame-net-http), the type lookups in Pass 2 (TypeToC ↦
    // ExternalClassMangled) only resolve if the referenced class was
    // already added to ExternalClasses. By running Pass 1 across ALL
    // externals before any Pass 2, the registry is fully populated
    // before any TypeToC call fires — the `amalgame.lock` ordering
    // caveat that surfaced during the v0.3.0 web release goes away.
    public void RegisterExternalProgPass1(AstNode prog) {
        let ns: string = prog.Str
        if (String_Length(ns) == 0) { return }
        let nsPrefix: string = String_Replace(ns, ".", "_")
        let kids: List<AstNode> = prog.Children
        let n: int = kids.Count()
        // Bug 9 (v0.8.27): enums get the same treatment — registered
        // in ExternalEnums and emitted as a full `typedef enum _M {…}`
        // (not just a forward) because gcc needs the body to know the
        // type's size when an enum is stored as a field. Algebraic
        // enums (variants with payloads) are NOT supported via the
        // external path yet — they'd need the tagged-union machinery
        // EmitEnum runs in-bundle. The bundled stdlib's user-facing
        // enums (JsonKind, TomlKind) are all simple, so this is fine
        // for the current auto-attach catalog.
        for i in 0..n {
            let decl: AstNode = kids.Get(i)
            if (decl.Kind == NodeKind.CLASS_DECL) {
                let mangled: string = nsPrefix + "_" + decl.Name
                if (decl.Flag2) {
                    // External interface: same fat-value lowering as a
                    // local one, but mangled with the package ns. The
                    // itab struct body is emitted in Pass 2.
                    this.RegisterIface(decl.Name, mangled, decl)
                    this.Out.EmitLine("struct " + mangled + "_itab;")
                    this.Out.EmitLine("typedef struct { const struct " + mangled +
                                      "_itab* itab; void* data; } " + mangled + "; /* external iface */")
                } else {
                    this.ExternalClasses.Add(decl.Name)
                    this.ExternalClassNsArr.Add(nsPrefix)
                    this.Out.EmitLine("typedef struct _" + mangled + " " + mangled + "; /* external */")
                }
            }
            if (decl.Kind == NodeKind.ENUM_DECL) {
                var isAlg: bool = false
                let vc: int = decl.Children.Count()
                for vi in 0..vc {
                    let vm: AstNode = decl.Children.Get(vi)
                    if (String_Length(vm.Str) > 0) { isAlg = true }
                }
                if (isAlg) {
                    // Skip algebraic external enums — emit only the
                    // forward typedef so any param/return type still
                    // type-checks at the C level. Consumer code that
                    // pattern-matches on the variants would need the
                    // full tag enum + union body emitted here; left
                    // as future work.
                    let mangled: string = nsPrefix + "_" + decl.Name
                    this.Out.EmitLine("typedef struct _" + mangled + " " + mangled + "; /* external alg-enum fwd */")
                } else {
                    this.ExternalEnums.Add(decl.Name)
                    this.ExternalEnumNsArr.Add(nsPrefix)
                    let mangled: string = nsPrefix + "_" + decl.Name
                    // Emit the full body so gcc has the enum size for
                    // any field/local of this type.
                    this.Out.EmitLine("typedef enum _" + mangled + " {")
                    this.Out.Indent_()
                    for vi in 0..vc {
                        let vm: AstNode = decl.Children.Get(vi)
                        let memberC: string = mangled + "_" + vm.Name
                        if (vi < vc - 1) {
                            this.Out.EmitLine(memberC + ",")
                        } else {
                            this.Out.EmitLine(memberC)
                        }
                    }
                    this.Out.Dedent()
                    this.Out.EmitLine("} " + mangled + "; /* external */")
                }
            }
        }
    }

    // Pass 2 — struct bodies, field type tracking, method forward
    // decls. MUST be called AFTER Pass 1 has run on every external
    // prog the consumer references, so cross-package type lookups
    // (e.g. `Closure<WebContext, HttpResponse>` where HttpResponse
    // is in a separate package) hit the populated ExternalClasses
    // registry instead of falling back to SymName.
    public void RegisterExternalProgPass2(AstNode prog) {
        let ns: string = prog.Str
        if (String_Length(ns) == 0) { return }
        let nsPrefix: string = String_Replace(ns, ".", "_")
        let kids: List<AstNode> = prog.Children
        let n: int = kids.Count()
        // Emit the struct body for every external class. Bug 9
        // (v0.8.27): pre-fix, only the forward typedef landed in the
        // consumer's .c, so any user code reading `r.Ok` / `r.Value`
        // on a `JsonResult` hit `invalid use of incomplete typedef`.
        // The fields actually live in libamalgame.a's compiled image,
        // and the layout is deterministic (a CLASS_DECL produces one
        // contiguous struct via EmitClass), so mirroring the body
        // verbatim here exposes the fields to gcc without needing
        // accessor shims. Field types are looked up via TypeToC, which
        // already knows pass-1 external typedefs — sibling references
        // (`JsonResult.Value: JsonValue`) resolve cleanly.
        //
        // Also register each field in FieldTypeSet so the cgen's
        // MEMBER dispatch (FieldTypeGet on `<class>.<field>`) gets a
        // non-empty C-type for chained `r.Field.Method()` patterns.
        // Without this, the chain falls back to `void*` erasure and
        // emits wrong methods on the inferred receiver.
        for i in 0..n {
            let decl: AstNode = kids.Get(i)
            if (decl.Kind != NodeKind.CLASS_DECL) { continue }
            let mangled: string = nsPrefix + "_" + decl.Name
            // External interface: emit the itab struct body so consumer
            // code can dispatch through it; no object struct / methods.
            if (decl.Flag2) {
                this.Out.EmitLine("struct " + mangled + "_itab {")
                this.Out.Indent_()
                let imc: int = decl.Children.Count()
                for imi in 0..imc {
                    let im: AstNode = decl.Children.Get(imi)
                    if (im.Kind == NodeKind.METHOD_DECL) {
                        this.Out.EmitLine(this.IfaceFnPtrField(im) + ";")
                    }
                }
                this.Out.Dedent()
                this.Out.EmitLine("};")
                continue
            }
            let members: List<AstNode> = decl.Children
            let mc: int = members.Count()
            // Pre-scan: register field C types before emitting the
            // struct body, so EmitClass-style chained-call dispatch
            // works for fields on this external class too.
            for mi in 0..mc {
                let m: AstNode = members.Get(mi)
                if (m.Kind == NodeKind.VAR_DECL) {
                    let rawType: string = m.Str
                    let ftype: string   = this.TypeToC(rawType)
                    this.FieldTypeSet(mangled, m.Name, ftype)
                    if (String_StartsWith(rawType, "List<")) {
                        let inner: string = String_Substring(rawType, 5, String_Length(rawType) - 6)
                        let elemC: string = this.TypeToC(inner)
                        this.ListElemSet(mangled, m.Name, elemC)
                    }
                    if (String_StartsWith(rawType, "Map<") && String_EndsWith(rawType, ">")) {
                        let mi2: string = String_Substring(rawType, 4, String_Length(rawType) - 5)
                        let mcomma: int = String_IndexOf(mi2, ",")
                        if (mcomma > 0) {
                            let vRaw: string  = String_Substring(mi2, mcomma + 1, String_Length(mi2) - mcomma - 1)
                            let vTrim: string = String_Trim(vRaw)
                            if (String_Length(vTrim) > 0) {
                                this.ListElemSet(mangled, m.Name, this.TypeToC(vTrim))
                            }
                        }
                    }
                    // Typed-Closure field on an external class — record
                    // the return type so MEMBER closure-call dispatch on
                    // chained `obj.Field.Method(args)` patterns can emit
                    // a typed cast. Mirrors EmitClass's same registration.
                    if (String_StartsWith(rawType, "Closure<") && String_EndsWith(rawType, ">")) {
                        let cinner: string = String_Substring(rawType, 8, String_Length(rawType) - 9)
                        let cparts: List<string> = this.SplitTopLevelCommas(cinner)
                        let cpc: int = cparts.Count()
                        if (cpc >= 1) {
                            let crawRet: string = String_Trim(cparts.Get(cpc - 1))
                            this.ListElemSet(mangled + "__closure_ret__", m.Name, this.TypeToC(crawRet))
                        }
                    }
                }
            }
            // Emit the struct body. Empty classes (static helpers like
            // `Path` or `Json`) still get a one-line `struct _X {};`
            // wrapper — gcc accepts the empty body and the type stays
            // a valid pointee, matching how EmitClass handles in-bundle
            // classes that hold no instance fields.
            this.Out.EmitLine("struct _" + mangled + " {")
            this.Out.Indent_()
            // Embed parent fields directly if this class extends another
            // external class (same shape as EmitClass's parent embed).
            let parentName: string = decl.Str
            if (String_Length(parentName) > 0) {
                let parentMangled: string = this.ExternalClassMangled(parentName)
                if (String_Length(parentMangled) > 0) {
                    let pfc: int = this.FieldNames.Count()
                    let pfPrefix: string = parentMangled + "."
                    for pfi in 0..pfc {
                        let pfkey: string = this.FieldNames.Get(pfi)
                        if (String_StartsWith(pfkey, pfPrefix)) {
                            let pfname: string = String_Substring(pfkey, String_Length(pfPrefix), String_Length(pfkey) - String_Length(pfPrefix))
                            let pftype: string = this.FieldCTypes.Get(pfi)
                            this.Out.EmitLine(pftype + " " + pfname + ";")
                            this.FieldTypeSet(mangled, pfname, pftype)
                        }
                    }
                }
            }
            for mi in 0..mc {
                let m: AstNode = members.Get(mi)
                if (m.Kind == NodeKind.VAR_DECL) {
                    let ftype: string = this.TypeToC(m.Str)
                    this.Out.EmitLine(ftype + " " + m.Name + ";")
                }
            }
            this.Out.Dedent()
            this.Out.EmitLine("};")
        }
        // Pass 3: emit method forward decls. All external classes are
        // now in the registry, so cross-class return/param types lower
        // to the correct mangled name.
        for i in 0..n {
            let decl: AstNode = kids.Get(i)
            if (decl.Kind == NodeKind.CLASS_DECL && !decl.Flag2) {
                let mangled: string = nsPrefix + "_" + decl.Name
                let members: List<AstNode> = decl.Children
                let mc: int = members.Count()
                for mi in 0..mc {
                    let m: AstNode = members.Get(mi)
                    if (m.Kind == NodeKind.METHOD_DECL) {
                        let sig: string = this.ExternalMethodSig(m, mangled, decl.Name)
                        this.Out.EmitLine(sig + ";")
                        // Record interface-typed params so the consumer
                        // packs concrete args when calling this external
                        // method / constructor across the package line.
                        if (m.Name == decl.Name) {
                            this.RegisterParamIfaces(mangled + "_new", m)
                        } else {
                            this.RegisterParamIfaces(mangled + "_" + m.Name, m)
                        }
                    }
                }
                // For each interface this external class implements, the
                // itab const lives in the package's own object; declare it
                // extern so a consumer can reference it when packing.
                let impl: string = decl.Str4
                if (String_Length(impl) > 0) {
                    let parts: List<string> = this.SplitTopLevelCommas(impl)
                    let pcI: int = parts.Count()
                    for pii in 0..pcI {
                        var iface: string = String_Trim(parts.Get(pii))
                        let lt: int = String_IndexOf(iface, "<")
                        if (lt >= 0) { iface = String_Substring(iface, 0, lt) }
                        let im2: string = this.IfaceMangledFor(iface)
                        if (String_Length(im2) > 0) {
                            this.Out.EmitLine("extern const struct " + im2 + "_itab " +
                                              this.IfaceItabSym(mangled, im2) + ";")
                        }
                    }
                }
            }
        }
    }

    // Build a C function-pointer signature for an external method.
    // Used by RegisterExternalProg so the host .c gets the right
    // forward decls without going through SymName / MethodSig
    // (which assume the bundle-wide NsPrefix).
    private string ExternalMethodSig(AstNode method, string mangledClass, string shortClassName) {
        let isCtor: bool = method.Name == shortClassName
        let retTypeRaw: string = method.Str
        var retType: string = ""
        if (String_StartsWith(retTypeRaw, "(")) {
            retType = this.TupleStructName(retTypeRaw)
        } else {
            retType = this.TypeToC(retTypeRaw)
        }
        // Register the return type so cross-package chained calls
        // (e.g. `Page.New().SetTitle(...)` where Page lives in an
        // --external facade) can resolve the intermediate receiver
        // type via InferTypeFromExpr → MethodRetGet. Without this,
        // EmitCalleeStr's CALL-on-MEMBER branch falls through to
        // its raw `EmitExprStr(callee.Left) + "_" + mname` fallback,
        // producing the invalid `Type_Method()_Method(...)` C string
        // pattern (the cross-pkg chain bug #2 in ROADMAP_COMPLET).
        // Mirrors the in-bundle registration that EmitForwardDecl
        // does around the MethodRetSet call ~line 1851.
        if (!isCtor) {
            this.MethodRetSet(mangledClass, method.Name, retType)
            this.MethodRetRawSet(mangledClass, method.Name, retTypeRaw)
            // Variadic registration for facade methods, symmetric to the
            // in-bundle path in EmitClass. The mangled callee name here
            // (`mangledClass_method`) matches what EmitCalleeStr emits
            // for package-class dispatch, so the call-site collector
            // fires for cross-package variadic calls too.
            let mpc: int = method.Params.Count()
            if (mpc > 0) {
                let lastP: AstNode = method.Params.Get(mpc - 1)
                if (lastP.Flag) {
                    this.MethodVariadicSet(mangledClass + "_" + method.Name, mpc - 1)
                }
            }
        } else {
            // Variadic constructor across a package boundary. Register
            // under `<mangledClass>_new`, the exact key the NEW_EXPR
            // call-site looks up (`ctorPrefix + "_new"` with ctorPrefix
            // == ExternalClassMangled(tname) == mangledClass). Mirror of
            // the in-bundle ctor registration in EmitConstructorForwards;
            // the ctor signature below already lowers the variadic param
            // to a single `AmalgameList*` (the `p.Flag` branch), so the
            // facade body (compiled via MethodSig) and the consumer's
            // call site agree on the ABI.
            let cpc: int = method.Params.Count()
            if (cpc > 0) {
                let lastCp: AstNode = method.Params.Get(cpc - 1)
                if (lastCp.Flag) {
                    this.MethodVariadicSet(mangledClass + "_new", cpc - 1)
                }
            }
        }
        var sig: string = ""
        if (isCtor) {
            sig = mangledClass + "* " + mangledClass + "_new("
        } else {
            sig = retType + " " + mangledClass + "_" + method.Name + "("
        }
        let isStatic: bool = method.Flag2
        var first: bool = true
        if (!isStatic && !isCtor) {
            sig   = sig + mangledClass + "* self"
            first = false
        }
        let pcount: int = method.Params.Count()
        for i in 0..pcount {
            let p: AstNode = method.Params.Get(i)
            if (!first) { sig = sig + ", " }
            // Variadic facade param lowers to a single `AmalgameList*`,
            // matching the in-bundle MethodSig lowering.
            if (p.Flag) {
                sig = sig + "AmalgameList* " + p.Name
            } else {
                sig = sig + this.TypeToC(p.Str) + " " + p.Name
            }
            first = false
        }
        sig = sig + ")"
        return sig
    }

    // Returns the full mangled C name for an external class
    // (e.g. "Random" → "Amalgame_Random_Random"), or "" if the
    // short name isn't registered as external.
    public string ExternalClassMangled(string tname) {
        let n = this.ExternalClasses.Count()
        for i in 0..n {
            if (this.ExternalClasses.Get(i) == tname) {
                return this.ExternalClassNsArr.Get(i) + "_" + tname
            }
        }
        return ""
    }

    // Bug 9 (v0.8.27): mirror of ExternalClassMangled for enums.
    // Returns the full mangled C name for an external enum
    // (e.g. "JsonKind" → "Amalgame_Formats_Json_JsonKind"), or ""
    // if the short name isn't registered. Used by TypeToC to lower
    // enum-typed fields/params to the bundled namespace.
    public string ExternalEnumMangled(string tname) {
        let n = this.ExternalEnums.Count()
        for i in 0..n {
            if (this.ExternalEnums.Get(i) == tname) {
                return this.ExternalEnumNsArr.Get(i) + "_" + tname
            }
        }
        return ""
    }

    // True iff the short class name was registered via
    // RegisterExternalProg — used by EmitClass / EmitForwardDecl to
    // skip definition emission for externally-supplied classes.
    private bool IsExternalClass(string tname) {
        let n = this.ExternalClasses.Count()
        for i in 0..n {
            if (this.ExternalClasses.Get(i) == tname) { return true }
        }
        return false
    }

    // Look up the mangled-C-symbol prefix for a registered package
    // class. Returns "" if the class isn't in the registry.
    // Build the C symbol prefix for `<Class>.<Method>(...)` calls
    // against a package class. Convention depends on the manifest:
    //   - Single-class packages bake the class into the namespace
    //     (Redis pkg → ns "Amalgame.Database.NoSQL.Redis" + class
    //      "Redis"); C symbols are `<ns>_<method>`. Don't double the
    //      class segment.
    //   - Multi-class packages don't include the class in the
    //     namespace (Tls pkg → ns "Amalgame.Tls" + classes
    //      TlsConfig/TlsContext/TlsStream); C symbols are
    //      `<ns>_<class>_<method>` so the same `_Default` method on
    //      multiple classes can't collide.
    // The "namespace ends with `_<class>`" check disambiguates the
    // two patterns from the same code path.
    // Split a comma-separated list of types, respecting nested `<...>`
    // depth so `List<int>, Map<string, int>, bool` returns 3 parts and
    // not 5. Used by the typed-Closure path (Closure<A1, A2, R>) to
    // peel apart the args + return type without a real parser.
    private List<string> SplitTopLevelCommas(string s) {
        let parts: List<string> = new List<string>()
        let n: int = String_Length(s)
        var depth: int = 0
        var cur: string = ""
        for i in 0..n {
            let ch: string = String_Substring(s, i, 1)
            if (ch == "<") { depth = depth + 1; cur = cur + ch }
            else if (ch == ">") { depth = depth - 1; cur = cur + ch }
            else if (ch == "," && depth == 0) {
                parts.Add(cur)
                cur = ""
            } else {
                cur = cur + ch
            }
        }
        if (String_Length(cur) > 0) { parts.Add(cur) }
        return parts
    }

    private bool IsLocalClass(string tname) {
        let n: int = this.LocalClasses.Count()
        for i in 0..n {
            if (this.LocalClasses.Get(i) == tname) { return true }
        }
        return false
    }

    // ── Interface dispatch helpers (Go-style itab+data) ────
    // An interface-typed value lowers to a 2-word C struct
    // { const <Iface>_itab* itab; void* data; } passed BY VALUE, so
    // objects stay headerless (no per-object cost — non-interface code
    // is byte-identical). A method call `x.m(a)` on an interface value
    // becomes `x.itab->m(x.data, a)`; converting a concrete `c` to the
    // interface packs `(<Iface>){ &<C>__as__<Iface>, (void*)c }`.

    // Register an interface in the parallel registries (idempotent —
    // the external pre-scan and RegisterExternalProgPass1 may both see
    // the same facade).
    private void RegisterIface(string shortName, string mangled, AstNode node) {
        let n: int = this.IfaceMangledNames.Count()
        for i in 0..n {
            if (this.IfaceMangledNames.Get(i) == mangled) { return }
        }
        this.IfaceShortNames.Add(shortName)
        this.IfaceMangledNames.Add(mangled)
        this.IfaceNodes.Add(node)
    }

    // Pre-scan an external program for interface decls and register
    // them (no emission). Called BEFORE BeginMulti so the pkg-class
    // typedef loop can skip interface names (which need the fat-value
    // typedef from RegisterExternalProgPass1, not an opaque struct).
    public void PreNoteInterfaces(AstNode prog) {
        let ns: string = prog.Str
        if (String_Length(ns) == 0) { return }
        let nsPrefix: string = String_Replace(ns, ".", "_")
        let kids: List<AstNode> = prog.Children
        let n: int = kids.Count()
        for i in 0..n {
            let decl: AstNode = kids.Get(i)
            if (decl.Kind == NodeKind.CLASS_DECL && decl.Flag2) {
                this.RegisterIface(decl.Name, nsPrefix + "_" + decl.Name, decl)
            }
        }
    }

    // True if `tname` (raw short or mangled) names a known interface.
    private bool IsInterface(string tname) {
        let n: int = this.IfaceShortNames.Count()
        for i in 0..n {
            if (this.IfaceShortNames.Get(i) == tname) { return true }
            if (this.IfaceMangledNames.Get(i) == tname) { return true }
        }
        return false
    }

    // The C-mangled name of interface `tname` (short or mangled in);
    // "" if not an interface. Lets TypeToC honour the package ns for
    // external interfaces instead of re-applying the consumer's.
    private string IfaceMangledFor(string tname) {
        let n: int = this.IfaceShortNames.Count()
        for i in 0..n {
            if (this.IfaceShortNames.Get(i) == tname) { return this.IfaceMangledNames.Get(i) }
            if (this.IfaceMangledNames.Get(i) == tname) { return this.IfaceMangledNames.Get(i) }
        }
        return ""
    }

    // Find the interface decl node by short or mangled name; null if
    // unknown (e.g. an external interface whose node we didn't capture).
    private AstNode IfaceNodeFor(string nameOrMangled) {
        let n: int = this.IfaceShortNames.Count()
        for i in 0..n {
            if (this.IfaceShortNames.Get(i) == nameOrMangled ||
                this.IfaceMangledNames.Get(i) == nameOrMangled) {
                return this.IfaceNodes.Get(i)
            }
        }
        return null
    }

    // Stable, unit-independent symbol for the itab of (class C, iface I):
    // both the defining unit and any consumer compute the same name from
    // the namespace-qualified mangled class + interface names.
    private string IfaceItabSym(string classMangled, string ifaceMangled) {
        return classMangled + "__as__" + ifaceMangled
    }

    // C function-pointer field for one interface method in the itab
    // struct: `<retC> (*<Name>)(void* self, <paramCs...>)`.
    private string IfaceFnPtrField(AstNode m) {
        var retC: string = this.TypeToC(m.Str)
        var ptr: string = retC + " (*" + m.Name + ")(void* self"
        let pc: int = m.Params.Count()
        for pi in 0..pc {
            let p: AstNode = m.Params.Get(pi)
            ptr = ptr + ", " + this.TypeToC(p.Str)
        }
        ptr = ptr + ")"
        return ptr
    }

    // The cast applied to a concrete method when storing it in an itab
    // slot: `(<retC> (*)(void* self, <paramCs...>))`.
    private string IfaceFnPtrCast(AstNode m) {
        var retC: string = this.TypeToC(m.Str)
        var cast: string = "(" + retC + " (*)(void* self"
        let pc: int = m.Params.Count()
        for pi in 0..pc {
            let p: AstNode = m.Params.Get(pi)
            cast = cast + ", " + this.TypeToC(p.Str)
        }
        cast = cast + "))"
        return cast
    }

    // Record which params of callee `mangled` are interface-typed, so a
    // call site can pack a concrete arg into a fat value. Indexed by AM
    // param position (self excluded), matching expr.Args at call sites.
    private void RegisterParamIfaces(string mangled, AstNode m) {
        let pc: int = m.Params.Count()
        for pi in 0..pc {
            let p: AstNode = m.Params.Get(pi)
            if (this.IsInterface(p.Str)) {
                this.ParamIfaceKeys.Add(mangled + "#" + String_FromInt(pi))
                this.ParamIfaceVals.Add(this.IfaceMangledFor(p.Str))
            }
        }
    }

    // Emit one positional call argument, packing a concrete value into a
    // {itab,data} fat value when the callee's param at `idx` is an
    // interface (and the arg isn't already that interface). Otherwise
    // identical to a plain EmitExprStr — so non-interface args are
    // byte-for-byte unchanged.
    private string CoerceArg(string callee, int idx, AstNode argExpr) {
        let key: string = callee + "#" + String_FromInt(idx)
        let n: int = this.ParamIfaceKeys.Count()
        for i in 0..n {
            if (this.ParamIfaceKeys.Get(i) == key) {
                return this.CoerceToIface(this.ParamIfaceVals.Get(i), argExpr)
            }
        }
        return this.EmitExprStr(argExpr)
    }

    // Pack an expression into a {itab,data} fat value of interface
    // `ifaceMangled`. If the expression is already that (or another)
    // interface value, it passes straight through.
    private string CoerceToIface(string ifaceMangled, AstNode argExpr) {
        let argC: string = this.EmitExprStr(argExpr)
        let argT: string = this.InferTypeFromExpr(argExpr)
        if (this.IsInterface(argT)) { return argC }
        let argClass: string = String_Replace(argT, "*", "")
        let itab: string = this.IfaceItabSym(argClass, ifaceMangled)
        return "(" + ifaceMangled + "){ &" + itab + ", (void*)(" + argC + ") }"
    }

    // A fat interface value is two words, but a generic List/Map slot is
    // a single `void*`. So when an interface value is stored in a generic
    // collection we heap-box it (copy the {itab,data} pair onto the GC
    // heap) and store the pointer; reads deref it back to a fat value.
    private string BoxIface(string ifaceMangled, string fatExpr) {
        return "({ " + ifaceMangled + "* __bx = (" + ifaceMangled
             + "*) code_alloc(sizeof(" + ifaceMangled + ")); *__bx = " + fatExpr
             + "; (void*) __bx; })"
    }

    // Resolve the element C-type of the List a `X.Add/Set/Get` call
    // targets, mirroring the receiver shapes the Get lowering handles
    // (this.Field / var.Field / local var). "" when unknown.
    private string ResolveListElemC(AstNode callee) {
        if (callee.Left == null) { return "" }
        let lkG = callee.Left.Kind
        if (lkG == NodeKind.MEMBER && callee.Left.Left != null) {
            let lll: AstNode = callee.Left.Left
            if (lll.Kind == NodeKind.THIS_EXPR) {
                return this.ListElemGet(this.CurrentClass, callee.Left.Name)
            }
            if (lll.Kind == NodeKind.IDENTIFIER) {
                let bare4: string = String_Replace(this.LocalTypeGet(lll.Name), "*", "")
                return this.ListElemGet(bare4, callee.Left.Name)
            }
        }
        if (lkG == NodeKind.IDENTIFIER) {
            return this.ListElemGet("__local__", callee.Left.Name)
        }
        return ""
    }

    private string PkgClassMangledPrefix(string tname) {
        let n: int = this.PkgClasses.Count()
        for i in 0..n {
            if (this.PkgClasses.Get(i) == tname) {
                let ns: string = this.PkgClassNs.Get(i)
                let mangledNs: string = String_Replace(ns, ".", "_")
                if (mangledNs == tname) { return mangledNs }
                if (String_EndsWith(mangledNs, "_" + tname)) {
                    return mangledNs
                }
                return mangledNs + "_" + tname
            }
        }
        return ""
    }

    // v0.8.38: unified class-name mangling — used wherever a class
    // name needs to be lowered to its C identifier. Resolution order:
    //   1. LocalClasses — current compilation unit owns the body.
    //      SymName() applies the consumer's NsPrefix. This wins over
    //      PkgClasses to handle the self-package-compile case
    //      (the facade.am of a package that's ALSO in its own lock
    //      file, like msgpack — see line 4501 comment).
    //   2. PkgClasses — declared in a [stdlib].classes entry of a
    //      loaded package's manifest. Lower to <pkg-ns>_<tname>.
    //      Catches the split-file pattern (net-http v0.4.6+) where
    //      facade.am has no CLASS_DECL and --external doesn't see
    //      the classes.
    //   3. Fall through to SymName() — bare consumer mangling.
    //
    // Used by TypeToC, InferTypeFromExpr's NEW_EXPR + ClassName.Method
    // branches, and EmitNewExpr's ctor-call composer.
    private string ClassMangledFor(string tname) {
        if (this.IsLocalClass(tname)) {
            return this.SymName(tname)
        }
        let pkgMangled: string = this.PkgClassMangledPrefix(tname)
        if (String_Length(pkgMangled) > 0) {
            return pkgMangled
        }
        return this.SymName(tname)
    }

    private void EmitForwardDecl(AstNode decl) {
        let k = decl.Kind
        if (k == NodeKind.ENUM_DECL) {
            let name = this.SymName(decl.Name)
            // Check if algebraic enum
            var isAlg = false
            let vc = decl.Children.Count()
            for vi in 0..vc {
                let vm = decl.Children.Get(vi)
                if (String_Length(vm.Str) > 0) { isAlg = true }
            }
            if (isAlg) {
                // Register as algebraic enum (value type, not pointer)
                this.EnumNames.Add("__alg__" + name)
                // Emit forward declaration as opaque struct
                this.Out.EmitLine("typedef struct _" + name + " " + name + "; /* alg-enum fwd */")
            } else {
                // Register as simple enum so TypeToC won't add * for this type
                this.EnumNames.Add(decl.Name)
                this.EnumNames.Add(name)
                this.Out.EmitLine("typedef enum _" + name + " " + name + ";")
            }
        }
        if (k == NodeKind.CLASS_DECL) {
            let name = this.SymName(decl.Name)
            if (decl.Flag2) {
                // Interface: lower to a Go-style fat value. Register it,
                // forward-declare the (incomplete) itab struct, and emit
                // the 2-word value typedef. The full itab struct body is
                // emitted in pass 2 (EmitClass), once every class typedef
                // it might reference exists.
                this.RegisterIface(decl.Name, name, decl)
                this.Out.EmitLine("struct " + name + "_itab;")
                this.Out.EmitLine("typedef struct { const struct " + name +
                                  "_itab* itab; void* data; } " + name + ";")
            } else {
                this.Out.EmitLine("typedef struct _" + name + " " + name + ";")
                // Track the short class name so IsLocalClass can give it
                // precedence over a same-named PkgClass (facade-ABI bug).
                this.LocalClasses.Add(decl.Name)
            }
        }
        if (k == NodeKind.INLINE_C) {
            // File-scope `@c { … }` raw block. Emit the body verbatim
            // here in Pass 1 so any `static` state globals or extra
            // libc includes land before the class typedefs / method
            // bodies that reference them. EmitDecl below skips this
            // kind in Pass 2.
            this.Out.EmitLine("/* inline-C top-level */")
            let body = decl.Str
            if (String_Length(body) > 0) {
                let lines: List<string> = String_Split(body, "\n")
                let count = lines.Count()
                for i in 0..count {
                    this.Out.EmitLine(lines.Get(i))
                }
            }
        }
    }

    private void EmitDecl(AstNode decl) {
        let k = decl.Kind
        if (k == NodeKind.ENUM_DECL) { this.EmitEnum(decl) }
        if (k == NodeKind.CLASS_DECL) { this.EmitClass(decl) }
        if (k == NodeKind.INLINE_C_INCLUDE) {
            // `@c_include "<h.h>"` → `#include <h.h>`; quoted form when
            // the argument starts with anything other than `<`. The user
            // controls the bracket style by what they pass.
            let arg = decl.Str
            if (String_Length(arg) > 0 && String_Substring(arg, 0, 1) == "<") {
                this.Out.EmitLine("#include " + arg)
            } else {
                this.Out.EmitLine("#include \"" + arg + "\"")
            }
        }
        if (k == NodeKind.INLINE_C_LINK) {
            // `@c_link "name"` — for v0.7.4 MVP we surface it as a comment
            // so the user knows which `-l<name>` to pass at gcc time.
            // `amc test` may thread these into its internal gcc command
            // in a follow-up; `amc -o` doesn't link at all today.
            this.Out.EmitLine("/* link: -l" + decl.Str + " */")
        }
    }

    private void EmitEnum(AstNode en) {
        let name  = this.SymName(en.Name)
        let count = en.Children.Count()

        // Check if this is an algebraic enum (any variant has payload types)
        var isAlgebraic = false
        for i in 0..count {
            let member = en.Children.Get(i)
            if (String_Length(member.Str) > 0) { isAlgebraic = true }
        }

        if (isAlgebraic) {
            // Emit as tagged union
            // 1. Tag enum
            this.Out.EmitLine("typedef enum {")
            this.Out.Indent_()
            for i in 0..count {
                let member = en.Children.Get(i)
                let mname  = name + "_TAG_" + member.Name
                if (i < count - 1) {
                    this.Out.EmitLine(mname + ",")
                } else {
                    this.Out.EmitLine(mname)
                }
            }
            this.Out.Dedent()
            this.Out.EmitLine("} " + name + "_Tag;")
            this.Out.EmitBlank()

            // 2. Union struct
            this.Out.EmitLine("struct _" + name + " {")
            this.Out.Indent_()
            this.Out.EmitLine(name + "_Tag tag;")
            this.Out.EmitLine("union {")
            this.Out.Indent_()
            for i in 0..count {
                let member = en.Children.Get(i)
                let payloads = member.Str
                if (String_Length(payloads) > 0) {
                    this.Out.EmitLine("struct {")
                    this.Out.Indent_()
                    // Split payload types by comma
                    var pi = 0
                    var pcur = ""
                    var pci  = 0
                    let plen = String_Length(payloads)
                    while (pci <= plen) {
                        var pch = ""
                        if (pci < plen) { pch = String_Substring(payloads, pci, 1) }
                        if (pch == "," || pci == plen) {
                            if (String_Length(pcur) > 0) {
                                this.Out.EmitLine(this.TypeToC(pcur) + " _" + String_FromInt(pi) + ";")
                                pi = pi + 1
                                pcur = ""
                            }
                        } else { pcur = pcur + pch }
                        pci = pci + 1
                    }
                    this.Out.Dedent()
                    this.Out.EmitLine("} " + member.Name + ";")
                } else {
                    this.Out.EmitLine("int " + member.Name + "_dummy;")
                }
            }
            this.Out.Dedent()
            this.Out.EmitLine("};")
            this.Out.Dedent()
            this.Out.EmitLine("};")
            this.Out.EmitBlank()

            // 3. Constructor functions
            for i in 0..count {
                let member = en.Children.Get(i)
                let payloads = member.Str
                var params = ""
                var fields = ""
                if (String_Length(payloads) > 0) {
                    var pi2 = 0
                    var pcur2 = ""
                    var pci2  = 0
                    let plen2 = String_Length(payloads)
                    while (pci2 <= plen2) {
                        var pch2 = ""
                        if (pci2 < plen2) { pch2 = String_Substring(payloads, pci2, 1) }
                        if (pch2 == "," || pci2 == plen2) {
                            if (String_Length(pcur2) > 0) {
                                let ct = this.TypeToC(pcur2)
                                let pname = "_" + String_FromInt(pi2)
                                if (pi2 > 0) { params = params + ", " fields = fields + ", " }
                                params = params + ct + " " + pname
                                fields = fields + pname
                                pi2 = pi2 + 1
                                pcur2 = ""
                            }
                        } else { pcur2 = pcur2 + pch2 }
                        pci2 = pci2 + 1
                    }
                }
                let ctorSig = "static inline " + name + " " + name + "_" + member.Name + "(" + params + ")"
                this.Out.EmitLine(ctorSig + " {")
                this.Out.Indent_()
                this.Out.EmitLine(name + " __v;")
                this.Out.EmitLine("__v.tag = " + name + "_TAG_" + member.Name + ";")
                if (String_Length(fields) > 0) {
                    // Set fields
                    var pi3 = 0
                    var pcur3 = ""
                    var pci3  = 0
                    let payloads3 = member.Str
                    let plen3 = String_Length(payloads3)
                    while (pci3 <= plen3) {
                        var pch3 = ""
                        if (pci3 < plen3) { pch3 = String_Substring(payloads3, pci3, 1) }
                        if (pch3 == "," || pci3 == plen3) {
                            if (pi3 >= 0) {
                                let fidx = String_FromInt(pi3)
                                this.Out.EmitLine("__v." + member.Name + "._" + fidx + " = _" + fidx + ";")
                                pi3 = pi3 + 1
                            }
                            pcur3 = ""
                        } else { pcur3 = pcur3 + pch3 }
                        pci3 = pci3 + 1
                    }
                }
                this.Out.EmitLine("return __v;")
                this.Out.Dedent()
                this.Out.EmitLine("}")
                this.Out.EmitBlank()
            }

            // Register as algebraic enum for type lookups
            this.EnumNames.Add("__alg__" + name)
        } else {
            // Simple enum — original C enum
            this.Out.EmitLine("enum _" + name + " {")
            this.Out.Indent_()
            for i in 0..count {
                let member = en.Children.Get(i)
                let mname  = name + "_" + member.Name
                if (i < count - 1) {
                    this.Out.EmitLine(mname + ",")
                } else {
                    this.Out.EmitLine(mname)
                }
            }
            this.Out.Dedent()
            this.Out.EmitLine("};")
            this.Out.EmitBlank()
        }
    }

    private void EmitClass(AstNode cls) {
        let name    = this.SymName(cls.Name)
        let members = cls.Children.Count()

        // Interface: emit the itab struct body (one fn-ptr per method, in
        // declaration order = stable slot numbering) and nothing else —
        // no object struct, no _new(), no method stubs. Dispatch happens
        // through the itab at call sites.
        if (cls.Flag2) {
            this.Out.EmitLine("struct " + name + "_itab {")
            this.Out.Indent_()
            for i in 0..members {
                let im = cls.Children.Get(i)
                if (im.Kind == NodeKind.METHOD_DECL) {
                    this.Out.EmitLine(this.IfaceFnPtrField(im) + ";")
                    // Register the return type so InferTypeFromExpr can
                    // type `iface.Method()` — without it, `x.Name() == s`
                    // on a string-returning interface method lowered to a
                    // pointer compare instead of code_string_equals.
                    this.MethodRetSet(name, im.Name, this.TypeToC(im.Str))
                    this.MethodRetRawSet(name, im.Name, im.Str)
                }
            }
            this.Out.Dedent()
            this.Out.EmitLine("};")
            this.Out.EmitBlank()
            return
        }

        // Track current class for field-type lookups inside methods
        this.CurrentClass = name

        // Record field C types for later method emission
        for i in 0..members {
            let m  = cls.Children.Get(i)
            let mk = m.Kind
            if (mk == NodeKind.VAR_DECL) {
                let rawType = m.Str
                let ftype = this.TypeToC(rawType)
                this.FieldTypeSet(name, m.Name, ftype)
                // Track element type for List<T> fields
                if (String_StartsWith(rawType, "List<")) {
                    // Extract T from "List<T>"
                    let inner = String_Substring(rawType, 5, String_Length(rawType) - 6)
                    let elemC = this.TypeToC(inner)
                    this.ListElemSet(name, m.Name, elemC)
                }
                // Track value type for Map<K,V> fields (Bug 2 follow-up,
                // v0.8.23): without this, `this.entries.Get(k)` falls
                // back to `(void*)` cast for class-field maps.
                if (String_StartsWith(rawType, "Map<") && String_EndsWith(rawType, ">")) {
                    let mi = String_Substring(rawType, 4, String_Length(rawType) - 5)
                    let mc = String_IndexOf(mi, ",")
                    if (mc > 0) {
                        let vRaw = String_Substring(mi, mc + 1, String_Length(mi) - mc - 1)
                        let vTrim = String_Trim(vRaw)
                        if (String_Length(vTrim) > 0) {
                            this.ListElemSet(name, m.Name, this.TypeToC(vTrim))
                        }
                    }
                }
                // Track return type for typed-Closure fields
                // (Closure<A, R> / Closure<A1, A2, R> / ...).
                // Without this, `this.Handler(req)` lowers as
                // `(i64)(intptr_t)AmalgameClosure_call1(...)` and gcc
                // complains when assigning the result to a pointer-
                // typed local. Read by the MEMBER closure-call branch
                // in EmitExprStr to emit a typed cast.
                if (String_StartsWith(rawType, "Closure<") && String_EndsWith(rawType, ">")) {
                    let cinner = String_Substring(rawType, 8, String_Length(rawType) - 9)
                    let cparts: List<string> = this.SplitTopLevelCommas(cinner)
                    let cpc: int = cparts.Count()
                    if (cpc >= 1) {
                        let crawRet = String_Trim(cparts.Get(cpc - 1))
                        this.ListElemSet(name + "__closure_ret__", m.Name, this.TypeToC(crawRet))
                    }
                }
            }
        }

        // Struct fields
        this.Out.EmitLine("struct _" + name + " {")
        this.Out.Indent_()
        // Embed parent fields directly if this class extends another
        let parentName = cls.Str
        if (String_Length(parentName) > 0) {
            let parentC = this.SymName(parentName)
            // Copy parent field declarations into child struct
            let pfc = this.FieldNames.Count()
            let pfPrefix = parentC + "."
            for pfi in 0..pfc {
                let pfkey = this.FieldNames.Get(pfi)
                if (String_StartsWith(pfkey, pfPrefix)) {
                    let pfname = String_Substring(pfkey, String_Length(pfPrefix), String_Length(pfkey) - String_Length(pfPrefix))
                    let pftype = this.FieldCTypes.Get(pfi)
                    this.Out.EmitLine(pftype + " " + pfname + ";")
                    // Register in child's field table for method lookup
                    this.FieldTypeSet(name, pfname, pftype)
                }
            }
        }
        for i in 0..members {
            let m  = cls.Children.Get(i)
            let mk = m.Kind
            if (mk == NodeKind.VAR_DECL) {
                let ftype = this.TypeToC(m.Str)
                this.Out.EmitLine(ftype + " " + m.Name + ";")
            }
        }
        this.Out.Dedent()
        this.Out.EmitLine("};")
        this.Out.EmitBlank()

        // Forward declare non-constructor methods only
        for i in 0..members {
            let m  = cls.Children.Get(i)
            let mk = m.Kind
            if (mk == NodeKind.METHOD_DECL) {
                if (m.Name != cls.Name && m.Flag3) {
                    // async fn → env struct + fiber + wrapper forwards,
                    // and registers the future-channel return type.
                    this.EmitAsyncForwards(m, name)
                } else if (m.Name != cls.Name) {
                    let sig     = this.MethodSig(m, name)
                    let isPublic = m.Flag
                    // Register return type for inference (both the C
                    // type and the raw Amalgame type — the raw form
                    // preserves `List<int>` / `Map<K,V>` so callers can
                    // propagate the generic argument).
                    let retC = this.TypeToC(m.Str)
                    this.MethodRetSet(name, m.Name, retC)
                    this.MethodRetRawSet(name, m.Name, m.Str)
                    // Variadic registration: if the last param carries the
                    // variadic flag, record the mangled callee name with
                    // the count of fixed params before it. The mangled
                    // name matches what EmitCalleeStr produces for local /
                    // static / instance dispatch (SymName(class)_method).
                    let mpc: int = m.Params.Count()
                    if (mpc > 0) {
                        let lastP: AstNode = m.Params.Get(mpc - 1)
                        if (lastP.Flag) {
                            this.MethodVariadicSet(name + "_" + m.Name, mpc - 1)
                        }
                    }
                    // Decorators (Str2) → C attributes on the prototype.
                    var attrs = ""
                    let decos = m.Str2
                    if (String_Length(decos) > 0) {
                        if (String_Contains("," + decos + ",", ",deprecated,")) {
                            attrs = " __attribute__((deprecated))"
                        }
                    }
                    if (isPublic) {
                        this.Out.EmitLine(sig + attrs + ";")
                    } else {
                        this.Out.EmitLine("static " + sig + attrs + ";")
                    }
                }
            }
        }
        this.Out.EmitBlank()

        // Constructor — find the constructor method (Name == class name)
        // Build _new() signature with constructor params
        var ctorFound = false
        for i in 0..members {
            let m  = cls.Children.Get(i)
            let mk = m.Kind
            if (mk == NodeKind.METHOD_DECL) {
                if (m.Name == cls.Name) {
                    ctorFound = true
                    // Build _new(params...) signature
                    var ctorSig = name + "* " + name + "_new("
                    let pcount  = m.Params.Count()
                    var first   = true
                    for pi in 0..pcount {
                        let p = m.Params.Get(pi)
                        if (!first) { ctorSig = ctorSig + ", " }
                        // Variadic ctor param → single `AmalgameList*`
                        // (must match EmitConstructorForwards + MethodSig).
                        if (p.Flag) {
                            ctorSig = ctorSig + "AmalgameList* " + p.Name
                        } else {
                            ctorSig = ctorSig + this.TypeToC(p.Str) + " " + p.Name
                        }
                        first = false
                    }
                    ctorSig = ctorSig + ")"
                    this.Out.EmitLine(ctorSig + " {")
                    this.Out.Indent_()
                    this.Out.EmitLine(name + "* self = (" + name + "*) " + this.AllocFn() + "(sizeof(" + name + "));")
                    // Emit constructor body with param types tracked
                    this.LocalTypeClear()
                    this.LocalTypeSet("self", name + "*")
                    for pi in 0..pcount {
                        let p = m.Params.Get(pi)
                        this.LocalTypeSet(p.Name, this.TypeToC(p.Str))
                    }
                    if (m.Body != null) {
                        this.EmitBlock(m.Body)
                    } else {
                        // Body-less constructor (data class / record): auto-assign
                        // every param that matches a declared field. ParseDataClass
                        // adds fields and ctor params with the same names, so this
                        // produces `self->X = X` lines without needing the user to
                        // write them. Plain user-written constructors normally
                        // come with a body and skip this path.
                        for pi in 0..pcount {
                            let p = m.Params.Get(pi)
                            // Confirm there's a field with the same name to assign to
                            var hasField = false
                            for fi in 0..members {
                                let f = cls.Children.Get(fi)
                                if (f.Kind == NodeKind.VAR_DECL && f.Name == p.Name) {
                                    hasField = true
                                }
                            }
                            if (hasField) {
                                this.Out.EmitLine("self->" + p.Name + " = " + p.Name + ";")
                            }
                        }
                    }
                    this.LocalTypeClear()
                    this.Out.EmitLine("return self;")
                    this.Out.Dedent()
                    this.Out.EmitLine("}")
                    this.Out.EmitBlank()
                }
            }
        }
        // No-args _new() if no constructor defined
        if (!ctorFound) {
            this.Out.EmitLine(name + "* " + name + "_new() {")
            this.Out.Indent_()
            this.Out.EmitLine(name + "* self = (" + name + "*) " + this.AllocFn() + "(sizeof(" + name + "));")
            this.Out.EmitLine("return self;")
            this.Out.Dedent()
            this.Out.EmitLine("}")
            this.Out.EmitBlank()
        }

        // Non-constructor methods
        for j in 0..members {
            let m2  = cls.Children.Get(j)
            let mk2 = m2.Kind
            if (mk2 == NodeKind.METHOD_DECL) {
                if (m2.Name != cls.Name && m2.Flag3) {
                    // async fn → impl + fiber trampoline + wrapper bodies.
                    this.EmitAsyncMethod(m2, name)
                } else if (m2.Name != cls.Name) {
                    this.EmitMethod(m2, name)
                }
            }
        }

        // Interface dispatch tables: for each interface this class
        // implements (Str4 CSV), emit a const itab wiring the interface's
        // ordered methods to this class's concrete methods. const → lands
        // in .rodata (flash on MCU); exported so a consumer in another
        // unit can reference it when packing a value.
        this.EmitClassItabs(cls, name)
    }

    // Emit `const struct <I>_itab <C>__as__<I> = { &C_m, … };` for every
    // interface C implements. Skips interfaces whose node we can't see.
    private void EmitClassItabs(AstNode cls, string name) {
        let impl: string = cls.Str4
        if (String_Length(impl) == 0) { return }
        let parts: List<string> = this.SplitTopLevelCommas(impl)
        let pc: int = parts.Count()
        for ii in 0..pc {
            var iface: string = String_Trim(parts.Get(ii))
            // Strip any generic args ("IComparable<int>" → "IComparable").
            let lt: int = String_IndexOf(iface, "<")
            if (lt >= 0) { iface = String_Substring(iface, 0, lt) }
            if (String_Length(iface) == 0) { continue }
            let inode: AstNode = this.IfaceNodeFor(iface)
            if (inode == null) { continue }
            let imangled: string = this.IfaceMangledFor(iface)
            let sym: string = this.IfaceItabSym(name, imangled)
            var line: string = "const struct " + imangled + "_itab " + sym + " = { "
            let mc: int = inode.Children.Count()
            var first: bool = true
            for mi in 0..mc {
                let m: AstNode = inode.Children.Get(mi)
                if (m.Kind != NodeKind.METHOD_DECL) { continue }
                if (!first) { line = line + ", " }
                line = line + this.IfaceFnPtrCast(m) + " " + name + "_" + m.Name
                first = false
            }
            line = line + " };"
            this.Out.EmitLine(line)
        }
        this.Out.EmitBlank()
    }

    // Generate a C struct name for a tuple type like "(int,string)"
    private string TupleStructName(string tupleType) {
        // "(int,string)" → "Tuple2_i64_code_string"
        let inner = String_Substring(tupleType, 1, String_Length(tupleType) - 2)
        let parts = String_Replace(inner, " ", "")
        var result = ""
        var count  = 0
        var i2     = 0
        let len2   = String_Length(parts)
        var cur    = ""
        while (i2 <= len2) {
            var ch = ""
            if (i2 < len2) { ch = String_Substring(parts, i2, 1) }
            if (ch == "," || i2 == len2) {
                if (String_Length(cur) > 0) {
                    count = count + 1
                    result = result + "_" + this.TypeToC(cur)
                    cur = ""
                }
            } else {
                cur = cur + ch
            }
            i2 = i2 + 1
        }
        return "Tuple" + String_FromInt(count) + result
    }

    // Emit a struct typedef for a tuple type if not already emitted
    private void EnsureTupleStruct(string tupleType) {
        let sname = this.TupleStructName(tupleType)
        // Check if already emitted (simple: check if in enum names list as marker)
        let n = this.EnumNames.Count()
        for i in 0..n {
            if (this.EnumNames.Get(i) == "__tuple__" + sname) { return }
        }
        this.EnumNames.Add("__tuple__" + sname)
        // Parse types from "(t1,t2,...)"
        let inner = String_Substring(tupleType, 1, String_Length(tupleType) - 2)
        let parts = String_Replace(inner, " ", "")
        this.Out.EmitLine("typedef struct {")
        var idx = 0
        var cur = ""
        var i2  = 0
        let len2 = String_Length(parts)
        while (i2 <= len2) {
            var ch = ""
            if (i2 < len2) { ch = String_Substring(parts, i2, 1) }
            if (ch == "," || i2 == len2) {
                if (String_Length(cur) > 0) {
                    this.Out.EmitLine("    " + this.TypeToC(cur) + " _" + String_FromInt(idx) + ";")
                    idx = idx + 1
                    cur = ""
                }
            } else { cur = cur + ch }
            i2 = i2 + 1
        }
        this.Out.EmitLine("} " + sname + ";")
    }

    private string MethodSig(AstNode method, string className) {
        let retTypeRaw = method.Str
        var retType    = ""
        // Tuple return type: "(int,string)"
        if (String_StartsWith(retTypeRaw, "(")) {
            this.EnsureTupleStruct(retTypeRaw)
            retType = this.TupleStructName(retTypeRaw)
        } else {
            retType = this.TypeToC(retTypeRaw)
        }
        let isStatic = method.Flag2
        var sig      = retType + " " + className + "_" + method.Name + "("
        var first    = true
        if (!isStatic) {
            sig   = sig + className + "* self"
            first = false
        }
        let pcount = method.Params.Count()
        for i in 0..pcount {
            let p  = method.Params.Get(i)
            if (!first) { sig = sig + ", " }
            // A variadic param `...xs: T` lowers to a single
            // `AmalgameList*` holding the gathered T elements.
            if (p.Flag) {
                sig = sig + "AmalgameList* " + p.Name
            } else {
                sig = sig + this.TypeToC(p.Str) + " " + p.Name
            }
            first = false
        }
        sig = sig + ")"
        return sig
    }

    // ── async fn lowering (v0.8.70) ───────────────────
    //
    // `async fn Foo(p): R` on class C (mangled `name`) lowers to THREE
    // C functions so a call site stays a plain call:
    //   R    name_Foo__impl(C* self, P p)   — the real body
    //   void* name_Foo__fiber(envRaw, arg)  — closure trampoline: runs
    //         impl, ChannelSend's the (boxed) result into the future
    //   chan name_Foo(C* self, P p)         — the PUBLIC wrapper, keeps
    //         the normal mangled name, spawns the fiber, returns the
    //         future channel
    // The wrapper's registered return type is `AmalgameAsyncChannel*`, so
    // `let f = obj.Foo(p)` types `f` as a future; `await f` lowers to a
    // ChannelReceive unboxed to R (R recovered via the __async_ret__ /
    // __async_future__ tracking tables).
    private string AsyncEnvName(string mangledClass, string mname) {
        return "AsyncEnv_" + mangledClass + "_" + mname
    }

    // Signature of the real-body `__impl` function: identical to a normal
    // method sig but the C name gains the `__impl` suffix and it keeps the
    // declared return type R.
    private string AsyncImplSig(AstNode method, string className) {
        let retTypeRaw = method.Str
        var retType    = ""
        if (String_StartsWith(retTypeRaw, "(")) {
            this.EnsureTupleStruct(retTypeRaw)
            retType = this.TupleStructName(retTypeRaw)
        } else {
            retType = this.TypeToC(retTypeRaw)
        }
        if (retType == "void") { retType = "void" }
        var sig   = retType + " " + className + "_" + method.Name + "__impl("
        var first = true
        if (!method.Flag2) {
            sig   = sig + className + "* self"
            first = false
        }
        let pcount = method.Params.Count()
        for i in 0..pcount {
            let p = method.Params.Get(i)
            if (!first) { sig = sig + ", " }
            if (p.Flag) {
                sig = sig + "AmalgameList* " + p.Name
            } else {
                sig = sig + this.TypeToC(p.Str) + " " + p.Name
            }
            first = false
        }
        sig = sig + ")"
        return sig
    }

    // Signature of the public wrapper: same params as the method, but the
    // return type is forced to the future channel.
    private string AsyncWrapperSig(AstNode method, string className) {
        var sig   = "AmalgameAsyncChannel* " + className + "_" + method.Name + "("
        var first = true
        if (!method.Flag2) {
            sig   = sig + className + "* self"
            first = false
        }
        let pcount = method.Params.Count()
        for i in 0..pcount {
            let p = method.Params.Get(i)
            if (!first) { sig = sig + ", " }
            if (p.Flag) {
                sig = sig + "AmalgameList* " + p.Name
            } else {
                sig = sig + this.TypeToC(p.Str) + " " + p.Name
            }
            first = false
        }
        sig = sig + ")"
        return sig
    }

    // C type of the awaited result R for an async method (used to unbox
    // ChannelReceive). Empty string for void async fns.
    private string AsyncRetCType(AstNode method) {
        let retTypeRaw = method.Str
        if (String_StartsWith(retTypeRaw, "(")) {
            return this.TupleStructName(retTypeRaw)
        }
        return this.TypeToC(retTypeRaw)
    }

    // Emit the env-struct typedef + fiber-trampoline + wrapper forward
    // decls for one async method, and register its return type as the
    // future channel (plus __async_ret__ = R for await unboxing).
    // Called from EmitClassForwards so it runs before any body.
    private void EmitAsyncForwards(AstNode method, string mangledClass) {
        let mname   = method.Name
        let envName = this.AsyncEnvName(mangledClass, mname)
        let retC    = this.AsyncRetCType(method)
        // Diagnostic: `async fn` / `await` desugar to Amalgame.Async
        // runtime calls. If the user forgot `import Amalgame.Async`, the
        // package header (which defines AMALGAME_ASYNC_H) isn't included,
        // so this fires a readable compile error instead of a wall of
        // "unknown type AmalgameAsyncChannel" noise. Harmless to repeat.
        this.Out.EmitLine("#ifndef AMALGAME_ASYNC_H")
        this.Out.EmitLine("#error \"async/await requires: import Amalgame.Async  (amc package add async)\"")
        this.Out.EmitLine("#endif")
        // env struct: self (if instance) + each param + the future channel
        this.Out.EmitLine("typedef struct " + envName + " {")
        this.Out.Indent_()
        if (!method.Flag2) {
            this.Out.EmitLine(mangledClass + "* self;")
        }
        let pcount = method.Params.Count()
        for i in 0..pcount {
            let p = method.Params.Get(i)
            if (p.Flag) {
                this.Out.EmitLine("AmalgameList* " + p.Name + ";")
            } else {
                this.Out.EmitLine(this.TypeToC(p.Str) + " " + p.Name + ";")
            }
        }
        this.Out.EmitLine("AmalgameAsyncChannel* __ch;")
        this.Out.Dedent()
        this.Out.EmitLine("} " + envName + ";")
        // forward decls: impl, fiber, wrapper
        let isPublic = method.Flag
        var implPrefix = "static "
        if (isPublic) { implPrefix = "" }
        this.Out.EmitLine(implPrefix + this.AsyncImplSig(method, mangledClass) + ";")
        this.Out.EmitLine("static void* " + mangledClass + "_" + mname + "__fiber(void* __envRaw, void* __arg);")
        if (isPublic) {
            this.Out.EmitLine(this.AsyncWrapperSig(method, mangledClass) + ";")
        } else {
            this.Out.EmitLine("static " + this.AsyncWrapperSig(method, mangledClass) + ";")
        }
        // Registration: the public name returns a future channel; await
        // recovers R from __async_ret__ keyed by the mangled C function
        // name (exactly what EmitCalleeStr produces for the call site).
        this.MethodRetSet(mangledClass, mname, "AmalgameAsyncChannel*")
        this.MethodRetRawSet(mangledClass, mname, "AmalgameAsyncChannel*")
        this.ListElemSet("__async_ret__", mangledClass + "_" + mname, retC)
    }

    // Emit the three function BODIES for one async method. Called from
    // EmitClass (bodies pass) in place of EmitMethod.
    private void EmitAsyncMethod(AstNode method, string mangledClass) {
        let mname   = method.Name
        let envName = this.AsyncEnvName(mangledClass, mname)
        let retC    = this.AsyncRetCType(method)
        let isVoid  = (retC == "void" || String_Length(retC) == 0)
        let isPublic = method.Flag
        var implPrefix = "static "
        if (isPublic) { implPrefix = "" }

        // 1. impl — the real body, lowered exactly like a normal method.
        if (String_StartsWith(method.Str, "(")) {
            this.CurrentRetType = this.TupleStructName(method.Str)
        } else {
            this.CurrentRetType = ""
        }
        this.Out.EmitLine(implPrefix + this.AsyncImplSig(method, mangledClass) + " {")
        this.Out.Indent_()
        this.LocalTypeClear()
        if (!method.Flag2) {
            this.LocalTypeSet("self", mangledClass + "*")
        }
        let pcount = method.Params.Count()
        for i in 0..pcount {
            let p = method.Params.Get(i)
            if (p.Flag) {
                this.LocalTypeSet(p.Name, "AmalgameList*")
                this.TrackGenericLocal(p.Name, "List<" + p.Str + ">")
            } else {
                this.LocalTypeSet(p.Name, this.TypeToC(p.Str))
                this.TrackGenericLocal(p.Name, p.Str)
            }
        }
        if (method.Body != null) {
            this.EmitBlock(method.Body)
        }
        this.LocalTypeClear()
        this.Out.Dedent()
        this.Out.EmitLine("}")
        this.Out.EmitBlank()

        // 2. fiber trampoline — closure ABI (envRaw, arg) → void*.
        this.Out.EmitLine("static void* " + mangledClass + "_" + mname + "__fiber(void* __envRaw, void* __arg) {")
        this.Out.Indent_()
        this.Out.EmitLine("(void)__arg;")
        this.Out.EmitLine(envName + "* __e = (" + envName + "*)__envRaw;")
        var callArgs = ""
        var firstA = true
        if (!method.Flag2) {
            callArgs = "__e->self"
            firstA = false
        }
        for i in 0..pcount {
            let p = method.Params.Get(i)
            if (!firstA) { callArgs = callArgs + ", " }
            callArgs = callArgs + "__e->" + p.Name
            firstA = false
        }
        let implCall = mangledClass + "_" + mname + "__impl(" + callArgs + ")"
        if (isVoid) {
            this.Out.EmitLine(implCall + ";")
            this.Out.EmitLine("Amalgame_Async_ChannelSend(__e->__ch, 0);")
        } else {
            this.Out.EmitLine(retC + " __r = " + implCall + ";")
            this.Out.EmitLine("Amalgame_Async_ChannelSend(__e->__ch, " + this.BoxAsVoidI64("__r") + ");")
        }
        this.Out.EmitLine("return (void*)0;")
        this.Out.Dedent()
        this.Out.EmitLine("}")
        this.Out.EmitBlank()

        // 3. wrapper — spawns the fiber, returns the future channel.
        this.Out.EmitLine(implPrefix + this.AsyncWrapperSig(method, mangledClass) + " {")
        this.Out.Indent_()
        this.Out.EmitLine("AmalgameAsyncChannel* __ch = Amalgame_Async_ChannelNew(1);")
        this.Out.EmitLine(envName + "* __e = (" + envName + "*)code_alloc(sizeof(" + envName + "));")
        if (!method.Flag2) {
            this.Out.EmitLine("__e->self = self;")
        }
        for i in 0..pcount {
            let p = method.Params.Get(i)
            this.Out.EmitLine("__e->" + p.Name + " = " + p.Name + ";")
        }
        this.Out.EmitLine("__e->__ch = __ch;")
        this.Out.EmitLine("Amalgame_Async_FiberSpawn(AmalgameClosure_new((void*)" + mangledClass + "_" + mname + "__fiber, __e), 0);")
        this.Out.EmitLine("return __ch;")
        this.Out.Dedent()
        this.Out.EmitLine("}")
        this.Out.EmitBlank()
    }

    // Box a value as the i64 expected by ChannelSend. Pointers and
    // scalars both round-trip through intptr_t.
    private string BoxAsVoidI64(string expr) {
        return "(i64)(intptr_t)(" + expr + ")"
    }

    // Recover the awaited result type R for `await <operand>`.
    //   - operand is a CALL → the callee mangles to an async wrapper name;
    //     look it up in __async_ret__ (keyed by that C function name).
    //   - operand is an IDENTIFIER → a future local tracked at its `let`;
    //     look it up in __async_future__.
    // Empty string when unknown (caller falls back to a raw i64 receive).
    private string ResolveAwaitRetC(AstNode operand) {
        if (operand == null) { return "" }
        let k = operand.Kind
        if (k == NodeKind.CALL) {
            let cs = this.EmitCalleeStr(operand.Left)
            return this.ListElemGet("__async_ret__", cs)
        }
        if (k == NodeKind.IDENTIFIER) {
            return this.ListElemGet("__async_future__", operand.Name)
        }
        return ""
    }

    private void EmitMethod(AstNode method, string className) {
        let sig      = this.MethodSig(method, className)
        let isPublic = method.Flag
        var prefix   = ""
        if (!isPublic) { prefix = "static " }
        // Decorators (comma-separated in Str2) → C attributes / inlining hints.
        let decos = method.Str2
        if (String_Length(decos) > 0) {
            if (String_Contains("," + decos + ",", ",inline,")) {
                prefix = prefix + "inline "
            }
        }
        // Track current return type for tuple returns
        if (String_StartsWith(method.Str, "(")) {
            this.CurrentRetType = this.TupleStructName(method.Str)
            // Register method return type for later lookup in tuple destructuring
            this.MethodRetSet(className, method.Name, method.Str)
            this.MethodRetRawSet(className, method.Name, method.Str)
        } else {
            this.CurrentRetType = ""
        }
        this.Out.EmitLine(prefix + sig + " {")
        this.Out.Indent_()
        // Reset local type table for this method scope
        this.LocalTypeClear()
        // Seed with 'self' if instance method
        let isStatic = method.Flag2
        if (!isStatic) {
            this.LocalTypeSet("self", className + "*")
            // The user-side build passes -Wno-unused-parameter so we
            // don't need the `(void)self;` boilerplate any more —
            // dropping it shrinks amc_lib.c by ~500 lines on its own.
        }
        // Seed with parameters. Generic params (List<T>, Map<K,V>)
        // also seed the elem-type table so `xs.Get(i)` / `m.Get(k)`
        // inside the body lower with a typed cast instead of falling
        // back to void*. Unused-parameter warnings are silenced by
        // the gcc flag.
        let pcount = method.Params.Count()
        for i in 0..pcount {
            let p = method.Params.Get(i)
            // A variadic param is a `List<T>` inside the body: register
            // it as an AmalgameList* local and seed elem-type tracking so
            // `xs.Get(i)` / `for v in xs` lower with the right cast.
            if (p.Flag) {
                this.LocalTypeSet(p.Name, "AmalgameList*")
                this.TrackGenericLocal(p.Name, "List<" + p.Str + ">")
            } else {
                this.LocalTypeSet(p.Name, this.TypeToC(p.Str))
                this.TrackGenericLocal(p.Name, p.Str)
            }
        }
        if (method.Body != null) {
            this.EmitBlock(method.Body)
        }
        this.LocalTypeClear()
        this.Out.Dedent()
        this.Out.EmitLine("}")
        this.Out.EmitBlank()
    }

    // ── Block & Statements ────────────────────────────

    // Recursive if/else-if/else emitter — produces clean "} else if (...) {" chains
    // Extract a single expression string from an if-expr branch block
    private string EmitIfBranch(AstNode block) {
        if (block == null) { return "0" }
        if (block.Kind == NodeKind.BLOCK) {
            let kids = block.Children
            if (kids.Count() > 0) {
                return this.EmitExprStr(kids.Get(0))
            }
            return "0"
        }
        return this.EmitExprStr(block)
    }

    private void EmitMatch(AstNode stmt) {
        let subject = stmt.Left
        let subjectStr = this.EmitExprStr(subject)
        // Determine if subject is an algebraic enum
        var subjectType = ""
        if (subject != null && subject.Kind == NodeKind.IDENTIFIER) {
            subjectType = this.LocalTypeGet(subject.Name)
        }
        // isAlg: true only if the type is a registered algebraic enum (has __alg__ marker)
        var isAlg = false
        if (String_Length(subjectType) > 0) {
            let algKey2 = "__alg__" + subjectType
            let enCount3 = this.EnumNames.Count()
            for eni3 in 0..enCount3 {
                if (this.EnumNames.Get(eni3) == algKey2) { isAlg = true }
            }
        }
        let armCount = stmt.Children.Count()
        if (isAlg) {
            // Emit as switch on tag
            this.Out.EmitLine("switch (" + subjectStr + ".tag) {")
        } else {
            // Emit as if-else chain for simple value matching
            this.Out.EmitLine("{ /* match " + subjectStr + " */")
        }
        this.Out.Indent_()
        var firstArm = true
        var needsClose = false   // true when the last non-alg arm left an open "if" brace
        for i in 0..armCount {
            let arm = stmt.Children.Get(i)
            let pat = arm.Left
            let body = arm.Right
            if (pat == null) { continue }
            let pk = pat.Kind
            // Wildcard
            if (pk == NodeKind.IDENTIFIER && pat.Name == "_") {
                if (isAlg) {
                    this.Out.EmitLine("default: {")
                    this.Out.Indent_()
                    this.EmitMatchBody(body)
                    this.Out.EmitLine("break;")
                    this.Out.Dedent()
                    this.Out.EmitLine("}")
                    needsClose = false
                } else {
                    // Wildcard arm: close previous arm (if any) and emit trailing "else"
                    let elsePrefix = if (firstArm) { "" } else { "} else " }
                    this.Out.EmitLine(elsePrefix + "{")
                    this.Out.Indent_()
                    this.EmitMatchBody(body)
                    this.Out.Dedent()
                    this.Out.EmitLine("}")
                    needsClose = false
                }
                firstArm = false
            } else {
                if (isAlg && pk == NodeKind.CALL) {
                    // Algebraic variant: Circle(r)
                    let variantName = pat.Name
                    let tagConst = subjectType + "_TAG_" + variantName
                    this.Out.EmitLine("case " + tagConst + ": {")
                    this.Out.Indent_()
                    // Bind capture variables
                    let capCount = pat.Args.Count()
                    for ci in 0..capCount {
                        let capNode = pat.Args.Get(ci)
                        let capName = capNode.Name
                        let fidx = String_FromInt(ci)
                        this.Out.EmitLine("__auto_type " + capName + " = " + subjectStr + "." + variantName + "._" + fidx + ";")
                        this.LocalTypeSet(capName, "i64") // assume numeric for now
                    }
                    this.EmitMatchBody(body)
                    this.Out.EmitLine("break;")
                    this.Out.Dedent()
                    this.Out.EmitLine("}")
                    needsClose = false
                } else {
                    // Simple value or range — emit as if/else-if chain.
                    // Optional guard `if <expr>` is AND-ed with the pattern condition.
                    let elsePrefix = if (firstArm) { "" } else { "} else " }
                    let isBinder = pk == NodeKind.IDENTIFIER && pat.Name != "_"
                    var cond = ""
                    if (pk == NodeKind.BINARY && pat.Str == "..") {
                        let lo = this.EmitExprStr(pat.Left)
                        let hi = this.EmitExprStr(pat.Right)
                        cond = subjectStr + " >= " + lo + " && " + subjectStr + " <= " + hi
                    } else if (pk == NodeKind.LITERAL_STRING) {
                        let patStr = this.EmitExprStr(pat)
                        cond = "strcmp(" + subjectStr + ", " + patStr + ") == 0"
                    } else if (isBinder) {
                        // Bare identifier acts as a binder + always-match (Rust-like).
                        // Only meaningful when paired with a guard (`n if n > 0`).
                        cond = "1"
                    } else {
                        let patStr = this.EmitExprStr(pat)
                        cond = subjectStr + " == " + patStr
                    }
                    if (arm.Cond != null) {
                        // Pre-declare the binder so it's in scope for the guard expression.
                        // Register it locally so EmitExprStr renders it as the bare name.
                        if (isBinder) {
                            this.LocalTypeSet(pat.Name, "i64")
                        }
                        let guardStr = this.EmitExprStr(arm.Cond)
                        if (isBinder) {
                            // GCC statement expression: introduces the binder in the
                            // condition's scope so `n if n > 0` evaluates the guard
                            // with `n = subject` visible.
                            cond = "(({ __auto_type " + pat.Name + " = " + subjectStr + "; " + guardStr + "; }))"
                        } else {
                            cond = "(" + cond + ") && (" + guardStr + ")"
                        }
                    }
                    this.Out.EmitLine(elsePrefix + "if (" + cond + ") {")
                    this.Out.Indent_()
                    // Bare-id binder: also declare inside the body so it's visible
                    // there (in addition to the guard's compound expression).
                    if (isBinder) {
                        this.Out.EmitLine("__auto_type " + pat.Name + " = " + subjectStr + ";")
                        this.LocalTypeSet(pat.Name, "i64")
                    }
                    this.EmitMatchBody(body)
                    this.Out.Dedent()
                    needsClose = true
                }
                firstArm = false
            }
        }
        // Close the last open "if" brace if the chain ended without a wildcard
        if (needsClose) {
            this.Out.EmitLine("}")
        }
        this.Out.Dedent()
        this.Out.EmitLine("}")
    }

    private void EmitMatchBody(AstNode body) {
        if (body == null) { return }
        let bk = body.Kind
        if (bk == NodeKind.BLOCK) {
            let stmts = body.Children.Count()
            for si in 0..stmts {
                this.EmitStmt(body.Children.Get(si))
            }
        } else if (bk == NodeKind.RETURN_STMT || bk == NodeKind.BREAK_STMT || bk == NodeKind.CONTINUE_STMT) {
            // Statement-form arm body: parser accepts `1 => return "X"` etc.
            // Delegate to EmitStmt which already knows how to render these.
            this.EmitStmt(body)
        } else {
            // Expression arm — emit as return statement (match arms are in return position)
            let exprStr = this.EmitExprStr(body)
            if (String_Length(exprStr) > 0 && exprStr != "_unknown_") {
                if (bk == NodeKind.CALL || bk == NodeKind.IDENTIFIER) {
                    // Void call (like Console.WriteLine)
                    this.Out.EmitLine(exprStr + ";")
                } else {
                    this.Out.EmitLine("return " + exprStr + ";")
                }
            }
        }
    }

    private void EmitIf(AstNode stmt) {
        this.Out.EmitLine("if (" + this.EmitExprStr(stmt.Cond) + ") {")
        this.Out.Indent_()
        if (stmt.Body != null) { this.EmitBlock(stmt.Body) }
        this.Out.Dedent()
        if (stmt.Else != null) {
            let elseKind = stmt.Else.Kind
            if (elseKind == NodeKind.IF_STMT) {
                // Fuse "} else if (...) {" on one line
                let innerCond = this.EmitExprStr(stmt.Else.Cond)
                this.Out.EmitLine("} else if (" + innerCond + ") {")
                this.Out.Indent_()
                if (stmt.Else.Body != null) { this.EmitBlock(stmt.Else.Body) }
                this.Out.Dedent()
                // Recurse for further else-if / else chains
                this.EmitIfTail(stmt.Else)
            } else {
                this.Out.EmitLine("} else {")
                this.Out.Indent_()
                this.EmitBlock(stmt.Else)
                this.Out.Dedent()
                this.Out.EmitLine("}")
            }
        } else {
            this.Out.EmitLine("}")
        }
    }

    // Emit the tail of an else-if chain (after body already emitted)
    private void EmitIfTail(AstNode stmt) {
        if (stmt.Else == null) {
            this.Out.EmitLine("}")
            return
        }
        let elseKind = stmt.Else.Kind
        if (elseKind == NodeKind.IF_STMT) {
            let innerCond = this.EmitExprStr(stmt.Else.Cond)
            this.Out.EmitLine("} else if (" + innerCond + ") {")
            this.Out.Indent_()
            if (stmt.Else.Body != null) { this.EmitBlock(stmt.Else.Body) }
            this.Out.Dedent()
            this.EmitIfTail(stmt.Else)
        } else {
            this.Out.EmitLine("} else {")
            this.Out.Indent_()
            this.EmitBlock(stmt.Else)
            this.Out.Dedent()
            this.Out.EmitLine("}")
        }
    }

    private void EmitBlock(AstNode block) {
        let count = block.Children.Count()
        for i in 0..count {
            let stmt = block.Children.Get(i)
            this.EmitStmt(stmt)
        }
    }

    // v0.8.0+: emit a `#line N "path"` directive when the source line
    // changes from the previous statement (avoids spamming consecutive
    // identical directives). gcc/clang pick up the file/line pair into
    // DWARF, so amc dap can set .am-relative breakpoints natively.
    // Path embedded as-is — gcc records DW_AT_comp_dir from the build
    // CWD, so debuggers resolve relative paths against the build dir.
    private void EmitLineDirective(AstNode stmt) {
        if (stmt.Line <= 0) { return }
        if (String_Length(this.CurrentSource) == 0) { return }
        if (stmt.Line == this.LastLineEmitted) { return }
        // Escape backslashes so a Windows source path (D:\…\FF-TAROT\…)
        // in the #line filename string doesn't read as C escape
        // sequences (\F, \m, …) — gcc floods "unknown escape sequence"
        // warnings otherwise.
        let escaped: string = String_Replace(this.CurrentSource, "\\", "\\\\")
        this.Out.EmitLine("#line " + String_FromInt(stmt.Line) + " \"" + escaped + "\"")
        this.LastLineEmitted = stmt.Line
    }

    private void EmitStmt(AstNode stmt) {
        this.EmitLineDirective(stmt)
        let k = stmt.Kind
        match k {
        NodeKind.BLOCK => {
            // Bare `{ ... }` block at statement position. The resolver
            // already pushes a "block" scope around the children, so
            // emitting a C `{ ... }` here gives each `let` inside its
            // own C-scope — siblings can reuse local names without
            // colliding with names from a previous sibling block (fix
            // for the ui-forms r0/r2 ↔ rz0/rz2 workaround).
            this.Out.EmitLine("{")
            this.Out.Indent_()
            this.EmitBlock(stmt)
            this.Out.Dedent()
            this.Out.EmitLine("}")
            return
        }
        NodeKind.TRY_STMT => {
            // try { … } catch e { … } [finally { … }] — setjmp/longjmp pattern
            // (matches the Vala bootstrap's c_generator).
            //   {
            //     jmp_buf _am_prev_env_NN;
            //     memcpy(&_am_prev_env_NN, &_am_ex.env, sizeof(jmp_buf));
            //     int _am_caught_NN = setjmp(_am_ex.env);
            //     if (_am_caught_NN == 0) { try…; _am_ex.active = 0; }
            //     else { void* e = _am_ex.value; _am_ex.active = 0; catch…; }
            //     memcpy(&_am_ex.env, &_am_prev_env_NN, sizeof(jmp_buf));
            //     finally…;
            //   }
            // Suffix uses the source line of the `try` token so nested try/catch
            // blocks get distinct local names.
            let suffix = String_FromInt(stmt.Line)
            this.Out.EmitLine("{")
            this.Out.Indent_()
            this.Out.EmitLine("jmp_buf _am_prev_env_" + suffix + ";")
            this.Out.EmitLine("memcpy(&_am_prev_env_" + suffix + ", &_am_ex.env, sizeof(jmp_buf));")
            this.Out.EmitLine("int _am_caught_" + suffix + " = setjmp(_am_ex.env);")
            this.Out.EmitLine("if (_am_caught_" + suffix + " == 0) {")
            this.Out.Indent_()
            if (stmt.Body != null) { this.EmitBlock(stmt.Body) }
            this.Out.EmitLine("_am_ex.active = 0;")
            this.Out.Dedent()
            this.Out.EmitLine("} else {")
            this.Out.Indent_()
            if (String_Length(stmt.Name) > 0) {
                this.Out.EmitLine("void* " + stmt.Name + " = _am_ex.value;")
                this.LocalTypeSet(stmt.Name, "void*")
            }
            this.Out.EmitLine("_am_ex.active = 0;")
            if (stmt.Else != null) { this.EmitBlock(stmt.Else) }
            this.Out.Dedent()
            this.Out.EmitLine("}")
            this.Out.EmitLine("memcpy(&_am_ex.env, &_am_prev_env_" + suffix + ", sizeof(jmp_buf));")
            if (stmt.Cond != null) { this.EmitBlock(stmt.Cond) }
            this.Out.Dedent()
            this.Out.EmitLine("}")
            return
        }
        NodeKind.INLINE_C => {
            // `@c { … }` — splice the raw C body inside a compound statement
            // so any `int x = …;` declarations stay scoped to the block. The
            // body is emitted line-by-line; the lexer captured it verbatim,
            // and the user is responsible for writing valid C.
            this.Out.EmitLine("{ /* inline-C */")
            this.Out.Indent_()
            let body = stmt.Str
            if (String_Length(body) > 0) {
                let lines: List<string> = String_Split(body, "\n")
                let count = lines.Count()
                for i in 0..count {
                    this.Out.EmitLine(lines.Get(i))
                }
            }
            this.Out.Dedent()
            this.Out.EmitLine("}")
            return
        }
        NodeKind.THROW_STMT => {
            // `throw new SomeError(args)` → `_am_throw((void*)(SomeError_new(args)),
            //   "SomeError", first_string_arg_or_empty)`.
            // Falls back to a generic throw for other shapes.
            if (stmt.Left == null) {
                this.Out.EmitLine("_am_throw(NULL, \"Error\", \"\");")
                return
            }
            let v = stmt.Left
            if (v.Kind == NodeKind.NEW_EXPR) {
                let typeName = v.Name
                var argsStr = ""
                let ac = v.Args.Count()
                for ai in 0..ac {
                    if (ai > 0) { argsStr = argsStr + ", " }
                    argsStr = argsStr + this.EmitExprStr(v.Args.Get(ai))
                }
                var msgStr = "\"\""
                if (ac > 0) {
                    let firstArg = v.Args.Get(0)
                    if (firstArg.Kind == NodeKind.LITERAL_STRING) {
                        msgStr = this.EmitExprStr(firstArg)
                    }
                }
                let symName = this.SymName(typeName)
                this.Out.EmitLine("_am_throw((void*)(" + symName + "_new(" + argsStr + ")), \"" + typeName + "\", " + msgStr + ");")
                return
            }
            let valStr = this.EmitExprStr(v)
            this.Out.EmitLine("_am_throw((void*)" + valStr + ", \"Error\", \"\");")
            return
        }
        NodeKind.VAR_DECL => {
            // Tuple destructuring: let (a, b) = expr
            if (stmt.Str == "__tuple_destructure__") {
                let rhs = this.EmitExprStr(stmt.Left)
                let tmpName = "__tup_" + String_FromInt(stmt.Line)
                this.Out.EmitLine("__auto_type " + tmpName + " = " + rhs + ";")
                // Try to infer element types from the called function's return tuple type
                var tupleRetType = ""
                if (stmt.Left != null && stmt.Left.Kind == NodeKind.CALL) {
                    let calleeStr2 = this.EmitCalleeStr(stmt.Left.Left)
                    // calleeStr2 = "ClassName_MethodName" — split at last _
                    let lastUs = String_LastIndexOf(calleeStr2, "_")
                    if (lastUs > 0) {
                        let cls2 = String_Substring(calleeStr2, 0, lastUs)
                        let mth2 = String_Substring(calleeStr2, lastUs + 1, String_Length(calleeStr2) - lastUs - 1)
                        tupleRetType = this.MethodRetGet(cls2, mth2)
                    }
                }
                let nc = stmt.Children.Count()
                for i in 0..nc {
                    let vnode = stmt.Children.Get(i)
                    let vname = vnode.Name
                    let idxStr = String_FromInt(i)
                    this.Out.EmitLine("__auto_type " + vname + " = " + tmpName + "._" + idxStr + ";")
                    // Infer element type from tuple type string "(int,string,bool)"
                    var elemType = "void*"
                    if (String_Length(tupleRetType) > 2 && String_StartsWith(tupleRetType, "(")) {
                        let inner2 = String_Substring(tupleRetType, 1, String_Length(tupleRetType) - 2)
                        // Split by comma and get i-th element
                        var ei = 0
                        var cur2 = ""
                        var ci2  = 0
                        let ilen = String_Length(inner2)
                        while (ci2 <= ilen) {
                            var ch2 = ""
                            if (ci2 < ilen) { ch2 = String_Substring(inner2, ci2, 1) }
                            if (ch2 == "," || ci2 == ilen) {
                                if (ei == i && String_Length(cur2) > 0) {
                                    elemType = this.TypeToC(cur2)
                                }
                                ei = ei + 1
                                cur2 = ""
                            } else { cur2 = cur2 + ch2 }
                            ci2 = ci2 + 1
                        }
                    }
                    this.LocalTypeSet(vname, elemType)
                }
                return
            }
            // Lambda assignment: let doubler = x => x * 2
            // The lambda's env struct + fn forward decl were already
            // emitted by Phase A (EmitLambdaForwards); here we just allocate
            // the env, copy captured locals into it, and bundle them
            // into an AmalgameClosure value.
            if (stmt.Left != null && stmt.Left.Kind == NodeKind.METHOD_DECL && stmt.Left.Name == "__lambda__") {
                let lam     = stmt.Left
                let id      = lam.Str2
                let envName = "LamEnv_" + id
                let fnName  = "lam_" + id + "_fn"
                let envVar  = "__env_" + id
                // Typed closure (Closure<A, R> / Closure<A1, A2, R> /
                // Closure<A1, A2, A3, R>): when the user annotated the
                // local with a typed-closure shape, push each A_i into
                // the lambda's i-th PARAM Str. Phase C (EmitLambdaBodies)
                // hasn't run yet, so subsequent body emission picks up
                // the typed unpack and member access lowers cleanly
                // (no more `-Wno-int-conversion` cache-misère on the
                // mosaic-build.sh side). The last comma-separated arg
                // is the return type — used to seed __closure_ret__
                // below.
                var typedRet: string = ""
                if (String_StartsWith(stmt.Str, "Closure<") && String_EndsWith(stmt.Str, ">")) {
                    let inner: string = String_Substring(stmt.Str, 8, String_Length(stmt.Str) - 9)
                    let parts: List<string> = this.SplitTopLevelCommas(inner)
                    let pc: int = parts.Count()
                    let pn: int = lam.Params.Count()
                    if (pc >= 1) {
                        // Last entry is the return type.
                        typedRet = String_Trim(parts.Get(pc - 1))
                        // All preceding entries are arg types — patch
                        // the lambda's params in order (only when the
                        // param has no annotation already, so the user
                        // can override per-param if they want).
                        let argCount: int = pc - 1
                        let toPatch: int = argCount
                        if (toPatch > pn) { toPatch = pn }
                        for ai in 0..toPatch {
                            let p = lam.Params.Get(ai)
                            if (String_Length(p.Str) == 0 || p.Str == "?") {
                                p.Str = String_Trim(parts.Get(ai))
                            }
                        }
                    }
                }
                this.Out.EmitLine(envName + "* " + envVar + " = (" + envName + "*) code_alloc(sizeof(" + envName + "));")
                let cn = lam.Args.Count()
                for i in 0..cn {
                    let cap = lam.Args.Get(i)
                    this.Out.EmitLine(envVar + "->_" + cap.Name + " = " + cap.Name + ";")
                }
                this.Out.EmitLine("AmalgameClosure* " + stmt.Name + " = AmalgameClosure_new((void*)" + fnName + ", " + envVar + ");")
                this.LocalTypeSet(stmt.Name, "AmalgameClosure*")
                // Track the lambda's return type so the call site emits
                // the right cast/unbox instead of always assuming i64.
                // Priority: explicit Closure<…, R> annotation > body
                // inference. Block-bodied lambdas with no annotation
                // leave it blank → call site falls back to the legacy
                // `UnboxScalar("i64", …)` path.
                if (String_Length(typedRet) > 0) {
                    this.ListElemSet("__closure_ret__", stmt.Name, this.TypeToC(typedRet))
                } else if (lam.Left != null) {
                    let retC = this.InferTypeFromExpr(lam.Left)
                    if (String_Length(retC) > 0) {
                        this.ListElemSet("__closure_ret__", stmt.Name, retC)
                    }
                }
                return
            }
            var t = this.TypeToC(stmt.Str)
            // If no explicit type annotation, infer from RHS
            if (String_Length(t) == 0 || t == "void") {
                t = this.InferTypeFromExpr(stmt.Left)
            }
            // Fall back to void* only if we truly can't infer
            if (String_Length(t) == 0) { t = "void*" }
            // Record in local type table for later use
            this.LocalTypeSet(stmt.Name, t)
            // Track the elem (List<T>) / value (Map<K,V>) type so a later
            // `xs.Get(i)` / `m.Get(k)` can emit a typed cast instead of
            // void*. Three sources, in order of confidence:
            //   1. Explicit annotation: `let xs: List<int> = ...`
            //   2. NEW_EXPR RHS: `let xs = new List<int>()`
            //   3. Method-call return type: `let xs = Program.MakeList()`
            //      where MakeList is declared `List<int>`.
            if (String_Length(stmt.Str) > 0) {
                this.TrackGenericLocal(stmt.Name, stmt.Str)
            }
            if (stmt.Left != null && stmt.Left.Kind == NodeKind.NEW_EXPR) {
                if (String_Length(stmt.Left.Str2) > 0) {
                    let synth = stmt.Left.Name + "<" + stmt.Left.Str2 + ">"
                    this.TrackGenericLocal(stmt.Name, synth)
                }
            }
            // Future-local tracking: `let f = <async-fn call>` records the
            // awaited result type R under __async_future__[f] so a later
            // `await f` unboxes the ChannelReceive to R. The RHS callee is
            // mangled and probed against __async_ret__ (set by
            // EmitAsyncForwards).
            if (stmt.Left != null && stmt.Left.Kind == NodeKind.CALL) {
                let af_cs = this.EmitCalleeStr(stmt.Left.Left)
                let af_ret = this.ListElemGet("__async_ret__", af_cs)
                if (String_Length(af_ret) > 0) {
                    this.ListElemSet("__async_future__", stmt.Name, af_ret)
                }
            }
            if (stmt.Left != null && stmt.Left.Kind == NodeKind.CALL) {
                // Recover ClassName + MethodName for `obj.Method()` and
                // `Program.Method()` so we can read the raw return type.
                // Three lookup keys, tried in turn:
                //   1. Bare receiver name — works for in-bundle static
                //      calls like `Program.MakeList()`.
                //   2. ExternalClassMangled(name) — works for static
                //      calls on an `--external` class (`FakeDb.Open()`).
                //   3. LocalTypeGet(name) → bare C type — works for
                //      instance calls on a typed local (`db.QueryAll()`)
                //      whether `db` was declared with an explicit
                //      annotation or had its type inferred from a
                //      prior call.
                let callee = stmt.Left.Left
                if (callee != null && callee.Kind == NodeKind.MEMBER) {
                    if (callee.Left != null && callee.Left.Kind == NodeKind.IDENTIFIER) {
                        let recvName = callee.Left.Name
                        var retRaw = this.MethodRetRawGet(recvName, callee.Name)
                        if (String_Length(retRaw) == 0) {
                            let extMangled = this.ExternalClassMangled(recvName)
                            if (String_Length(extMangled) > 0) {
                                retRaw = this.MethodRetRawGet(extMangled, callee.Name)
                            }
                        }
                        if (String_Length(retRaw) == 0) {
                            let recvType = this.LocalTypeGet(recvName)
                            if (String_Length(recvType) > 0) {
                                let bareT = String_Replace(recvType, "*", "")
                                if (String_Length(bareT) > 0) {
                                    retRaw = this.MethodRetRawGet(bareT, callee.Name)
                                }
                            }
                        }
                        // Last-chance: chained `.Get(i)` on a typed
                        // local with a known raw shape. Peels one
                        // generic layer (List<List<T>>→List<T>,
                        // Map<K, List<T>>→List<T>) so an intermediate
                        // local (`let row0 = rows.Get(0)`) stays typed
                        // without an explicit annotation. Mirrors the
                        // RecoverChainedListElemRaw path used by the
                        // chained-emit branch at the call site.
                        if (String_Length(retRaw) == 0 && callee.Name == "Get") {
                            retRaw = this.RecoverChainedListElemRaw(callee.Left)
                        }
                        if (String_Length(retRaw) > 0) {
                            this.TrackGenericLocal(stmt.Name, retRaw)
                        }
                    }
                    // Higher-order list methods (lambda v2.5):
                    // - Filter conserves the receiver's element type
                    //   (List<int>.Filter → List<int>).
                    // - Map's result element type is the lambda's
                    //   return type, NOT the receiver's element type.
                    //   We push the lambda params into LocalTypes so
                    //   InferTypeFromExpr can resolve `u.Name` against
                    //   the param's annotated type, then pop them.
                    let mname = callee.Name
                    if (mname == "Filter") {
                        if (callee.Left != null && callee.Left.Kind == NodeKind.IDENTIFIER) {
                            let recvName = callee.Left.Name
                            let recvElem = this.ListElemGet("__local__", recvName)
                            if (String_Length(recvElem) > 0) {
                                this.ListElemSet("__local__", stmt.Name, recvElem)
                            }
                        }
                    } else if (mname == "Map") {
                        this.TrackMapResultElem(stmt)
                    }
                }
            }
            // Emit the declaration — for void* from List.Get(), emit a typed cast
            let rhs = this.EmitExprStr(stmt.Left)
            var decl = t + " " + stmt.Name + " = " + rhs + ";"
            // If inferred void* but we have a typed cast available, upgrade the variable type
            if (t == "void*") {
                // Check if rhs already contains a typed cast like "(SomeType*)AmalgameList_get"
                // but NOT a ternary expression like "(cond ? a : b)"
                if (String_StartsWith(rhs, "(") && !String_StartsWith(rhs, "(void*)") && !String_StartsWith(rhs, "({") && !String_Contains(rhs, "?")) {
                    // Extract cast type from "(Type*)expr" → strip outer parens up to first )
                    let closeP = String_IndexOf(rhs, ")")
                    if (closeP > 1) {
                        let castT = String_Substring(rhs, 1, closeP - 1)
                        if (String_Length(castT) > 0) {
                            t = castT
                            this.LocalTypeSet(stmt.Name, t)
                            decl = t + " " + stmt.Name + " = " + rhs + ";"
                        }
                    }
                }
            }
            this.Out.EmitLine(decl)
        }
        NodeKind.RETURN_STMT => {
            if (stmt.Left == null) {
                if (this.InLambdaBody) {
                    // Bare `return` inside a lambda body — yield boxed 0.
                    this.Out.EmitLine("return " + this.BoxAsVoid("0") + ";")
                } else {
                    this.Out.EmitLine("return;")
                }
            } else {
                let retExpr = this.EmitExprStr(stmt.Left)
                if (retExpr == "_unknown_") {
                    this.Out.EmitLine("return;")
                } else if (this.InLambdaBody) {
                    // Lambda body's enclosing fn returns void*; box the
                    // expression via intptr_t so call sites can unbox.
                    this.Out.EmitLine("return " + this.BoxAsVoid(retExpr) + ";")
                } else if (String_StartsWith(retExpr, "{") && String_Length(this.CurrentRetType) > 0) {
                    // Tuple literal {a,b,...} — cast with current return type.
                    this.Out.EmitLine("return (" + this.CurrentRetType + ")" + retExpr + ";")
                } else {
                    this.Out.EmitLine("return " + retExpr + ";")
                }
            }
        }
        NodeKind.IF_STMT => {
            // Check if this is a match statement
            if (stmt.Name == "__match__") {
                this.EmitMatch(stmt)
                return
            }
            this.EmitIf(stmt)
        }
        NodeKind.WHILE_STMT => {
            this.Out.EmitLine("while (" + this.EmitExprStr(stmt.Cond) + ") {")
            this.Out.Indent_()
            if (stmt.Body != null) { this.EmitBlock(stmt.Body) }
            this.Out.Dedent()
            this.Out.EmitLine("}")
        }
        NodeKind.FOR_IN_STMT => {
            let vn = stmt.Name
            // iter is the range expression: BINARY("..", start, end) or a collection
            if (stmt.Left != null) {
                let iterKind = stmt.Left.Kind
                if (iterKind == NodeKind.BINARY) {
                    let iterOp = stmt.Left.Str
                    if (iterOp == "..") {
                        // Range for: for i in start..end → for (i64 i = start; i < end; i++)
                        let startExpr = this.EmitExprStr(stmt.Left.Left)
                        let endExpr   = this.EmitExprStr(stmt.Left.Right)
                        this.Out.EmitLine("for (i64 " + vn + " = " + startExpr + "; " + vn + " < " + endExpr + "; " + vn + "++) {")
                        this.LocalTypeSet(vn, "i64")
                        this.Out.Indent_()
                        if (stmt.Body != null) { this.EmitBlock(stmt.Body) }
                        this.Out.Dedent()
                        this.Out.EmitLine("}")
                        this.LocalTypeSet(vn, "")
                        return
                    }
                }
            }
            // Collection for: for x in <list-expr>. Emit a wrapper block so
            // the synthetic iterator + length stay scoped to the loop. The
            // synthetic names use vn as a suffix so nested for-in over
            // different lists don't shadow each other.
            //
            // Lambda v2.5 follow-up: when the iter expression is a known
            // typed local (e.g. `let xs: List<User> = ...`) or a typed
            // class field, infer the element C type and type the loop
            // variable accordingly so the body resolves `u.Name`,
            // `u.Method()`, etc., without manual casts. Falls back to
            // `void*` when the type can't be recovered — same behaviour
            // as before, just opt-in to typed casts when info is there.
            var elemC: string = ""
            if (stmt.Left != null) {
                let ilk = stmt.Left.Kind
                if (ilk == NodeKind.IDENTIFIER) {
                    elemC = this.ListElemGet("__local__", stmt.Left.Name)
                } else if (ilk == NodeKind.MEMBER && stmt.Left.Left != null && stmt.Left.Left.Kind == NodeKind.THIS_EXPR) {
                    elemC = this.ListElemGet(this.CurrentClass, stmt.Left.Name)
                }
            }
            if (String_Length(elemC) == 0) { elemC = "void*" }
            let iter = this.EmitExprStr(stmt.Left)
            this.Out.EmitLine("{")
            this.Out.Indent_()
            this.Out.EmitLine("AmalgameList* __it_" + vn + " = " + iter + ";")
            this.Out.EmitLine("i64 __len_" + vn + " = AmalgameList_size(__it_" + vn + ");")
            this.Out.EmitLine("for (i64 __idx_" + vn + " = 0; __idx_" + vn + " < __len_" + vn + "; __idx_" + vn + "++) {")
            this.Out.Indent_()
            let rawElem = "__it_" + vn + "->data[__idx_" + vn + "]"
            if (elemC == "void*") {
                this.Out.EmitLine("void* " + vn + " = " + rawElem + ";")
            } else if (this.IsCPointerType(elemC)) {
                this.Out.EmitLine(elemC + " " + vn + " = (" + elemC + ")" + rawElem + ";")
            } else {
                // Scalar (i64, double, code_bool …) — unbox through intptr_t.
                this.Out.EmitLine(elemC + " " + vn + " = " + this.UnboxScalar(elemC, rawElem) + ";")
            }
            this.LocalTypeSet(vn, elemC)
            if (stmt.Body != null) { this.EmitBlock(stmt.Body) }
            this.Out.Dedent()
            this.Out.EmitLine("}")
            this.Out.Dedent()
            this.Out.EmitLine("}")
            this.LocalTypeSet(vn, "")
        }
        NodeKind.BREAK_STMT => {
            this.Out.EmitLine("break;")
        }
        NodeKind.CONTINUE_STMT => {
            this.Out.EmitLine("continue;")
        }
        NodeKind.BINARY => {
            this.Out.EmitLine(this.EmitExprStr(stmt) + ";")
        }
        NodeKind.CALL => {
            this.Out.EmitLine(this.EmitExprStr(stmt) + ";")
        }
        NodeKind.MEMBER => {
            this.Out.EmitLine(this.EmitExprStr(stmt) + ";")
        }
        _ => { }
        }
    }

    // ── Expression emission ───────────────────────────

    private string EmitExprStr(AstNode expr) {
        if (expr == null) { return "NULL" }
        let k = expr.Kind
        match k {
        // Lambda: x => expr — emit as a real AmalgameClosure*.
        //
        // Higher-order list methods (Map/Filter/etc.) intercept the
        // lambda earlier via EmitClosureArg with their element-type
        // framing; anything landing here is an inline lambda passed
        // to a regular call site (e.g. webview Bind, builder OnClick),
        // where the closure value itself is the desired argument.
        //
        // The legacy `__lambda_<param>_<body>__` placeholder pattern
        // didn't survive any call site that wasn't a Map/Filter — it
        // surfaced as garbage C tokens. Emitting an inline
        // `AmalgameClosure_new((void*)lam_N_fn, env)` is type-correct
        // and lifetime-safe (env is code_alloc'd, GC tracks both).
        NodeKind.METHOD_DECL if expr.Name == "__lambda__" => {
            return this.EmitLambdaAsClosure(expr)
        }
        // Tuple literal: (val1, val2, ...)
        NodeKind.CALL if expr.Name == "__tuple_literal__" => {
            // We don't know the struct name here without context,
            // use compound literal with positional initializers
            let argc = expr.Args.Count()
            var result = "{"
            for i in 0..argc {
                if (i > 0) { result = result + ", " }
                result = result + this.EmitExprStr(expr.Args.Get(i))
            }
            result = result + "}"
            return result
        }
        NodeKind.IF_STMT => {
            // match-as-expression: same NodeKind, distinguished by marker.
            if (expr.Name == "__match__") {
                return this.EmitMatchExpr(expr)
            }
            let condStr = this.EmitExprStr(expr.Cond)
            let thenStr = this.EmitIfBranch(expr.Body)
            let elseStr = this.EmitIfBranch(expr.Else)
            return "(" + condStr + " ? " + thenStr + " : " + elseStr + ")"
        }
        // Emit integer literals as `long long` (LL suffix) so arithmetic
        // on two literals happens in 64-bit, not C's default `int`.
        // Without this, `900 * 1000000000` overflows int (→ negative)
        // even when assigned to an i64. The lexer stores the value as a
        // canonical decimal string (String_FromInt), so appending LL is
        // always valid C (no hex / underscores to worry about).
        NodeKind.LITERAL_INT => { return expr.Str + "LL" }
        NodeKind.LITERAL_FLOAT => { return expr.Str }
        NodeKind.LITERAL_STRING => {
            let raw = expr.Str
            return this.EmitInterpolatedString(raw)
        }
        NodeKind.LITERAL_BOOL => {
            if (expr.Flag) { return "1" }
            return "0"
        }
        NodeKind.LITERAL_NULL => { return "NULL" }
        NodeKind.THIS_EXPR => { return "self" }
        NodeKind.IDENTIFIER => {
            // Auto-qualify implicit field access in method bodies:
            // `Id = id` inside a method/constructor lowers to
            // `self->Id = id` when Id isn't a local (no shadow) but
            // IS a field of the current class. Lets users from
            // C# / TS / Kotlin / Swift skip the explicit `this.`
            // qualifier without breaking codegen. Resolves naturally
            // for both reads (rhs) and writes (lhs) since both go
            // through this branch.
            let name = expr.Name
            if (String_Length(this.CurrentClass) > 0) {
                let asLocal: string = this.LocalTypeGet(name)
                if (String_Length(asLocal) == 0) {
                    let asField: string = this.FieldTypeGet(this.CurrentClass, name)
                    if (String_Length(asField) > 0 && asField != "?") {
                        return "self->" + name
                    }
                }
            }
            return name
        }
        NodeKind.MEMBER => {
            // Null-safe access: `obj?.field` → `(obj ? obj->field : NULL)`.
            // Note: assumes `obj` has no side effects (we evaluate it twice).
            // Use a let-binding for complex receivers.
            if (expr.Flag) {
                let target = this.EmitExprStr(expr.Left)
                return "(" + target + " ? " + target + "->" + expr.Name + " : NULL)"
            }
            if (expr.Left != null) {
                let lk = expr.Left.Kind
                if (lk == NodeKind.THIS_EXPR) {
                    return "self->" + expr.Name
                }
                if (lk == NodeKind.IDENTIFIER) {
                    let tname = expr.Left.Name
                    let firstChar = String_Substring(tname, 0, 1)
                    let isUpper = firstChar == String_ToUpper(firstChar)
                    if (isUpper) {
                        // Cross-package enum variant: a package's
                        // `WatchEventKind.Created` referenced from a consumer
                        // namespace. The variant's C symbol lives under the
                        // package's namespace, not the consumer's. Symmetric to
                        // ExternalClassMangled for cross-package CLASS dispatch
                        // (PR #521).
                        let externalEnumMangled: string = this.ExternalEnumMangled(tname)
                        if (String_Length(externalEnumMangled) > 0) {
                            return externalEnumMangled + "_" + expr.Name
                        }
                        // Enum or static class access: TokenType.NEWLINE → Ns_TokenType_NEWLINE
                        return this.SymName(tname) + "_" + expr.Name
                    }
                    return tname + "->" + expr.Name
                }
            }
            let target = this.EmitExprStr(expr.Left)
            return target + "->" + expr.Name
        }
        NodeKind.BINARY => {
            var left  = this.EmitExprStr(expr.Left)
            let op    = expr.Str
            var right = this.EmitExprStr(expr.Right)
            // Preserve source precedence: any sub-BINARY operand
            // gets wrapped in parens at the C level. C's precedence
            // table doesn't always match the source's nesting (e.g.
            // `(h - 2*pad - gap) / n` would otherwise emit as
            // `h - 2*pad - gap / n`, evaluating `gap / n` first).
            // Belt-and-braces — over-parenthesising is harmless and
            // matches what pretty-printers like clang-format do.
            if (expr.Left != null && expr.Left.Kind == NodeKind.BINARY) {
                left = "(" + left + ")"
            }
            if (expr.Right != null && expr.Right.Kind == NodeKind.BINARY) {
                right = "(" + right + ")"
            }
            if (op == "==" || op == "!=") {
                // Infer LHS type to decide: string → code_string_equals, else → C == / !=
                let ltype = this.InferTypeFromExpr(expr.Left)
                var useStrEq = false
                if (ltype == "code_string") { useStrEq = true }
                // If LHS is a CALL to a known string-returning method, treat as string
                if (String_Length(ltype) == 0) {
                    if (expr.Left != null) {
                        let lk2 = expr.Left.Kind
                        if (lk2 == NodeKind.LITERAL_STRING) { useStrEq = true }
                        // CALL to CharAt / String_* → code_string
                        if (lk2 == NodeKind.CALL) {
                            if (expr.Left.Left != null) {
                                let calleeStr = this.EmitCalleeStr(expr.Left.Left)
                                if (String_StartsWith(calleeStr, "String_") || String_EndsWith(calleeStr, "_CharAt")) {
                                    useStrEq = true
                                }
                            }
                        }
                        // IDENTIFIER whose local type is code_string
                        if (lk2 == NodeKind.IDENTIFIER) {
                            let lt2 = this.LocalTypeGet(expr.Left.Name)
                            if (lt2 == "code_string") { useStrEq = true }
                        }
                        // MEMBER → this.Field or var.Field
                        if (lk2 == NodeKind.MEMBER) {
                            let ft = this.InferTypeFromExpr(expr.Left)
                            if (ft == "code_string") { useStrEq = true }
                        }
                    }
                }
                // Also: if RHS is a string literal, LHS must be string
                if (!useStrEq) {
                    if (expr.Right != null) {
                        if (expr.Right.Kind == NodeKind.LITERAL_STRING) { useStrEq = true }
                    }
                }
                if (useStrEq) {
                    if (op == "==") { return "code_string_equals(" + left + ", " + right + ")" }
                    return "!code_string_equals(" + left + ", " + right + ")"
                }
                // Non-string (int, bool, enum, pointer): use C == / !=
                return left + " " + op + " " + right
            }
            // String concatenation: a + b where either side is a string
            if (op == "+") {
                let ltype2 = this.InferTypeFromExpr(expr.Left)
                var useConcat = false
                if (ltype2 == "code_string") { useConcat = true }
                if (!useConcat) {
                    if (expr.Left != null) {
                        let lk3 = expr.Left.Kind
                        if (lk3 == NodeKind.LITERAL_STRING) { useConcat = true }
                        if (lk3 == NodeKind.IDENTIFIER) {
                            let lt3 = this.LocalTypeGet(expr.Left.Name)
                            if (lt3 == "code_string") { useConcat = true }
                        }
                        // CALL that returns code_string (including nested
                        // code_string_concat). Bug 7: previously also
                        // triggered on any `String_*` callee name, which
                        // misclassified `pos + String_Length(needle)` as
                        // a concat because `String_Length` *starts with*
                        // `String_` yet returns `i64`. InferTypeFromExpr
                        // already knows the precise return type, so consult
                        // it instead of the name prefix.
                        if (lk3 == NodeKind.CALL) {
                            let ltype3 = this.InferTypeFromExpr(expr.Left)
                            if (ltype3 == "code_string") { useConcat = true }
                            if (expr.Left.Left != null) {
                                let calleeL = this.EmitCalleeStr(expr.Left.Left)
                                if (calleeL == "code_string_concat") {
                                    useConcat = true
                                }
                            }
                        }
                    }
                }
                if (!useConcat) {
                    if (expr.Right != null) {
                        let rk3 = expr.Right.Kind
                        if (rk3 == NodeKind.LITERAL_STRING) { useConcat = true }
                        if (rk3 == NodeKind.CALL) {
                            // Bug 7 (RHS): mirror of the LHS fix above —
                            // trust InferTypeFromExpr rather than callee-
                            // name prefix matching. `String_Length`,
                            // `String_IndexOf`, `String_ToInt` etc. return
                            // i64 and must not be classified as concat.
                            let rtype3 = this.InferTypeFromExpr(expr.Right)
                            if (rtype3 == "code_string") { useConcat = true }
                            if (expr.Right.Left != null) {
                                let calleeR = this.EmitCalleeStr(expr.Right.Left)
                                if (calleeR == "code_string_concat") {
                                    useConcat = true
                                }
                            }
                        }
                    }
                }
                if (useConcat) {
                    var lcast = left
                    var rcast = right
                    let ltype4 = this.InferTypeFromExpr(expr.Left)
                    let rtype4 = this.InferTypeFromExpr(expr.Right)
                    if (ltype4 == "void*") { lcast = "(code_string)(" + left + ")" }
                    if (rtype4 == "void*") { rcast = "(code_string)(" + right + ")" }
                    return "code_string_concat(" + lcast + ", " + rcast + ")"
                }
            }
            return left + " " + op + " " + right
        }
        NodeKind.UNARY => {
            // `await <future>` → block on the result channel + unbox to R.
            // The awaited expr already lowers to an AmalgameAsyncChannel*
            // (an async-fn call returns the future, or a tracked future
            // local). R is recovered via __async_ret__ (call) /
            // __async_future__ (identifier); fall back to i64.
            if (expr.Str == "await") {
                let futExpr = this.EmitExprStr(expr.Left)
                let retC = this.ResolveAwaitRetC(expr.Left)
                // The future channel is filled by a fiber that only runs
                // when the scheduler is pumped. From the main context
                // (FiberCurrentId()==0) ChannelReceive would return 0
                // immediately without ever running the fiber, so we pump
                // the scheduler to completion first. From inside a fiber
                // the receive parks and the already-running scheduler
                // resumes us when the value lands.
                var recv = "Amalgame_Async_ChannelReceive(__af)"
                if (!(String_Length(retC) == 0 || retC == "void" || retC == "i64")) {
                    recv = this.UnboxScalar(retC, "Amalgame_Async_ChannelReceive(__af)")
                }
                return "({ AmalgameAsyncChannel* __af = (" + futExpr + "); "
                    + "if (Amalgame_Async_FiberCurrentId() == 0) { Amalgame_Async_SchedulerRun(); } "
                    + recv + "; })"
            }
            let operand = this.EmitExprStr(expr.Left)
            // Wrap binary/ternary operands in parens so C precedence matches
            // the source (e.g. `!(x > 0)`, not `!x > 0`).
            if (expr.Left != null) {
                let lk = expr.Left.Kind
                if (lk == NodeKind.BINARY) { return expr.Str + "(" + operand + ")" }
            }
            return expr.Str + operand
        }
        NodeKind.CALL => {
            // ── Closure call via MEMBER access (v0.8.30+) ─────────
            // `this.Fn(x)`, `obj.Handler(req)`, etc. — when the
            // referenced field has type `Closure` (lowered to
            // `AmalgameClosure*`), dispatch through
            // AmalgameClosure_callN instead of emitting a method
            // call. Same arity 1-3 limit as the IDENTIFIER path
            // below; uses the same BoxAsVoid / unbox machinery.
            //
            // This is what makes `Closure` a first-class type for
            // class fields, enabling handler-callback APIs:
            //   public class HttpServer {
            //       public Handler: Closure
            //       public HttpResponse Dispatch(HttpRequest req) {
            //           return this.Handler(req)
            //       }
            //   }
            if (expr.Left != null && expr.Left.Kind == NodeKind.MEMBER) {
                let mem: AstNode = expr.Left
                if (mem.Left != null && mem.Name != "") {
                    var recvCls: string = ""
                    var recvExpr: string = ""
                    if (mem.Left.Kind == NodeKind.THIS_EXPR) {
                        recvCls  = this.CurrentClass
                        recvExpr = "self"
                    } else if (mem.Left.Kind == NodeKind.IDENTIFIER) {
                        // Receiver is a local — strip trailing `*` from
                        // its C type to recover the bare class name
                        // (matches the convention used by FieldTypeGet
                        // lookups elsewhere in this file).
                        let localType: string = this.LocalTypeGet(mem.Left.Name)
                        recvCls  = String_Replace(localType, "*", "")
                        recvExpr = mem.Left.Name
                    } else if (mem.Left.Kind == NodeKind.MEMBER) {
                        // Nested member access: `obj.A.B.fn(args)` —
                        // resolve the receiver chain's leaf class via
                        // ResolveReceiverClass and emit the C
                        // expression for the inner chain directly (no
                        // bind-to-local required).
                        let nestedCls: string = this.ResolveReceiverClass(mem.Left)
                        if (String_Length(nestedCls) > 0) {
                            recvCls  = nestedCls
                            recvExpr = this.EmitExprStr(mem.Left)
                        }
                    }
                    if (String_Length(recvCls) > 0) {
                        let ft: string = this.FieldTypeGet(recvCls, mem.Name)
                        if (ft == "AmalgameClosure*") {
                            let argc: int = expr.Args.Count()
                            let calleeName: string = recvExpr + "->" + mem.Name
                            // Typed-Closure return: read the per-class,
                            // per-field closure return type recorded by
                            // EmitClass for `Closure<...>`-annotated
                            // fields. Falls back to i64 when the field
                            // is the legacy bare `Closure` (no annot).
                            let retC0: string = this.ListElemGet(recvCls + "__closure_ret__", mem.Name)
                            var retC: string = retC0
                            if (String_Length(retC) == 0) { retC = "i64" }
                            if (argc == 1) {
                                let arg0 = this.EmitExprStr(expr.Args.Get(0))
                                let callC = "AmalgameClosure_call1(" + calleeName + ", " + this.BoxAsVoid(arg0) + ")"
                                if (this.IsCPointerType(retC)) { return "((" + retC + ")" + callC + ")" }
                                return this.UnboxScalar(retC, callC)
                            }
                            if (argc == 2) {
                                let arg0 = this.EmitExprStr(expr.Args.Get(0))
                                let arg1 = this.EmitExprStr(expr.Args.Get(1))
                                let callC = "AmalgameClosure_call2(" + calleeName + ", " + this.BoxAsVoid(arg0) + ", " + this.BoxAsVoid(arg1) + ")"
                                if (this.IsCPointerType(retC)) { return "((" + retC + ")" + callC + ")" }
                                return this.UnboxScalar(retC, callC)
                            }
                            if (argc == 3) {
                                let arg0 = this.EmitExprStr(expr.Args.Get(0))
                                let arg1 = this.EmitExprStr(expr.Args.Get(1))
                                let arg2 = this.EmitExprStr(expr.Args.Get(2))
                                let callC = "AmalgameClosure_call3(" + calleeName + ", " + this.BoxAsVoid(arg0) + ", " + this.BoxAsVoid(arg1) + ", " + this.BoxAsVoid(arg2) + ")"
                                if (this.IsCPointerType(retC)) { return "((" + retC + ")" + callC + ")" }
                                return this.UnboxScalar(retC, callC)
                            }
                        }
                    }
                }
            }
            // Closure call: callee is a local of type AmalgameClosure*.
            // v2 supports arities 1, 2, 3 — args boxed via intptr_t at
            // the call site, result unboxed back to i64. Arities >3
            // would need a runtime/codegen extension; not yet emitted
            // by anything.
            if (expr.Left != null && expr.Left.Kind == NodeKind.IDENTIFIER) {
                let calleeName = expr.Left.Name
                let calleeType = this.LocalTypeGet(calleeName)
                if (calleeType == "AmalgameClosure*") {
                    let argc: int = expr.Args.Count()
                    // Result-type-aware unwrap. The lambda's declared
                    // return type was stashed at assignment time (see
                    // EmitVarDeclStmt / __closure_ret__). For pointer
                    // types (code_string, anything ending in `*`) emit
                    // a direct cast so gcc doesn't complain about
                    // integer-to-pointer; for scalars stay on the
                    // intptr_t-roundtrip path; default to i64 if we
                    // never learned the return type (block-bodied
                    // lambdas, or fall-throughs from older code).
                    let retC0 = this.ListElemGet("__closure_ret__", calleeName)
                    var retC: string = retC0
                    if (String_Length(retC) == 0) { retC = "i64" }
                    if (argc == 1) {
                        let arg0 = this.EmitExprStr(expr.Args.Get(0))
                        let callC = "AmalgameClosure_call1(" + calleeName + ", " + this.BoxAsVoid(arg0) + ")"
                        if (this.IsCPointerType(retC)) { return "((" + retC + ")" + callC + ")" }
                        return this.UnboxScalar(retC, callC)
                    }
                    if (argc == 2) {
                        let arg0 = this.EmitExprStr(expr.Args.Get(0))
                        let arg1 = this.EmitExprStr(expr.Args.Get(1))
                        let callC = "AmalgameClosure_call2(" + calleeName + ", " + this.BoxAsVoid(arg0) + ", " + this.BoxAsVoid(arg1) + ")"
                        if (this.IsCPointerType(retC)) { return "((" + retC + ")" + callC + ")" }
                        return this.UnboxScalar(retC, callC)
                    }
                    if (argc == 3) {
                        let arg0 = this.EmitExprStr(expr.Args.Get(0))
                        let arg1 = this.EmitExprStr(expr.Args.Get(1))
                        let arg2 = this.EmitExprStr(expr.Args.Get(2))
                        let callC = "AmalgameClosure_call3(" + calleeName + ", " + this.BoxAsVoid(arg0) + ", " + this.BoxAsVoid(arg1) + ", " + this.BoxAsVoid(arg2) + ")"
                        if (this.IsCPointerType(retC)) { return "((" + retC + ")" + callC + ")" }
                        return this.UnboxScalar(retC, callC)
                    }
                }
            }
            // Check for AmalgameList method dispatch before generic emit
            let listCall = this.TryEmitListCall(expr)
            if (String_Length(listCall) > 0) { return listCall }
            // Detect this.Method() or this.Field.Method() → inject self / self->Field as first arg
            var isSelfCall = false
            var selfExpr   = "self"
            if (expr.Left != null) {
                if (expr.Left.Kind == NodeKind.MEMBER) {
                    if (expr.Left.Left != null) {
                        let ll = expr.Left.Left
                        // this.Method(...)
                        if (ll.Kind == NodeKind.THIS_EXPR) {
                            isSelfCall = true
                            selfExpr   = "self"
                        }
                        // this.Field.Method(...) or varName.Field.Method(...)
                        // — field is itself a struct.
                        if (ll.Kind == NodeKind.MEMBER) {
                            if (ll.Left != null) {
                                if (ll.Left.Kind == NodeKind.THIS_EXPR) {
                                    isSelfCall = true
                                    selfExpr   = "self->" + ll.Name
                                }
                                // varName.Field.Method(...): pass varName->Field
                                // as self. The function name resolves via
                                // EmitCalleeStr's matching new branch below.
                                if (ll.Left.Kind == NodeKind.IDENTIFIER) {
                                    let vt = this.LocalTypeGet(ll.Left.Name)
                                    let vbare = String_Replace(vt, "*", "")
                                    if (String_Length(vbare) > 0 && !this.IsEnum(vbare)) {
                                        isSelfCall = true
                                        selfExpr   = ll.Left.Name + "->" + ll.Name
                                    }
                                }
                                // Deeper chain: ll is itself this.A.B... (its
                                // Left is a MEMBER). Resolve the leaf class
                                // and pass the whole inner chain expression
                                // as self; EmitCalleeStr's ResolveReceiverClass
                                // branch emits the matching method symbol.
                                if (ll.Left.Kind == NodeKind.MEMBER) {
                                    let deepCls: string = this.ResolveReceiverClass(ll)
                                    if (String_Length(deepCls) > 0 && !this.IsEnum(deepCls)) {
                                        isSelfCall = true
                                        selfExpr   = this.EmitExprStr(ll)
                                    }
                                }
                            }
                        }
                        // varName.Method(...) where varName is a known instance type
                        if (ll.Kind == NodeKind.IDENTIFIER) {
                            let vt = this.LocalTypeGet(ll.Name)
                            let bare = String_Replace(vt, "*", "")
                            if (String_Length(bare) > 0 && !this.IsEnum(bare)) {
                                isSelfCall = true
                                selfExpr   = ll.Name
                            }
                        }
                        // varName.Method().OtherMethod(...) — chain into the
                        // result of the inner call. InferTypeFromExpr knows
                        // user-defined method return types (registered via
                        // MethodRetSet during pass-1 forward emission), so
                        // the receiver type comes back resolved.
                        if (ll.Kind == NodeKind.CALL) {
                            let rt = this.InferTypeFromExpr(ll)
                            let rbare = String_Replace(rt, "*", "")
                            if (String_Length(rbare) > 0 && !this.IsEnum(rbare)) {
                                isSelfCall = true
                                selfExpr   = this.EmitExprStr(ll)
                            }
                        }
                        // new ClassName(...).Method(...) — instantiate
                        // and call on the result. The receiver is the
                        // full constructor call; EmitCalleeStr below
                        // resolves the method symbol via the same
                        // path as a static call to ClassName.
                        if (ll.Kind == NodeKind.NEW_EXPR) {
                            isSelfCall = true
                            selfExpr   = this.EmitExprStr(ll)
                        }
                        // "literal".Method(...) — pass the literal as the
                        // first argument to String_Method.
                        if (ll.Kind == NodeKind.LITERAL_STRING) {
                            isSelfCall = true
                            selfExpr   = this.EmitExprStr(ll)
                        }
                    }
                }
            }
            // Interface dispatch (Go-style itab): when the receiver's
            // static type is an interface value, route through the itab
            // (`recv.itab->m(recv.data, …)`) instead of a concrete
            // symbol. Gated on IsInterface → concrete calls unaffected.
            if (expr.Left != null && expr.Left.Kind == NodeKind.MEMBER && expr.Left.Left != null) {
                let recvT0: string = this.InferTypeFromExpr(expr.Left.Left)
                if (this.IsInterface(recvT0)) {
                    let recvC: string = this.EmitExprStr(expr.Left.Left)
                    let mname: string = expr.Left.Name
                    let icallee: string = recvC + ".itab->" + mname
                    var ic: string = icallee + "(" + recvC + ".data"
                    let argcI: int = expr.Args.Count()
                    for ai in 0..argcI {
                        ic = ic + ", " + this.CoerceArg(icallee, ai, expr.Args.Get(ai))
                    }
                    ic = ic + ")"
                    return ic
                }
            }
            let callee = this.EmitCalleeStr(expr.Left)
            var callStr = callee + "("
            var first = true
            if (isSelfCall) {
                callStr = callStr + selfExpr
                first = false
            }
            let argc = expr.Args.Count()
            // Variadic callee: emit `fixedArity` args positionally, then
            // gather every remaining arg into one `AmalgameList*`. A
            // non-variadic callee (fixedArity < 0) keeps the plain
            // one-arg-per-param path below.
            let fixedArity = this.MethodVariadicGet(callee)
            if (fixedArity >= 0) {
                for i in 0..argc {
                    if (i < fixedArity) {
                        let arg = expr.Args.Get(i)
                        if (!first) { callStr = callStr + ", " }
                        callStr = callStr + this.EmitExprStr(arg)
                        first = false
                    }
                }
                if (!first) { callStr = callStr + ", " }
                callStr = callStr + this.EmitVariadicTail(expr, fixedArity)
                first = false
            } else {
                for i in 0..argc {
                    let arg = expr.Args.Get(i)
                    if (!first) { callStr = callStr + ", " }
                    callStr = callStr + this.CoerceArg(callee, i, arg)
                    first = false
                }
            }
            callStr = callStr + ")"
            // Null-safe call `obj?.method(...)`: wrap as `(obj ? call : NULL)`
            // — receiver is evaluated twice, so callers should keep it side-effect-free.
            if (expr.Left != null && expr.Left.Kind == NodeKind.MEMBER && expr.Left.Flag) {
                let recv = this.EmitExprStr(expr.Left.Left)
                return "(" + recv + " ? " + callStr + " : NULL)"
            }
            return callStr
        }
        NodeKind.NEW_EXPR => {
            let tname = expr.Name
            var newCall = ""
            if (String_StartsWith(tname, "List<") || tname == "List") {
                newCall = "AmalgameList_new()"
            } else {
                if (String_StartsWith(tname, "Map<") || tname == "Map") {
                    newCall = "AmalgameMap_new()"
                } else {
                    if (String_StartsWith(tname, "Set<") || tname == "Set") {
                        newCall = "AmalgameSet_new()"
                    } else if (tname == "WebSocket") {
                        // WebSocket runtime helper — skip the
                        // namespace-mangled symbol so `new WebSocket(...)`
                        // lowers to `WebSocket_new(...)` against the
                        // dedicated runtime header. FileWatcher used
                        // to be in this list before its post-v0.7.5
                        // AM migration; Vec3/Vec4/Mat4 same post the
                        // Math_Vec.h migration.
                        newCall = tname + "_new("
                        let argc = expr.Args.Count()
                        for i in 0..argc {
                            let arg = expr.Args.Get(i)
                            if (i > 0) { newCall = newCall + ", " }
                            newCall = newCall + this.EmitExprStr(arg)
                        }
                        newCall = newCall + ")"
                        return newCall
                    } else {
                        // Project F: external classes use their file's
                        // own mangled prefix, not the bundle's NsPrefix.
                        // v0.8.38: PkgClasses also consulted so
                        // `new Cookie()` in amalgame-web emits
                        // `Amalgame_Net_Http_Cookie_new(...)` instead
                        // of the consumer-namespace SymName fallback.
                        let externalMangled: string = this.ExternalClassMangled(tname)
                        var ctorPrefix: string = ""
                        if (String_Length(externalMangled) > 0) {
                            ctorPrefix = externalMangled
                        } else {
                            ctorPrefix = this.ClassMangledFor(tname)
                        }
                        newCall = ctorPrefix + "_new("
                        // Variadic constructor: emit `fixedArity` args
                        // positionally, then gather every remaining arg
                        // (plain or `...spread`) into one AmalgameList*,
                        // mirroring the CALL-site path. A non-variadic ctor
                        // (fixedArity < 0) keeps the plain one-arg-per-param
                        // path below.
                        let ctorArity = this.MethodVariadicGet(ctorPrefix + "_new")
                        let argc = expr.Args.Count()
                        if (ctorArity >= 0) {
                            var cfirst = true
                            for i in 0..argc {
                                if (i < ctorArity) {
                                    let arg = expr.Args.Get(i)
                                    if (!cfirst) { newCall = newCall + ", " }
                                    newCall = newCall + this.EmitExprStr(arg)
                                    cfirst = false
                                }
                            }
                            if (!cfirst) { newCall = newCall + ", " }
                            newCall = newCall + this.EmitVariadicTail(expr, ctorArity)
                        } else {
                            for i in 0..argc {
                                let arg = expr.Args.Get(i)
                                if (i > 0) { newCall = newCall + ", " }
                                newCall = newCall + this.CoerceArg(ctorPrefix + "_new", i, arg)
                            }
                        }
                        newCall = newCall + ")"
                    }
                }
            }
            return newCall
        }
        NodeKind.INDEX_EXPR => {
            let base = this.EmitExprStr(expr.Left)
            let idx  = this.EmitExprStr(expr.Right)
            return base + "[" + idx + "]"
        }
        NodeKind.LIST_COMP => {
            return this.EmitListComp(expr)
        }
        NodeKind.LIST_LITERAL => {
            return this.EmitListLiteral(expr)
        }
        _ => { }
        }
        return "/* unknown expr */"
    }

    // ── List literal ──────────────────────────────────
    // [expr1, expr2, expr3] becomes a GCC compound-statement
    // expression that allocates a fresh AmalgameList* and pushes
    // each element box. Empty `[]` emits an empty list. Elements
    // are boxed via BoxAsVoid (matches the convention used by
    // user-written .Add(x) calls and by EmitListComp).
    private string EmitListLiteral(AstNode n) {
        var s: string = "({ AmalgameList* __ll = AmalgameList_new(); "
        let nc: int = n.Children.Count()
        for i in 0..nc {
            let child: AstNode = n.Children.Get(i)
            // Spread item `...expr` (v0.8.36+): the operand is an
            // iterable; splice its elements one by one via an inline
            // for-loop over its data array. The operand is bound to
            // a fresh `__sp_<i>` local so a side-effecting source
            // expression (e.g. a method call) only fires once.
            if (child.Kind == NodeKind.UNARY && child.Str == "...") {
                let src: string = this.EmitExprStr(child.Left)
                let idx: string = String_FromInt(i)
                s = s + "{ AmalgameList* __sp_" + idx + " = " + src + "; "
                s = s + "i64 __spn_" + idx + " = AmalgameList_size(__sp_" + idx + "); "
                s = s + "for (i64 __spi_" + idx + " = 0; __spi_" + idx + " < __spn_" + idx + "; __spi_" + idx + "++) { "
                s = s + "AmalgameList_add(__ll, __sp_" + idx + "->data[__spi_" + idx + "]); "
                s = s + "} } "
                continue
            }
            let elem: string = this.EmitExprStr(child)
            s = s + "AmalgameList_add(__ll, " + this.BoxAsVoid(elem) + "); "
        }
        s = s + "__ll; })"
        return s
    }

    // Gather a call's trailing arguments (those at index >= fixedArity)
    // into a single fresh `AmalgameList*`, the value passed for a
    // variadic parameter. Mirrors EmitListLiteral's element/spread
    // handling: a plain arg is boxed and appended; a spread arg
    // `...expr` splices the source list's elements one by one. The
    // list is always built (possibly empty), so the callee's variadic
    // param is never NULL.
    private string EmitVariadicTail(AstNode call, int fixedArity) {
        var s: string = "({ AmalgameList* __va = AmalgameList_new(); "
        let argc: int = call.Args.Count()
        for i in fixedArity..argc {
            let arg: AstNode = call.Args.Get(i)
            if (arg.Kind == NodeKind.UNARY && arg.Str == "...") {
                let src: string = this.EmitExprStr(arg.Left)
                let idx: string = String_FromInt(i)
                s = s + "{ AmalgameList* __va_sp_" + idx + " = " + src + "; "
                s = s + "i64 __va_spn_" + idx + " = AmalgameList_size(__va_sp_" + idx + "); "
                s = s + "for (i64 __va_spi_" + idx + " = 0; __va_spi_" + idx + " < __va_spn_" + idx + "; __va_spi_" + idx + "++) { "
                s = s + "AmalgameList_add(__va, __va_sp_" + idx + "->data[__va_spi_" + idx + "]); "
                s = s + "} } "
                continue
            }
            let elem: string = this.EmitExprStr(arg)
            s = s + "AmalgameList_add(__va, " + this.BoxAsVoid(elem) + "); "
        }
        s = s + "__va; })"
        return s
    }

    // ── Match as expression ───────────────────────────
    // `let x = match subj { p1 => e1, p2 => e2, _ => ed }` becomes a GCC
    // compound statement expression:
    //   ({ <type> __mr; if (subj == p1) __mr = (e1);
    //      else if (subj == p2) __mr = (e2); else __mr = (ed); __mr; })
    // The result type is inferred from the first arm body. Block bodies
    // are unwrapped to their last expression statement (they're rare in
    // expression position). Algebraic-enum patterns and guards aren't
    // supported in expression position yet — we emit a stub so the rest
    // of the surrounding compilation can proceed and surface the error
    // through the type checker rather than a syntax-broken C dump.
    private string EmitMatchExpr(AstNode n) {
        let subject = n.Left
        if (subject == null) { return "/* match-expr: missing subject */" }
        let subjectStr = this.EmitExprStr(subject)
        let armCount = n.Children.Count()
        if (armCount == 0) { return "/* match-expr: no arms */" }
        // Infer the result type from the first arm body — drives the
        // declared type of __mr in the generated compound expression.
        let firstArm = n.Children.Get(0)
        let firstBody = firstArm.Right
        var resultType = this.InferTypeFromExpr(firstBody)
        if (String_Length(resultType) == 0) { resultType = "i64" }
        var s = "({ " + resultType + " __mr; "
        var firstArmFlag = true
        for i in 0..armCount {
            let arm = n.Children.Get(i)
            let pat = arm.Left
            let body = arm.Right
            if (pat == null || body == null) { continue }
            let pk = pat.Kind
            let bodyStr = this.EmitExprStr(body)
            // Wildcard arm: `_ => expr` — emit as terminal else.
            if (pk == NodeKind.IDENTIFIER && pat.Name == "_") {
                let prefix = if (firstArmFlag) { "" } else { " else " }
                s = s + prefix + "{ __mr = (" + bodyStr + "); }"
                firstArmFlag = false
                continue
            }
            // Range pattern: lo..hi
            var cond = ""
            if (pk == NodeKind.BINARY && pat.Str == "..") {
                let lo = this.EmitExprStr(pat.Left)
                let hi = this.EmitExprStr(pat.Right)
                cond = subjectStr + " >= " + lo + " && " + subjectStr + " <= " + hi
            } else if (pk == NodeKind.LITERAL_STRING) {
                let patStr = this.EmitExprStr(pat)
                cond = "strcmp(" + subjectStr + ", " + patStr + ") == 0"
            } else {
                let patStr = this.EmitExprStr(pat)
                cond = subjectStr + " == " + patStr
            }
            let prefix = if (firstArmFlag) { "" } else { " else " }
            s = s + prefix + "if (" + cond + ") { __mr = (" + bodyStr + "); }"
            firstArmFlag = false
        }
        s = s + " __mr; })"
        return s
    }

    // ── List comprehension ────────────────────────────
    // [proj for vn in iter (if guard)?] becomes a GCC compound statement
    // expression that builds and returns an AmalgameList*. Two iteration
    // shapes: range (BINARY "..") emits a counted i64 loop; everything
    // else is treated as a List* and iterated by index. Elements are
    // boxed via (void*)(intptr_t)(...) — same convention as user code
    // does when calling .Add() directly. Unique names are suffixed with
    // the iteration variable so nested comps over distinct vars don't
    // collide; same-var nesting is unsupported (rare in practice).
    private string EmitListComp(AstNode n) {
        let vn = n.Str
        let iter = n.Right
        var isRange = false
        if (iter != null && iter.Kind == NodeKind.BINARY && iter.Str == "..") {
            isRange = true
        }
        // Emit the iterable BEFORE setting the local type, so its sub-expressions
        // see the outer scope (e.g. an outer variable named `vn` keeps its type).
        var loopHeader = ""
        if (isRange) {
            let startStr = this.EmitExprStr(iter.Left)
            let endStr   = this.EmitExprStr(iter.Right)
            loopHeader = "for (i64 " + vn + " = " + startStr + "; " + vn + " < " + endStr + "; " + vn + "++) { "
            this.LocalTypeSet(vn, "i64")
        } else {
            let iterStr = this.EmitExprStr(iter)
            loopHeader = "AmalgameList* __it_" + vn + " = " + iterStr + "; "
            loopHeader = loopHeader + "i64 __n_" + vn + " = AmalgameList_size(__it_" + vn + "); "
            loopHeader = loopHeader + "for (i64 __i_" + vn + " = 0; __i_" + vn + " < __n_" + vn + "; __i_" + vn + "++) { "
            loopHeader = loopHeader + "void* " + vn + " = __it_" + vn + "->data[__i_" + vn + "]; "
            this.LocalTypeSet(vn, "void*")
        }
        // Now emit the projection and guard with vn visible.
        let projStr = this.EmitExprStr(n.Left)
        var guardStr = ""
        if (n.Cond != null) {
            guardStr = "if (" + this.EmitExprStr(n.Cond) + ") "
        }
        this.LocalTypeSet(vn, "")
        var s = "({ AmalgameList* __lc_" + vn + " = AmalgameList_new(); "
        s = s + loopHeader
        s = s + guardStr
        s = s + "AmalgameList_add(__lc_" + vn + ", " + this.BoxAsVoid(projStr) + "); "
        s = s + "} __lc_" + vn + "; })"
        return s
    }

    // ── AmalgameList method dispatch ──────────────────
    // Returns "" if not a list call, otherwise returns the C call string.
    // Handles:
    //   varName.Add(x)     → AmalgameList_add(varName, (void*)(intptr_t)(x))
    //   varName.Count()    → AmalgameList_count(varName)
    //   varName.Get(i)     → (<ElemType>)(intptr_t)AmalgameList_get(varName, i)
    //   this.Field.Add(x)  → AmalgameList_add(self->Field, ...)
    //   this.Field.Count() → AmalgameList_count(self->Field)
    //   this.Field.Get(i)  → AmalgameList_get(self->Field, i)
    private string TryEmitListCall(AstNode callExpr) {
        if (callExpr.Left == null) { return "" }
        if (callExpr.Left.Kind != NodeKind.MEMBER) { return "" }
        let callee = callExpr.Left
        let mname  = callee.Name

        // Resolve the receiver to a C expression + C type, regardless
        // of whether it's a simple local (`m.Set(...)`), a field on
        // `this` (`this.entries.Set(...)`), or a field on a known
        // local instance (`obj.entries.Set(...)`). Bug 2 (v0.8.23):
        // before this, only the IDENTIFIER case was specialized, so
        // `this.entries.Set(k, v)` fell through to the generic method
        // dispatch and emitted `AmalgameMap_Set` (PascalCase, undefined).
        var rxExpr  = ""
        var rxType  = ""
        var rxElem  = ""   // tracking key for ListElemGet on Map<K,V> Get
        if (callee.Left != null) {
            let rk = callee.Left.Kind
            if (rk == NodeKind.IDENTIFIER) {
                rxExpr = callee.Left.Name
                rxType = this.LocalTypeGet(rxExpr)
                rxElem = "__local_map__." + rxExpr
            }
            if (rk == NodeKind.MEMBER && callee.Left.Left != null) {
                let pk = callee.Left.Left.Kind
                if (pk == NodeKind.THIS_EXPR) {
                    let fn = callee.Left.Name
                    rxExpr = "self->" + fn
                    rxType = this.FieldTypeGet(this.CurrentClass, fn)
                    rxElem = this.CurrentClass + "." + fn
                }
                if (pk == NodeKind.IDENTIFIER) {
                    let vn = callee.Left.Left.Name
                    let vt = this.LocalTypeGet(vn)
                    let bn = String_Replace(vt, "*", "")
                    let fn = callee.Left.Name
                    if (String_Length(bn) > 0) {
                        rxExpr = vn + "->" + fn
                        rxType = this.FieldTypeGet(bn, fn)
                        rxElem = bn + "." + fn
                    }
                }
            }
        }

        // General deep-chain fallback (v0.8.66): the hand-coded shapes
        // above only reach a single field hop (`this.F` / `ident.F`).
        // For a 2+-level receiver chain (`w.Inner.Vals.Method()`,
        // where callee.Left.Left is itself a MEMBER), resolve the
        // receiver generically — InferTypeFromExpr walks the field
        // chain to its C type and EmitExprStr lowers the MEMBER node to
        // the `a->b->c` accessor. Without this, such calls fell through
        // to the broken `recv->Field_Method()` generic dispatch (the
        // `obj.X.Y.Method()` collapse bug). Covers Map/Set here via
        // rxExpr/rxType; the List path picks it up in Case 5 below.
        if (String_Length(rxExpr) == 0 && callee.Left != null && callee.Left.Kind == NodeKind.MEMBER) {
            let deepT = this.InferTypeFromExpr(callee.Left)
            if (deepT == "AmalgameMap*" || deepT == "AmalgameSet*" || deepT == "AmalgameList*") {
                rxExpr = this.EmitExprStr(callee.Left)
                rxType = deepT
            }
        }

        // Map methods
        // Map iteration helpers — Keys() / Values() return List<K>/List<V>.
        if (mname == "Keys" || mname == "Values") {
            if (rxType == "AmalgameMap*") {
                if (mname == "Keys")   { return "AmalgameMap_keys(" + rxExpr + ")" }
                if (mname == "Values") { return "AmalgameMap_values(" + rxExpr + ")" }
            }
        }
        if (mname == "Set" || mname == "Has" || mname == "Size" || mname == "Remove" || mname == "Get") {
            if (rxType == "AmalgameMap*") {
                let args = callExpr.Args
                let ac = args.Count()
                if (mname == "Set" && ac >= 2) {
                    let k2 = this.EmitExprStr(args.Get(0))
                    let v2 = this.EmitExprStr(args.Get(1))
                    return "AmalgameMap_set(" + rxExpr + ", " + k2 + ", " + this.BoxAsVoid(v2) + ")"
                }
                if (mname == "Has" && ac >= 1) {
                    let k2 = this.EmitExprStr(args.Get(0))
                    return "AmalgameMap_has(" + rxExpr + ", " + k2 + ")"
                }
                if (mname == "Size") { return "AmalgameMap_size(" + rxExpr + ")" }
                if (mname == "Remove" && ac >= 1) {
                    let k2 = this.EmitExprStr(args.Get(0))
                    return "AmalgameMap_remove(" + rxExpr + ", " + k2 + ")"
                }
                if (mname == "Get" && ac >= 1) {
                    let k2 = this.EmitExprStr(args.Get(0))
                    // Use the recorded value type for `new Map<K,V>()` so
                    // `m.Get(k)` lowers to `(V)AmalgameMap_get(m, k)`
                    // instead of `(void*)…`. Falls back to void* when V
                    // wasn't tracked (e.g. param-passed map or field).
                    var castT = ""
                    let dotPos = String_IndexOf(rxElem, ".")
                    if (dotPos > 0) {
                        let nsPart = String_Substring(rxElem, 0, dotPos)
                        let kPart  = String_Substring(rxElem, dotPos + 1, String_Length(rxElem) - dotPos - 1)
                        castT = this.ListElemGet(nsPart, kPart)
                    }
                    if (String_Length(castT) == 0) { castT = "void*" }
                    return "(" + castT + ")AmalgameMap_get(" + rxExpr + ", " + k2 + ")"
                }
            }
        }
        // Set methods
        if (mname == "Contains" || mname == "Size") {
            if (rxType == "AmalgameSet*") {
                let args = callExpr.Args
                let ac = args.Count()
                if (mname == "Contains" && ac >= 1) {
                    let v2 = this.EmitExprStr(args.Get(0))
                    return "AmalgameSet_contains(" + rxExpr + ", " + v2 + ")"
                }
                if (mname == "Size") { return "AmalgameSet_size(" + rxExpr + ")" }
            }
        }
        if (mname == "Add" || mname == "Remove") {
            if (rxType == "AmalgameSet*") {
                let args = callExpr.Args
                let ac = args.Count()
                if (ac >= 1) {
                    let v2 = this.EmitExprStr(args.Get(0))
                    if (mname == "Add") { return "AmalgameSet_add(" + rxExpr + ", " + v2 + ")" }
                    return "AmalgameSet_remove(" + rxExpr + ", " + v2 + ")"
                }
            }
        }

        if (mname != "Add" && mname != "Set" && mname != "Count" && mname != "Get" && mname != "IsEmpty" && mname != "Remove" && mname != "RemoveAt" && mname != "Clear" && mname != "Reserve" && mname != "Filter" && mname != "Map" && mname != "Reduce" && mname != "ForEach" && mname != "Any" && mname != "All" && mname != "CountIf") { return "" }

        // Determine the list object expression and its C type
        var listExpr = ""
        var listCType = ""

        if (callee.Left != null) {
            let lk = callee.Left.Kind

            // Case 1: varName.Method()
            if (lk == NodeKind.IDENTIFIER) {
                let vname = callee.Left.Name
                let vtype = this.LocalTypeGet(vname)
                if (vtype == "AmalgameList*") {
                    listExpr  = vname
                    listCType = "AmalgameList*"
                }
            }

            // Case 4: <list-call>.Method() — chained higher-order calls
            // (e.g. xs.Filter(p).Map(q)). We recursively emit the inner
            // call as the listExpr; the result is itself a List* so the
            // outer Filter/Map/etc. can wrap it cleanly.
            if (lk == NodeKind.CALL) {
                let innerStr: string = this.TryEmitListCall(callee.Left)
                if (String_Length(innerStr) > 0) {
                    listExpr  = innerStr
                    listCType = "AmalgameList*"
                }
            }

            // Case 2: this.Field.Method()
            if (lk == NodeKind.MEMBER) {
                if (callee.Left.Left != null) {
                    let llk = callee.Left.Left.Kind
                    if (llk == NodeKind.THIS_EXPR) {
                        let fname = callee.Left.Name
                        let ftype = this.FieldTypeGet(this.CurrentClass, fname)
                        if (ftype == "AmalgameList*") {
                            listExpr  = "self->" + fname
                            listCType = "AmalgameList*"
                        }
                    }
                    // Case 3: varName.Field.Method() where varName is a known struct type
                    if (llk == NodeKind.IDENTIFIER) {
                        let vname2  = callee.Left.Left.Name
                        let vtype2  = this.LocalTypeGet(vname2)
                        let fname2  = callee.Left.Name
                        // Strip trailing * to get class name for field lookup
                        let vbare   = String_Replace(vtype2, "*", "")
                        let ftype2  = this.FieldTypeGet(vbare, fname2)
                        if (ftype2 == "AmalgameList*") {
                            listExpr  = vname2 + "->" + fname2
                            listCType = "AmalgameList*"
                        }
                    }
                }
            }
        }

        // Case 5 (v0.8.66): general deep member chain for List methods.
        // Reuses the rxExpr/rxType deep-chain fallback resolved above
        // (Cases 2/3 only reach a single field hop, leaving listExpr
        // empty for `w.Inner.Vals.Count()`). The guard means this fires
        // only when the hand-coded cases missed, so it never double-
        // handles the simpler shapes.
        if (String_Length(listExpr) == 0 && rxType == "AmalgameList*" && String_Length(rxExpr) > 0) {
            listExpr  = rxExpr
            listCType = "AmalgameList*"
        }

        if (String_Length(listExpr) == 0) { return "" }

        // Emit the appropriate C call
        if (mname == "Clear") {
            return "AmalgameList_clear(" + listExpr + ")"
        }
        if (mname == "Reserve") {
            let arg0 = this.EmitExprStr(callExpr.Args.Get(0))
            return "AmalgameList_reserve(" + listExpr + ", " + arg0 + ")"
        }
        if (mname == "Count") {
            return "AmalgameList_count(" + listExpr + ")"
        }
        if (mname == "Add") {
            let argc = callExpr.Args.Count()
            if (argc == 0) { return "AmalgameList_add(" + listExpr + ", NULL)" }
            // List<I> of an interface: coerce the concrete element to a
            // fat value and heap-box it into the void* slot.
            let elemA: string = this.ResolveListElemC(callee)
            if (String_Length(elemA) > 0 && this.IsInterface(elemA)) {
                let im: string = this.IfaceMangledFor(elemA)
                let fat: string = this.CoerceToIface(im, callExpr.Args.Get(0))
                return "AmalgameList_add(" + listExpr + ", " + this.BoxIface(im, fat) + ")"
            }
            let arg0 = this.EmitExprStr(callExpr.Args.Get(0))
            return "AmalgameList_add(" + listExpr + ", " + this.BoxAsVoid(arg0) + ")"
        }
        if (mname == "Set") {
            // List.Set(idx, value): replace the element at idx in place.
            // The runtime guards out-of-range writes (silent no-op).
            let argc = callExpr.Args.Count()
            if (argc < 2) { return "" }
            let idxArg = this.EmitExprStr(callExpr.Args.Get(0))
            let elemS: string = this.ResolveListElemC(callee)
            if (String_Length(elemS) > 0 && this.IsInterface(elemS)) {
                let im: string = this.IfaceMangledFor(elemS)
                let fat: string = this.CoerceToIface(im, callExpr.Args.Get(1))
                return "AmalgameList_set(" + listExpr + ", " + idxArg + ", " + this.BoxIface(im, fat) + ")"
            }
            let valArg = this.EmitExprStr(callExpr.Args.Get(1))
            return "AmalgameList_set(" + listExpr + ", " + idxArg + ", " + this.BoxAsVoid(valArg) + ")"
        }
        if (mname == "Get") {
            let argc = callExpr.Args.Count()
            var idx0 = "0"
            if (argc > 0) { idx0 = this.EmitExprStr(callExpr.Args.Get(0)) }
            // Try to find element type from the list field's owning class
            var elemType = ""
            if (callee.Left != null) {
                let lkG = callee.Left.Kind
                // Case: this.Field.Get(i)
                if (lkG == NodeKind.THIS_EXPR) {
                    // listExpr is just the list var — field name is callee.Name of the outer
                }
                // Case: varName.Field.Get(i) — lkG == MEMBER(IDENTIFIER(varName), Field)
                if (lkG == NodeKind.MEMBER) {
                    if (callee.Left.Left != null) {
                        let lll = callee.Left.Left
                        // this.Field.Get(i)
                        if (lll.Kind == NodeKind.THIS_EXPR) {
                            let fn4 = callee.Left.Name
                            elemType = this.ListElemGet(this.CurrentClass, fn4)
                        }
                        // var.Field.Get(i) — look up var type → class → field elem type
                        if (lll.Kind == NodeKind.IDENTIFIER) {
                            let vn4   = lll.Name
                            let vt4   = this.LocalTypeGet(vn4)
                            let bare4 = String_Replace(vt4, "*", "")
                            let fn4b  = callee.Left.Name
                            elemType = this.ListElemGet(bare4, fn4b)
                        }
                    }
                }
                // Case: varName.Get(i) — listExpr is varName itself (Case 1).
                // Look up the local elem type recorded at `let xs = new List<T>()`.
                if (lkG == NodeKind.IDENTIFIER) {
                    let vn5 = callee.Left.Name
                    elemType = this.ListElemGet("__local__", vn5)
                }
                // Case: chained `xs.Get(i).Get(j)` — receiver is a CALL
                // to Get. Walk the chain back to the original typed
                // local, peeling one `List<...>` layer per hop. Lets
                // nested-collection access lower with proper typed casts
                // instead of falling through to `(void*)`.
                if (lkG == NodeKind.CALL && String_Length(elemType) == 0) {
                    let chainedRaw: string = this.RecoverChainedListElemRaw(callee.Left)
                    if (String_Length(chainedRaw) > 0) {
                        elemType = this.TypeToC(chainedRaw)
                    }
                }
            }
            if (String_Length(elemType) > 0) {
                // List<I> of an interface: the slot holds a heap pointer
                // to a {itab,data} fat value (see BoxIface) — deref it.
                if (this.IsInterface(elemType)) {
                    return "(*(" + elemType + "*)AmalgameList_get(" + listExpr + ", " + idx0 + "))"
                }
                // For pointer-shaped elems (anything ending in `*`,
                // including code_string), the direct cast suffices.
                // For scalar elems (i64, double, code_bool), the
                // runtime stored an intptr_t-boxed value — unbox via
                // the standard helper so the assignment doesn't trip
                // a sign-extension warning.
                if (this.IsCPointerType(elemType)) {
                    return "(" + elemType + ")AmalgameList_get(" + listExpr + ", " + idx0 + ")"
                }
                return this.UnboxScalar(elemType, "AmalgameList_get(" + listExpr + ", " + idx0 + ")")
            }
            return "(void*)AmalgameList_get(" + listExpr + ", " + idx0 + ")"
        }
        if (mname == "IsEmpty") {
            return "AmalgameList_isEmpty(" + listExpr + ")"
        }
        if (mname == "Remove") {
            let argc = callExpr.Args.Count()
            if (argc > 0) {
                let arg0 = this.EmitExprStr(callExpr.Args.Get(0))
                return "AmalgameList_remove(" + listExpr + ", " + this.BoxAsVoid(arg0) + ")"
            }
        }
        if (mname == "RemoveAt") {
            let argc = callExpr.Args.Count()
            if (argc > 0) {
                let arg0 = this.EmitExprStr(callExpr.Args.Get(0))
                return "AmalgameList_removeAt(" + listExpr + ", " + arg0 + ")"
            }
        }
        // ── Higher-order methods (lambda v2.5) ──────────
        // Each lambda argument is emitted as an inline GCC compound
        // statement expression that allocates the env, copies captures
        // in, and yields a fresh AmalgameClosure*. The runtime helpers
        // (AmalgameList_filter / _map / _reduce / _forEach) expect the
        // closure as their last argument.
        if (mname == "Filter") {
            let argc = callExpr.Args.Count()
            if (argc != 1) { return "" }
            let lamStr = this.EmitClosureArg(callExpr.Args.Get(0))
            if (String_Length(lamStr) == 0) { return "" }
            return "AmalgameList_filter(" + listExpr + ", " + lamStr + ")"
        }
        if (mname == "Map") {
            let argc = callExpr.Args.Count()
            if (argc != 1) { return "" }
            let lamStr = this.EmitClosureArg(callExpr.Args.Get(0))
            if (String_Length(lamStr) == 0) { return "" }
            return "AmalgameList_map(" + listExpr + ", " + lamStr + ")"
        }
        if (mname == "ForEach") {
            let argc = callExpr.Args.Count()
            if (argc != 1) { return "" }
            let lamStr = this.EmitClosureArg(callExpr.Args.Get(0))
            if (String_Length(lamStr) == 0) { return "" }
            return "AmalgameList_forEach(" + listExpr + ", " + lamStr + ")"
        }
        if (mname == "Reduce") {
            // Two-arg form: xs.Reduce(init, (acc, x) => …)
            let argc = callExpr.Args.Count()
            if (argc != 2) { return "" }
            let initStr = this.EmitExprStr(callExpr.Args.Get(0))
            let lamStr  = this.EmitClosureArg(callExpr.Args.Get(1))
            if (String_Length(lamStr) == 0) { return "" }
            return this.UnboxScalar("i64", "AmalgameList_reduce(" + listExpr + ", " + this.BoxAsVoid(initStr) + ", " + lamStr + ")")
        }
        if (mname == "Any") {
            let argc = callExpr.Args.Count()
            if (argc != 1) { return "" }
            let lamStr = this.EmitClosureArg(callExpr.Args.Get(0))
            if (String_Length(lamStr) == 0) { return "" }
            return "AmalgameList_any(" + listExpr + ", " + lamStr + ")"
        }
        if (mname == "All") {
            let argc = callExpr.Args.Count()
            if (argc != 1) { return "" }
            let lamStr = this.EmitClosureArg(callExpr.Args.Get(0))
            if (String_Length(lamStr) == 0) { return "" }
            return "AmalgameList_all(" + listExpr + ", " + lamStr + ")"
        }
        if (mname == "CountIf") {
            let argc = callExpr.Args.Count()
            if (argc != 1) { return "" }
            let lamStr = this.EmitClosureArg(callExpr.Args.Get(0))
            if (String_Length(lamStr) == 0) { return "" }
            return "AmalgameList_countIf(" + listExpr + ", " + lamStr + ")"
        }
        return ""
    }

    // ── Closure-argument emission (lambda v2.5) ──────
    // Higher-order calls accept either an inline lambda (METHOD_DECL
    // tagged "__lambda__"), already assigned an id by EmitLambdaForwards,
    // or a local variable already typed AmalgameClosure*. Returns "" when
    // we can't produce a closure (caller bails out and emits the call
    // through the regular path).
    private string EmitClosureArg(AstNode arg) {
        if (arg == null) { return "" }
        if (arg.Kind == NodeKind.METHOD_DECL && arg.Name == "__lambda__") {
            return this.EmitLambdaAsClosure(arg)
        }
        if (arg.Kind == NodeKind.IDENTIFIER) {
            let t = this.LocalTypeGet(arg.Name)
            if (t == "AmalgameClosure*") { return arg.Name }
        }
        return ""
    }

    // GCC compound statement expression: allocate the env, copy each
    // captured local in, then yield AmalgameClosure_new(...). Single-line
    // emission so the parent call site can drop it as one C expression.
    private string EmitLambdaAsClosure(AstNode lam) {
        let id      = lam.Str2
        let envName = "LamEnv_" + id
        let fnName  = "lam_" + id + "_fn"
        let envVar  = "__env_" + id
        let cn: int = lam.Args.Count()
        var s = "({ " + envName + "* " + envVar + " = (" + envName + "*)code_alloc(sizeof(" + envName + ")); "
        for i in 0..cn {
            s = s + this.EmitLambdaCaptureCopy(envVar, lam.Args.Get(i))
        }
        s = s + "AmalgameClosure_new((void*)" + fnName + ", " + envVar + "); })"
        return s
    }

    // Helper exists separately so `cap.Name` is read through a typed
    // parameter — chained `.Get(i).Name` erases to void* in the
    // emitted C and breaks the access otherwise.
    private string EmitLambdaCaptureCopy(string envVar, AstNode cap) {
        return envVar + "->_" + cap.Name + " = " + cap.Name + "; "
    }

    private string EmitCalleeStr(AstNode callee) {
        if (callee == null) { return "NULL" }
        let k = callee.Kind
        if (k == NodeKind.IDENTIFIER) { return callee.Name }
        if (k == NodeKind.MEMBER) {
            let mname = callee.Name
            if (callee.Left != null) {
                let lk = callee.Left.Kind
                if (lk == NodeKind.THIS_EXPR) {
                    // this.Method() → CurrentClass_Method (includes class name)
                    return this.CurrentClass + "_" + mname
                }
                // String literal receiver: `"foo".Trim()` → String_Trim("foo")
                if (lk == NodeKind.LITERAL_STRING) {
                    return "String_" + mname
                }
                if (lk == NodeKind.IDENTIFIER) {
                    let tname = callee.Left.Name
                    let firstChar = String_Substring(tname, 0, 1)
                    let isUpper = firstChar == String_ToUpper(firstChar)
                    if (isUpper) {
                        // Path.{Combine,Sep,IsAbsolute,Normalize} —
                        // their runtime symbols match the method
                        // name 1:1, so lower without requiring an
                        // `import Amalgame.Path`. The other four
                        // (Directory/Filename/Extension/Stem) wrap
                        // `Path_Get*` and must still go through the
                        // namespace dispatch below.
                        if (tname == "Path") {
                            if (mname == "Combine" || mname == "Sep" || mname == "IsAbsolute" || mname == "Normalize") {
                                return "Path_" + mname
                            }
                        }
                        // Project F (v0.7.5+): external classes registered via
                        // `--external <file.am>` route through the file's own
                        // namespace mangling (`Amalgame_Random_Random_*`),
                        // not the bundle's global NsPrefix. Checked before
                        // isCoreStdlib so the same names can coexist.
                        let externalMangled: string = this.ExternalClassMangled(tname)
                        if (String_Length(externalMangled) > 0) {
                            return externalMangled + "_" + mname
                        }
                        // Cross-package algebraic enum variant constructor:
                        // `Shape.Circle(5)` from a package whose enum was
                        // registered via --external. Same shape fix as the
                        // bare-enum-variant access in EmitExprStr.
                        let externalEnumMangled: string = this.ExternalEnumMangled(tname)
                        if (String_Length(externalEnumMangled) > 0) {
                            return externalEnumMangled + "_" + mname
                        }
                        // Core stdlib classes lower to the flat
                        // `ClassName_Method` symbol — they're
                        // single-author and have no collision risk.
                        // BuildInfo used to be in this list (its body was a
                        // runtime header). Since v0.7.4 it's an AM class
                        // (src/stdlib/amc_buildinfo.am) bundled under the
                        // Amalgame.Compiler namespace, so it now goes
                        // through the normal namespace-mangled dispatch.
                        // Log is the next migration (post-v0.7.5) — it
                        // lives in src/stdlib/logging.am with `@c { … }`
                        // bodies, same namespace-mangled dispatch.
                        let isCoreStdlib: bool = tname == "Console" || tname == "Mcu" || tname == "File" || tname == "String" || tname == "List" || tname == "Env" || tname == "Process" || tname == "Regex" || tname == "Compress" || tname == "WebSocket"
                        if (isCoreStdlib) {
                            return tname + "_" + mname
                        }
                        // Facade-package ABI fix: when the class is BOTH
                        // declared locally in this compilation unit AND
                        // registered as a PkgClass (the package's own
                        // facade.am compiled while the package is in the
                        // running amc's lockfile), prefer the local
                        // dispatch — the method body is emitted under
                        // SymName(tname)_mname, not under the PkgClass's
                        // header-export shape. Without this short-circuit,
                        // `MsgPack.DecodeOne(...)` inside MsgPack's own
                        // facade lowers to `Amalgame_Formats_MsgPack_DecodeOne`
                        // (header shape) while the body is
                        // `Amalgame_Formats_MsgPack_MsgPack_DecodeOne` (local
                        // shape) → implicit-int decl + segfault.
                        if (this.IsLocalClass(tname)) {
                            return this.SymName(tname) + "_" + mname
                        }
                        // v0.5 packages: namespace-mangled form so
                        // two packages that happen to expose the
                        // same short class name can't collide.
                        //   Redis.Open → Amalgame_Database_NoSQL_Redis_Open
                        let mangledPrefix: string = this.PkgClassMangledPrefix(tname)
                        if (String_Length(mangledPrefix) > 0) {
                            return mangledPrefix + "_" + mname
                        }
                        // Static call: ClassName.Method → Ns_ClassName_Method
                        return this.SymName(tname) + "_" + mname
                    }
                    // Instance call on known-type variable: look up field type of obj
                    let varType = this.LocalTypeGet(tname)
                    let bareType = String_Replace(varType, "*", "")
                    if (String_Length(bareType) > 0) {
                        // Opaque `void*` receiver — typically the result of a
                        // `<AmalgameList*>.Get(i)` where the inner cell type
                        // was erased because the surrounding `List<List<...>>`
                        // generic wasn't annotated. Dispatch through the
                        // collection runtime (AmalgameList_<method>) when the
                        // method is a known list verb, so chained
                        // `rows.Get(i).Get(j)` lowers cleanly without
                        // requiring `let row: List<X> = rows.Get(i)`
                        // annotations at every step. Same downcase trick
                        // as the chained-CALL branch below.
                        if (bareType == "void") {
                            let isListM: bool = mname == "Get" || mname == "Count" || mname == "Size" || mname == "Add" || mname == "Remove" || mname == "Clear" || mname == "IndexOf" || mname == "Contains"
                            if (isListM) {
                                let mfirst: string = String_Substring(mname, 0, 1)
                                let mrest:  string = String_Substring(mname, 1, String_Length(mname) - 1)
                                return "AmalgameList_" + String_ToLower(mfirst) + mrest
                            }
                        }
                        // WebSocket runtime helper — strip the
                        // "Amalgame" struct prefix so `ws.Send()`
                        // on a `WebSocket*` lowers to `WebSocket_Send`,
                        // matching the runtime header naming.
                        // Vec3/Vec4/Mat4 used to be in this list
                        // before their post-v0.7.5 AM migration.
                        if (bareType == "AmalgameWebSocket") {
                            return String_Replace(bareType, "Amalgame", "") + "_" + mname
                        }
                        // Regex.Match struct → `Match_<method>` runtime.
                        if (bareType == "AmalgameRegexMatch") {
                            return "Match_" + mname
                        }
                        // `s.Length()` on a string variable should call
                        // `String_Length(s)`, not `code_string_Length(s)`.
                        // `code_string` is the legacy C typedef (the
                        // language used to be called "code" before it was
                        // renamed Amalgame); the runtime helpers are under
                        // the `String_` prefix.
                        if (bareType == "code_string") {
                            return "String_" + mname
                        }
                        // Primitive `.ToString()` — the receiver is passed
                        // as the first arg (selfExpr), so returning the
                        // matching runtime converter lowers `n.ToString()`
                        // to `String_FromInt(n)` etc. Without this the
                        // fallback emits a non-existent `i64_ToString(n)`
                        // that only fails at link time (passes --check).
                        if (mname == "ToString") {
                            if (bareType == "i64")       { return "String_FromInt" }
                            if (bareType == "double")    { return "String_FromFloat" }
                            if (bareType == "code_bool") { return "String_FromBool" }
                        }
                        return bareType + "_" + mname
                    }
                    // Fallback: obj_Method (simplified)
                    return tname + "_" + mname
                }
                // Chained call: o.GetInner().Doubled(). The inner
                // CALL's return type is the receiver of the outer call;
                // emit `RetType_Method`. Without this the fallback
                // appends `_Method` to the call expression string,
                // producing e.g. `Outer_GetInner(o)_Doubled` (invalid).
                if (lk == NodeKind.CALL) {
                    let retT = this.InferTypeFromExpr(callee.Left)
                    let bareR = String_Replace(retT, "*", "")
                    if (String_Length(bareR) > 0) {
                        // AmalgameList / Map / Set runtime helpers use
                        // camelCase first-letter (Add → add, Count →
                        // count, etc.), unlike user classes which keep
                        // PascalCase. Downcase mname's first letter for
                        // chained calls landing on a collection.
                        if (bareR == "AmalgameList" || bareR == "AmalgameMap" || bareR == "AmalgameSet") {
                            let first: string = String_Substring(mname, 0, 1)
                            let rest:  string = String_Substring(mname, 1, String_Length(mname) - 1)
                            return bareR + "_" + String_ToLower(first) + rest
                        }
                        // Primitive `.ToString()` on a chained call result
                        // (`f(x).ToString()`) — same converter lowering as
                        // the identifier-receiver branch above.
                        if (mname == "ToString") {
                            if (bareR == "i64")       { return "String_FromInt" }
                            if (bareR == "double")    { return "String_FromFloat" }
                            if (bareR == "code_bool") { return "String_FromBool" }
                        }
                        return bareR + "_" + mname
                    }
                }
                // <call-chain>.Method(...) — receiver is a CALL whose
                // return type we can infer. Used by patterns like
                // `new X().M1().M2()` or `a.M1(x).M2(y)`. The
                // detection in the call-emission site already sets
                // isSelfCall + selfExpr; this branch resolves the
                // method symbol from the inferred receiver type.
                if (lk == NodeKind.CALL) {
                    let rt: string = this.InferTypeFromExpr(callee.Left)
                    let bare: string = String_Replace(rt, "*", "")
                    if (String_Length(bare) > 0) {
                        if (bare == "AmalgameList" || bare == "AmalgameMap" || bare == "AmalgameSet") {
                            let first: string = String_Substring(mname, 0, 1)
                            let rest:  string = String_Substring(mname, 1, String_Length(mname) - 1)
                            return bare + "_" + String_ToLower(first) + rest
                        }
                        return bare + "_" + mname
                    }
                }
                // new ClassName(...).Method(...) — receiver is a NEW_EXPR.
                // Resolve the method symbol from the class being
                // instantiated, same dispatch as a static call to
                // ClassName (external mangled / core stdlib / package
                // mangled / SymName fallback). Without this, the
                // fallback at the end of the function mashes the
                // method name into `new()`'s call string, producing
                // invalid C like `App_Widget_new("foo")_Class("bar")`.
                if (lk == NodeKind.NEW_EXPR) {
                    let tname: string = callee.Left.Name
                    let externalMangled: string = this.ExternalClassMangled(tname)
                    if (String_Length(externalMangled) > 0) {
                        return externalMangled + "_" + mname
                    }
                    let isCoreStdlib: bool = tname == "Console" || tname == "Mcu" || tname == "File" || tname == "String" || tname == "List" || tname == "Env" || tname == "Process" || tname == "Regex" || tname == "Compress" || tname == "WebSocket"
                    if (isCoreStdlib) {
                        return tname + "_" + mname
                    }
                    let mangledPrefix: string = this.PkgClassMangledPrefix(tname)
                    if (String_Length(mangledPrefix) > 0) {
                        return mangledPrefix + "_" + mname
                    }
                    return this.SymName(tname) + "_" + mname
                }
                // Chained-member call: this.Field.Method(),
                // varName.Field.Method(), or any deeper chain
                // (this.A.B.C.Method()). The two depth-2 branches are
                // kept as explicit fast paths; the ResolveReceiverClass
                // fallback below walks the receiver to its leaf class at
                // arbitrary depth and subsumes them.
                if (lk == NodeKind.MEMBER) {
                    if (callee.Left.Left != null) {
                        let llk = callee.Left.Left.Kind
                        if (llk == NodeKind.THIS_EXPR) {
                            let fname = callee.Left.Name
                            let ftype = this.FieldTypeGet(this.CurrentClass, fname)
                            let bare  = String_Replace(ftype, "*", "")
                            if (String_Length(bare) > 0) {
                                return bare + "_" + mname
                            }
                        }
                        if (llk == NodeKind.IDENTIFIER) {
                            // varName.Field.Method(): chain into the
                            // local's class to find Field's type, then
                            // emit `FieldType_Method`. Without this the
                            // fallback at the end of the function would
                            // mash the field name into the method name
                            // (`o->Field_Method` instead of
                            // `Inner_Method(o->Field)`), causing the
                            // chain-mash bug we're fixing.
                            let vname = callee.Left.Left.Name
                            let vtype = this.LocalTypeGet(vname)
                            let vbare = String_Replace(vtype, "*", "")
                            if (String_Length(vbare) > 0) {
                                let fname = callee.Left.Name
                                let ftype = this.FieldTypeGet(vbare, fname)
                                let fbare = String_Replace(ftype, "*", "")
                                if (String_Length(fbare) > 0) {
                                    return fbare + "_" + mname
                                }
                            }
                        }
                    }
                    // Deep chain (receiver is itself a member chain, e.g.
                    // `this.A.B.C.Method()` — llk above is MEMBER and the
                    // fast paths don't fire). Resolve the leaf class of
                    // the whole receiver expression. Without this such a
                    // call used to fall through to the EmitExprStr
                    // fallback and mash the last field into the method
                    // name (`Mid has no member named 'L_Hit'`).
                    let recvClass: string = this.ResolveReceiverClass(callee.Left)
                    if (String_Length(recvClass) > 0) {
                        if (recvClass == "AmalgameList" || recvClass == "AmalgameMap" || recvClass == "AmalgameSet") {
                            let cf: string = String_Substring(mname, 0, 1)
                            let cr: string = String_Substring(mname, 1, String_Length(mname) - 1)
                            return recvClass + "_" + String_ToLower(cf) + cr
                        }
                        return recvClass + "_" + mname
                    }
                }
            }
            let target = this.EmitExprStr(callee.Left)
            return target + "_" + mname
        }
        return this.EmitExprStr(callee)
    }

    // ── Type mapping ──────────────────────────────────

    private bool IsEnum(string t) {
        let n = this.EnumNames.Count()
        for i in 0..n {
            let e = this.EnumNames.Get(i)
            if (e == t) { return true }
        }
        return false
    }

    // True for C types passed as a pointer at the ABI level: anything
    // ending in `*` plus `code_string` (typedef'd to `char*`). Used by
    // EmitOneLambda to decide whether to unbox a void* arg via a
    // direct cast or via intptr_t.
    private bool IsCPointerType(string ct) {
        if (ct == "code_string") { return true }
        if (String_EndsWith(ct, "*")) { return true }
        return false
    }

    // ── Box / unbox helpers ──────────────────────────
    //
    // The closure ABI passes everything as `void*` (see
    // runtime/_runtime.h). Box scalar expressions through
    // `intptr_t` to silence -Wint-to-pointer-cast on platforms where
    // sizeof(int) < sizeof(void*); unbox the same way coming back.
    // Pointer-typed values cast through `intptr_t` is wasteful but
    // valid in 64-bit (we don't currently 32-bit), so the same helper
    // covers both ABI shapes.
    //
    // These were duplicated across ~17 sites in CGen before being
    // extracted; the refactor aimed at readability, not behavior.

    // Box any expression to `void*` for the closure / collection ABI.
    private string BoxAsVoid(string expr) {
        return "(void*)(intptr_t)(" + expr + ")"
    }

    // Unbox a `void*` back to a scalar C type. Pointer types
    // (anything for which IsCPointerType is true) should use a direct
    // cast instead — the dedicated EmitOneLambdaBody path already
    // does so via that predicate.
    private string UnboxScalar(string ctype, string expr) {
        return "(" + ctype + ")(intptr_t)" + expr
    }

    private string TypeToC(string t) {
        if (t == "int")    { return "i64" }
        if (t == "float")  { return "double" }
        if (t == "bool")   { return "code_bool" }
        if (t == "string") { return "code_string" }
        if (t == "void")   { return "void" }
        if (t == "")       { return "void" }
        // First-class closure values. AM source spells the type as
        // `Closure`; it lowers to `AmalgameClosure*` (the runtime
        // type used everywhere else for lambdas — see _runtime.h).
        // Lets facade.am declare `(name: string, handler: Closure)`
        // without needing a per-package typedef shim.
        if (t == "Closure") { return "AmalgameClosure*" }
        // Typed closure: `Closure<A, R>` / `Closure<A1, A2, R>` / etc.
        // Still lowers to the same runtime type — the args/return
        // annotations only inform the cgen at call sites + lambda
        // bodies, not the field/local/ctor-param C layout.
        if (String_StartsWith(t, "Closure<")) { return "AmalgameClosure*" }
        // Array types: string[] → code_string*, int[] → i64*, etc.
        if (String_EndsWith(t, "[]")) {
            let inner = String_Substring(t, 0, String_Length(t) - 2)
            return this.TypeToC(inner) + "*"
        }
        if (String_EndsWith(t, "?")) {
            // The `?` is purely a typechecker concern (the pointer can be
            // NULL). All non-primitive Amalgame types lower to a C pointer
            // already, so `Box?` stays `Box*` rather than becoming `Box**`.
            // Primitives lose their nullability at the C level — accepted
            // limitation, matches the pre-`?`-token behaviour.
            let inner = String_Substring(t, 0, String_Length(t) - 1)
            return this.TypeToC(inner)
        }
        if (String_StartsWith(t, "List<")) {
            return "AmalgameList*"
        }
        if (String_StartsWith(t, "Map<")) {
            return "AmalgameMap*"
        }
        if (String_StartsWith(t, "Set<")) {
            return "AmalgameSet*"
        }
        if (t == "List") { return "AmalgameList*" }
        if (t == "Map")  { return "AmalgameMap*" }
        if (t == "Set")  { return "AmalgameSet*" }
        // Vec3 / Vec4 / Mat4 migrated to AM (post-v0.7.5); fall
        // through to the regular namespace-mangled lowering below.
        // FileWatcher migrated to AM (post-v0.7.5); same path.
        if (t == "Match") { return "AmalgameRegexMatch*" }
        if (t == "WebSocket") { return "AmalgameWebSocket*" }
        if (this.IsEnum(t)) {
            return this.SymName(t)
        }
        // Interface types lower to the 2-word value typedef (no `*`):
        // they're passed by value (itab+data), like Go interfaces. Use
        // the registered mangled name (package ns for external ones).
        let ifaceM: string = this.IfaceMangledFor(t)
        if (String_Length(ifaceM) > 0) {
            return ifaceM
        }
        // Project F: external classes use their own ns-mangled name
        // so `let r: Random = …` lowers to `Amalgame_Random_Random* r`,
        // matching the typedef emitted by RegisterExternalProg + the
        // symbol exported by libamalgame.a.
        let externalMangled: string = this.ExternalClassMangled(t)
        if (String_Length(externalMangled) > 0) {
            return externalMangled + "*"
        }
        // Bug 9 (v0.8.27): external enums are value types — return the
        // mangled name without the `*` suffix. Reaches here for fields
        // like `JsonValue.Kind: JsonKind` when emitting JsonValue's
        // struct body from an external file's --external import.
        let externalEnumMangled: string = this.ExternalEnumMangled(t)
        if (String_Length(externalEnumMangled) > 0) {
            return externalEnumMangled
        }
        // v0.8.37: opaque C types declared as PkgFunc return types
        // (e.g. `AmalgameRedis` from Redis.Open → AmalgameRedis*).
        // Lower them straight to `<name>*` so the consumer's struct
        // body emits the right C type for fields like
        // `public Handle: AmalgameRedis`. Without this, SymName
        // would prefix the consumer's namespace and gcc would fail
        // (`unknown type 'Amalgame_Web_AmalgameRedis'`).
        let opaqueCount: int = this.PkgOpaqueTypes.Count()
        for oi in 0..opaqueCount {
            if (this.PkgOpaqueTypes.Get(oi) == t) {
                return t + "*"
            }
        }
        // v0.8.38: AM-side classes declared in a loaded package's
        // manifest [stdlib].classes. Catches e.g. Cookie, HttpRequest,
        // HttpResponse from amalgame-net-http when the consumer only
        // --externals facade.am (which doesn't define them — they live
        // in cookie.am / http_request.am / etc. since the v0.4.6 split).
        // Without this lookup, the type lowers via SymName to the
        // consumer's namespace and gcc fails with "unknown type
        // Amalgame_Web_Cookie".
        let pkgMangled: string = this.PkgClassMangledPrefix(t)
        if (String_Length(pkgMangled) > 0 && !this.IsLocalClass(t)) {
            return pkgMangled + "*"
        }
        let sym = this.SymName(t)
        // Single uppercase letter = generic type parameter → use void*
        if (String_Length(t) == 1) {
            let fc = String_Substring(t, 0, 1)
            let isUp = fc == String_ToUpper(fc)
            if (isUp) { return "void*" }
        }
        if (this.IsEnum(sym)) {
            return sym
        }
        // Check if algebraic enum (tagged union) — value type, no pointer
        let algKey = "__alg__" + sym
        let en2 = this.EnumNames.Count()
        for ei2 in 0..en2 {
            if (this.EnumNames.Get(ei2) == algKey) { return sym }
        }
        return sym + "*"
    }
}
