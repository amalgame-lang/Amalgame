    // Record that the C function `cname` (already mangled,
    // e.g. "App_Program_logAll") takes a trailing variadic param,
    // preceded by `fixedArity` ordinary params.
    private void MethodVariadicSet(string cname, int fixedArity) {
        this.MethodVariadicNames.Add(cname)
        this.MethodVariadicArity.Add(fixedArity)
    }

    // Fixed-param count for a variadic C function, or -1 if `cname`
    // is not a known variadic method. The call-site collector uses
    // this to decide how many leading args bind positionally before
    // the rest are gathered into one `AmalgameList*`.
    private int MethodVariadicGet(string cname) {
        let n = this.MethodVariadicNames.Count()
        var result = 0 - 1
        for i in 0..n {
            if (this.MethodVariadicNames.Get(i) == cname) {
                result = this.MethodVariadicArity.Get(i)
            }
        }
        return result
    }

    // ── Infer C type from RHS expression ─────────────
    // Memoized entry point. Look up the node by its C pointer
    // identity; on a miss, dispatch to InferTypeFromExprUncached
    // and cache the result. Critical for long fluent-chain expressions
    // (e.g. v0.0.5 ui-web builders with 20+ AddChild) — without the
    // cache the recursion re-inferred every prefix at every step.
    private string InferTypeFromExpr(AstNode expr) {
        if (expr == null) { return "" }
        var key: int = 0
        @c {
            key = (i64)expr;
        }
        let n: int = this.InferCacheKeys.Count()
        for i in 0..n {
            if (this.InferCacheKeys.Get(i) == key) {
                return this.InferCacheVals.Get(i)
            }
        }
        let result: string = this.InferTypeFromExprUncached(expr)
        this.InferCacheKeys.Add(key)
        this.InferCacheVals.Add(result)
        return result
    }

    private string InferTypeFromExprUncached(AstNode expr) {
        if (expr == null) { return "" }
        let k = expr.Kind
        match k {
        // v0.8.39 — `let app = this` picks up the enclosing class's
        // C type so the local is declared as `<Class>* app = self;`
        // instead of `void* app = self;`.  Closures capturing `app`
        // then box it as a class pointer, and `app.Field` lowers
        // cleanly without a void-pointer member access error.
        // CurrentClass is the already-mangled symbol (e.g. Demo_Counter),
        // so we tack on `*` directly — running it through TypeToC would
        // double-prefix via SymName.
        NodeKind.THIS_EXPR => {
            if (String_Length(this.CurrentClass) > 0) {
                return this.CurrentClass + "*"
            }
        }
        NodeKind.LIST_COMP => { return "AmalgameList*" }
        NodeKind.LIST_LITERAL => { return "AmalgameList*" }
        // match-as-expression: type is the type of the first arm body.
        // (All arms must agree at runtime; we trust the first as a hint.)
        NodeKind.IF_STMT if expr.Name == "__match__" => {
            if (expr.Children.Count() > 0) {
                let firstArm: AstNode = expr.Children.Get(0)
                if (firstArm.Right != null) {
                    return this.InferTypeFromExpr(firstArm.Right)
                }
            }
            return ""
        }
        // if-as-expression: the type is the type of the then-branch.
        // The body is a BLOCK whose last child is the result expression.
        NodeKind.IF_STMT => {
            if (expr.Body != null) {
                let body: AstNode = expr.Body
                if (body.Kind == NodeKind.BLOCK && body.Children.Count() > 0) {
                    let last: AstNode = body.Children.Get(body.Children.Count() - 1)
                    return this.InferTypeFromExpr(last)
                }
                return this.InferTypeFromExpr(body)
            }
            return ""
        }
        NodeKind.LITERAL_INT => { return "i64" }
        NodeKind.LITERAL_FLOAT => { return "double" }
        NodeKind.LITERAL_STRING => { return "code_string" }
        NodeKind.LITERAL_BOOL => { return "code_bool" }
        NodeKind.BINARY => {
            let bop = expr.Str
            let isCmpOp = (bop == "&&" || bop == "||" || bop == "==" || bop == "!=")
            let isRelOp = (bop == "<" || bop == ">" || bop == "<=" || bop == ">=")
            if (isCmpOp || isRelOp) {
                return "code_bool"
            }
            // Arithmetic: propagate numeric/string types
            if (bop == "+" || bop == "-" || bop == "*" || bop == "/" || bop == "%") {
                let lt = this.InferTypeFromExpr(expr.Left)
                let rt = this.InferTypeFromExpr(expr.Right)
                if (lt == "code_string" || rt == "code_string") { return "code_string" }
                if (expr.Left != null) {
                    if (expr.Left.Kind == NodeKind.LITERAL_STRING) { return "code_string" }
                    if (expr.Left.Kind == NodeKind.LITERAL_INT)    { return "i64" }
                }
                if (expr.Right != null) {
                    if (expr.Right.Kind == NodeKind.LITERAL_STRING) { return "code_string" }
                    if (expr.Right.Kind == NodeKind.LITERAL_INT)    { return "i64" }
                }
                if (lt == "i64" || rt == "i64") { return "i64" }
                if (lt == "double" || rt == "double") { return "double" }
            }
        }
        NodeKind.UNARY => {
            if (expr.Str == "!") { return "code_bool" }
            // `await <future>` yields R, the async fn's declared return
            // type (recovered from the __async_ret__/__async_future__
            // tables). Lets `let a = await f` type `a` as R, not void*.
            if (expr.Str == "await") {
                let ar = this.ResolveAwaitRetC(expr.Left)
                if (String_Length(ar) > 0) { return ar }
            }
        }
        NodeKind.IDENTIFIER => {
            // Could be a local var — look it up
            return this.LocalTypeGet(expr.Name)
        }
        NodeKind.MEMBER => {
            // this.Field → look up field type
            if (expr.Left != null) {
                let lk = expr.Left.Kind
                if (lk == NodeKind.THIS_EXPR) {
                    return this.FieldTypeGet(this.CurrentClass, expr.Name)
                }
                if (lk == NodeKind.IDENTIFIER) {
                    let lname = expr.Left.Name
                    let varCType = this.LocalTypeGet(lname)
                    let bare = String_Replace(varCType, "*", "")
                    if (String_Length(bare) > 0) {
                        return this.FieldTypeGet(bare, expr.Name)
                    }
                    // Not a local var — check if it's an enum type (Direction.North → Tests_Direction)
                    let symT = this.SymName(lname)
                    if (this.IsEnum(symT)) { return symT }
                    if (this.IsEnum(lname)) { return this.SymName(lname) }
                }
                // CALL.Field — e.g. this.Current().Value → infer type from call return
                if (lk == NodeKind.CALL) {
                    let callRetT = this.InferTypeFromExpr(expr.Left)
                    let bareCall = String_Replace(callRetT, "*", "")
