namespace Amalgame.Compiler

import Amalgame.Collections
import Amalgame.String

// ── C Code Emitter ────────────────────────────────────
public class Emitter {
    private Lines:    List<string>
    private Indent:   int
    private Streaming: bool   // write directly to file via File_StreamLine

    public Emitter() {
        this.Lines     = new List<string>()
        this.Indent    = 0
        this.Streaming = false
    }

    public void SetStreaming(bool v) { this.Streaming = v }

    public void Emit(string text) {
        if (this.Streaming) {
            File.StreamLine(text)
        } else {
            this.Lines.Add(text)
        }
    }

    public void EmitLine(string text) {
        var line = ""
        let i = this.Indent
        for k in 0..i {
            line = line + "    "
        }
        line = line + text
        if (this.Streaming) {
            File.StreamLine(line)
        } else {
            this.Lines.Add(line)
        }
    }

    public void EmitBlank() {
        if (this.Streaming) {
            File.StreamLine("")
        } else {
            this.Lines.Add("")
        }
    }

    public void Indent_() {
        this.Indent = this.Indent + 1
    }

    public void Dedent() {
        this.Indent = this.Indent - 1
    }

    public string GetOutput() {
        var result = ""
        let count = this.Lines.Count()
        for i in 0..count {
            let line = this.Lines.Get(i)
            result = result + line + "\n"
        }
        return result
    }
}

// ── C Generator ───────────────────────────────────────
public class CGen {
    public  Out:            Emitter
    private NsPrefix:       string
    // Type inference: two parallel lists — var name → C type
    private LocalTypeNames: List<string>
    private LocalTypeCType: List<string>
    // Current class being emitted (for this.Field list element type lookup)
    private CurrentClass:   string
    private CurrentRetType: string
    // Field types: two parallel lists — "ClassName.FieldName" → C type
    private FieldNames:     List<string>
    private FieldCTypes:    List<string>
    // List element types: "ClassName.FieldName" → element C type (for List<T> fields)
    private ListElemNames:  List<string>
    private ListElemCTypes: List<string>
    // Enum names registered at forward-decl time (to avoid TypeToC adding *)
    private EnumNames:      List<string>
    // Method return types: "ClassName_MethodName" → C return type
    private MethodRetNames: List<string>
    private MethodRetTypes: List<string>
    // Same key, but storing the *raw* Amalgame return type ("List<int>",
    // "Map<string,int>", …) so VAR_DECL can recover the generic type
    // arguments and propagate them to local elem-type tracking.
    private MethodRetRawNames: List<string>
    private MethodRetRawTypes: List<string>
    // Variadic methods: mangled C callee name ("ClassName_MethodName")
    // → number of FIXED params preceding the trailing variadic one.
    // Absence from this table means "not variadic". Populated in the
    // forward-decl pass (EmitClass), consulted at every CALL site so
    // trailing args get collected into a single `AmalgameList*`.
    private MethodVariadicNames: List<string>
    private MethodVariadicArity: List<int>
    // Lambda numbering — each lambda gets a unique id used to name the
    // generated env struct (LamEnv_N) and top-level function (lam_N_fn).
    // Phase A of pass 2 walks the AST, assigns ids, and emits the
    // top-level definitions before the regular decl loop.
    private LambdaCounter: int
    // True while emitting statements inside a lambda body block.
    // Causes RETURN_STMT emission to box the expression as void* so
    // the generated `void* lam_N_fn(...)` returns the right type.
    // Saved/restored around each lambda emit so nested lambdas (or
    // a lambda inside a regular method, etc.) don't pollute each
    // other's emit context.
    private InLambdaBody: bool

    // v0.8.0+: per-statement `#line N "foo.am"` directives so gcc/clang
    // record .am line numbers in DWARF (via DW_AT_decl_file +
    // DW_AT_decl_line on each insn). `amc dap` then forwards plain
    // DAP messages to gdb/lldb-dap and breakpoints on .am sources
    // resolve natively — no path rewriting on the wire. Each
    // AddFilePass2 caller sets CurrentSource to the file's path;
    // EmitStmt emits the directive when the source line changes
    // (avoids spamming consecutive identical directives).
    private CurrentSource:   string
    private LastLineEmitted: int

    // InferTypeFromExpr memoization (v0.8.15).
    // Without this cache, a chain like `a.AddChild(x).AddChild(y).AddChild(z)...`
    // recurses on the receiver of each call, re-inferring the whole
    // chain up to the leftmost expression every step — quadratic
    // visits, and beyond ~24 links amc effectively hangs because each
    // visit itself does string concat / list walks.
    //
    // The cache keys nodes by their C pointer cast to i64 — AstNode
    // identity is stable within a single compilation. Parallel
    // List<i64>/List<string> rather than AmalgameMap so we don't have
    // to introduce a new generic-key map shape just for this.
    private InferCacheKeys: List<int>
    private InferCacheVals: List<string>

    // v0.5 package-manager: each external package's class +
    // functions feed the isStdlib check (ClassName), return-type
    // table (Func → CRetType), and prelude #include emission
    // (Header). Parallel lists, same pattern as the resolver
    // (PR 3c). Empty lists = no installed packages = no-op.
    public PkgClasses:    List<string>
    public PkgFuncs:      List<string>
    public PkgFuncCTypes: List<string>
    public PkgHeaders:    List<string>
    // Parallel to PkgHeaders: namespace of the package contributing
    // each header (e.g. "Amalgame.Database.NoSQL.Redis"). Used by
    // EmitHeader to filter `#include` emission to only the packages
    // the source actually imports (post-v0.8.50 refactor — avoids
    // dragging duckdb / mongodb / postgresql preprocessing into every
    // .c when those are in the cache but not imported).
    public PkgHeaderNs:   List<string>
    // Parallel to PkgClasses: stores the namespace each registered
    // class came from (e.g. "Amalgame.Database.NoSQL.Redis"), so
    // the isStdlib short-circuit can mangle calls correctly.
    public PkgClassNs:    List<string>

    // v0.8.51: namespaces imported by the source under compilation.
    // Populated by SetImportedNamespaces() (called from main.am after
    // parse pass). When non-empty AND ImportsFiltered is true, the
    // pkg-header / pkg-class-typedef emission filters out packages
    // whose namespace does NOT match any import. When false (default),
    // every registered package's header is emitted (back-compat path
    // for callers that haven't been updated to feed imports).
    public ImportedNs:       List<string>
    public ImportsFiltered:  bool

    // MCU (docs/proposals/amc-embedded.md §4). When true, EmitHeader emits
    // the freestanding prelude (embedded _runtime.h only) instead of the
    // hosted includes. Default false → hosted output byte-identical
    // (guarded by tools/golden-c). Set by the driver from --target.
    public Embedded:         bool

    // Project F (v0.7.5+): external files registered via --external.
    // Short class names + their own mangled-ns prefix. Call sites
    // route through ExternalClassMangled() before the regular
    // SymName / isCoreStdlib / PkgClassMangledPrefix paths. Class
    // definitions (struct body + methods) are NOT emitted for these
    // — they land at link time from libamalgame.a.
    public ExternalClasses:    List<string>
    public ExternalClassNsArr: List<string>

    // Bug 9 (v0.8.27): external enum registry — parallel to
    // ExternalClasses, but for ENUM_DECL nodes. Needed once the
    // struct-body emission for external classes started exposing
    // private fields whose type is a sibling enum (e.g.
    // `JsonValue.Kind: JsonKind`). TypeToC checks this before its
    // SymName fallback so the type lowers to the bundled namespace
    // (`Amalgame_Formats_Json_JsonKind`, value not pointer) instead
    // of the consumer's NsPrefix.
    public ExternalEnums:      List<string>
    public ExternalEnumNsArr:  List<string>

    // v0.8.37: opaque C types declared as return types in a
    // package's [stdlib.functions] table (e.g. `Redis.Open →
    // AmalgameRedis*`). PackageRegistry.AmalgameTypeFromC strips
    // the `*` to give the AM-side name; the consumer can now use
    // that name as a class field type (`public Handle: AmalgameRedis`)
    // and TypeToC lowers it to the raw C name (`AmalgameRedis*`)
    // instead of mangling it into the consumer's namespace. Lifts
    // the "AM can't store an opaque C handle in a class field"
    // limitation that blocked Redis-connection pooling and
    // per-instance pthread mutexes.
    public PkgOpaqueTypes: List<string>

    // Classes declared in the current compilation unit, accumulated by
    // EmitForwardDecl during AddFilePass1. Lets EmitCalleeStr / TypeToC
    // give Local precedence over PkgClasses when both register the same
    // short name — the facade-ABI conflict that surfaced during the
    // msgpack extraction (`MsgPack.DecodeOne(...)` inside the facade
    // itself, while the running amc has the same MsgPack registered as
    // a package). Without this, the call mangles to the package's
    // header-export shape (`Amalgame_Formats_MsgPack_DecodeOne`) while
    // the body is defined under the Local shape
    // (`Amalgame_Formats_MsgPack_MsgPack_DecodeOne`), producing an
    // implicit-int decl + segfault on first dereference.
    public LocalClasses: List<string>
    // Interface dispatch (Go-style itab+data, v0.8.72). Mangled names of
    // every interface (local + external) so TypeToC / call sites know a
    // type is an interface (a 2-word {itab,data} value, not a pointer).
    // IfaceNodes holds the decl nodes so we can recover each interface's
    // ordered method set (for the itab struct + per-implementor itabs).
    // Parallel registries (same index): an interface's short name, its
    // C-mangled name (consumer ns for local, package ns for external),
    // and its decl node (for the ordered method set).
    public IfaceShortNames:   List<string>
    public IfaceMangledNames: List<string>
    public IfaceNodes:        List<AstNode>
    // Which callee params are interface-typed: key "calleeMangled#idx"
    // → interface mangled name. Lets a call site pack a concrete arg
    // into a {itab,data} value only where the param actually is an
    // interface (non-interface calls are untouched → no overhead).
    public ParamIfaceKeys: List<string>
    public ParamIfaceVals: List<string>

    public CGen() {
        this.Out            = new Emitter()
        this.NsPrefix       = ""
        this.LocalTypeNames = new List<string>()
        this.LocalTypeCType = new List<string>()
        this.CurrentClass   = ""
        this.CurrentRetType = ""
        this.FieldNames     = new List<string>()
        this.FieldCTypes    = new List<string>()
        this.ListElemNames  = new List<string>()
        this.ListElemCTypes = new List<string>()
        this.EnumNames      = new List<string>()
        this.MethodRetNames = new List<string>()
        this.MethodRetTypes = new List<string>()
        this.MethodRetRawNames = new List<string>()
        this.MethodRetRawTypes = new List<string>()
        this.MethodVariadicNames = new List<string>()
        this.MethodVariadicArity = new List<int>()
        this.LambdaCounter     = 0
        this.InLambdaBody      = false
        this.PkgClasses        = new List<string>()
        this.PkgFuncs          = new List<string>()
        this.PkgFuncCTypes     = new List<string>()
        this.PkgHeaders        = new List<string>()
        this.PkgHeaderNs       = new List<string>()
        this.PkgClassNs        = new List<string>()
        this.ImportedNs        = new List<string>()
        this.ImportsFiltered   = false
        this.Embedded          = false
        this.ExternalClasses   = new List<string>()
        this.ExternalClassNsArr = new List<string>()
        this.ExternalEnums     = new List<string>()
        this.ExternalEnumNsArr = new List<string>()
        this.PkgOpaqueTypes    = new List<string>()
        this.LocalClasses      = new List<string>()
        this.IfaceShortNames   = new List<string>()
        this.IfaceMangledNames = new List<string>()
        this.IfaceNodes        = new List<AstNode>()
        this.ParamIfaceKeys    = new List<string>()
        this.ParamIfaceVals    = new List<string>()
        this.CurrentSource     = ""
        this.LastLineEmitted   = -1
        this.InferCacheKeys    = new List<int>()
        this.InferCacheVals    = new List<string>()
        // Pre-register stdlib struct fields (libcurl-backed
        // AmalgameHttpResponse dropped in v0.8.31 — see resolver.am).
        this.FieldTypeSet("AmalgameTcpConn",      "RemoteIp",   "code_string")
        this.FieldTypeSet("AmalgameTcpConn",      "RemotePort", "i64")
        this.FieldTypeSet("AmalgameTcpConn",      "Connected",  "code_bool")
        this.FieldTypeSet("AmalgameTcpConn",      "Fd",         "i64")
        this.FieldTypeSet("AmalgameTcpServer",    "Fd",         "i64")
        this.FieldTypeSet("AmalgameTcpServer",    "Port",       "i64")
        this.FieldTypeSet("AmalgameTcpServer",    "Listening",  "code_bool")
        this.FieldTypeSet("AmalgameTcpClient",    "Connected",  "code_bool")
        this.FieldTypeSet("AmalgameTcpClient",    "RemoteHost", "code_string")
        this.FieldTypeSet("AmalgameTcpClient",    "RemotePort", "i64")
        // v0.8.52: UDP socket fields + UdpDatagram for ReceiveFrom.
        this.FieldTypeSet("AmalgameUdpSocket",    "BoundPort", "i64")
        this.FieldTypeSet("AmalgameUdpSocket",    "Bound",    "code_bool")
        this.FieldTypeSet("AmalgameUdpDatagram",  "Data",     "code_string")
        this.FieldTypeSet("AmalgameUdpDatagram",  "DataLen",  "i64")
        this.FieldTypeSet("AmalgameUdpDatagram",  "FromIp",   "code_string")
        this.FieldTypeSet("AmalgameUdpDatagram",  "FromPort", "i64")
        this.FieldTypeSet("AmalgameProcessResult", "Exit",   "i64")
        this.FieldTypeSet("AmalgameProcessResult", "Stdout", "code_string")
        this.FieldTypeSet("AmalgameProcessResult", "Stderr", "code_string")
    }

    public string Generate(AstNode prog) {
        let ns = prog.Str
        if (String_Length(ns) > 0) {
            this.NsPrefix = String_Replace(ns, ".", "_")
        }
        // v0.8.51: single-file callers (LSP, gen_test) auto-extract
        // imports from prog.Args (parser stores them there as Ident
        // qnames). Skip if SetImportedNamespaces has already been
        // called explicitly — that caller knows what it wants.
        if (!this.ImportsFiltered) {
            let autoImports = new List<string>()
            let ai: int = prog.Args.Count()
            for ii in 0..ai {
                let impNode: AstNode = prog.Args.Get(ii)
                autoImports.Add(impNode.Str)
            }
            this.SetImportedNamespaces(autoImports)
        }
        // v0.8.59: always treat the source's OWN namespace as
        // implicitly imported. Without this, compiling a package
        // source file (e.g. amalgame-tls/acme.am, namespace
        // `Amalgame.Tls`) drops its OWN runtime header `#include`
        // AND every typedef forward-decl for sibling pkg-classes
        // declared via manifest `classes = [...]` but without an
        // AM `class` decl (e.g. AmalgameTlsAcmeHttpResponse, a
        // pure C struct in the runtime header). You can't `import`
        // yourself, so the import-extraction loop above misses it;
        // we patch it up here once NsPrefix is known.
        if (String_Length(ns) > 0) {
            var alreadyPresent: bool = false
            let existing: int = this.ImportedNs.Count()
            for ei in 0..existing {
                if (this.ImportedNs.Get(ei) == ns) {
                    alreadyPresent = true
                }
            }
            if (!alreadyPresent) {
                this.ImportedNs.Add(ns)
            }
        }
        this.EmitHeader()
        let decls = prog.Children.Count()
        for i in 0..decls {
            let decl = prog.Children.Get(i)
            this.EmitForwardDecl(decl)
        }
        this.Out.EmitBlank()
        // Forward-declare every constructor before any class body —
        // see AddFilePass2 for the rationale.
        this.EmitConstructorForwards(prog)
        this.Out.EmitBlank()
        for j in 0..decls {
            let decl = prog.Children.Get(j)
            this.EmitDecl(decl)
        }
        return this.Out.GetOutput()
    }

    // Multi-file support: call BeginMulti() once, then AddFile() per file, then FinishMulti()
    public void SetStreaming(bool v) {
        this.Out.SetStreaming(v)
    }

    public void BeginMulti(string ns) {
        if (String_Length(ns) > 0) {
            this.NsPrefix = String_Replace(ns, ".", "_")
        }
        // v0.8.59: always treat the compilation unit's own namespace
        // as implicitly imported — same rationale as Generate(). A
        // package compiling its own facade via `amc --lib` (e.g. the
        // amc package-add precompile path) needs its OWN runtime
        // header to be #included so manifest-declared pkg-classes
        // (no AM source, just a C typedef in the header) reach gcc.
        // ImportedNs stores DOTTED-form namespaces (matching what
        // NamespaceImported compares against). main.am passes
        // BeginMulti an underscored `nsPrefix`, so convert back.
        if (String_Length(ns) > 0) {
            let nsDot: string = String_Replace(ns, "_", ".")
            var alreadyPresent: bool = false
            let existing: int = this.ImportedNs.Count()
            for ei in 0..existing {
                if (this.ImportedNs.Get(ei) == nsDot) {
                    alreadyPresent = true
                }
            }
            if (!alreadyPresent) {
                this.ImportedNs.Add(nsDot)
            }
        }
        this.EmitHeader()
        // v0.8.38: emit forward-decl typedefs for every class
        // declared in a loaded package's [stdlib].classes. Without
        // this, a consumer-side method signature that returns
        // `Amalgame_Net_Http_Cookie*` (correctly mangled by the
        // v0.8.38 TypeToC fix) would still fail at gcc with
        // "unknown type name" because no `typedef struct _<mangled>
        // <mangled>;` was emitted. Skip if the PkgClass's namespace
        // is the SAME as the consumer's NsPrefix — that's the
        // self-package compile case (the package's facade.am being
        // built while it's also listed in its own lock); the local
        // EmitForwardDecl will produce the same typedef under the
        // SymName shape and a duplicate here would gcc-error.
        let pc: int = this.PkgClasses.Count()
        for pi in 0..pc {
            let cname: string = this.PkgClasses.Get(pi)
            let cns: string = this.PkgClassNs.Get(pi)
            let cnsPrefix: string = String_Replace(cns, ".", "_")
            if (cnsPrefix == this.NsPrefix) { continue }
            // v0.8.51: same filter as EmitHeader — only forward-declare
            // pkg-class structs for packages the source imports. The
            // matching typedef would otherwise reference an `#include`
            // we just skipped, leaving gcc with an unused incomplete
            // type at best, or a `unknown type name` at worst when a
            // sibling package's header transitively expected it.
            if (this.ImportsFiltered) {
                if (!this.NamespaceImported(cns)) { continue }
            }
            // Interfaces lower to a fat-value typedef emitted by
            // RegisterExternalProgPass1 — skip the opaque pkg-class
            // typedef here (it would clash). Requires the external
            // pre-scan (PreNoteInterfaces) to have run before BeginMulti.
            if (this.IsInterface(cname)) { continue }
            let mangled: string = this.PkgClassMangledPrefix(cname)
            if (String_Length(mangled) > 0) {
                this.Out.EmitLine("typedef struct _" + mangled + " " + mangled + "; /* pkg-class */")
            }
        }
    }

    public void AddFilePass1(AstNode prog) {
        let decls = prog.Children.Count()
        for i in 0..decls {
            let decl = prog.Children.Get(i)
            this.EmitForwardDecl(decl)
        }
    }

    public void EmitSeparator() {
        this.Out.EmitBlank()
    }

    public void AddFilePass2(AstNode prog, string sourcePath) {
        // Backward-compatible single-call entry: emits forwards + bodies
        // for ONE file. Cross-file callers (main.am, gen_test.am)
        // should invoke AddFilePass2Forwards on every file first, then
        // AddFilePass2Bodies — see Bug 1 fix (v0.8.23) for the
        // rationale.
        this.AddFilePass2Forwards(prog)
        this.AddFilePass2Bodies(prog, sourcePath)
    }

    // Pass 2a — forwards only. Constructor signatures, non-constructor
    // method signatures, lambda env structs and fn forward decls.
    // Bug 1 (v0.8.23): when the driver compiles N files, calling this
    // for every file BEFORE emitting any body lets a call site in
    // file A reach a method defined in file B without gcc tripping
    // an implicit-declaration warning + conflicting-types error.
    public void AddFilePass2Forwards(AstNode prog) {
        this.EmitConstructorForwards(prog)
        this.EmitMethodForwards(prog)
        // Phase A — assign ids and emit env struct + forward decl for
        // every lambda in this file. The fn bodies themselves land in
        // AddFilePass2Bodies so they can dereference fields on class
        // structs (like u->Name) whose bodies emit there.
        this.EmitLambdaForwards(prog)
    }

    // Pass 2b — bodies only. Class struct + method bodies, lambda fn
    // bodies. Must be called AFTER every file's forwards (Pass 2a)
    // have been emitted.
    public void AddFilePass2Bodies(AstNode prog, string sourcePath) {
        // v0.8.0+: track the current source path so EmitStmt can prefix
        // each lowered statement with `#line N "<path>"`. Reset the
        // last-line cache per file so the first statement always
        // emits a directive.
        this.CurrentSource   = sourcePath
        this.LastLineEmitted = -1
        // Phase B — regular decl emission (class struct bodies + method bodies).
        let decls = prog.Children.Count()
        for j in 0..decls {
            let decl = prog.Children.Get(j)
            this.EmitDecl(decl)
        }
        // Phase C — emit each lambda fn body. Class struct bodies are
        // now visible, so typed param unboxing (e.g. `Probe_User* u =
        // (Probe_User*)__arg0;` followed by `u->Name`) lowers cleanly.
        this.EmitLambdaBodies(prog)
    }

    // Emit forward decls for every non-constructor method in the prog.
    // Constructors are handled by EmitConstructorForwards; this fills
    // the gap so a method in file A can call one in file B that hasn't
    // been emitted yet.
    private void EmitMethodForwards(AstNode prog) {
        let decls = prog.Children.Count()
        for i in 0..decls {
            let decl = prog.Children.Get(i)
            if (decl.Kind == NodeKind.CLASS_DECL && !decl.Flag2) {
                let cname = this.SymName(decl.Name)
                let members = decl.Children.Count()
                for j in 0..members {
                    let m = decl.Children.Get(j)
                    if (m.Kind == NodeKind.METHOD_DECL && m.Name != decl.Name && !m.Flag3) {
                        let isPublic = m.Flag
                        var prefix   = ""
                        if (!isPublic) { prefix = "static " }
                        this.Out.EmitLine(prefix + this.MethodSig(m, cname) + ";")
                        this.RegisterParamIfaces(cname + "_" + m.Name, m)
                    }
                    // async methods are forward-declared (impl+fiber+
                    // wrapper) by EmitAsyncForwards in EmitClassForwards.
                }
            }
        }
    }

    private void EmitConstructorForwards(AstNode prog) {
        let decls = prog.Children.Count()
        for i in 0..decls {
            let decl = prog.Children.Get(i)
            if (decl.Kind == NodeKind.CLASS_DECL && !decl.Flag2) {
                let name = this.SymName(decl.Name)
                var ctorFound = false
                let members = decl.Children.Count()
                for j in 0..members {
                    let m = decl.Children.Get(j)
                    if (m.Kind == NodeKind.METHOD_DECL && m.Name == decl.Name) {
                        ctorFound = true
                        var sig = name + "* " + name + "_new("
                        let pcount = m.Params.Count()
                        var first = true
                        for pi in 0..pcount {
                            let p = m.Params.Get(pi)
                            if (!first) { sig = sig + ", " }
                            // A variadic ctor param `...xs: T` lowers to a
                            // single `AmalgameList*`, mirroring MethodSig.
                            if (p.Flag) {
                                sig = sig + "AmalgameList* " + p.Name
                            } else {
                                sig = sig + this.TypeToC(p.Str) + " " + p.Name
                            }
                            first = false
                        }
                        sig = sig + ");"
                        this.Out.EmitLine(sig)
                        this.RegisterParamIfaces(name + "_new", m)
                        // Variadic constructor: register `Name_new` with the
                        // fixed-param count so the NEW_EXPR call site gathers
                        // trailing args into one AmalgameList*, matching the
                        // lowered param above. Done in this forward-decl pass
                        // so the table is populated before any body emits a
                        // `new Name(...)`.
                        if (pcount > 0) {
                            let lastP = m.Params.Get(pcount - 1)
                            if (lastP.Flag) {
                                this.MethodVariadicSet(name + "_new", pcount - 1)
                            }
                        }
                    }
                }
                // Class without an explicit constructor still gets a
                // no-arg `Name_new()` from EmitClass — forward-declare
                // that too so peer constructors can call `new Name()`.
                if (!ctorFound) {
                    this.Out.EmitLine(name + "* " + name + "_new();")
                }
            }
        }
    }

    // ── Lambda discovery & top-level emission ─────────
    //
    // v2.5 splits emission in two: forwards (env struct + fn forward
    // decl) before class struct bodies, and bodies (fn definition)
    // after them. This lets typed param unboxing dereference fields
    // on user classes (`u->Name` where u is `Probe_User*`).
    private void EmitLambdaForwards(AstNode node) {
        if (node == null) { return }
        if (node.Kind == NodeKind.METHOD_DECL && node.Name == "__lambda__") {
            this.EmitOneLambdaForward(node)
        }
        if (node.Left  != null) { this.EmitLambdaForwards(node.Left) }
        if (node.Right != null) { this.EmitLambdaForwards(node.Right) }
        if (node.Cond  != null) { this.EmitLambdaForwards(node.Cond) }
        if (node.Body  != null) { this.EmitLambdaForwards(node.Body) }
        if (node.Else  != null) { this.EmitLambdaForwards(node.Else) }
        let cn = node.Children.Count()
        for i in 0..cn {
            this.EmitLambdaForwards(node.Children.Get(i))
        }
        let pn = node.Params.Count()
        for j in 0..pn {
            this.EmitLambdaForwards(node.Params.Get(j))
        }
        let an = node.Args.Count()
        for k in 0..an {
            this.EmitLambdaForwards(node.Args.Get(k))
        }
    }

    private void EmitLambdaBodies(AstNode node) {
        if (node == null) { return }
        if (node.Kind == NodeKind.METHOD_DECL && node.Name == "__lambda__") {
            this.EmitOneLambdaBody(node)
        }
        if (node.Left  != null) { this.EmitLambdaBodies(node.Left) }
        if (node.Right != null) { this.EmitLambdaBodies(node.Right) }
        if (node.Cond  != null) { this.EmitLambdaBodies(node.Cond) }
        if (node.Body  != null) { this.EmitLambdaBodies(node.Body) }
        if (node.Else  != null) { this.EmitLambdaBodies(node.Else) }
        let cn = node.Children.Count()
        for i in 0..cn {
            this.EmitLambdaBodies(node.Children.Get(i))
        }
        let pn = node.Params.Count()
        for j in 0..pn {
            this.EmitLambdaBodies(node.Params.Get(j))
        }
        let an = node.Args.Count()
        for k in 0..an {
            this.EmitLambdaBodies(node.Args.Get(k))
        }
    }

    // Phase A — assign id, emit env struct + fn forward decl. The id
    // (lam.Str2) is set here so call sites in Phase B can reference
    // lam_N_fn by name.
    private void EmitOneLambdaForward(AstNode lam) {
        let id      = this.LambdaCounter
        this.LambdaCounter = id + 1
        let idStr   = String_FromInt(id)
        lam.Str2    = idStr
        let envName = "LamEnv_" + idStr
        let fnName  = "lam_" + idStr + "_fn"
        let cn: int = lam.Args.Count()
        let pn: int = lam.Params.Count()
        // Emit env struct (always, even when empty — keeps the
        // allocation site uniform).
        this.Out.EmitLine("typedef struct " + envName + " {")
        this.Out.Indent_()
        if (cn == 0) {
            this.Out.EmitLine("char _empty;")
        } else {
            for i in 0..cn {
                let cap = lam.Args.Get(i)
                let ct  = this.TypeToC(cap.Str)
                if (String_Length(ct) == 0 || ct == "void") {
                    this.Out.EmitLine("void* _" + cap.Name + ";")
                } else {
                    this.Out.EmitLine(ct + " _" + cap.Name + ";")
                }
            }
        }
        this.Out.Dedent()
        this.Out.EmitLine("} " + envName + ";")
        // Forward decl of the fn — body comes in Phase C after class
        // struct bodies are emitted.
        var fwdLine = "static void* " + fnName + "(void* __envRaw"
        for pi in 0..pn {
            fwdLine = fwdLine + ", void* __arg" + String_FromInt(pi)
        }
        fwdLine = fwdLine + ");"
        this.Out.EmitLine(fwdLine)
    }

    // Phase C — emit the fn body. The id (lam.Str2) was set in Phase A.
    private void EmitOneLambdaBody(AstNode lam) {
        let idStr   = lam.Str2
        let envName = "LamEnv_" + idStr
        let fnName  = "lam_" + idStr + "_fn"
        let cn: int = lam.Args.Count()
        let pn: int = lam.Params.Count()
        // Emit top-level fn definition. Signature is `void*
        // lam_N_fn(void* env, void* arg0, void* arg1, ...)` — args and
        // result are passed as void*, matching the AmalgameClosure
        // ABI. v2.5 honours each PARAM's annotated type (set by the
        // resolver from the higher-order callsite, e.g.
        // List<User>.Map's lambda gets its first param typed `User`)
        // so member access like x.Name lowers correctly. Pointer-typed
        // params cast directly from void*; scalar-typed params still
        // go through intptr_t.
        var sigLine = "static void* " + fnName + "(void* __envRaw"
        for pi in 0..pn {
            sigLine = sigLine + ", void* __arg" + String_FromInt(pi)
        }
        sigLine = sigLine + ") {"
        this.Out.EmitLine(sigLine)
        this.Out.Indent_()
        this.Out.EmitLine(envName + "* __env = (" + envName + "*)__envRaw;")
        // Unpack params using their annotated type when available.
        for pi in 0..pn {
            let p = lam.Params.Get(pi)
            let pTypeRaw = p.Str
            var pTypeC: string = "i64"
            if (String_Length(pTypeRaw) > 0 && pTypeRaw != "?") {
                pTypeC = this.TypeToC(pTypeRaw)
            }
            let argName = "__arg" + String_FromInt(pi)
            if (this.IsCPointerType(pTypeC)) {
                this.Out.EmitLine(pTypeC + " " + p.Name + " = (" + pTypeC + ")" + argName + ";")
            } else {
                this.Out.EmitLine(pTypeC + " " + p.Name + " = " + this.UnboxScalar(pTypeC, argName) + ";")
            }
        }
        // Unpack captures into local C vars so the body emits naturally.
        for i in 0..cn {
            let cap = lam.Args.Get(i)
            let ct  = this.TypeToC(cap.Str)
            if (String_Length(ct) == 0 || ct == "void") {
                this.Out.EmitLine("void* " + cap.Name + " = __env->_" + cap.Name + ";")
            } else {
                this.Out.EmitLine(ct + " " + cap.Name + " = __env->_" + cap.Name + ";")
            }
            this.LocalTypeSet(cap.Name, ct)
        }
        // Param types too — the local-type table is consulted by
        // identifier emission so x.Field lookups work. v2.5 honours
        // p.Str (set by the resolver) instead of always pinning to i64.
        for pi in 0..pn {
            let p = lam.Params.Get(pi)
            let pTypeRaw = p.Str
            var pTypeC: string = "i64"
            if (String_Length(pTypeRaw) > 0 && pTypeRaw != "?") {
                pTypeC = this.TypeToC(pTypeRaw)
            }
            this.LocalTypeSet(p.Name, pTypeC)
        }
        // Body — either an expression in Left, or a block in Body.
        // Block bodies push InLambdaBody so any RETURN_STMT inside
        // boxes its value as void*; the trailing default return is
        // there in case the block falls through without returning.
        if (lam.Body != null) {
            let prevInLam = this.InLambdaBody
            this.InLambdaBody = true
            this.EmitBlock(lam.Body)
            this.InLambdaBody = prevInLam
            this.Out.EmitLine("return " + this.BoxAsVoid("0") + ";")
        } else if (lam.Left != null) {
            let bodyStr = this.EmitExprStr(lam.Left)
            this.Out.EmitLine("return " + this.BoxAsVoid(bodyStr) + ";")
        } else {
            this.Out.EmitLine("return " + this.BoxAsVoid("0") + ";")
        }
        // Reset local-type entries so subsequent emission isn't polluted.
        for pi in 0..pn {
            let p = lam.Params.Get(pi)
            this.LocalTypeSet(p.Name, "")
        }
        for i in 0..cn {
            let cap = lam.Args.Get(i)
            this.LocalTypeSet(cap.Name, "")
        }
        this.Out.Dedent()
        this.Out.EmitLine("}")
    }

    public string FinishMulti() {
        return this.Out.GetOutput()
    }

    public List<string> GetLines() {
        return this.Out.Lines
    }

    private string SymName(string name) {
        let ns = this.NsPrefix
        if (String_Length(ns) > 0) {
            return ns + "_" + name
        }
        return name
    }

    // ── Local type table ──────────────────────────────
    // Since Amalgame has no Map<string,string> in bootstrap,
    // we use two parallel lists as a poor-man's dictionary.

    private void LocalTypeSet(string varName, string ctype) {
        let n = this.LocalTypeNames.Count()
        for i in 0..n {
            let k = this.LocalTypeNames.Get(i)
            if (k == varName) {
                // update in place — replace by removing and re-adding at same index is not possible,
                // so we overwrite using the Add trick: mark old as "" then add new pair
                // Simplest: just append — lookup finds the last match
                this.LocalTypeNames.Add(varName)
                this.LocalTypeCType.Add(ctype)
                return
            }
        }
        this.LocalTypeNames.Add(varName)
        this.LocalTypeCType.Add(ctype)
    }

    private string LocalTypeGet(string varName) {
        // Search from end so later writes shadow earlier ones
        let n = this.LocalTypeNames.Count()
        var result = ""
        for i in 0..n {
            let k = this.LocalTypeNames.Get(i)
            if (k == varName) {
                result = this.LocalTypeCType.Get(i)
            }
        }
        return result
    }

    private void LocalTypeClear() {
        this.LocalTypeNames = new List<string>()
        this.LocalTypeCType = new List<string>()
    }

    private void FieldTypeSet(string className, string fieldName, string ctype) {
        let key = className + "." + fieldName
        this.FieldNames.Add(key)
        this.FieldCTypes.Add(ctype)
    }

    private string FieldTypeGet(string className, string fieldName) {
        let key = className + "." + fieldName
        let n = this.FieldNames.Count()
        var result = ""
        for i in 0..n {
            let k = this.FieldNames.Get(i)
            if (k == key) {
                result = this.FieldCTypes.Get(i)
            }
        }
        return result
    }

    // Walk a chain of MEMBER nodes rooted at THIS/IDENT and return the
    // bare class name of the leaf. Used by call-site dispatch to
    // resolve `obj.A.B.fn(args)` without forcing a bind-to-local.
    // Empty string if the chain hits an unknown local/field.
    private string ResolveReceiverClass(AstNode node) {
        if (node == null) { return "" }
        let nk = node.Kind
        if (nk == NodeKind.THIS_EXPR) { return this.CurrentClass }
        if (nk == NodeKind.IDENTIFIER) {
            let t = this.LocalTypeGet(node.Name)
            if (String_Length(t) == 0) { return "" }
            return String_Replace(t, "*", "")
        }
        if (nk == NodeKind.MEMBER) {
            let parentCls = this.ResolveReceiverClass(node.Left)
            if (String_Length(parentCls) == 0) { return "" }
            let ft = this.FieldTypeGet(parentCls, node.Name)
            if (String_Length(ft) == 0) { return "" }
            return String_Replace(ft, "*", "")
        }
        return ""
    }

    // For `let names = users.Map(u => u.Name)`, the result list's
    // element type is the lambda's return type — NOT the receiver's
    // element type. We push the lambda params into LocalTypes so
    // InferTypeFromExpr can resolve `u.Name` against the param's
    // annotated type, then pop them. Lives as its own helper so the
    // self-host CGen sees PARAM access through typed AstNode locals
    // (avoids void* erasure across chained `.Get(i)` calls).
    private void TrackMapResultElem(AstNode stmt) {
        let call: AstNode = stmt.Left
        if (call == null) { return }
        if (call.Args.Count() == 0) { return }
        let lam: AstNode = call.Args.Get(0)
        if (lam == null) { return }
        if (lam.Kind != NodeKind.METHOD_DECL) { return }
        if (lam.Name != "__lambda__") { return }
        if (lam.Left == null) { return }
        let pn: int = lam.Params.Count()
        for pi in 0..pn {
            let p: AstNode = lam.Params.Get(pi)
            let pTypeRaw: string = p.Str
            var pTypeC: string = "i64"
            if (String_Length(pTypeRaw) > 0 && pTypeRaw != "?") {
                pTypeC = this.TypeToC(pTypeRaw)
            }
            this.LocalTypeSet(p.Name, pTypeC)
        }
        let retC: string = this.InferTypeFromExpr(lam.Left)
        for pi in 0..pn {
            let p: AstNode = lam.Params.Get(pi)
            this.LocalTypeSet(p.Name, "")
        }
        if (String_Length(retC) > 0 && retC != "void*") {
            this.ListElemSet("__local__", stmt.Name, retC)
        }
    }

    // Record the elem (List<T>) or value (Map<K,V>) type for a local
    // variable, given the raw Amalgame type annotation. No-op when the
    // type isn't generic. Used at VAR_DECL emission for both NEW_EXPR
    // RHS, explicit `: List<int>` annotations, and inferred return types
    // from method calls.
    private void TrackGenericLocal(string varName, string rawType) {
        if (String_StartsWith(rawType, "List<") && String_EndsWith(rawType, ">")) {
            let inner = String_Substring(rawType, 5, String_Length(rawType) - 6)
            if (String_Length(inner) > 0) {
                this.ListElemSet("__local__", varName, this.TypeToC(inner))
                // Also stash the RAW elem type so chained `.Get(i).Get(j)`
                // can peel another generic layer at the consumer's call
                // site (see RecoverChainedListElemRaw). Without this,
                // nested-collection access (`List<List<string>>`) falls
                // through to a `(void*)` cast on the inner Get.
                this.ListElemSet("__local_raw__", varName, inner)
            }
            return
        }
        if (String_StartsWith(rawType, "Map<") && String_EndsWith(rawType, ">")) {
            let inner = String_Substring(rawType, 4, String_Length(rawType) - 5)
            let comma = String_IndexOf(inner, ",")
            if (comma > 0) {
                let vRaw  = String_Substring(inner, comma + 1, String_Length(inner) - comma - 1)
                let vTrim = String_Trim(vRaw)
                if (String_Length(vTrim) > 0) {
                    this.ListElemSet("__local_map__", varName, this.TypeToC(vTrim))
                    // Same raw-shape tracking as for List<T>, keyed under
                    // a Map-specific tag so the chained dispatch can tell
                    // List<T> apart from Map<K,V>.
                    this.ListElemSet("__local_map_raw__", varName, vTrim)
                }
            }
        }
    }

    // Peel one `List<...>` (or `Map<K, ...>`) layer off a raw type
    // string. `List<List<string>>` → `List<string>`, `List<string>` →
    // `string`, `Map<string, int>` → `int`, anything else → "".
    private string PeelOneGenericLayer(string rawType) {
        if (String_StartsWith(rawType, "List<") && String_EndsWith(rawType, ">")) {
            return String_Substring(rawType, 5, String_Length(rawType) - 6)
        }
        if (String_StartsWith(rawType, "Map<") && String_EndsWith(rawType, ">")) {
            let inner = String_Substring(rawType, 4, String_Length(rawType) - 5)
            // Split on the FIRST top-level comma — same logic as
            // TrackGenericLocal above.
            let comma = String_IndexOf(inner, ",")
            if (comma > 0) {
                return String_Trim(String_Substring(inner, comma + 1, String_Length(inner) - comma - 1))
            }
        }
        return ""
    }

    // Walk a chained `.Get(i).Get(j)…` receiver to recover the
    // element raw type at the consumer's call depth. Returns "" if
    // the chain doesn't bottom out at a known typed local. Recursion
    // peels one `List<...>` / `Map<K,...>` layer per Get hop.
    //
    // Example: with `let rows: List<List<string>>`,
    //   `rows.Get(0).Get(0)` → outer Get's receiver is `rows.Get(0)`,
    //   inner is `rows` (IDENTIFIER, depth 0). Inner Get returns
    //   `List<string>`. Outer Get peels one more layer → `string`.
    //   The Get-emit branch uses that to emit `(code_string)…` instead
    //   of `(void*)…`.
    private string RecoverChainedListElemRaw(AstNode recv) {
        if (recv == null) { return "" }
        if (recv.Kind == NodeKind.IDENTIFIER) {
            return this.ListElemGet("__local_raw__", recv.Name)
        }
        if (recv.Kind == NodeKind.CALL) {
            if (recv.Left == null) { return "" }
            if (recv.Left.Kind != NodeKind.MEMBER) { return "" }
            if (recv.Left.Name != "Get") { return "" }
            let innerElemRaw: string = this.RecoverChainedListElemRaw(recv.Left.Left)
            if (String_Length(innerElemRaw) == 0) { return "" }
            return this.PeelOneGenericLayer(innerElemRaw)
        }
        return ""
    }

    private void ListElemSet(string className, string fieldName, string elemCType) {
        let key = className + "." + fieldName
        this.ListElemNames.Add(key)
        this.ListElemCTypes.Add(elemCType)
    }

    private string ListElemGet(string className, string fieldName) {
        let key = className + "." + fieldName
        let n = this.ListElemNames.Count()
        var result = ""
        for i in 0..n {
            let k = this.ListElemNames.Get(i)
            if (k == key) {
                result = this.ListElemCTypes.Get(i)
            }
        }
        return result
    }

