// The element type of a local list must not leak from one method to another.
//
// `let r: List<string>` in A() recorded r's element type; an untyped
// `let r = Holder.Lengths(...)` (List<int>) in B() of the same class then
// reused it, so `r.Get(0) == 3` lowered to code_string_equals on an
// integer and crashed. Locals now forget their element types between
// methods.

namespace Tests

public class Holder {
    public static bool A() {
        let r: List<string> = ["abc"]
        return r.Count() == 1
    }

    public static List<int> Lengths(List<string> l) {
        let res = new List<int>()
        for x in l { res.Add(String.Length(x)) }
        return res
    }

    public static bool B() {
        let r = Holder.Lengths(["abc", "de"])
        return r.Get(0) == 3 && r.Get(1) == 2
    }
}

public class Program {
    public static void Main(string[] args) {
        if (Holder.A()) { Console.WriteLine("typed: ok") }
        if (Holder.B()) { Console.WriteLine("untyped: ok") } else { Console.WriteLine("untyped: wrong") }
    }
}
