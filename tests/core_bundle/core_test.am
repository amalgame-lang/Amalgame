                let lExp    = "{\"seq\":6,\"type\":\"request\",\"command\":\"variables\",\"arguments\":{\"variablesReference\":1000}}"
                let lDisc   = "{\"seq\":7,\"type\":\"request\",\"command\":\"disconnect\"}"
