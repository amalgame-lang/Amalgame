// Migrated from tests/run_tests.sh — 197 `run_test` core compiler
// assertions across 63 samples. Each sample compiles + runs ONCE;
// the captured stdout is scanned for each assertion's expected
// substring. Mirrors the bash runner case-for-case.
//
// PHASE 1 of the run_tests.sh migration. Still TBD:
//   run_external_test (6), run_lib_test (2), run_multifile_test (4),
//   run_multi_test (1), run_check_fail (1), run_amc_test_check (4),
//   run_lint_check (4), run_c_check (7), run_lsp_check (36),
//   run_lsp_absent (1), run_migrate_* (22), run_generate_check (25),
//   run_explain_check (10), run_lib_link_test (1).
//
// Driven by `amc test` discovery (*_test.am). Assumes CWD is the
// repo root.

class CoreCase {
    public Label: string
    public Needle: string
    public CoreCase(label: string, needle: string) {
        this.Label = label
        this.Needle = needle
    }
}

class Program {
    public static string CompileAndRunOnce(string sample, string tag, string envPrefix) {
        let outBin = "/tmp/amc_core_" + tag + "_bin"
        let outC = outBin + ".c"
        let amcCmd = "./amc -o '" + outBin + "' '" + sample + "' --quiet 2>/dev/null"
        let cr = Process.RunCapture(amcCmd)
        if (cr.Exit != 0) { return "<<compile-fail>>" }
        let gccCmd = "gcc -O2 -Wno-unused-variable -Wno-unused-parameter -Iruntime '" + outC + "' -lgc -lm -lz -ldl -lpthread -o '" + outBin + "' 2>/dev/null"
        let gc = Process.RunCapture(gccCmd)
        if (gc.Exit != 0) { return "<<link-fail>>" }
        // envPrefix lets callers set runtime env vars (e.g. "AMC_ENV_PROBE=hello ")
        let rr = Process.RunCapture(envPrefix + "'" + outBin + "' 2>&1")
        return rr.Stdout
    }

    public static void RunGroup(string sample, string tag, List<CoreCase> cases) {
        Program.RunGroupEnv(sample, tag, "", cases)
    }

    public static void RunGroupEnv(string sample, string tag, string envPrefix, List<CoreCase> cases) {
        let captured = Program.CompileAndRunOnce(sample, tag, envPrefix)
        let n: int = cases.Count()
        if (captured == "<<compile-fail>>") {
            for i in 0..n {
                let c1 = cases.Get(i)
                Console.WriteLine("[FAIL] " + c1.Label + " (amc compile failed for " + sample + ")")
            }
            return
        }
        if (captured == "<<link-fail>>") {
            for i in 0..n {
                let c2 = cases.Get(i)
                Console.WriteLine("[FAIL] " + c2.Label + " (gcc link failed for " + sample + ")")
            }
            return
        }
        for i in 0..n {
            let c = cases.Get(i)
            if (String_Contains(captured, c.Needle)) {
                Console.WriteLine("[PASS] " + c.Label)
            } else {
                Console.WriteLine("[FAIL] " + c.Label + " (missing: " + c.Needle + ")")
            }
        }
    }

    // ── LLM / generic-cmd helper ───────────────────

    // Run a shell command (already includes amc + args + env prefix),
    // capture merged stdout/stderr, grep for `needle`. Used by all the
    // migrate / generate / explain test cases.
    public static void RunCmdGrep(string label, string cmd, string needle) {
        let r = Process.RunCapture(cmd + " 2>&1")
        if (String_Contains(r.Stdout, needle)) {
            Console.WriteLine("[PASS] " + label)
        } else {
            Console.WriteLine("[FAIL] " + label + " (pattern not found: " + needle + ")")
        }
    }

    // Same as RunCmdGrep but asserts pattern is ABSENT.
    public static void RunCmdAbsent(string label, string cmd, string needle) {
        let r = Process.RunCapture(cmd + " 2>&1")
        if (!String_Contains(r.Stdout, needle)) {
            Console.WriteLine("[PASS] " + label)
        } else {
            Console.WriteLine("[FAIL] " + label + " (forbidden pattern present: " + needle + ")")
        }
    }

    // ── LSP helpers ────────────────────────────────

    // Frame a single JSON-RPC body with LSP's Content-Length header.
    // String_Length on UTF-8 strings returns byte count (matches `${#var}` in bash).
    public static string LspFrame(string body) {
        let n: int = String_Length(body)
        return "Content-Length: " + String_FromInt(n) + "\r\n\r\n" + body
    }

    // Pipe the bytes of `fixturePath` into `./amc lsp` and return the
    // merged stdout/stderr. The bash `printf '%s' "$seq" | amc lsp 2>&1`
    // shape becomes `cat <fixture> | amc lsp 2>&1`.
    public static string LspRun(string fixturePath) {
        let r = Process.RunCapture("cat '" + fixturePath + "' | ./amc lsp 2>&1")
        return r.Stdout
    }

    public static void RunLspCheck(string label, string fixturePath, string needle) {
        let out = Program.LspRun(fixturePath)
        if (String_Contains(out, needle)) {
            Console.WriteLine("[PASS] " + label)
        } else {
            Console.WriteLine("[FAIL] " + label + " (pattern not found in LSP output)")
        }
    }

    public static void RunLspAbsent(string label, string fixturePath, string needle) {
        let out = Program.LspRun(fixturePath)
        if (!String_Contains(out, needle)) {
            Console.WriteLine("[PASS] " + label)
        } else {
            Console.WriteLine("[FAIL] " + label + " (forbidden pattern present: " + needle + ")")
        }
    }

    // Build the xdir fixture at runtime: the JSON body embeds the
    // ABSOLUTE path to tests/fixtures/lsp-workspace/tests/byteio_test.am
    // so the LSP resolves the file. Path varies per machine — Python's
    // precomputed fixtures can't hardcode it.
    public static string BuildLspXdirFixture() {
        let absPath = String_Trim(Program.ShellRead("realpath tests/fixtures/lsp-workspace/tests/byteio_test.am"))
        let init = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{}}"
        let openXdir = "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file://" + absPath + "\",\"languageId\":\"amalgame\",\"version\":1,\"text\":\"namespace Workspace.Tests\\n\\npublic class TestRunner {\\n    public static void Run() {\\n        let v: int = ByteIO.Read(42)\\n    }\\n}\\n\"}}}"
        let shut = "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"shutdown\"}"
        let exitMsg = "{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}"
        let seq = Program.LspFrame(init) + Program.LspFrame(openXdir) + Program.LspFrame(shut) + Program.LspFrame(exitMsg)
        let dest = "/tmp/amc_core_lsp_xdir.bin"
        File.WriteAll(dest, seq)
        return dest
    }

    // Build a self-contained documentHighlight fixture: a tiny doc
    // where `Greet` appears twice (decl on line 1, call on line 6),
    // then a documentHighlight request on the call site (line 6).
    // Expect two highlight ranges back, both kind 1 (Text).
    public static string BuildLspHighlightFixture() {
        let uri = "file:///tmp/amc_hl_doc.am"
        let text = "class Foo {\\n    public void Greet() {}\\n}\\n\\npublic class Program {\\n    public static void Main() {\\n        let f = new Foo()\\n        f.Greet()\\n    }\\n}\\n"
        let init = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{}}"
        let open = "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"" + uri + "\",\"languageId\":\"amalgame\",\"version\":1,\"text\":\"" + text + "\"}}}"
        // line 7 (0-based) `        f.Greet()` — character 10 lands on Greet
        let hl = "{\"jsonrpc\":\"2.0\",\"id\":30,\"method\":\"textDocument/documentHighlight\",\"params\":{\"textDocument\":{\"uri\":\"" + uri + "\"},\"position\":{\"line\":7,\"character\":11}}}"
        let shut = "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"shutdown\"}"
        let exitMsg = "{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}"
        let seq = Program.LspFrame(init) + Program.LspFrame(open) + Program.LspFrame(hl) + Program.LspFrame(shut) + Program.LspFrame(exitMsg)
        let dest = "/tmp/amc_core_lsp_hl.bin"
        File.WriteAll(dest, seq)
        return dest
    }

    // ── Phase 2 helpers ─────────────────────────────

    public static int ShellExit(string cmd) {
        let r = Process.RunCapture(cmd + " >/dev/null 2>&1")
        return r.Exit
    }

    public static string ShellRead(string cmd) {
        let r = Process.RunCapture(cmd)
        return r.Stdout
    }

    // run_check_fail: `amc --check <file>` must exit non-zero AND output
    // contain the diagnostic substring.
    public static void RunCheckFail(string label, string file, string needle) {
        let r = Process.RunCapture("./amc --check '" + file + "' 2>&1")
        if (r.Exit == 0) {
            Console.WriteLine("[FAIL] " + label + " (expected non-zero exit)")
            return
        }
        if (String_Contains(r.Stdout, needle)) {
            Console.WriteLine("[PASS] " + label)
        } else {
            Console.WriteLine("[FAIL] " + label + " (diagnostic missing: " + needle + ")")
        }
    }

    // run_amc_test_check: `amc test <dir>`, grep stdout for pattern.
    public static void RunAmcTestCheck(string label, string dir, string needle) {
        let r = Process.RunCapture("./amc test '" + dir + "' 2>&1")
        if (String_Contains(r.Stdout, needle)) {
            Console.WriteLine("[PASS] " + label)
        } else {
            Console.WriteLine("[FAIL] " + label + " (pattern not found: " + needle + ")")
        }
    }

    // run_lint_check: `amc --lint -o <out> <file>`, grep stdout for pattern.
    public static void RunLintCheck(string label, string file, string needle) {
        let outBase = "/tmp/amc_core_lint_" + label
        let r = Process.RunCapture("./amc --lint -o '" + outBase + "' '" + file + "' 2>&1")
        if (String_Contains(r.Stdout, needle)) {
            Console.WriteLine("[PASS] " + label)
        } else {
            Console.WriteLine("[FAIL] " + label + " (lint pattern not found: " + needle + ")")
        }
    }

    // run_c_check: `amc <flags> -o <out> <file>`, check generated .c contains pattern.
    public static void RunCCheck(string label, string file, string needle, string flags) {
        let outBase = "/tmp/amc_core_ccheck_" + label
        let cmd = "./amc " + flags + " -o '" + outBase + "' '" + file + "' >/dev/null 2>&1"
        Program.ShellExit(cmd)
        let cFile = outBase + ".c"
        if (!File.Exists(cFile)) {
            Console.WriteLine("[FAIL] " + label + " (no .c generated)")
            return
        }
        let body = File.ReadAll(cFile)
        if (String_Contains(body, needle)) {
            Console.WriteLine("[PASS] " + label)
        } else {
            Console.WriteLine("[FAIL] " + label + " (C pattern missing: " + needle + ")")
        }
    }

    // run_lib_test: `amc <flags> -o <out> <file>`, expect "Library" in amc's output.
    public static void RunLibTest(string label, string file, string flags) {
        let outBase = "/tmp/amc_core_lib_" + label
        let r = Process.RunCapture("./amc " + flags + " -o '" + outBase + "' '" + file + "' 2>&1")
        if (r.Exit != 0) {
            Console.WriteLine("[FAIL] " + label + " (amc exit=" + String_FromInt(r.Exit) + ")")
            return
        }
        if (String_Contains(r.Stdout, "Library")) {
            Console.WriteLine("[PASS] " + label)
        } else {
            Console.WriteLine("[FAIL] " + label + " (expected Library mode)")
        }
    }

    // run_external_test: amc with --external flags, link against lib/libamalgame.a.
    public static void RunExternalTest(string label, string file, string needle, string externals) {
        if (!File.Exists("lib/libamalgame.a")) {
            Console.WriteLine("[SKIP] " + label + " (lib/libamalgame.a missing)")
            return
        }
        let outBase = "/tmp/amc_core_ext_" + label
        // Split externals on whitespace and prefix each with --external
        let parts: List<string> = String_Split(externals, " ")
        let np: int = parts.Count()
        var extArgs: string = ""
        for i in 0..np {
            let e: string = String_Trim(parts.Get(i))
            if (String_Length(e) > 0) {
                extArgs = extArgs + " --external " + e
            }
        }
        let amcCmd = "./amc -o '" + outBase + "'" + extArgs + " '" + file + "' 2>&1"
        let cr = Process.RunCapture(amcCmd)
        if (cr.Exit != 0) {
            Console.WriteLine("[FAIL] " + label + " (amc exit=" + String_FromInt(cr.Exit) + ")")
            return
        }
        let outC = outBase + ".c"
        let gccCmd = "gcc -O2 -Iruntime '" + outC + "' lib/libamalgame.a -lgc -lm -lz -o '" + outBase + "' 2>/dev/null"
        let gc = Process.RunCapture(gccCmd)
        if (gc.Exit != 0) {
            Console.WriteLine("[FAIL] " + label + " (gcc link failed)")
            return
        }
        let rr = Process.RunCapture("'" + outBase + "' 2>&1")
        if (String_Contains(rr.Stdout, needle)) {
            Console.WriteLine("[PASS] " + label)
        } else {
            Console.WriteLine("[FAIL] " + label + " (output mismatch — wanted: " + needle + ")")
        }
    }

    // run_external_pair: compile a facade and its consumer in TWO separate
    // amc invocations (the consumer with `--external <facade>`), then link
    // both generated .c files together. Unlike RunExternalTest this does
    // not need the facade precompiled into libamalgame.a, so it can cover
    // an ad-hoc facade — used to exercise the cross-TU variadic ABI
    // (consumer's ExternalMethodSig forward-decl vs facade's MethodSig body).
    public static void RunExternalPair(string label, string facade, string consumer, string needle) {
        let outBase = "/tmp/amc_core_extpair_" + label
        let facadeC = outBase + "_facade"
        let mainC   = outBase + "_main"
        let fr = Process.RunCapture("./amc -o '" + facadeC + "' '" + facade + "' 2>&1")
        if (fr.Exit != 0) {
            Console.WriteLine("[FAIL] " + label + " (facade amc exit=" + String_FromInt(fr.Exit) + ")")
            return
        }
        let cr = Process.RunCapture("./amc -o '" + mainC + "' --external '" + facade + "' '" + consumer + "' 2>&1")
        if (cr.Exit != 0) {
            Console.WriteLine("[FAIL] " + label + " (consumer amc exit=" + String_FromInt(cr.Exit) + ")")
            return
        }
        let gccCmd = "gcc -O2 -Iruntime '" + mainC + ".c' '" + facadeC + ".c' -lgc -lm -lz -o '" + outBase + "' 2>&1"
        let gc = Process.RunCapture(gccCmd)
        if (gc.Exit != 0) {
            Console.WriteLine("[FAIL] " + label + " (gcc link failed)")
            return
        }
        let rr = Process.RunCapture("'" + outBase + "' 2>&1")
        if (String_Contains(rr.Stdout, needle)) {
            Console.WriteLine("[PASS] " + label)
        } else {
            Console.WriteLine("[FAIL] " + label + " (output mismatch — wanted: " + needle + ")")
        }
    }

    // run_multifile_test / run_multi_test: amc with multiple .am files, link, run, grep stdout.
    public static void RunMultiFile(string label, string needle, string files) {
        let outBase = "/tmp/amc_core_multi_" + label
        let amcCmd = "./amc -o '" + outBase + "' " + files + " 2>&1"
        let cr = Process.RunCapture(amcCmd)
        if (cr.Exit != 0) {
            Console.WriteLine("[FAIL] " + label + " (amc exit=" + String_FromInt(cr.Exit) + ")")
            return
        }
        let outC = outBase + ".c"
        let gccCmd = "gcc -O2 -Werror=implicit-function-declaration -Iruntime '" + outC + "' -lgc -lm -lz -o '" + outBase + "' 2>/dev/null"
        let gc = Process.RunCapture(gccCmd)
        if (gc.Exit != 0) {
            Console.WriteLine("[FAIL] " + label + " (gcc link failed — implicit decl?)")
            return
        }
        let rr = Process.RunCapture("'" + outBase + "' 2>&1")
        if (String_Contains(rr.Stdout, needle)) {
            Console.WriteLine("[PASS] " + label)
        } else {
            Console.WriteLine("[FAIL] " + label + " (output mismatch — wanted: " + needle + ")")
        }
    }

    // run_lib_link_test: amc --lib lib.am → .o, then gcc consumer.c + lib.o, run, grep.
    public static void RunLibLinkTest(string label, string libFile, string consumerC, string needle) {
        let tmp = String_Trim(Program.ShellRead("mktemp -d"))
        let libBase = tmp + "/lib"
        Program.ShellExit("./amc --lib '" + libFile + "' -o '" + libBase + "' >/dev/null 2>&1")
        if (!File.Exists(libBase + ".c")) {
            Console.WriteLine("[FAIL] " + label + " (no lib .c generated)")
            Program.ShellExit("rm -rf '" + tmp + "'")
            return
        }
        // Lib must NOT contain `int main`
        let libC = File.ReadAll(libBase + ".c")
        if (String_Contains(libC, "\nint main")) {
            Console.WriteLine("[FAIL] " + label + " (lib has int main)")
            Program.ShellExit("rm -rf '" + tmp + "'")
            return
        }
        let cc1 = Program.ShellExit("gcc -Iruntime -c '" + libBase + ".c' -o '" + libBase + ".o'")
        if (cc1 != 0) {
            Console.WriteLine("[FAIL] " + label + " (gcc -c)")
            Program.ShellExit("rm -rf '" + tmp + "'")
            return
        }
        let cc2 = Program.ShellExit("gcc -Iruntime '" + consumerC + "' '" + libBase + ".o' -lgc -lm -lz -o '" + tmp + "/app'")
        if (cc2 != 0) {
            Console.WriteLine("[FAIL] " + label + " (link)")
            Program.ShellExit("rm -rf '" + tmp + "'")
            return
        }
        let rr = Process.RunCapture("'" + tmp + "/app' 2>&1")
        if (String_Contains(rr.Stdout, needle)) {
            Console.WriteLine("[PASS] " + label)
        } else {
            Console.WriteLine("[FAIL] " + label + " (got: " + rr.Stdout + ")")
        }
        Program.ShellExit("rm -rf '" + tmp + "'")
    }

