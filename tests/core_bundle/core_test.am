        let docSrc: string = "namespace Tests.Doc\n\n// Top-level intro comment for the class.\n// Spans two lines.\npublic class Greeter {\n    // Field doc.\n    public Name: string\n\n    // Method doc — appears under the method heading.\n    public string Greet(string who) {\n        return \"hello \" + who\n    }\n}\n"
