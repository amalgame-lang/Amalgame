            "provider:      gemini")

        // ── --help mentions new providers (3) ──
        Program.RunCmdGrep("v2: --help mentions chatgpt", "./amc generate --help", "chatgpt")
        Program.RunCmdGrep("v2: --help mentions gemini",  "./amc generate --help", "gemini")
        Program.RunCmdGrep("v2: --help mentions custom",  "./amc generate --help", "custom")

        // ── Cost estimation (5) ──
        Program.RunCmdGrep("cost: claude free",
            "./amc generate 'test' --dry-run",
            "free (subscription")
        Program.RunCmdGrep("cost: chatgpt has tokens",
            "OPENAI_API_KEY=fake env -u GEMINI_API_KEY -u ANTHROPIC_API_KEY ./amc generate 'test' --dry-run",
            "in + ~1000 out")
        Program.RunCmdGrep("cost: chatgpt opus model dollars",
            "OPENAI_API_KEY=fake env -u GEMINI_API_KEY -u ANTHROPIC_API_KEY ./amc generate 'test' --dry-run --model gpt-4o",
            "$")
        Program.RunCmdGrep("cost: claude-api opus mentions opus",
            "ANTHROPIC_API_KEY=fake env -u OPENAI_API_KEY -u GEMINI_API_KEY ./amc generate 'test' --dry-run --model claude-opus-4-7",
            "claude-opus-4-7")
        Program.RunCmdGrep("cost: gemini default flash",
            "GEMINI_API_KEY=fake env -u OPENAI_API_KEY -u ANTHROPIC_API_KEY ./amc generate 'test' --dry-run",
            "gemini-1.5-flash")

        // ── --stream constraints (5) ──
        Program.RunCmdGrep("stream: requires CLI provider",
            "./amc generate 'test' --stream --provider claude-api",
            "requires --provider claude")
        Program.RunCmdGrep("stream: incompat with -o",
            "./amc generate 'test' --stream -o /tmp/x.am",
            "incompatible with -o")
        Program.RunCmdGrep("stream: --help mentions",
            "./amc generate --help",
            "Stream the LLM response")
        Program.RunCmdGrep("stream: explain requires CLI",
            "./amc explain '" + explainFix + "' --stream --provider claude-api",
            "requires --provider claude")
        Program.RunCmdGrep("stream: explain --help",
            "./amc explain --help",
            "Stream the LLM response")

        // ── Result cache (2) ──
        Program.RunCmdGrep("cache: --help mentions",
            "./amc migrate --help",
            "Skip the on-disk result cache")
        Program.RunCmdGrep("cache: --no-cache accepted",
            unsetAll + "./amc migrate '" + migTs + "' --provider claude-api --no-cache",
            "claude-api: ANTHROPIC_API_KEY not set")

        // Cleanup
        Program.ShellExit("rm -rf '" + bdir + "'")
    }
}
