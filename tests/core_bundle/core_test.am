        // dap: bridge tests — require gdb. Skip cleanly when absent.
        let hasGdb = Program.ShellExit("command -v gdb")
        if (hasGdb != 0) {
            Console.WriteLine("[SKIP] dap: bridge initialize handshake (gdb not on PATH)")
            Console.WriteLine("[SKIP] dap: bridge full session (gdb not on PATH)")
            Console.WriteLine("[SKIP] dap: bridge pretty-print + drill (gdb not on PATH)")
        } else {
            // Bridge handshake (initialize → initialized event → disconnect).
            let dInit = "{\"seq\":1,\"type\":\"request\",\"command\":\"initialize\",\"arguments\":{\"clientID\":\"test\",\"adapterID\":\"amc\"}}"
            let dDisc = "{\"seq\":2,\"type\":\"request\",\"command\":\"disconnect\"}"
            let initFrame = Program.LspFrame(dInit)
            let discFrame = Program.LspFrame(dDisc)
            File.WriteAll("/tmp/amc_core_dap_init.bin", initFrame + discFrame)
            let bridgeOut = Process.RunCapture("cat /tmp/amc_core_dap_init.bin | timeout 5 ./amc dap --bridge 2>&1")
            let bOut = bridgeOut.Stdout
            if (String_Contains(bOut, "\"command\":\"initialize\",\"body\":{")
                && String_Contains(bOut, "\"event\":\"initialized\"")
                && String_Contains(bOut, "\"command\":\"disconnect\"")) {
                Console.WriteLine("[PASS] dap: bridge initialize handshake")
            } else {
                Console.WriteLine("[FAIL] dap: bridge initialize handshake")
            }

            // Full session — compile a small C program with -g, drive DAP through bridge.
            let dapProg = String_Trim(Program.ShellRead("mktemp --suffix=.c"))
            let dapBin = String_Trim(Program.ShellRead("mktemp -u"))
            let cBody = "#include <stdio.h>\nint main() {\n    int x = 7;\n    int y = 11;\n    int sum = x + y;\n    printf(\"%d\\n\", sum);\n    return 0;\n}\n"
            File.WriteAll(dapProg, cBody)
            let gccG = Program.ShellExit("gcc -g -O0 '" + dapProg + "' -o '" + dapBin + "'")
            if (gccG != 0) {
                Console.WriteLine("[SKIP] dap: bridge full session (gcc -g failed)")
            } else {
                // Build the session in 3 chunks (matches bash sleep pacing).
                let dLaunch = "{\"seq\":2,\"type\":\"request\",\"command\":\"launch\",\"arguments\":{\"program\":\"" + dapBin + "\"}}"
                let dSetBp  = "{\"seq\":3,\"type\":\"request\",\"command\":\"setBreakpoints\",\"arguments\":{\"source\":{\"path\":\"" + dapProg + "\"},\"breakpoints\":[{\"line\":5}]}}"
                let dCfgDone = "{\"seq\":4,\"type\":\"request\",\"command\":\"configurationDone\"}"
                let dSt     = "{\"seq\":5,\"type\":\"request\",\"command\":\"stackTrace\",\"arguments\":{\"threadId\":1}}"
                let dVars   = "{\"seq\":6,\"type\":\"request\",\"command\":\"variables\",\"arguments\":{\"variablesReference\":1}}"
                let dEval   = "{\"seq\":7,\"type\":\"request\",\"command\":\"evaluate\",\"arguments\":{\"expression\":\"x+y\",\"frameId\":0}}"
                let dCont   = "{\"seq\":8,\"type\":\"request\",\"command\":\"continue\"}"
                let dDisc2  = "{\"seq\":9,\"type\":\"request\",\"command\":\"disconnect\"}"
                let chunk1 = Program.LspFrame(dInit) + Program.LspFrame(dLaunch) + Program.LspFrame(dSetBp) + Program.LspFrame(dCfgDone)
                let chunk2 = Program.LspFrame(dSt) + Program.LspFrame(dVars) + Program.LspFrame(dEval)
                let chunk3 = Program.LspFrame(dCont)
                let chunk4 = Program.LspFrame(dDisc2)
                File.WriteAll("/tmp/amc_core_dap_c1.bin", chunk1)
                File.WriteAll("/tmp/amc_core_dap_c2.bin", chunk2)
                File.WriteAll("/tmp/amc_core_dap_c3.bin", chunk3)
                File.WriteAll("/tmp/amc_core_dap_c4.bin", chunk4)
